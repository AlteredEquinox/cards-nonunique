      },
      "translations": {
        "en_US": {
          "text": "\"Chin up and stand tall. You’re shieldbearers of the Aegis now!\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Relevez la tête, tenez vous fièrement. Vous êtes maintenant boucliers de l'Aegis ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Su col morale e testa alta! Ora siete gli scudieri dell'Aegis!\"",
          "locale": "it_IT"
        },
        "de_DE": {
          "text": "„Kopf hoch und Haltung annehmen. Ihr seid jetzt Schildträger der Aegis!“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Animen esas caras, las cabezas bien altas. ¡Ahora son escuderos de la Égida!».",
          "locale": "es_ES"
        }
      },
      "id": "01JV4TAWCGX51TT9YVC7TSKZPQ",
      "text": "\"Chin up and stand tall. You’re shieldbearers of the Aegis now!\""
    }
