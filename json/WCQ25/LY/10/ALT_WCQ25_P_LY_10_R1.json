                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Cuando voy a la reserva desde la zona de expedición — Puedes devolver a tu mano otra carta de tu reserva.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando vado nella Riserva dall'area delle spedizioni — Puoi riprendere in mano un'altra carta dalla tua Riserva.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque je vais en Réserve depuis la zone d'Expédition — Vous pouvez renvoyer une autre carte de votre Réserve dans votre main.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ich aus der Expeditionszone in die Reserve gehe — Du darfst eine andere Karte aus deiner Reserve in deine Hand zurückholen.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "When I go to Reserve from the Expedition zone — You may return another card from your Reserve to your hand.",
                    "locale": "en_US"
                  }
                },
                "text": "When I go to Reserve from the Expedition zone — You may return another card from your Reserve to your hand."
