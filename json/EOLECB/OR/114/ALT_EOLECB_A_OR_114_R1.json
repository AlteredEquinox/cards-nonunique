                "translations": {
                  "en_US": {
                    "text": "When I leave the Expedition zone — Create an [ORDIS_RECRUIT] Soldier token in each of your Expeditions.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn ich die Expeditionszone verlasse — Erschaffe eine [ORDIS_RECRUIT]-Soldatenmarke in jeder deiner Expeditionen.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando abandone la zona de expedición — Crea una ficha de soldado [ORDIS_RECRUIT] en cada una de tus expediciones.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsque je quitte la zone d'Expédition — Créez un jeton Soldat [ORDIS_RECRUIT] dans chacune de vos Expéditions.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Quando lascio l'area delle spedizioni — Crea una pedina Soldato [ORDIS_RECRUIT] in ciascuna delle tue spedizioni.",
                    "locale": "it_IT"
                  }
                },
                "text": "When I leave the Expedition zone — Create an [ORDIS_RECRUIT] Soldier token in each of your Expeditions."
