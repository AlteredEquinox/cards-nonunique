                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Wenn ein anderer Charakter sich deinen Expeditionen anschließt — Du darfst 1 meiner Verstärkungen ausgeben. Falls du das tust, erhält er 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "When another Character joins your Expeditions — You may spend 1 of my boosts. If you do, it gains 1 boost.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando otro personaje se incorpore a tus expediciones — Puedes gastar 1 de mis potenciadores. Si lo haces, gana 1 potenciador.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando un altro personaggio si unisce alle tue spedizioni — Puoi spendere 1 dei miei rinforzi. Se lo fai, ottiene 1 rinforzo.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un autre Personnage rejoint vos Expéditions — Vous pouvez dépenser 1 de mes boosts. Si vous le faites, il gagne 1 boost.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When another Character joins your Expeditions — You may spend 1 of my boosts. If you do, it gains 1 boost."
              }
            ],
            "reference": "02786"
          },
