        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "« Vous passerez que d'une seule manière : de vie à trépas ! »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"Getting past me means going through hell—with no way back.\"",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "«El único paso que daréis será el de la vida a la muerte».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„An mir vorbei heißt: durch die Hölle gehen, ohne Rückweg.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Chi vuole superarmi dovrà sfidare l'inferno, senza possibilità di ritorno.\"",
          "locale": "it_IT"
        }
      },
      "id": "01KHBKDKCHSS1BCZHJRMQS36RV",
      "text": "\"Getting past me means going through hell—with no way back.\""
