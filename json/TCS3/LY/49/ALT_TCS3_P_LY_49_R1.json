                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "{I} Lorsque vous jouez un autre Personnage avec une stat de base 0 — Je gagne 1 boost, jusqu'à un max de 2.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{I} Quando giochi un altro personaggio con una statistica base pari a 0 — Ottengo 1 rinforzo, fino a un max di 2.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "{I} When you play another Character with a base statistic of 0 — I gain 1 boost, up to a max of 2.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{I} Wenn du einen anderen Charakter mit einer Basisstatistik von 0 spielst — Ich erhalte 1 Verstärkung, bis maximal 2.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{I} Cuando juegues otro personaje con una estadística básica de 0 — Gano 1 potenciador, hasta un máximo de 2.",
                    "locale": "es_ES"
                  }
                },
                "text": "{I} When you play another Character with a base statistic of 0 — I gain 1 boost, up to a max of 2."
              }
            ],
            "reference": "00882"
          },
          "sequence": 0,
          "id": "01JV2B2JQATW5855WXT1PCY27H"
