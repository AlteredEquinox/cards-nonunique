{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"This one's for all the explorers out there and all the hard work they do. They're not just monkeyin' around!\" — Boona",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "«Esta se la dedicamos a los exploradores que salen ahí fuera a darlo todo. ¡No van por ahí haciendo el mono!». — Boona",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Cette chanson est dédiée à tous les explorateurs qui paient avec leur sueur, et pas en monnaie de singe ! » — Boona",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Dieses Lied ist allen Entdeckern gewidmet, die in ihrer Aufgabe mehr als nur Affentheater sehen!“ – Boona",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Questa la dedichiamo ai nostri esploratori per le loro grandi gesta. Noialtri possiamo solo scimmiottarli!\" — Boona",
          "locale": "it_IT"
        }
      },
      "id": "01JV4T4QG6HRB559YB1519WHF3",
      "text": "\"This one's for all the explorers out there and all the hard work they do. They're not just monkeyin' around!\" — Boona"
    }
  ],
