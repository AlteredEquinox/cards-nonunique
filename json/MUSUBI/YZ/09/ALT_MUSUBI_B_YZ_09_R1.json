        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "« Un jour, je te montrerai les merveilles d'Avalon, la véritable majesté des royaumes faés. »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"One day, I will show you the wonders of Avalon and the true might of the Fae realms.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Eines Tages werde ich dir die Wunder von Avalon und die wahre Macht der Fae-Reiche zeigen.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Un giorno ti mostrerò le meraviglie di Avalon e il vero potere dei reami delle fate.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Un día te mostraré las maravillas de Avalon y el verdadero poder de los reinos feéricos».",
          "locale": "es_ES"
        }
      },
      "id": "01K4WGXV5PS4J2AAXK0K0WHDWG",
      "text": "\"One day, I will show you the wonders of Avalon and the true might of the Fae realms.\""
    }
  ],
