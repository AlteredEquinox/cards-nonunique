          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Then, send to Reserve target Character they control with Base Cost {3} or less. (Its Base Cost is the Reserve Cost if it's Fleeting or the Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Dann schicke einen Charakter deiner Wahl mit Basiskosten {3} oder weniger, den er kontrolliert, in die Reserve. (Basiskosten sind Reservekosten, falls er Vergänglich ist, oder Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Puis, envoyez en Réserve un Personnage ciblé qu'il contrôle de Coût de Base {3} ou moins. (Son Coût de Base est le Coût de Réserve s'il est Fugace, le Coût de Main sinon.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Poi, manda nella Riserva un personaggio bersaglio che controlla con costo base pari o inferiore a {3}. (Il suo costo base corrisponde al costo dalla Riserva se ha Fugace, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Luego, envía a la reserva un personaje objetivo que controle con coste base de {3} o menos. (Su coste base es su coste desde la reserva si tiene fugacidad o su coste desde la mano.)",
                    "locale": "es_ES"
                  }
                },
                "text": "Then, send to Reserve target Character they control with Base Cost {3} or less. (Its Base Cost is the Reserve Cost if it's Fleeting or the Hand Cost if not.)"
              }
            ],
            "reference": "02114"
          },
          "sequence": 2,
          "id": "01KH66XCKB8C5XYY62NRG14DE7"
        }
