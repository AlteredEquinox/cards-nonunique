                "translations": {
                  "en_US": {
                    "text": "Create a [MANASEED] token in target opponent's Landmarks.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Créez un jeton [MANASEED] dans les Repères d'un adversaire ciblé.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Erschaffe eine [MANASEED]-Marke im Wahrzeichen-Bereich eines Gegners deiner Wahl.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Crea una pedina [MANASEED] nei fulcri di un avversario bersaglio.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Crea una ficha de [MANASEED] en los hitos de un oponente objetivo.",
                    "locale": "es_ES"
                  }
                },
                "text": "Create a [MANASEED] token in target opponent's Landmarks."
