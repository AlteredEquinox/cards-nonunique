                "translations": {
                  "en_US": {
                    "text": "{H} You may target another Character with Base Cost {3} or less, it gains [ANCHORED].",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez cibler un autre Personnage de Coût de Base {3} ou moins. Il gagne [ANCHORED]. (Son Coût de Base est le Coût de Réserve s'il est Fugace, le Coût de Main sinon.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst einen anderen Charakter mit Basiskosten {3} oder weniger wählen, er erhält [ANCHORED]. (Basiskosten sind Reservekosten, falls er Vergänglich ist, oder Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Puoi scegliere come bersaglio un altro personaggio con costo base pari o inferiore a {3} e fargli ottenere [ANCHORED]. (Il suo costo base corrisponde al suo costo dalla Riserva se ha Fugace, altrimenti al suo costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} Puedes hacer objetivo a otro personaje con coste base de {3} o menos. Gana [ANCHORED]. (El coste base es su coste desde la reserva si tiene fugacidad o su coste desde la mano.)",
                    "locale": "es_ES"
                  }
                },
