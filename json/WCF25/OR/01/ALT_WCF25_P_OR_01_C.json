      },
      "translations": {
        "es_ES": {
          "text": "«¡Seguidme, amigos! ¡Juntos, nada puede pararnos!».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Seguitemi, amici! Se rimaniamo uniti, nulla può fermarci!",
          "locale": "it_IT"
        },
        "de_DE": {
          "text": "„Folgt mir, Freunde! Wenn wir zusammenstehen, kann uns nichts aufhalten!“",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "\"Follow me, friends! If we stand together, nothing can stop us!\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Suivez-moi, compagnons ! Si nous travaillons de concert, rien ne pourra nous arrêter ! »",
          "locale": "fr_FR"
        }
      },
      "id": "01K3N7XQ877TR34123MQTME7R1",
