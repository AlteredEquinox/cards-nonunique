                "translations": {
                  "es_ES": {
                    "text": "No se me puede jugar, pero se me puede usar como orbe de maná. (En un draft, puedes añadir cualquier número de cartas \"Convergencia de maná\" a tu mazo.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Je peux seulement être utilisé en tant qu'Orbe de Mana. (En format draft ou scellé, ajoutez autant d'Afflux de Mana que souhaité à votre deck.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Non puoi giocarmi, ma puoi usarmi come una sfera di mana. (In Draft, puoi aggiungere al tuo mazzo un qualsiasi numero di carte \"Convergenza di Mana\".)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "I can't be played, but I can be used as a Mana Orb. (In Draft or Sealed format, you may add any number of 'Mana Convergence' cards to your deck.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Ich fungiere nur als Manakugel. (Im Draft- oder Sealed-Modus darfst du dein Deck um eine beliebige Anzahl von \"Mana-Konvergenz\"-Karten ergänzen.)",
                    "locale": "de_DE"
                  }
                },
                "text": "I can't be played, but I can be used as a Mana Orb. (In Draft or Sealed format, you may add any number of 'Mana Convergence' cards to your deck.)"
