        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Io e te sappiamo bene che la spada ha sempre avuto un ruolo marginale.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Nous savons tous les deux que l'épée n'était qu'un prétexte.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Wir beide wissen, dass es nie um das Schwert ging.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Tú y yo sabemos que la espada nunca ha importado».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"You and I both know it has never been about the sword.\"",
          "locale": "en_US"
        }
      },
      "id": "01JBT1ABNND5D2F2WGRSKHN5V6",
      "text": "\"You and I both know it has never been about the sword.\""
    }
