          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Nelle sue correnti nuotano conoscenze antiche e ricordi dimenticati.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Au sein de ses courants nagent des savoirs anciens et des souvenirs oubliés.",
