      "translations": {
        "es_ES": {
          "text": "Observar el Tumulto exige una perspectiva de altura. Dominarlo exige conocimiento.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Per osservare il Tumulto, bisogna elevarsi al di sopra di esso; per dominarlo, bisogna conoscerlo.",
          "locale": "it_IT"
        },
        "de_DE": {
          "text": "Um den Tumult zu beobachten, muss man den Überblick behalten. Ihn zu bändigen erfordert Wissen.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Observer le Tumulte nécessite de prendre de la hauteur, le maîtriser requiert de la connaissance.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "Observing the Tumult requires taking a high-level perspective on it, and mastering it requires knowledge.",
          "locale": "en_US"
        }
      },
      "id": "01JBT1ACV3F2MQ5MKC7NX3FB07",
      "text": "Observing the Tumult requires taking a high-level perspective on it, and mastering it requires knowledge."
