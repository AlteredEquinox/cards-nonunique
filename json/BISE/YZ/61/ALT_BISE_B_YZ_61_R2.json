        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "Cuando la Remanencia te aflige, las ideas brotan de la mente como el agua de una presa.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Wenn die Remanenz zuschlägt, strömen Gedanken aus deinem Verstand wie Wasser durch einen gebrochenen Damm.",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "When the Remanence strikes, ideas burst out of one's mind like water from a dam.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Quando la Gruma colpisce, le idee balzano fuori dalla mente della vittima come acqua da una diga.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Lorsque la Rémanence frappe, les idées jaillissent de l'esprit comme l'eau d'un barrage.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1ACPYAF45XKNYZ3KJ3NJ5",
      "text": "When the Remanence strikes, ideas burst out of one's mind like water from a dam."
    }
  ],
