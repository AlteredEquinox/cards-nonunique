        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "En las profundidades de la Ciudad, algo parece estar devorando recuerdos y pensamientos.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "In den Tiefen der Stadt scheint etwas Erinnerungen und Gedanken zu verschlingen.",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "In the depths of the City, something seems to be devouring memories and thoughts.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Nelle viscere della città, sembra che qualcosa stia divorando i ricordi e i pensieri.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Dans les profondeurs de la Cité, quelque chose semble dévorer les souvenirs et les pensées.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1AC83HVS9GTH65EX0Q87X",
      "text": "In the depths of the City, something seems to be devouring memories and thoughts."
    }
  ],
