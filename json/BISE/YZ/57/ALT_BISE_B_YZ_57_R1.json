      "translations": {
        "es_ES": {
          "text": "Hay mil maneras de utilizar la savia. Los Yzmir buscan explotar todo su potencial.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Es gibt tausende Arten, Harz zu nutzen. Die Yzmir versuchen, sein Potenzial voll auszuschöpfen.",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "There are a thousand ways to use the Sap. The Yzmir seek to exploit its full potential.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Esistono migliaia di modi di usare la linfa. Gli Yzmir cercano di sfruttare al massimo il suo potenziale.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Il y a mille et une façons d'utiliser la Sève. Les Yzmir cherchent à en tirer tout son potentiel.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1AC43YG41M9GCFGV3C7DF",
      "text": "There are a thousand ways to use the Sap. The Yzmir seek to exploit its full potential."
