      },
      "translations": {
        "de_DE": {
          "text": "Durch Beimischung von etwas Harz in die Tinte wird die Macht der Sigillen dutzendfach verstärkt.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Al mezclar savia y tinta, el poder de los sigilos se multiplica por diez.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "By mixing Sap into the ink, the power of the Sigils is augmented tenfold.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Mescolando la linfa all'inchiostro, il potere dei sigilli decuplica.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "En mêlant la Sève à l'encre, la puissance des Sceaux est décuplée.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1AB4SB0GSCFFP8GY72SB3",
      "text": "By mixing Sap into the ink, the power of the Sigils is augmented tenfold."
    }
  ],
