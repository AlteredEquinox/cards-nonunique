      "translations": {
        "de_DE": {
          "text": "Mit der richtigen Technik nimmt Harz energetische Eigenschaften an, die es zu einer guten Kelon-Alternative machen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Con la tecnología adecuada, la savia podría hacer gala de propiedades energéticas capaces de sustituir al kelón.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Con la tecnologia giusta, la linfa può acquisire proprietà energetiche sufficienti a sostituire il kelon.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "With the appropriate tech, Sap can exhibit energetic properties sufficient to replace Kelon.",
          "locale": "en_US"
        },
        "fr_FR": {
