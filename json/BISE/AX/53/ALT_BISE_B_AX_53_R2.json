      "translations": {
        "de_DE": {
          "text": "Es ist keine Zerstörung, sondern „Recycling“. Behaupten sie zumindest.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "No destrozan, reciclan... O eso dicen.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Non è demolizione, bensì semplice riciclaggio. O almeno così dicono.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Ce n'est pas de la destruction, c'est du recyclage. Du moins, c'est ce qu'ils disent.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "It's not demolition, but basic recycling. Or so they say.",
          "locale": "en_US"
        }
