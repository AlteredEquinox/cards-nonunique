                  },
                  "it_IT": {
                    "text": "{J} [AUGMENT_IMP] #un numero qualsiasi# di carte bersaglio in gioco o nella Riserva. (Se hanno dei segnalini, ne ottengono un altro. Il bersaglio non può essere una carta eroe.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} [AUGMENT_IMP] #cualquier número# de cartas objetivo en juego o en reserva. (Si tienen contadores, ganan 1 más. Esto no puede hacer objetivo a cartas de héroe.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{J} [AUGMENT_IMP] #any number# of target cards in play or in Reserve. (If they have counters, they gain 1 more. This can't target Hero cards.)",
