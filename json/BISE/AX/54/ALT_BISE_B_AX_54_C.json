                "translations": {
                  "fr_FR": {
                    "text": "{J} Vous pouvez [AUGMENT] une carte ciblée en jeu ou en Réserve. (Si elle a des compteurs, elle en gagne 1 de plus. Cet effet ne peut cibler une carte Héros.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{J} Puoi [AUGMENT] una carta bersaglio in gioco o nella Riserva. (Se ha dei segnalini, ne ottiene un altro. Il bersaglio non può essere una carta eroe.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Puedes [AUGMENT] una carta objetivo en juego o en reserva. (Si tiene contadores, gana uno más. Esto no puede hacer objetivo a cartas de héroe.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{J} You may [AUGMENT] target card in play or in Reserve. (If it has counters, it gains 1 more. This can't target Hero cards.)",
                    "locale": "en_US"
                  },
