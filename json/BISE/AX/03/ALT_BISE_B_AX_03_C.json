                "translations": {
                  "en_US": {
                    "text": "At Noon — You may pay {1} and put a card from your hand in Reserve to create a [BRASSBUG] Robot token in target Expedition.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Puedes pagar {1} y colocar una carta de tu mano en la reserva para crear una ficha de robot [BRASSBUG] en una expedición objetivo.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "À Midi — Vous pouvez payer {1} et mettre une carte de votre main en Réserve pour créer un jeton Robot [BRASSBUG] dans une Expédition ciblée.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Puoi pagare {1} e mettere una carta dalla tua mano nella Riserva per creare una pedina Robot [BRASSBUG] in una spedizione bersaglio.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Du darfst {1} bezahlen und eine Karte aus deiner Hand in die Reserve legen, um eine [BRASSBUG]-Robotermarke in einer Expedition deiner Wahl zu erschaffen.",
