                "translations": {
                  "en_US": {
                    "text": "#{R} You may spend 1 counter from a card you control or in your Reserve to reduce the cost of the next Permanent you play this Afternoon by {2}.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#{R} Du darfst 1 Zähler von einer Karte unter deiner Kontrolle oder in deiner Reserve ausgeben, um die Kosten der nächsten Bleibenden Karte, die du diesen Nachmittag spielst, um {2} zu senken.#",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#{R} Puedes gastar 1 contador de una carta que controles o que esté en tu reserva para reducir en {2} el coste del siguiente permanente que juegues esta tarde.#",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#{R} Puoi spendere 1 segnalino di una carta che controlli o nella tua Riserva per ridurre di {2} il costo del prossimo permanente che giochi questo pomeriggio.#",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "#{R} Vous pouvez dépenser 1 compteur d'une carte que vous contrôlez ou dans votre Réserve pour réduire le coût du prochain Permanent que vous jouez cet Après-midi de {2}.#",
                    "locale": "fr_FR"
                  }
                },
