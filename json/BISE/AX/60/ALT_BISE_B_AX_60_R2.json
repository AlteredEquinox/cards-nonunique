                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Al mediodía — [AUGMENT_IMP] #cualquier número# de cartas objetivo en juego o en reserva. (Si tienen contadores, ganan 1 más. Esto no puede hacer objetivo a cartas de héroe.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "At Noon — [AUGMENT_IMP] #any number# of target cards in play or in Reserve. (If they have counters, they gain 1 more. This can't target Hero cards.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — [AUGMENT_IMP] #eine beliebige Anzahl# Karten deiner Wahl im Spiel oder in der Reserve. (Falls sie Zähler haben, erhalten sie 1 mehr. Heldenkarten sind davon ausgenommen.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "À Midi — [AUGMENT_IMP] #n'importe quel nombre# de cartes ciblées en jeu ou en Réserve. (Si elles ont des compteurs, elles en gagnent 1 de plus. Cet effet ne peut cibler une carte Héros.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — [AUGMENT_IMP] #un numero qualsiasi# di carte bersaglio in gioco o nella Riserva. (Se hanno dei segnalini, ne ottengono un altro. Il bersaglio non può essere una carta eroe.)",
                    "locale": "it_IT"
                  }
                },
                "text": "At Noon — [AUGMENT_IMP] #any number# of target cards in play or in Reserve. (If they have counters, they gain 1 more. This can't target Hero cards.)"
              }
