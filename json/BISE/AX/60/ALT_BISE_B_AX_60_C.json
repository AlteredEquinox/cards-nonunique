      "translations": {
        "de_DE": {
          "text": "Das Harz fließt durch die Stadt wie das Blut durch die Adern eines Sterblichen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "La savia fluye por toda la ciudad como la sangre en las venas de un mortal.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "La linfa scorre per tutta la città come il sangue nelle vene di un mortale.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "La Sève coule dans la Cité comme le sang dans les veines d'un mortel.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "The Sap courses through the whole city like blood in a mortal's veins.",
          "locale": "en_US"
        }
      },
      "id": "01JBT1A4DZMD1K384BDA2D7P21",
      "text": "The Sap courses through the whole city like blood in a mortal's veins."
