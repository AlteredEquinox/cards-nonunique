                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "À Midi — Vous pouvez [AUGMENT] une carte ciblée en jeu ou en Réserve. (Si elle a des compteurs, elle en gagne 1 de plus. Cet effet ne peut cibler une carte Héros.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "At Noon — You may [AUGMENT] target card in play or in Reserve. (If it has counters, it gains 1 more. This can't target Hero cards.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Puedes [AUGMENT] una carta objetivo en juego o en reserva. (Si tiene contadores, gana uno más. Esto no puede hacer objetivo a cartas de héroe.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Du darfst eine Karte deiner Wahl im Spiel oder in der Reserve [AUGMENT]. (Falls sie Zähler hat, erhält sie 1 weiteren. Heldenkarten sind davon ausgenommen.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Puoi [AUGMENT] una carta bersaglio in gioco o nella Riserva. (Se ha dei segnalini, ne ottiene un altro. Il bersaglio non può essere una carta eroe.)",
                    "locale": "it_IT"
                  }
                },
                "text": "At Noon — You may [AUGMENT] target card in play or in Reserve. (If it has counters, it gains 1 more. This can't target Hero cards.)"
              }
