                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Lorsqu'une carte quitte votre Réserve pendant l'Après-midi — Je gagne 1 compteur Sève.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When a card leaves your Reserve during the Afternoon — I gain 1 Sap counter.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Quando una carta lascia la tua Riserva durante il pomeriggio — Ottengo 1 segnalino Linfa.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando una carta abandone tu reserva durante la tarde — Gano 1 contador de savia.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn eine Karte am Nachmittag deine Reserve verlässt — Ich erhalte 1 Harzzähler.",
                    "locale": "de_DE"
                  }
                },
                "text": "When a card leaves your Reserve during the Afternoon — I gain 1 Sap counter."
              }
            ],
