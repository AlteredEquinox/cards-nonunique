      "translations": {
        "de_DE": {
          "text": "Niemand ist wirklich verloren, alle sind dort, wo das Schicksal es für sie vorgesehen hat.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Nadie está completamente perdido. Todos estamos donde el destino quiere.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "No one is truly lost, for all are exactly where fate wants them to be.",
          "locale": "en_US"
        },
