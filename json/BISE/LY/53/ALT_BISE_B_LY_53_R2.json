      },
      "translations": {
        "de_DE": {
          "text": "Niemand ist wirklich verloren, alle sind dort, wo das Schicksal es für sie vorgesehen hat.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Nadie está completamente perdido. Todos estamos donde el destino quiere.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "No one is truly lost, for all are exactly where fate wants them to be.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Nessuno è davvero perduto; sono tutti esattamente dove il fato vuole che siano.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Personne n'est vraiment perdu. Chacun est exactement là où le destin l'a placé.",
