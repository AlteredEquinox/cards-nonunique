        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Das Leben ist ein Labyrinth, aber unser Ziel ist nicht, ihm zu entkommen. Vielmehr ist der Sinn des Lebens das Labyrinth selbst.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "La vita è un labirinto, ma il nostro scopo non è uscirne: lo scopo della vita è il labirinto stesso.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "La vida es un laberinto, pero nuestro propósito no es escapar de él. El propósito de la vida es el propio laberinto.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Life is a maze, but our purpose is not to escape it. The purpose of life is the maze itself.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "La vie est un labyrinthe, mais le but n'est pas de s'en échapper. Le but de la vie est le labyrinthe lui-même.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A659FQ2567BPQZ4560YY",
      "text": "Life is a maze, but our purpose is not to escape it. The purpose of life is the maze itself."
    }
  ],
