                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "{H} Remove all boosts from Characters in play and in Reserve. Then, depending on the number of boosts removed this way:",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{H} Entferne alle Verstärkungen von Charakteren im Spiel und in der Reserve. Dann, abhängig von der Anzahl an Verstärkungen, die auf diese Art entfernt werden:",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{H} Retira todos los potenciadores de los personajes en juego y en reserva. Luego, en función del número de potenciadores retirados de esta manera:",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{H} Rimuovi tutti i rinforzi dai personaggi in gioco e nella Riserva. Poi, in base al numero di rinforzi rimossi:",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{H} Retirez tous les boosts des Personnages en jeu et en Réserve. Puis, en fonction du nombre de boosts retirés de cette manière :",
                    "locale": "fr_FR"
                  }
                },
                "text": "{H} Remove all boosts from Characters in play and in Reserve. Then, depending on the number of boosts removed this way:"
              }
            ],
