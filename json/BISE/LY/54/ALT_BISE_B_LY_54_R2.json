        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Alzate le mani per tutti coloro che portano alla luce quei meravigliosi cimeli dalla Città degli studiosi!\" — Tamati",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Levez les bras en l'air pour ceux qui remontent les fabuleuses reliques de la Cité des Sages ! » — Tamati",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Applaus für die, die all die Wahnsinns-Relikte aus der Stadt der Gelehrten ausgraben!“ – Tamati",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«¡Levantad esas manos por aquellos que están acarreando las increíbles reliquias de la Ciudad de los Eruditos!». — Tamati",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"Throw your hands up in the air for everyone who's hauling out those amazing relics from the City of Scholars!\" — Tamati",
          "locale": "en_US"
        }
      },
      "id": "01JBT1A5XE4DYY4CVR3QA6SWN5",
      "text": "\"Throw your hands up in the air for everyone who's hauling out those amazing relics from the City of Scholars!\" — Tamati"
    }
  ],
