                "translations": {
                  "en_US": {
                    "text": "If I'm [BOOSTED], you may play other #Artists# from your Reserve for {1} less, down to a minimum of {1}. (Other effects may still reduce it further.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Si estoy [BOOSTED], te cuesta {1} menos jugar otros #artistas# desde tu reserva, hasta un mínimo de {1}. (Otros efectos pueden reducirlo aún más.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Se ho [BOOSTED], gli altri #Artisti# costano {1} in meno per essere giocati dalla tua Riserva, con un minimo di {1}. (Altri effetti possono ridurlo ulteriormente.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Si je suis [BOOSTED], vous pouvez jouer les autres #Artistes# depuis votre Réserve pour {1} de moins, jusqu'à un minimum de {1}. (D'autres effets peuvent réduire ce coût davantage.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Falls ich [BOOSTED] bin, kosten andere #Künstler# {1} weniger, wenn du sie aus deiner Reserve spielst, mindestens aber {1}. (Andere Effekte reduzieren dies zusätzlich.)",
                    "locale": "de_DE"
                  }
                },
                "text": "If I'm [BOOSTED], you may play other #Artists# from your Reserve for {1} less, down to a minimum of {1}. (Other effects may still reduce it further.)"
