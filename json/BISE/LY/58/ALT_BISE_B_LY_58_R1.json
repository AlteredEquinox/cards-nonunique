                "translations": {
                  "fr_FR": {
                    "text": "[RESUPPLY]. Si vous mettez un Personnage en Réserve de cette façon, vous pouvez ensuite #le mettre dans votre main.#",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "[RESUPPLY]. Se metti un personaggio nella Riserva in questo modo, poi puoi #metterlo nella tua mano.#",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "[RESUPPLY]. If you put a Character in Reserve this way, you may then #put it in your hand.#",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "[RESUPPLY]. Si colocas un personaje en reserva de esta manera, luego puedes #colocarlo en tu mano.#",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "[RESUPPLY]. Falls du einen Charakter auf diese Weise in die Reserve schickst, darfst du ihn dann #auf deine Hand nehmen.#",
                    "locale": "de_DE"
                  }
                },
                "text": "[RESUPPLY]. If you put a Character in Reserve this way, you may then #put it in your hand.#"
              }
