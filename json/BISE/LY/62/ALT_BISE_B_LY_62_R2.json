            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "#Lorsque vous jouez un Bureaucrate — Lancez un dé# et révélez la première carte de votre deck.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "#When you play a Bureaucrat — Roll a die# and reveal the top card of your deck.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#Wenn du einen Bürokraten spielst — Würfle einmal# und decke die oberste Karte deines Decks auf.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#Cuando juegues un burócrata — Tira un dado# y revela la primera carta de tu mazo.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#Quando giochi un Burocrate — Tira un dado# e rivela la prima carta del tuo mazzo.",
                    "locale": "it_IT"
                  }
                },
                "text": "#When you play a Bureaucrat — Roll a die# and reveal the top card of your deck."
              }
            ],
            "reference": "00930"
          },
          "sequence": 0,
          "id": "01K4JNYE312NQYSMVMY0CT8DHR"
        },
        {
          "cardElement": "\/card_elements\/01K4JNYDHD2GN0R9BWG0A9NZ38",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Cuando reveles una carta de esta manera — Si su coste desde la mano es igual al resultado de la tirada, róbala.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When you reveal a card this way — If its Hand Cost is equal to the die's result, draw it.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Quando riveli una carta in questo modo — Se il costo dalla mano è pari al risultato dei dadi, pescala.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous révélez une carte de cette façon — Si son Coût de Main est égal au résultat du dé, piochez-la.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du auf diese Art eine Karte aufdeckst — Falls ihre Handkosten und das Würfelergebnis gleich sind, ziehe sie.",
                    "locale": "de_DE"
                  }
                },
                "text": "When you reveal a card this way — If its Hand Cost is equal to the die's result, draw it."
              }
            ],
            "reference": "00928"
          },
          "sequence": 1,
          "id": "01K4JNYEH37QBV721H1Q5EYVV3"
        }
      ],
      "value": "When you play a Bureaucrat — Roll a die and reveal the top card of your deck.  When you reveal a card this way — If its Hand Cost is equal to the die's result, draw it.",
