                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Cuando reveles una carta de esta manera — Si su coste desde la mano es igual al resultado de la tirada, róbala.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When you reveal a card this way — If its Hand Cost is equal to the die's result, draw it.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Quando riveli una carta in questo modo — Se il costo dalla mano è pari al risultato dei dadi, pescala.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous révélez une carte de cette façon — Si son Coût de Main est égal au résultat du dé, piochez-la.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du auf diese Art eine Karte aufdeckst — Falls ihre Handkosten und das Würfelergebnis gleich sind, ziehe sie.",
                    "locale": "de_DE"
                  }
                },
                "text": "When you reveal a card this way — If its Hand Cost is equal to the die's result, draw it."
              }
