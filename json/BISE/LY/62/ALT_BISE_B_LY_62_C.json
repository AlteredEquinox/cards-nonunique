                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Si fueses a tirar un dado o más, revela también la primera carta de tu mazo.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "If you would roll one or more dice, also reveal the top card of your deck.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Si vous lancez au moins un dé, révélez également la première carte de votre deck.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Falls du einen oder mehr Würfel werfen würdest, decke auch die oberste Karte deines Decks auf.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Se stai per tirare uno o più dadi, rivela anche la prima carta del tuo mazzo.",
