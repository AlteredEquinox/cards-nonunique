                  "it_IT": {
                    "text": "{I} Quando giochi un #incantesimo# — Ottengo 1 rinforzo, fino a un max di 2.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "{I} When you play a #Spell# — I gain 1 boost, up to a max of 2.",
