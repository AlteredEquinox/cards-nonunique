                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "#Si estoy [BOOSTED], los {V}, {M} y {O} de otros personajes que controles son iguales a su estadística más alta.#",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "#If I'm [BOOSTED], the {V}, {M}, and {O} of other Characters you control are equal to their highest statistic.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#Falls ich [BOOSTED] bin, sind {V}, {M} und {O} anderer Charaktere, die du kontrollierst, so viel wie ihre höchste Statistik.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "#Se ho [BOOSTED], {V}, {M} e {O} degli altri personaggi che controlli sono pari alla loro statistica più alta.#",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "#Si je suis [BOOSTED], les {V}, {M} et {O} des autres Personnages que vous contrôlez sont égales à leur statistique la plus élevée.#",
                    "locale": "fr_FR"
                  }
                },
                "text": "#If I'm [BOOSTED], the {V}, {M}, and {O} of other Characters you control are equal to their highest statistic.#"
              }
            ],
