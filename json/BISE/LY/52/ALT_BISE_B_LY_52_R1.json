                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Au Crépuscule — Si je suis [BOOSTED], révélez la première carte de votre deck. Si c'est un #Artiste# ou un #Chant#, piochez-la. Sinon, défaussez-la.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Al crepuscolo — Se ho [BOOSTED], rivela la prima carta del tuo mazzo. Se è un #Artista# o una #Canzone#, pesca la carta. Altrimenti, scartala.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Zum Abend — Falls ich [BOOSTED] bin, decke die oberste Karte deines Decks auf. Falls sie ein #Künstler# oder ein #Lied# ist, ziehe sie. Andernfalls lege sie ab.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "At Dusk — If I'm [BOOSTED], reveal the top card of your deck. If it's an #Artist# or #Song#, draw it. Otherwise, discard it.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Al anochecer — Si estoy [BOOSTED], revela la primera carta de tu mazo. Si es un #artista# o una #canción#, róbala. De lo contrario, descártala.",
                    "locale": "es_ES"
                  }
                },
                "text": "At Dusk — If I'm [BOOSTED], reveal the top card of your deck. If it's an #Artist# or #Song#, draw it. Otherwise, discard it."
              }
            ],
            "reference": "00892"
          },
