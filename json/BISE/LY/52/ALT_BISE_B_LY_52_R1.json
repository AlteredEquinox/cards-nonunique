        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Un bell'applauso a tutti i coraggiosi che estraggono la linfa dalle profondità!\" — Orbec",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Make some noise for all the brave folks pulling Sap up from the depths!\" — Orbec",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Faites du bruit pour les courageux qui extraient la Sève des profondeurs ! » — Orbec",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Und jetzt Applaus für die mutigen Leute, die uns das Harz aus der Tiefe holen!“ – Orbec",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«¡Un aplauso por aquellos valientes que extraen savia de las profundidades!». — Orbec",
          "locale": "es_ES"
        }
      },
      "id": "01JBT1A5S8ERXQW2S8SQXACBTP",
      "text": "\"Make some noise for all the brave folks pulling Sap up from the depths!\" — Orbec"
    }
  ],
