      },
      "translations": {
        "de_DE": {
          "text": "Wenn der Rhythmus schneller wird, geben die Saiten das Harz frei, das sie umschließt.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Quando il ritmo accelera, le corde rilasciano la linfa che le ricopre.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Cuando el ritmo se acelera, las cuerdas sueltan la savia que las recubre.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "When the rhythm picks up, the strings release the Sap covering them.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Quand le rythme s'emballe, les cordes libèrent la Sève qui les recouvre.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A6F0B0QWFVTXHEFVNZQN",
      "text": "When the rhythm picks up, the strings release the Sap covering them."
