        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Non avrei mai permesso ai fili del destino di separarmi da mia figlia.\" — Efrén",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"I could never let the winding threads of fate separate me from my daughter.\" — Efrén",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Je ne pouvais laisser les fils du destin me séparer de ma fille. » — Efrén",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Ich könnte nie zulassen, dass mich die verschlungenen Fäden des Schicksals von meiner Tochter getrennt halten.“ – Efrén",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Jamás dejaré que los sinuosos hilos del destino me separen de mi hija». — Efrén",
          "locale": "es_ES"
        }
      },
      "id": "01JBT1A62M076FEKNWQYG6HK63",
      "text": "\"I could never let the winding threads of fate separate me from my daughter.\" — Efrén"
    }
  ],
