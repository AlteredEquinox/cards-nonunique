      "translations": {
        "de_DE": {
          "text": "Ob Tag oder Nacht, die Musik von BLISS wirkt belebend auf müde Herzen und Körper.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Di giorno o di notte, la musica dei BLISS rinvigorisce il cuore e il corpo.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "De día o de noche, la música de BLISS infunde vigor a los corazones y a los cuerpos cansados.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Day or night, the music of BLISS reinvigorates weary hearts and bodies.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Nuit et jour, la musique de BLISS revigore les cœurs et les corps éreintés.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A6KTE45C7C1H1MM3SMAT",
      "text": "Day or night, the music of BLISS reinvigorates weary hearts and bodies."
