      },
      "translations": {
        "de_DE": {
          "text": "Stark wie eine alte Eiche, deren Wurzeln sich unter der Erde verzweigen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Tan fuerte como un viejo roble con raíces ramificadas bajo tierra.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "As strong as an old oak with roots branching out beneath the ground.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Forte come una vecchia quercia le cui radici si espandono nel sottosuolo.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Robuste comme le vieux chêne dont les racines s'étendent sous terre.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A7QG2KS7NFV1Q876MM2M",
      "text": "As strong as an old oak with roots branching out beneath the ground."
