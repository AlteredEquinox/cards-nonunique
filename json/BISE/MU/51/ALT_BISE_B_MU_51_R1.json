                  "es_ES": {
                    "text": "{H} #Puedes pagar {1} para descartar un permanente objetivo con coste desde la mano de {2} o menos.# Si lo haces, su controlador [RESUPPLIES].",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{H} #Vous pouvez payer {1} pour défausser un Permanent ciblé de Coût de Main {2} ou moins.# Si vous le faites, son contrôleur [RESUPPLIES].",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{H} #Puoi pagare {1} per scartare un permanente bersaglio con costo dalla mano pari o inferiore a {2}.# Se lo fai, il suo controllore [RESUPPLIES].",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "{H} #Du darfst {1} bezahlen, um eine Bleibende Karte deiner Wahl mit Handkosten {2} oder weniger abzulegen.# Falls du das tust, nutzt ihr kontrollierender Spieler [RESUPPLIES].",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "{H} #You may pay {1} to discard target Permanent with Hand Cost {2} or less.# If you do, its controller [RESUPPLIES].",
