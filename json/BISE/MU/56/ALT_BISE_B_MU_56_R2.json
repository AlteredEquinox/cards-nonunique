        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Make an offering of Sap and spiced rum, and Gran Bwa will bless your orchard.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Fai un'offerta di linfa e rum speziato, e il Gran Bois benedirà il tuo frutteto.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Fais une offrande de Sève et de rhum épicé, et Grand Bois bénira ton verger.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Bringe eine Opfergabe aus Harz und gewürztem Rum und der Große Bwa wird deinen Obstgarten segnen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Haz una ofrenda de savia y ron especiado, y el Gran Bwa bendecirá tu huerto.",
          "locale": "es_ES"
        }
      },
      "id": "01JBT1A7H9EQRHTC42QNXER6YX",
      "text": "Make an offering of Sap and spiced rum, and Gran Bwa will bless your orchard."
    }
  ],
