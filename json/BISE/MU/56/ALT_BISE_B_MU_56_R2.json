                "translations": {
                  "en_US": {
                    "text": "{J} You may target an opponent, they draw a card. If you do, I gain [ANCHORED].",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{J} Du darfst einen Gegner deiner Wahl eine Karte ziehen lassen. Falls du das tust, erhalte ich [ANCHORED].",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{J} Puoi far pescare una carta a un avversario bersaglio. Se lo fai, ottengo [ANCHORED].",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Puedes hacer que un oponente objetivo robe una carta. Si lo haces, gano [ANCHORED].",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{J} Vous pouvez faire piocher une carte à un adversaire ciblé. Si vous le faites, je gagne [ANCHORED].",
                    "locale": "fr_FR"
                  }
                },
                "text": "{J} You may target an opponent, they draw a card. If you do, I gain [ANCHORED]."
