                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "#Lorsqu'un adversaire pioche au moins une carte ou [RESUPPLIES] — Je gagne 1 boost.#",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "#When an opponent draws one or more cards or [RESUPPLIES] — I gain 1 boost.#",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "#Quando un avversario pesca una o più carte o [RESUPPLIES] — Ottengo 1 rinforzo.#",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "#Wenn ein Gegner eine oder mehrere Karten zieht oder [RESUPPLIES] nutzt — Ich erhalte 1 Verstärkung.#",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#Cuando un oponente robe una o más cartas o [RESUPPLIES] — Gano 1 potenciador.#",
                    "locale": "es_ES"
