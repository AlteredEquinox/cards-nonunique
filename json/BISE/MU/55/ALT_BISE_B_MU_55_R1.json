                  },
                  "it_IT": {
                    "text": "A mezzogiorno — #Fino a due# personaggi bersaglio in gioco o nella Riserva ottengono 1 rinforzo ciascuno.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "At Noon — #Up to two# target Characters in play or in Reserve each gain 1 boost.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Al mediodía — #Hasta dos# personajes objetivo en juego o en reserva ganan 1 potenciador cada uno.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — #Bis zu zwei# Charaktere deiner Wahl im Spiel oder in der Reserve erhalten jeweils 1 Verstärkung.",
                    "locale": "de_DE"
                  }
                },
                "text": "At Noon — #Up to two# target Characters in play or in Reserve each gain 1 boost."
              }
