      },
      "translations": {
        "de_DE": {
          "text": "Nachts fliegen sie umher und verbreiten ihren Nektar, wenn die Sonne am höchsten steht.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Zumban por la noche y esparcen su néctar cuando el sol está en lo más alto.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "They buzz about at night and spread their nectar when the sun is at its height.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Ronzano indaffarate di notte e diffondono il loro nettare quando il sole è alto.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Elles butinent la nuit et répandent leur nectar quand le soleil est au plus haut.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A7E6B0Y56AT1115T6DAZ",
      "text": "They buzz about at night and spread their nectar when the sun is at its height."
