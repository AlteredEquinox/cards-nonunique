        },
        "es_ES": {
          "text": "El Mesón necesita una granja que pueda satisfacer sus necesidades cotidianas.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "The Mess requires a farm that can consistently provide for its day-to-day needs.",
          "locale": "en_US"
        },
