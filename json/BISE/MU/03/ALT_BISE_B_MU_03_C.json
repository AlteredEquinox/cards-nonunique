                "translations": {
                  "it_IT": {
                    "text": "Quando una delle tue spedizioni avanza per via di {V} — Pesca una carta, poi metti una carta dalla tua mano nella Riserva.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
