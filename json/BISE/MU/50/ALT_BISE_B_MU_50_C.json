      "translations": {
        "de_DE": {
          "text": "Hummelrüben spielen für die Muna eine wichtige Rolle beim Bestäuben und Kultivieren von Nutzpflanzen an der Oberfläche.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "A primera vista, la polinización de las abejolachas es una herramienta clave para los cultivos Muna.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "On the surface, pollination by bumblebeets is a key tool in growing Muna crops.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "A prima vista, l'impollinazione delle bombobietole è uno strumento chiave per far crescere le colture dei Muna.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "À la surface, la pollinisation par les beilleraves est un atout majeur pour développer les cultures des Muna.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A6Z16RCJY2AKT1MFW1W3",
      "text": "On the surface, pollination by bumblebeets is a key tool in growing Muna crops."
    }
