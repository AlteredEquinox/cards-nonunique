        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Wurzeln brauchen Jahre, um sich durch den härtesten Stein zu graben, er hingegen braucht nur ein paar Stunden.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Le radici hanno bisogno di anni per farsi strada attraverso la pietra più dura, ma loro ci mettono solo qualche ora.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Las raíces tardan años en atravesar la piedra más dura, pero estos excavadores solo tardan unas horas.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "It takes years for roots to punch their way through the hardest stone, but for them it only takes a few hours.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Là où il faut des années aux racines pour perforer la plus solide des pierres, il ne leur faut qu'une poignée d'heures.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A6W5Q6S3FTYYRT5VHXAT",
      "text": "It takes years for roots to punch their way through the hardest stone, but for them it only takes a few hours."
    }
  ],
