                "translations": {
                  "en_US": {
                    "text": "Target an Expedition. Create X [ORDIS_RECRUIT] Soldier tokens in it, where X is the number of cards in target player's Reserve.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Ciblez une Expédition. Créez-y X jetons Soldat [ORDIS_RECRUIT], X étant le nombre de cartes en Réserve d'un joueur ciblé.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Haz objetivo a una expedición. Crea en ella X fichas de soldado [ORDIS_RECRUIT], donde X equivale al número de cartas en la reserva del jugador objetivo.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wähle eine Expedition. Erschaffe in ihr X [ORDIS_RECRUIT]-Soldatenmarken, wobei X die Anzahl der Karten in der Reserve eines Spielers deiner Wahl ist.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Scegli come bersaglio una spedizione. Crea al suo interno X pedine Soldato [ORDIS_RECRUIT], dove X è il numero di carte nella Riserva del giocatore bersaglio.",
                    "locale": "it_IT"
                  }
                },
                "text": "Target an Expedition. Create X [ORDIS_RECRUIT] Soldier tokens in it, where X is the number of cards in target player's Reserve."
