                "translations": {
                  "en_US": {
                    "text": "When you play a Bureaucrat — It gains [ASLEEP]. (During Dusk, ignore its statistics. During Rest, it doesn't go to Reserve and it loses Asleep.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Bürokraten spielst — Er erhält [ASLEEP]. (Am Abend ignoriere seine Statistiken. Während der Ruhepause geht er nicht in die Reserve und verliert Schlafend.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando giochi un Burocrate — Ottiene [ASLEEP]. (Durante il crepuscolo, ignora le sue statistiche. Durante il riposo, non va nella Riserva e perde Dormiente.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Bureaucrate — Il gagne [ASLEEP]. (Durant le Crépuscule, ignorez ses statistiques. Au Repos, il ne va pas en Réserve et il perd Endormi.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un burócrata — Gana [ASLEEP]. (Durante el anochecer, ignora sus estadísticas. Durante el descanso, no va a la reserva y pierde sueño).",
                    "locale": "es_ES"
                  }
                },
