                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When an opponent plays a Character — If there are no Characters in the Expedition facing me, that Character switches Expeditions.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un adversaire joue un Personnage — S'il n'y a aucun Personnage dans l'Expédition qui me fait face, ce Personnage change d'Expédition.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ein Gegner einen Charakter spielt — Falls es keine Charaktere in der mir gegenüberstehenden Expedition gibt, wechselt dieser Charakter die Expeditionen.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando un avversario gioca un personaggio — Se non c'è alcun personaggio nella spedizione che mi affronta, quel personaggio cambia spedizione.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando un oponente juegue un personaje — Si no hay ningún personaje en la expedición enfrentada a mí, ese personaje se traslada de expedición.",
                    "locale": "es_ES"
                  }
                },
                "text": "When an opponent plays a Character — If there are no Characters in the Expedition facing me, that Character switches Expeditions."
              }
            ],
            "reference": "01622"
          },
