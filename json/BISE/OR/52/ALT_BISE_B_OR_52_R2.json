                "translations": {
                  "fr_FR": {
                    "text": "À la tombée de la Nuit — Vous pouvez dépenser 1 compteur d'une carte dans votre Réserve ou vos Repères pour [SABOTAGE_INF] après le Repos.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "At Night — You may spend 1 counter from a card in your Reserve or Landmarks to [SABOTAGE_INF] after Rest.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Di notte — Puoi spendere 1 segnalino di una carta nella tua Riserva o nei tuoi fulcri per [SABOTAGE_INF] dopo il riposo.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Zur Nacht — Du darfst 1 Zähler von einer Karte in deiner Reserve oder einem Wahrzeichen ausgeben, um nach der Ruhepause [SABOTAGE_INF] zu nutzen.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "A la noche — Puedes gastar 1 contador de una carta en tu reserva o en tu zona de hitos para [SABOTAGE_INF] tras el descanso.",
                    "locale": "es_ES"
                  }
                },
                "text": "At Night — You may spend 1 counter from a card in your Reserve or Landmarks to [SABOTAGE_INF] after Rest."
