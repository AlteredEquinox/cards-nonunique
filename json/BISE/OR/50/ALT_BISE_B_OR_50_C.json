          "cardElement": "\/card_elements\/01K4JP3TWWE8EB4XRR3PZ3X45S",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [
                  {
                    "cardKeyword": {
                      "translations": {
                        "de_DE": {
                          "displayWeb": "Schlafend",
                          "locale": "de_DE",
                          "description": "Am Abend ignoriere meine Statistiken. Während der Ruhepause gehe ich nicht in die Reserve und verliere Schlafend."
                        },
                        "it_IT": {
                          "displayWeb": "Dormiente",
                          "locale": "it_IT",
                          "description": "Durante il crepuscolo, ignora le mie statistiche. Durante il riposo, non vado nella Riserva e perdo Dormiente."
                        },
                        "en_US": {
                          "displayWeb": "Asleep",
                          "locale": "en_US",
                          "description": "During Dusk, ignore my statistics. During Rest, I don't go to Reserve and I lose Asleep."
                        },
                        "fr_FR": {
                          "displayWeb": "Endormi",
                          "locale": "fr_FR",
                          "description": "Ignorez mes statistiques pendant le Crépuscule. Au Repos, je ne vais pas en Réserve et je perds Endormi."
                        },
                        "es_ES": {
                          "displayWeb": "Sueño",
                          "locale": "es_ES",
                          "description": "Durante el anochecer, ignora mis estadísticas. Durante el descanso, no voy a la reserva y pierdo sueño."
                        }
                      },
                      "id": "01HKAGPDSXJC9J9QJ4Y1DBK28E",
                      "reference": "ASLEEP"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01JB22SX4GZ7R3DY4ECMNKFKJE"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "{R} Puoi spendere 1 dei miei rinforzi per far ottenere [ASLEEP] a un personaggio bersaglio. (Durante il crepuscolo, ignora le sue statistiche. Durante il riposo, non va nella Riserva e perde Dormiente.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{R} Vous pouvez dépenser 1 de mes boosts pour qu'un Personnage ciblé gagne [ASLEEP]. (Au Crépuscule, ignorez ses statistiques. Au Repos, il ne va pas en Réserve et il perd Endormi.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{R} Puedes gastar 1 de mis potenciadores para hacer que un personaje objetivo gane [ASLEEP]. (Durante el anochecer, ignora sus estadísticas. Durante el descanso, no va a la reserva y pierde sueño.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{R} Du darfst 1 meiner Verstärkungen ausgeben, um einen Charakter deiner Wahl [ASLEEP] erhalten zu lassen. (Am Abend ignoriere seine Statistiken. Während der Ruhepause geht er nicht in die Reserve und verliert Schlafend.)",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "{R} You may spend 1 of my boosts to have target Character gain [ASLEEP]. (During Dusk, ignore its statistics. During Rest, it doesn't go to Reserve and it loses Asleep.)",
                    "locale": "en_US"
                  }
                },
                "text": "{R} You may spend 1 of my boosts to have target Character gain [ASLEEP]. (During Dusk, ignore its statistics. During Rest, it doesn't go to Reserve and it loses Asleep.)"
              }
            ],
            "reference": "00978"
          },
