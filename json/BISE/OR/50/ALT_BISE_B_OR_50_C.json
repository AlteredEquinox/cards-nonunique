                  "en_US": {
                    "text": "{I} When another Character joins your Expeditions — I gain 1 boost, up to a max of 2.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{I} Quando un altro personaggio si unisce alle tue spedizioni — Ottengo 1 rinforzo, fino a un max di 2.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{I} Lorsqu'un autre Personnage rejoint vos Expéditions — Je gagne 1 boost, jusqu'à un max de 2.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{I} Wenn ein anderer Charakter sich deinen Expeditionen anschließt — Ich erhalte 1 Verstärkung, bis maximal 2.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{I} Cuando otro personaje se incorpore a una de tus expediciones — Gano 1 potenciador, hasta un máximo de 2.",
                    "locale": "es_ES"
                  }
                },
                "text": "{I} When another Character joins your Expeditions — I gain 1 boost, up to a max of 2."
