        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "En vista de las famosas virtudes organizativas de los Ordis, las facciones les confiaron la logística de los puestos avanzados.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "In light of the Ordis' well-known organizational advantages, the Factions entrusted them with outpost logistics.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Da die Ordis für ihr Organisationstalent bekannt sind, vertrauten ihnen die anderen Fraktionen die Logistik der Außenposten an.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Alla luce della ben nota superiorità organizzativa degli Ordis, le fazioni hanno affidato loro la logistica degli avamposti.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Conscientes des avantages de l'organisation Ordis, les Factions lui confièrent la logistique de l'avant-poste.",
          "locale": "fr_FR"
        }
      },
      "id": "01K477YZPJ2VDM2C18447CYPNM",
      "text": "In light of the Ordis' well-known organizational advantages, the Factions entrusted them with outpost logistics."
    }
  ],
