                "translations": {
                  "de_DE": {
                    "text": "Zum Mittag — Erschaffe eine #[BRASSBUG]-Robotermarke# in jeder deiner Expeditionen, die hinten liegt oder gleichauf ist.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
