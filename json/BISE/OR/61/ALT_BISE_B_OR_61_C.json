                "translations": {
                  "fr_FR": {
                    "text": "Si mon Expédition devait avancer, vous pouvez me défausser pour piocher deux cartes à la place.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Si mi expedición fuera a avanzar, en vez de eso, puedes descartarme para robar dos cartas",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Se la mia spedizione sta per avanzare, puoi invece scartarmi per pescare due carte.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "If my Expedition would move forward, you may discard me instead to draw two cards.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Falls sich meine Expedition vorwärts bewegen würde, darfst du mich stattdessen ablegen und zwei Karten ziehen.",
