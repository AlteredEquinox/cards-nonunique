        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Die Bravos waren in vielerlei Hinsicht Pioniere und experimentierten als Erste mit Harz in ihren Gerichten.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Pioneros en más de un sentido, los Bravos fueron los primeros en experimentar con la savia en las artes culinarias.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Pionieri sotto molti punti di vista, i Bravos furono i primi a sperimentare la linfa nelle arti culinarie.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Pionniers à plus d'un titre, les Bravos ont été les premiers à intégrer la Sève dans leurs expériences culinaires.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "Pioneers in more ways than one, the Bravos were the first to experiment with Sap in the culinary arts.",
          "locale": "en_US"
        }
      },
      "id": "01JBT1A4WR6TFG6W6SB5WV4GHM",
      "text": "Pioneers in more ways than one, the Bravos were the first to experiment with Sap in the culinary arts."
    }
  ],
