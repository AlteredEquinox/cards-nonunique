        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "In diesen Ruinen klingen noch die Erinnerungen an eine vergessene Zivilisation nach. Wir sind nicht allein.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Los vestigios de una civilización olvidada descansan en esas ruinas. No estamos solos.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "In queste rovine permangono i segni di una civiltà dimenticata. Non siamo soli.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Memories of a forgotten civilization linger in those ruins. We are not alone.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Dans ces ruines subsistent les souvenirs d'une civilisation oubliée. Nous ne sommes pas seuls.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A4PNZ47AJA8BZMBXMBPD",
      "text": "Memories of a forgotten civilization linger in those ruins. We are not alone."
