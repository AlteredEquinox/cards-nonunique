      },
      "translations": {
        "de_DE": {
          "text": "Ob beim Duell oder in der Küche: Die Bravos sind Meister im Umgang mit der Klinge.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Los Bravos son los más duchos tanto con la espada como con un cuchillo de cocina.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "I Bravos sono sempre i migliori con una lama, che sia in un duello o in cucina.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The Bravos are always the best with a blade, whether it's in a duel or in the kitchen.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Les Bravos manient la lame comme personne, que ce soit en duel ou en cuisine.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A4N230KJVVYTFFA8DTZV",
      "text": "The Bravos are always the best with a blade, whether it's in a duel or in the kitchen."
