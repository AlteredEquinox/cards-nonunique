          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When I leave the Expedition zone, for each of my boosts — Another target Character in your Reserve gains 1 boost.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn ich die Expeditionszone verlasse, gilt für jede meiner Verstärkungen — Ein anderer Charakter deiner Wahl in deiner Reserve erhält 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando abandone la zona de expedición, por cada uno de mis potenciadores — Otro personaje objetivo en tu reserva gana 1 potenciador.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando lascio l'area delle spedizioni, per ciascuno dei miei rinforzi — Un altro personaggio bersaglio nella tua Riserva ottiene 1 rinforzo.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque je quitte la zone d'Expédition, pour chacun de mes boosts — Un autre Personnage ciblé dans votre Réserve gagne 1 boost.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When I leave the Expedition zone, for each of my boosts — Another target Character in your Reserve gains 1 boost."
              }
            ],
            "reference": "00853"
          },
          "sequence": 0,
          "id": "01K4JNQAKWQQPXQCKJ34MGGCZY"
        }
      ],
      "value": "When I leave the Expedition zone, for each of my boosts — Another target Character in your Reserve gains 1 boost.",
