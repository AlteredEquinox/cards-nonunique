      },
      "translations": {
        "de_DE": {
          "text": "Die Tiefen der Stadt stecken voller archäologischer Wunder … und jeder Menge Harz!",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Las profundidades de la ciudad están repletas de maravillas arqueológicas... ¡además de mucha savia!",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Le viscere della città sono ricche di meraviglie archeologiche... e un mucchio di linfa!",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The depths of the city are filled with archaeological marvels... along with plenty of Sap!",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Les tréfonds de la Cité regorgent de merveilles archéologiques... et de Sève !",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A4TW0TJ91FQWQN8SW6NC",
      "text": "The depths of the city are filled with archaeological marvels... along with plenty of Sap!"
    }
