                "translations": {
                  "es_ES": {
                    "text": "Cuando un personaje #que no sea ficha# abandone tus expediciones — Gano 1 contador de comida.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn ein #Nicht-Marken-Charakter# deine Expeditionen verlässt — Ich erhalte 1 Nahrungszähler.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "When a #non-token# Character leaves your Expeditions — I gain 1 Food counter.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Quando un personaggio #non pedina# lascia le tue spedizioni — Ottengo 1 segnalino Cibo.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un Personnage #non-jeton# quitte vos Expéditions — Je gagne 1 compteur Nourriture.",
