        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Hier schwadronieren die Entdecker allabendlich unter lautem Lachen und Gejohle von ihren neuesten Heldentaten.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Ogni sera, nella mensa si odono risate e un gran vociare degli esploratori che raccontano le loro imprese.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Todas las noches, el Mesón se llena de risas y gritos cuando los exploradores comparten sus hazañas diarias.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Every evening, the Mess overflows with laughter and shouting as explorers share their daily exploits.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Tous les soirs, le mess résonne des cris et des rires des explorateurs partageant leurs exploits quotidiens.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A5CN57N8VNCDDZB2HYJK",
      "text": "Every evening, the Mess overflows with laughter and shouting as explorers share their daily exploits."
    }
  ],
