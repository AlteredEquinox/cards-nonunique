        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Das Leben jener Waghalsigen, die die tiefen Labyrinthe der Stadt erkunden, hängt oft an einem seidenen Faden.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Para los valientes que exploran las profundidades laberínticas de la ciudad, la vida pende a menudo de los hilos más finos.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Per le anime audaci che esplorano il labirinto nelle viscere della città, la vita è spesso appesa a un filo sottilissimo.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "For the brave souls exploring the labyrinthine depths of the city, life often hangs by the thinnest of threads.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Pour ceux qui explorent les profondeurs labyrinthiques de la Cité, la vie ne tient parfois qu'à un fil.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A53AN0FYYE7WFGKEM7DM",
      "text": "For the brave souls exploring the labyrinthine depths of the city, life often hangs by the thinnest of threads."
    }
  ],
