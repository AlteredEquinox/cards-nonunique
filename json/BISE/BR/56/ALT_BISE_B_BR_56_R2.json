        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Wenn der Funke des Feuervogels in dir entzündet wird, bist du bereit, der Phönixier-Wache beizutreten.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Cuando la chispa del pájaro de fuego se prenda en tu interior, podrás unirte a la guardia del fénix.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Quando dentro di te si accende la scintilla ardente, puoi finalmente unirti alla Guardia fenicia.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "When the Firebird's spark ignites within you, that's when you become worthy of joining the Phoenixian Guard.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Lorsque l'étincelle de l'Oiseau de Feu embrase votre cœur, vous devenez digne de rejoindre la Garde Phénixienne.",
          "locale": "fr_FR"
        }
      },
      "id": "01JBT1A4ZYK3QZT09VB6RPXD5G",
      "text": "When the Firebird's spark ignites within you, that's when you become worthy of joining the Phoenixian Guard."
    }
  ],
