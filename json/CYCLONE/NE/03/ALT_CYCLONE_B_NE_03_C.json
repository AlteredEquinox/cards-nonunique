      "translations": {
        "de_DE": {
          "text": "Dank Aerolit sind wir beim Bauen nicht mehr durch die Schwerkraft gefesselt.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Grazie all'aerolite, la gravità non è più un ostacolo quando si costruisce.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Gracias al aerolito, la gravedad ya no limita la forma en que construimos.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "L'aérolithe permet de construire tout en défiant la gravité.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "With Aerolith, gravity no longer constrains how we build.",
          "locale": "en_US"
        }
      },
