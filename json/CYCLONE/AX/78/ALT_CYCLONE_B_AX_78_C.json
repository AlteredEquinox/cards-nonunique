        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Even far from their Hive, the Brassbugs have developed a way to continue reproducing.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Auch weit entfernt von ihrem Nest haben die Blechkäfer eine Möglichkeit gefunden, sich weiter zu vermehren.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Le ottonblatte hanno sviluppato un modo per continuare a riprodursi anche lontano dal loro alveare.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Incluso lejos de su colmena, los bicholatas han encontrado una forma de seguir reproduciéndose.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Même loin de leur Ruche, les Scarabots ont développé le moyen de continuer de se répliquer.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBWEN7A555YN1G9YS7N1D",
      "text": "Even far from their Hive, the Brassbugs have developed a way to continue reproducing."
    }
  ],
