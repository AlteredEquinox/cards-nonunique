                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando mi sacrifichi — #[RESUPPLY].# (I fulcri in eccesso vengono sacrificati alla fine della giornata.)",
                    "locale": "it_IT"
                  },
