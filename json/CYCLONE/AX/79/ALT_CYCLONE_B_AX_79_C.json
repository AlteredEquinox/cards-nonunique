      "translations": {
        "en_US": {
          "text": "\"There's no doubt about it... These ruins are the work of people from the City of Scholars.\" - Abiram",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Es gibt keinen Zweifel … Diese Ruinen gehörten einst den Bewohnern der Stadt der Gelehrten.“ – Abiram",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Non c'è dubbio... Queste rovine sono opera degli abitanti della Città degli studiosi.\" - Abiram",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«No hay duda... Estas ruinas son obra de los habitantes de la Ciudad de los Sabios». — Abiram",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Il n'y a pas de doute possible, ces ruines sont l'œuvre du peuple de la Cité des Sages. » - Abiram",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBWGBB13AKGJW47JBGKBB",
      "text": "\"There's no doubt about it... These ruins are the work of people from the City of Scholars.\" - Abiram"
    }
  ],
