      },
      "translations": {
        "en_US": {
          "text": "Reaching the pillar is no easy journey, as the clouds conceal countless reefs and other dangers.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Die Reise zur Säule ist schwierig, denn die Wolken verbergen zahllose Riffe und andere Gefahren.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Raggiungere la cima non è facile, perché le nuvole nascondono innumerevoli asperità e altri pericoli.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Llegar al pilar no es un viaje fácil, pues las nubes ocultan innumerables arrecifes y otros peligros.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Atteindre le pilier n'est pas un voyage de tout repos : les nuages cachent de nombreux récifs et écueils.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBWCTTNGN9HTQNABV63W8",
      "text": "Reaching the pillar is no easy journey, as the clouds conceal countless reefs and other dangers."
