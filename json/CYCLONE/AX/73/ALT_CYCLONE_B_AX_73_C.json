        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Träume dir dein Leben schön, und mach aus diesen Träumen eine Realität.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"È importante rendere la vita un sogno e trasformare i sogni in realtà.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Es importante hacer un sueño de la vida y de la realidad un sueño».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"It is important to make a dream of life and of a dream reality.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Il faut faire de la vie un rêve, et d'un rêve une réalité. »",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBW67KKX0EET0RD90MD97",
      "text": "\"It is important to make a dream of life and of a dream reality.\""
    }
  ],
