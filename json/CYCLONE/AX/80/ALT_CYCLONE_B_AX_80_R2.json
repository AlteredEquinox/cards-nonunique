                "translations": {
                  "en_US": {
                    "text": "When I'm sacrificed — Create a [BRASSBUG] Robot token in each of your Expeditions. (Excess Landmarks are sacrificed at the end of the Day.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je suis sacrifié — Créez un jeton Robot [BRASSBUG] dans chacune de vos Expéditions. (Les Repères excédentaires sont sacrifiés à la fin du Jour.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ich geopfert werde — Erschaffe eine [BRASSBUG]-Robotermarke in jeder deiner Expeditionen. (Überschüssige Wahrzeichen werden am Ende des Tages geopfert.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando mi sacrifichi — Crea una pedina Robot [BRASSBUG] in ciascuna delle tue spedizioni. (I fulcri in eccesso vengono sacrificati alla fine della giornata.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando me sacrifiques — Crea una ficha de robot [BRASSBUG] en cada una de tus expediciones. (Los hitos sobrantes se sacrifican al final del día.)",
                    "locale": "es_ES"
                  }
                },
                "text": "When I'm sacrificed — Create a [BRASSBUG] Robot token in each of your Expeditions. (Excess Landmarks are sacrificed at the end of the Day.)"
              }
            ],
