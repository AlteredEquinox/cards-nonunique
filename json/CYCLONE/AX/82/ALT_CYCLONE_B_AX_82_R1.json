            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#When you sacrifice a Permanent — You may exhaust me ({T}) to give target Character 1 boost.#",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "#Quando sacrifichi un permanente — Puoi consumarmi ({T}) per conferire 1 rinforzo a un personaggio bersaglio.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#Cuando sacrifiques un permanente — Puedes agotarme ({T}) para dar 1 potenciador a un personaje objetivo.#",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "#Lorsque vous sacrifiez un Permanent — Vous pouvez m'épuiser ({T}) pour donner 1 boost à un Personnage ciblé.#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "#Wenn du eine Bleibende Karte opferst — Du darfst mich erschöpfen ({T}), um einem Charakter deiner Wahl 1 Verstärkung zu geben.#",
                    "locale": "de_DE"
                  }
                },
                "text": "#When you sacrifice a Permanent — You may exhaust me ({T}) to give target Character 1 boost.#"
              }
            ],
            "reference": "01280"
          },
          "sequence": 1,
          "id": "01KGQD8PXP0BDNCT6XB4FVKS7H"
        }
      ],
