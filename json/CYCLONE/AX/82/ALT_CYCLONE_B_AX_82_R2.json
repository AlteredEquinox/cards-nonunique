                "translations": {
                  "en_US": {
                    "text": "At Noon — If your opponent is first player, create an [AEROLITH] token in your Landmarks.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Falls dein Gegner der Startspieler ist, erschaffe eine [AEROLITH]-Marke in deinem Wahrzeichen-Bereich.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Se un tuo avversario è il primo giocatore, crea una pedina [AEROLITH] nei tuoi fulcri.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Si tu oponente es el primer jugador, crea una ficha de [AEROLITH] en tus hitos.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "À Midi — Si votre adversaire est le premier joueur, créez un jeton [AEROLITH] dans vos Repères.",
                    "locale": "fr_FR"
                  }
                },
                "text": "At Noon — If your opponent is first player, create an [AEROLITH] token in your Landmarks."
              }
