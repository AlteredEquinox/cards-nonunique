        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"It took great feats of ingenuity to mine for resources at such altitude.\" - Isaree",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Es bedurfte großen Einfallsreichtums, in solchen Höhen nach Ressourcen zu schürfen.“ – Isaree",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Sono servite grandi opere di ingegno per estrarre risorse a una tale altitudine.\" - Isaree",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Se necesita muchísimo ingenio para extraer recursos a semejante altitud». — Isaree",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Il a fallu déployer des trésors d'ingéniosité pour miner même à des kilomètres d'altitude. » - Isaree",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBWNHAGFDZ2WDD1VXJC2E",
      "text": "\"It took great feats of ingenuity to mine for resources at such altitude.\" - Isaree"
    }
  ],
