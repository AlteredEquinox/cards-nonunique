        "it_IT": {
          "text": "L'hanno resa un mostro solo per essersi difesa.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "La convirtieron en un monstruo solo por haberse defendido.",
          "locale": "es_ES"
        },
