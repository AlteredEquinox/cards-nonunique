      "translations": {
        "en_US": {
          "text": "They made her a monster simply for defending herself.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Sie erklärten sie zu einem Monster, nur weil sie sich verteidigte.",
          "locale": "de_DE"
