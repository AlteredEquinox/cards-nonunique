                "translations": {
                  "en_US": {
                    "text": "{R} You may discard target Character. If you do, create an [AEROLITH] token in its controller's Landmarks.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{R} Du darfst einen Charakter deiner Wahl ablegen. Falls du das tust, erschaffe eine [AEROLITH]-Marke im Wahrzeichen-Bereich des kontrollierenden Spielers.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "{R} Vous pouvez défausser un Personnage ciblé. Si vous le faites, créez un jeton [AEROLITH] dans les Repères de son contrôleur.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{R} Puoi scartare un personaggio bersaglio. Se lo fai, crea una pedina [AEROLITH] nei fulcri del suo controllore.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{R} Puedes descartar un personaje objetivo. Si lo haces, crea una ficha de [AEROLITH] en los hitos de su controlador.",
                    "locale": "es_ES"
                  }
                },
                "text": "{R} You may discard target Character. If you do, create an [AEROLITH] token in its controller's Landmarks."
              }
