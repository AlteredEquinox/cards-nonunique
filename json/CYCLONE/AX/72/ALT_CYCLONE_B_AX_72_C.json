      "translations": {
        "de_DE": {
          "text": "„Bei Schere-Stein-Papier gewinne ich immer durch K.o.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"A sasso-carta-forbice, ho sempre la vittoria in pugno.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«En piedra, papel o tijera siempre gano por goleada».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« À pierre-papier-ciseaux, je gagne toujours par KO. »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"In rock-paper-scissors, I always win by a knockout.\"",
          "locale": "en_US"
        }
      },
      "id": "01JNRGBW4PRC2KYR4XP4EP9XBA",
      "text": "\"In rock-paper-scissors, I always win by a knockout.\""
