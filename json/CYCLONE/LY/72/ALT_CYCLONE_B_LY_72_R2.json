      },
      "translations": {
        "en_US": {
          "text": "The Cloth Dancers' great talent is to use every rough spot to adapt to their environment.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Das große Talent der Schleiertänzerinnen besteht darin, jede Unebenheit auszunutzen, um sich an ihre Umgebung anzupassen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Le danzatrici di tessuti hanno il grande talento di sfruttare ogni asperità per adattarsi all'ambiente.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "El gran talento de los danzatelas es utilizar cada superficie para adaptarse a su entorno.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Le talent des Danseurs d'Étoffe, c'est d'utiliser chaque aspérité pour s'adapter à leur environnement.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBYJ7W8GPJAZ091A481AJ",
      "text": "The Cloth Dancers' great talent is to use every rough spot to adapt to their environment."
