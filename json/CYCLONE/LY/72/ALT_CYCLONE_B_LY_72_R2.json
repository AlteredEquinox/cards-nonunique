                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#If three or more single-terrain regions are visible, my {V}, {M}, and {O} are equal to my highest statistic.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#Falls mindestens drei Regionen mit einem Geländetyp sichtbar sind, sind meine {V}, {M} und {O} so hoch wie meine höchste Statistik.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "#Se sono visibili tre o più regioni con un unico tipo di terreno, ho {V}, {M} e {O} pari alla mia statistica più alta.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#Si tres o más regiones monoterreno son visibles, mis {V}, {M} y {O} son iguales a mi estadística más alta.#",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "#Si au moins trois régions mono-terrain sont visibles, mes {V}, {M} et {O} sont égales à ma statistique la plus élevée.#",
                    "locale": "fr_FR"
                  }
                },
                "text": "#If three or more single-terrain regions are visible, my {V}, {M}, and {O} are equal to my highest statistic.#"
              }
            ],
