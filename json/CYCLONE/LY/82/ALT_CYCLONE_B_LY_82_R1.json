      },
      "translations": {
        "en_US": {
          "text": "The Arkaster Opera House is known as the Spark, for that's where stars are born.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Die Oper von Arkaster wird auch „Funke“ genannt, denn dort werden neue Stars und Sternchen geboren.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Il Teatro dell'Opera di Arkaster è chiamato \"La Scintilla\", perché è lì che nascono le stelle.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "El teatro de ópera de Arkaster es conocido como la Chispa, porque es allí donde nacen las estrellas.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "On appelle l'Opéra d'Arkaster l'Étincelle, car c'est là que naissent les étoiles.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBZH1MSE1JJBKK7Z7HV60",
      "text": "The Arkaster Opera House is known as the Spark, for that's where stars are born."
    }
  ],
