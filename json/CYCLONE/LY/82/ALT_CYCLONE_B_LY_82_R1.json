                  "en_US": {
                    "text": "{T} : Reveal the top card of your deck. If it's a Spell, draw it. #If it's a Permanent, put it in Reserve.# (Otherwise, leave it on top of your deck.)",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{T}: rivela la prima carta del tuo mazzo. Se è un incantesimo, pescala. #Se è un permanente, mettila nella Riserva.# (Altrimenti, lasciala in cima al tuo mazzo.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{T} : Revela la primera carta de tu mazo. Si es un hechizo, róbala. #Si es un permanente, colócala en reserva.# (De lo contrario, déjala en la parte superior de tu mazo.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{T} : Révélez la première carte de votre deck. Si c'est un Sort, piochez-la. #Si c'est un Permanent, mettez-la en Réserve.# (Sinon, laissez-la au-dessus de votre deck.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{T} : Decke die oberste Karte deines Decks auf. Falls es ein Zauber ist, ziehe sie. #Falls es eine Bleibende Karte ist, lege sie in die Reserve.# (Andernfalls lasse sie oben auf deinem Deck liegen.)",
                    "locale": "de_DE"
                  }
                },
