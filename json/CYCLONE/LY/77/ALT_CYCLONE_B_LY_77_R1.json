                "translations": {
                  "fr_FR": {
                    "text": "Renvoyez un Personnage ciblé sur le dessus du deck de son propriétaire. #S'il était en {O}, redressez deux Orbes de Mana.#",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "Return target Character to the top of its owner's deck. #If it was in {O}, ready two Mana Orbs.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Lege einen Charakter deiner Wahl als oberste Karte auf das Deck seines Besitzers zurück. #Falls er in {O} war, stelle zwei Manakugeln bereit.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Fai tornare un personaggio bersaglio in cima al mazzo del suo proprietario. #Se era in {O}, ripristina due sfere di mana.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Devuelve un personaje objetivo a la parte superior del mazo de su propietario. #Si estaba en {O}, prepara dos orbes de maná.#",
