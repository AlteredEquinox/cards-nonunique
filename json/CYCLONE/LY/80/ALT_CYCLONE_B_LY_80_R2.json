                "translations": {
                  "en_US": {
                    "text": "If three or more single-terrain regions are visible, target Character gains 4 boosts. Otherwise, it gains 2 boosts.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Falls mindestens drei Regionen mit einem Geländetyp sichtbar sind, erhält ein Charakter deiner Wahl 4 Verstärkungen. Andernfalls erhält er 2 Verstärkungen.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Se sono visibili tre o più regioni con un unico tipo di terreno, un personaggio bersaglio ottiene 4 rinforzi. Altrimenti, ottiene 2 rinforzi.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Si au moins trois régions mono-terrain sont visibles, un Personnage ciblé gagne 4 boosts. Sinon, il gagne 2 boosts.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Si tres o más regiones monoterreno son visibles, un personaje objetivo gana 4 potenciadores. De lo contrario, gana 2 potenciadores.",
                    "locale": "es_ES"
                  }
                },
                "text": "If three or more single-terrain regions are visible, target Character gains 4 boosts. Otherwise, it gains 2 boosts."
              }
