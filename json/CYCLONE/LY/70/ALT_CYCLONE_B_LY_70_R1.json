                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "{H} If I'm facing an Expedition in {M}, create an [AEROLITH] token in #target player's# Landmarks.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Si je suis face à une Expédition en {M}, créez un jeton [AEROLITH] dans les Repères #d'un joueur ciblé.#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{H} Falls ich einer Expedition in {M} gegenüberstehe, erschaffe eine [AEROLITH]-Marke im Wahrzeichen-Bereich eines #Spielers deiner Wahl.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Se sto affrontando una spedizione in {M}, crea una pedina [AEROLITH] nei fulcri #di un giocatore bersaglio.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} Si la expedición enfrentada a mí está en {M}, crea una ficha de [AEROLITH] en los hitos del #jugador objetivo.#",
                    "locale": "es_ES"
                  }
                },
                "text": "{H} If I'm facing an Expedition in {M}, create an [AEROLITH] token in #target player's# Landmarks."
              }
            ],
