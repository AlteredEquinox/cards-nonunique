        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Its gracious leap parted the clouds, revealing our path forward.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Sein anmutiger Sprung zerteilte die Wolken und enthüllte den Weg, der vor uns lag.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Il suo balzo gentile ha squarciato le nuvole, rivelando il cammino davanti a noi.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Saltó con elegancia y, apartando las nubes, nos reveló el camino a seguir.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Son saut gracieux écarta les nuages, nous dévoilant la voie.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBYQEVWP95N8DVSKSGY5V",
      "text": "Its gracious leap parted the clouds, revealing our path forward."
    }
