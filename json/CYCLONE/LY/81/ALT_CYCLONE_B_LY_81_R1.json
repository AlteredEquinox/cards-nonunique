      "translations": {
        "en_US": {
          "text": "The paints of the Tisdhera still perfume the heights of the Wayfarer.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Die Farben der Tisdhera erfüllen noch immer die Höhen der Vagant mit ihren Düften.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "I colori dei Tisdhera profumano ancora le alture dell'Errante.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Las pinturas de los Tisdhera aún perfuman las alturas del Trotamundos.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "La peinture des Tisdhera embaume toujours le sommet du Wayfarer.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBZE05N40V61HQRE00JKP",
