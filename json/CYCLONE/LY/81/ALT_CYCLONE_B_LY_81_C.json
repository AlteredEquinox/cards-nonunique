                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "At Noon — If three or more single-terrain regions are visible, you may give 1 boost to target Character in Reserve.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Falls mindestens drei Regionen mit einem Geländetyp sichtbar sind, darfst du einem Charakter deiner Wahl in der Reserve 1 Verstärkung geben.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Se sono visibili tre o più regioni con un unico tipo di terreno, puoi conferire 1 rinforzo a un personaggio bersaglio nella Riserva.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Si tres o más regiones monoterreno son visibles, puedes dar 1 potenciador a un personaje objetivo en reserva.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "À Midi — Si au moins trois régions mono-terrain sont visibles, vous pouvez donner 1 boost à un Personnage ciblé en Réserve.",
                    "locale": "fr_FR"
                  }
                },
                "text": "At Noon — If three or more single-terrain regions are visible, you may give 1 boost to target Character in Reserve."
              }
            ],
