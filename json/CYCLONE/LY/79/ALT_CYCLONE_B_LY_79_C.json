                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Target Expedition moves backwards one region. If it does, its controller moves their other Expedition forward one region.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Eine Expedition deiner Wahl bewegt sich eine Region zurück. Falls sie das tut, bewegt ihr kontrollierender Spieler seine andere Expedition eine Region vorwärts.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Una spedizione bersaglio arretra di una regione. Se lo fa, il suo controllore fa avanzare l'altra sua spedizione di una regione.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Une Expédition ciblée recule d'une région. Si elle le fait, son contrôleur avance son autre Expédition d'une région.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Una expedición objetivo retrocede una región. Si lo hace, la otra expedición de su controlador avanza una región.",
                    "locale": "es_ES"
                  }
                },
                "text": "Target Expedition moves backwards one region. If it does, its controller moves their other Expedition forward one region."
              }
            ],
