                "translations": {
                  "en_US": {
                    "text": "Target Expedition #you control# moves backwards one region. If it does, move your other Expedition forward one region.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Una spedizione bersaglio #che controlli# arretra di una regione. Se lo fa, fai avanzare l'altra tua spedizione di una regione.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Una expedición objetivo #que controlas# retrocede una región. Si lo hace, tu otra expedición avanza una región.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Une Expédition ciblée #que vous contrôlez# recule d'une région. Si elle le fait, avancez votre autre Expédition d'une région.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Eine Expedition deiner Wahl, #die du kontrollierst#, bewegt sich eine Region zurück. Falls sie das tut, bewege deine andere Expedition eine Region vorwärts.",
                    "locale": "de_DE"
                  }
                },
                "text": "Target Expedition #you control# moves backwards one region. If it does, move your other Expedition forward one region."
              }
            ],
