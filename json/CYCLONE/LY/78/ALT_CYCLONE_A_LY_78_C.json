      "loreEntryElements": [
        {
          "loreEntryElementType": {
            "id": "01GR6AENPX6HQP8G16KNV7BNA2",
            "reference": "FLAVOR_TEXT",
            "subject": "Flavor Text"
          },
          "translations": {
            "en_US": {
              "text": "Imagination, drawn from dreams.",
              "locale": "en_US"
            },
            "fr_FR": {
              "text": "L'imagination, puisée des rêves.",
              "locale": "fr_FR"
            }
          },
          "id": "01JNRGBVF5A3YWAG20T9HAQCJF",
          "text": "Imagination, drawn from dreams."
        },
        {
          "loreEntryElementType": {
            "id": "01GR6AE2ZSVVYP6SDJXN8Q5DVF",
            "reference": "STORY",
            "subject": "Story"
          },
          "translations": {
            "fr_FR": {
              "text": "\"Il part dans le néant, où tout n'est que chaos ;\r\nEntrant dans le Tumulte, il en accepte l'essence ;\r\nMieux, il s'en réjouit, lui confiant tous ses sens ;\r\nIl laisse pénétrer l'énergie, dans son âme, sur sa peau ;\r\n\r\nÀ l'instant, sur le vif, la mutation s'opère ;\r\nL'initié enthousiaste, comprend que sa nature ;\r\nLoin d'être figée, unique, n'en est qu'une signature ;\r\nMultiple et changeante, sans cesse se régénère ;\r\n\r\nIl accepte le fardeau de sa vive mutation ;\r\nSigne de sa Faction, source de son pouvoir ;\r\nDe tous il souhaite la joie, ainsi que les émouvoir ;\r\nDe la magie qu'il crée, l'art est son expression ;\r\n\r\nRevenu de ce voyage, dans une dimension autre ;\r\nIl veut louer l'Ignescence, la force du changement ;\r\nAu regard de la puissance de ses sentiments ;\r\nDu Tumulte sculpté, il en devient l'apôtre.\"\r",
              "locale": "fr_FR"
            },
            "en_US": {
              "text": "\"He departs into the void and the chaos within;\r\nEntering the Tumult, he embraces its essence;\r\nHe delights in it, trusting it with every sense;\r\nHe absorbs the energy, into soul and onto skin;\r\n\r\nIn that instant, that moment, the transformation takes place;\r\nThe eager initiate now understands that his nature;\r\nFar from being fixed and unique, is just a signature;\r\nMany-faced and ever-changing, it constantly regenerates;\r\n\r\nHe accepts the burden of his intense transformation;\r\nThe sign of his Faction and the source of its might;\r\nFor all, he wants only to bring joy and to excite;\r\nFrom the magic he creates, art is its expression;\r\n\r\nReturning from this journey and into a new dimension;\r\nHe celebrates Ignescence, and the change it brings;\r\nAnd inspired by the power of all these feelings;\r\nFrom the Tumult reshaped, he becomes its champion.\"\r",
              "locale": "en_US"
            }
          },
          "id": "01JNRGBVFKEZAGPDKKK74ATNE9",
          "text": "\"He departs into the void and the chaos within;\r\nEntering the Tumult, he embraces its essence;\r\nHe delights in it, trusting it with every sense;\r\nHe absorbs the energy, into soul and onto skin;\r\n\r\nIn that instant, that moment, the transformation takes place;\r\nThe eager initiate now understands that his nature;\r\nFar from being fixed and unique, is just a signature;\r\nMany-faced and ever-changing, it constantly regenerates;\r\n\r\nHe accepts the burden of his intense transformation;\r\nThe sign of his Faction and the source of its might;\r\nFor all, he wants only to bring joy and to excite;\r\nFrom the magic he creates, art is its expression;\r\n\r\nReturning from this journey and into a new dimension;\r\nHe celebrates Ignescence, and the change it brings;\r\nAnd inspired by the power of all these feelings;\r\nFrom the Tumult reshaped, he becomes its champion.\"\r"
        },
