                "translations": {
                  "en_US": {
                    "text": "#At Noon — If I'm in {V}, create an [AEROLITH] token in target player's Landmarks.#",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "#À Midi — Si je suis en {V}, créez un jeton [AEROLITH] dans les Repères d'un joueur ciblé.#",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "#Al mediodía — Si estoy en {V}, crea una ficha de [AEROLITH] en los hitos del jugador objetivo.#",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#A mezzogiorno — Se sono in {V}, crea una pedina [AEROLITH] nei fulcri di un giocatore bersaglio.#",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "#Zum Mittag — Falls ich in {V} bin, erschaffe eine [AEROLITH]-Marke im Wahrzeichen-Bereich eines Spielers deiner Wahl.#",
