      },
      "translations": {
        "en_US": {
          "text": "He's a fun guy, but he can get into some sticky situations.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Er schießt wie jeder Pilz schnell aus dem Boden und kann auch extrem anhänglich sein.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "È un bravo ragazzo, ma a volte è difficile levarselo di dosso.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Es simpático, pero setagarra y no te suelta.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Appuyer sur le champignon, c'est plus difficile quand il colle aux basques.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBY42MXSXM582ERBRCPNM",
      "text": "He's a fun guy, but he can get into some sticky situations."
