                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "If my Expedition would move forward during Dusk, roll a die. On a 4+: it moves forward one more region instead.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Se la mia spedizione sta per avanzare durante il crepuscolo, tira un dado. Con 4+: avanza invece di una regione in più.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Si mi expedición fuera a avanzar durante el anochecer, tira un dado. Si sacas 4+: en vez de eso, avanza una región más.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Si mon Expédition devait avancer pendant le Crépuscule, lancez un dé. Sur 4+ : elle avance d'une région supplémentaire à la place.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Falls sich meine Expedition am Abend vorwärts bewegen würde, würfle einmal. Bei 4+: Sie bewegt sich stattdessen eine weitere Region vorwärts.",
                    "locale": "de_DE"
                  }
                },
                "text": "If my Expedition would move forward during Dusk, roll a die. On a 4+: it moves forward one more region instead."
              }
            ],
