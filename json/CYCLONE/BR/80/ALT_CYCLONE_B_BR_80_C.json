                "translations": {
                  "en_US": {
                    "text": "Target non-Fleeting Character gains 2 boosts and [FLEETING]. (If it would go to Reserve, it goes to discard instead.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Ein nicht-Vergänglicher Charakter deiner Wahl erhält 2 Verstärkungen und [FLEETING]. (Falls er in die Reserve gehen würde, geht er stattdessen in die Ablage.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Un personaggio bersaglio senza Fugace ottiene 2 rinforzi e [FLEETING]. (Se sta per andare nella Riserva, finisce invece negli scarti.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Un personaje objetivo sin fugacidad gana 2 potenciadores y [FLEETING]. (Si fuera a ir a la reserva, en vez de eso, va al descarte.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Un Personnage ciblé non Fugace gagne 2 boosts et [FLEETING]. (S'il devait être envoyé en Réserve, défaussez-le à la place.)",
                    "locale": "fr_FR"
                  }
                },
