        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"If its fury does not wane, it will soon have a taste of my own!\" - Sol",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wenn sein Zorn nicht abkühlt, wird er bald den meinen zu spüren bekommen!“ – Sol",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Se la sua furia non si placa, presto avrà un assaggio della mia!\" - Sol",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡Si su furia no se apacigua, pronto probará la mía!». — Sol",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Si sa furie ne tarit pas, il aura tôt fait de goûter la mienne ! » - Sol",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBXP9BX7MSG6DES9CT0H0",
      "text": "\"If its fury does not wane, it will soon have a taste of my own!\" - Sol"
    }
  ],
