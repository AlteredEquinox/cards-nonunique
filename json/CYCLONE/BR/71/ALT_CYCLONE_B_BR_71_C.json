      "translations": {
        "en_US": {
          "text": "\"The chance which now seems lost may present itself at the last moment.\" - Jules Verne",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Eine Chance, die schon verloren scheint, kann sich noch im letzten Moment ergeben.“ – Jules Verne",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"L'occasione che adesso ci sfugge può ripresentarsi all'ultimo momento.\" - Jules Verne",
          "locale": "it_IT"
        },
