                "translations": {
                  "en_US": {
                    "text": "When you pass first — #Target Character gains 1 boost,# then create an [AEROLITH] token in #target player's# Landmarks.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando pases primero — #Un personaje objetivo gana 1 potenciador,# y luego creas una ficha de [AEROLITH] en los hitos del #jugador objetivo.#",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous passez en premier — #Un Personnage ciblé gagne 1 boost,# puis créez un jeton [AEROLITH] dans les Repères #d'un joueur ciblé.#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du zuerst passt — #Ein Charakter deiner Wahl erhält 1 Verstärkung,# dann erschaffe eine [AEROLITH]-Marke im Wahrzeichen-Bereich eines #Spielers deiner Wahl.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando passi per primo — #Un personaggio bersaglio ottiene 1 rinforzo,# poi crea una pedina [AEROLITH] nei fulcri #di un giocatore bersaglio.#",
                    "locale": "it_IT"
                  }
                },
                "text": "When you pass first — #Target Character gains 1 boost,# then create an [AEROLITH] token in #target player's# Landmarks."
