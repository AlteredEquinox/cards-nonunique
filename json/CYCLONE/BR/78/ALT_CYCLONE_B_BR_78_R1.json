      "translations": {
        "en_US": {
          "text": "\"I'll stop it before it sows death far and wide!\" - Sol",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Ich werde ihn stoppen, bevor er überall Tod verbreitet!“ – Sol",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Lo fermerò prima che semini morte in lungo e in largo!\" - Sol",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡Lo detendré antes de que siembre la muerte a su paso!». — Sol",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Je l'arrêterai avant qu'il sème la mort ! » - Sol",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBXHWGF2NMM9FREK11A08",
