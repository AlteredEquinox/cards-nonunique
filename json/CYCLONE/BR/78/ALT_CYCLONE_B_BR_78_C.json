                "translations": {
                  "it_IT": {
                    "text": "Puoi [RUSH] per [SABOTAGE_INF]. (Incalzare significa giocare un'altra carta immediatamente. Se lo fai, scarta fino a una carta bersaglio da una Riserva.)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "You may [RUSH] to [SABOTAGE_INF]. (Rush means playing another card immediately. If you do, discard up to one target card from a Reserve.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Puedes [RUSH] para [SABOTAGE_INF]. (Presionar es jugar otra carta inmediatamente. Si lo haces, descarta hasta una carta objetivo de una reserva.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Vous pouvez [RUSH] pour [SABOTAGE_INF]. (Foncer signifie jouer une autre carte immédiatement. Si vous le faites, défaussez jusqu'à une carte ciblée d'une Réserve.)",
                    "locale": "fr_FR"
                  },
