      },
      "translations": {
        "it_IT": {
          "text": "Senza cariche esplosive, questi arpioni ad Halua non farebbero nemmeno il solletico.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Sin cargas explosivas, estos arpones no harían ni un rasguño en la piel de Halua.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Sans charge explosive, ces harpons n'entameront même pas le cuir d'Halua.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "Without explosive charges, these harpoons wouldn't even make a dent in Halua's hide.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Ohne Sprengladungen würden diese Harpunen nicht einmal einen Kratzer in Haluas Haut hinterlassen.",
          "locale": "de_DE"
        }
      },
      "id": "01JNRGBX6J84BGWNCV72YFCEGA",
