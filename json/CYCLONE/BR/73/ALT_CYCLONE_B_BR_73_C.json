                "translations": {
                  "en_US": {
                    "text": "{H} You may [RUSH] to [SABOTAGE_INF]. (Rush means playing another card immediately. If you do, discard up to one target card from a Reserve.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst [RUSH] nutzen, um [SABOTAGE_INF] zu nutzen. (Forcieren bedeutet, eine andere Karte sofort zu spielen. Falls du das tust, lege bis zu eine Karte deiner Wahl aus einer Reserve ab.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Puoi [RUSH] per [SABOTAGE_INF]. (Incalzare significa giocare un'altra carta immediatamente. Se lo fai, scarta fino a una carta bersaglio da una Riserva.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez [RUSH] pour [SABOTAGE_INF]. (Foncer signifie jouer une autre carte immédiatement. Si vous le faites, défaussez jusqu'à une carte ciblée d'une Réserve.)",
