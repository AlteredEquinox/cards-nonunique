                  {
                    "cardKeyword": {
                      "translations": {
                        "de_DE": {
                          "displayWeb": "Gigantisch",
                          "locale": "de_DE",
                          "description": "Ich werde in jeder deiner Expeditionen als anwesend betrachtet."
                        },
                        "it_IT": {
