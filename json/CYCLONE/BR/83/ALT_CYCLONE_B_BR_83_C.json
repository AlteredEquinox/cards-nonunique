                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "If your Hero has 5 or more Quest counters, I am [GIGANTIC]. (A Gigantic Character is considered present in both Expeditions. When I leave the Expedition zone, remove me from the game.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Si tu héroe tiene 5 o más contadores de misión, soy [GIGANTIC]. (Un personaje gigante se considera presente en ambas expediciones. Cuando abandone la zona de expedición, retírame del juego.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Se il tuo eroe ha 5 o più segnalini Missione, ho [GIGANTIC]. (Un personaggio Colossale si considera presente in entrambe le spedizioni. Quando lascio l'area delle spedizioni, rimuovimi dalla partita.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Falls dein Held mindestens 5 Questzähler hat, bin ich [GIGANTIC]. (Ein gigantischer Charakter wird in beiden Expeditionen als anwesend betrachtet. Wenn ich die Expeditionszone verlasse, entferne mich aus dem Spiel.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Si votre Héros a au moins 5 compteurs Quête, je suis [GIGANTIC]. (Un Personnage Gigantesque est considéré présent dans les deux Expéditions. Lorsque je quitte la zone d'Expédition, retirez-moi du jeu.)",
                    "locale": "fr_FR"
                  }
                },
                "text": "If your Hero has 5 or more Quest counters, I am [GIGANTIC]. (A Gigantic Character is considered present in both Expeditions. When I leave the Expedition zone, remove me from the game.)"
              }
            ],
            "reference": "01479"
          },
