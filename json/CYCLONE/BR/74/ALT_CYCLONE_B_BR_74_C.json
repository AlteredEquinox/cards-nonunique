                "translations": {
                  "fr_FR": {
                    "text": "Lorsque mon Expédition avance — Créez un jeton [AEROLITH] dans vos Repères.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When my Expedition moves forward — Create an [AEROLITH] token in your Landmarks. (It's a Permanent with \"When I'm sacrificed — Resupply. {T}, {1}: Sacrifice me.\")",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Quando la mia spedizione avanza — Crea una pedina [AEROLITH] nei tuoi fulcri.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando mi expedición avance — Crea una ficha de [AEROLITH] en tus hitos.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn sich meine Expedition vorwärts bewegt — Erschaffe eine [AEROLITH]-Marke in deinem Wahrzeichen-Bereich.",
                    "locale": "de_DE"
                  }
                },
                "text": "When my Expedition moves forward — Create an [AEROLITH] token in your Landmarks. (It's a Permanent with \"When I'm sacrificed — Resupply. {T}, {1}: Sacrifice me.\")"
