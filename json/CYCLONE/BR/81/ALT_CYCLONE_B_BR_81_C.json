      },
      "translations": {
        "en_US": {
          "text": "A place of eternal rest for the dead, and for Rune's Phoenix, the nest of its rebirth.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Ein Ort der ewigen Ruhe für die Toten und das Nest für die Wiedergeburt von Runes Phönix.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Per i morti, un luogo di riposo eterno; per la fenice di Rune, il nido della rinascita.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Un lugar de descanso eterno para los muertos y, para el fénix de Rune, el nido donde renacerá.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Pour les défunts, un lieu de repos éternel, pour le Phénix de Rune, le nid de sa renaissance.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBXRDGRDG7HEJHZQ6HMBA",
      "text": "A place of eternal rest for the dead, and for Rune's Phoenix, the nest of its rebirth."
    }
  ],
