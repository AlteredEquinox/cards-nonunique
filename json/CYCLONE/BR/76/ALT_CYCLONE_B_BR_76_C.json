                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Quando lascio l'area delle spedizioni — Puoi giocare un personaggio con costo base pari o inferiore a {2} senza pagarne il costo. (Costo dalla Riserva se nella Riserva, altrimenti costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When I leave the Expedition zone — You may play a Character with Base Cost {2} or less for free. (Reserve Cost if from Reserve, Hand Cost otherwise.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn ich die Expeditionszone verlasse — Du darfst einen Charakter mit Basiskosten {2} oder weniger kostenlos spielen. (Reservekosten, falls aus der Reserve, andernfalls Handkosten.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando abandone la zona de expedición — Puedes jugar sin coste un personaje con coste base de {2} o menos. (Si se juega desde la reserva, es su coste desde esta, si no, su coste desde la mano.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsque je quitte la zone d'Expédition — Vous pouvez jouer un Personnage de Coût de Base {2} ou moins gratuitement. (Coût de Main, ou Coût de Réserve si joué depuis la Réserve.)",
                    "locale": "fr_FR"
                  }
                },
                "text": "When I leave the Expedition zone — You may play a Character with Base Cost {2} or less for free. (Reserve Cost if from Reserve, Hand Cost otherwise.)"
              }
            ],
            "reference": "01301"
          },
