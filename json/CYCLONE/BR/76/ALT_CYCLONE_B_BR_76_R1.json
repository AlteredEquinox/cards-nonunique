        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"Each of us must suffer death; let he who is able cover himself in glory (before the end)!\" - Beowulf",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Jeder von uns muss sterben; wer kann, der möge sich (vor dem Ende) mit Ruhm schmücken!“ – Beowulf",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Ognuno di noi deve affrontare la morte; chi ne è in grado, si copra di gloria (prima della fine)!\" - Beowulf",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«A todos nos llegará la muerte. Quien pueda, que gane gloria antes de su fin». — Beowulf",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Chacun de nous doit subir la mort ; que celui qui le peut se couvre de gloire (avant la fin) ! » - Beowulf",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBXD3H28XF5G1Y8WFWSEA",
      "text": "\"Each of us must suffer death; let he who is able cover himself in glory (before the end)!\" - Beowulf"
    }
  ],
