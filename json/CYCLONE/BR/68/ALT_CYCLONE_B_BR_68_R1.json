                "translations": {
                  "en_US": {
                    "text": "{R} #You may [RUSH] to# put the top card of your deck in your Mana zone, exhausted. (Rush means playing another card immediately.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{R} #Du darfst [RUSH] nutzen, um# die oberste Karte deines Decks in deine Manazone zu legen, erschöpft. (Forcieren bedeutet, eine andere Karte sofort zu spielen.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{R} #Puoi [RUSH] per# mettere la prima carta del tuo mazzo nella tua area del mana, consumata. (Incalzare significa giocare un'altra carta immediatamente.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{R} #Puedes [RUSH] para# colocar la primera carta de tu mazo en tu zona de maná como orbe de maná agotado. (Presionar es jugar otra carta inmediatamente.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{R} #Vous pouvez [RUSH] pour# mettre la première carte de votre deck dans votre zone de Mana, épuisée. (Foncer signifie jouer une autre carte immédiatement.)",
                    "locale": "fr_FR"
                  }
                },
