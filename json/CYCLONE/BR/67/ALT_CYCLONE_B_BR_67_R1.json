                  "en_US": {
                    "text": "{J} You may [RUSH] to give #target Character# 1 boost. (Rush means playing another card immediately.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "{J} Puedes [RUSH] para dar 1 potenciador a un #personaje objetivo#. (Presionar es jugar otra carta inmediatamente.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{J} Vous pouvez [RUSH] pour donner 1 boost à #un Personnage ciblé.# (Foncer signifie jouer une autre carte immédiatement.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{J} Du darfst [RUSH] nutzen, um einem #Charakter deiner Wahl# 1 Verstärkung zu geben. (Forcieren bedeutet, eine andere Karte sofort zu spielen.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{J} Puoi [RUSH] per conferire 1 rinforzo a #un personaggio bersaglio#. (Incalzare significa giocare un'altra carta immediatamente.)",
