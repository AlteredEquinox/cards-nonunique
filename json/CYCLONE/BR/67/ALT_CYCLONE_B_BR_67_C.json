      "translations": {
        "en_US": {
          "text": "Altrun is a running and obstacle-dodging discipline that comes in very handy on these islands.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Altlauf ist eine Laufdisziplin, die Parkours und Alteration beinhaltet und auf diesen Inseln sehr nützlich ist.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "L'Altercorsa, disciplina che richiede velocità e prontezza nel superare ostacoli, è molto utile su queste isole.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "El altrun es una modalidad de carrera de obstáculos que resulta muy útil en estas islas.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "L'Altrun est une discipline de course et de franchissement d'obstacles, très utile sur ces archipels.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBWTY08YZ0YRN6E3V2G05",
