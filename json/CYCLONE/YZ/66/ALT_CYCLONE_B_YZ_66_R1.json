        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "When Yzmir alchemists call on the water spirit, the mischievous undine responds.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wenn die Alchemisten der Yzmir den Wassergeist rufen, antwortet die schelmische Undine.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Quando gli alchimisti Yzmir invocano lo spirito dell'acqua, la maliziosa ondina risponde.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Cuando los alquimistas de Yzmir invocan al espíritu del agua, la traviesa ondina responde.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Lorsque les alchimistes Yzmir en appellent à l'esprit de l'eau, l'ondine facétieuse leur répond.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC4S58K1ZGZN5NT28RM4F",
      "text": "When Yzmir alchemists call on the water spirit, the mischievous undine responds."
    }
