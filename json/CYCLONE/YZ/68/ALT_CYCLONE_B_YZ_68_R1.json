                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Puoi giocare incantesimi per #{2} in meno# se il loro costo base è #pari o superiore a {7}.# (Costo dalla Riserva se nella Riserva, altrimenti costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Puedes jugar hechizos por #{2} menos# si su coste base es #{7} o más.# (Si se juega desde la reserva, es su coste desde esta, si no, su coste desde la mano.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "You may play Spells for #{2} less# if their Base Cost is #{7} or more.# (Reserve Cost if from Reserve, Hand Cost otherwise.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Du darfst Zauber für #{2} weniger# spielen, falls ihre Basiskosten #{7} oder mehr# betragen. (Reservekosten, falls aus der Reserve, andernfalls Handkosten.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Vous pouvez jouer les Sorts pour #{2} de moins #si leur Coût de Base est #{7} ou plus.# (Coût de Main, ou Coût de Réserve si joué depuis la Réserve.)",
                    "locale": "fr_FR"
                  }
                },
                "text": "You may play Spells for #{2} less# if their Base Cost is #{7} or more.# (Reserve Cost if from Reserve, Hand Cost otherwise.)"
              }
            ],
