                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "#Hasta tres# fichas de personaje objetivo desertan. (Se incorporan a la expedición enfrentada a ellas y cambian de controlador.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "#Jusqu'à trois# jetons Personnages ciblés trahissent. (Ils rejoignent chacun l'Expédition qui leur fait face et changent de contrôleur.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "#Up to three# target token Characters defect. (They each join the Expedition facing theirs, changing controllers.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#Bis zu drei# Marken-Charaktere deiner Wahl laufen über. (Sie schließen sich der ihnen jeweils gegenüberstehenden Expedition an und wechseln den kontrollierenden Spieler.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "#Fino a tre# personaggi pedina bersaglio disertano. (Ognuno si unisce alla spedizione che lo affronta, cambiando controllore.)",
                    "locale": "it_IT"
                  }
                },
                "text": "#Up to three# target token Characters defect. (They each join the Expedition facing theirs, changing controllers.)"
              }
            ],
            "reference": "01473"
          },
