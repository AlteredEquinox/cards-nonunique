                "translations": {
                  "en_US": {
                    "text": "When you play a Spell with Base Cost {4} or more — You may give target Character 1 boost. (Reserve Cost if from Reserve, Hand Cost otherwise.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Sort de Coût de Base {4} ou plus — Vous pouvez donner 1 boost à un Personnage ciblé. (Coût de Main, ou Coût de Réserve si joué depuis la Réserve.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Zauber mit Basiskosten {4} oder mehr spielst — Du darfst einem Charakter deiner Wahl 1 Verstärkung geben. (Reservekosten, falls aus der Reserve, andernfalls Handkosten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando giochi un incantesimo con costo base pari o superiore a {4} — Puoi conferire 1 rinforzo a un personaggio bersaglio. (Costo dalla Riserva se nella Riserva, altrimenti costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un hechizo con coste base de {4} o más — Puedes dar 1 potenciador a un personaje objetivo. (Si se juega desde la reserva, es su coste desde esta, si no, su coste desde la mano.)",
                    "locale": "es_ES"
                  }
                },
