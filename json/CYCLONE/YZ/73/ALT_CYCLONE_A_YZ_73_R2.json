        },
        "it_IT": {
          "text": "Abbiamo seguito la sua scia credendo che fosse un girino.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Seguimos su rastro, creyendo que era un renacuajo.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Nous suivîmes son onde, pensant qu'il s'agissait d'un têtard.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "We followed on its wave, believing it was a tadpole.",
          "locale": "en_US"
        }
