        "it_IT": {
          "text": "Abbiamo seguito la sua scia, credendo che fosse una corrente magica.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Seguimos su estela, creyendo que era una corriente mágica.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Nous suivîmes son sillage, pensant qu'il s'agissait d'un courant magique.",
