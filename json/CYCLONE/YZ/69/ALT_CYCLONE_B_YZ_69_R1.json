      },
      "translations": {
        "en_US": {
          "text": "\"I'll gladly give you the spot, there's no use getting in a stew.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Ich gebe dir gern den Platz, ich möchte keinen Stress.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Ti cedo volentieri il posto, non c'è bisogno di agitarsi.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«No te enfades. Si quieres, te dejo ganar».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Je te cède la place volontiers, je vais pas en faire des salades. »",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC58EES78WNQSTAK5J087",
      "text": "\"I'll gladly give you the spot, there's no use getting in a stew.\""
    }
  ],
