        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Indem Suha das Angebot der Qorgan annahm, konnte sie sehen, was unten im Kaninchenbau war.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Accettando l'offerta del Qorgan, Suha è riuscita a scoprire cosa si celava nella tana del coniglio.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Al aceptar la oferta del Qorgan, Suha pudo ver qué había en el fondo de la madriguera.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "En acceptant l'offre du Qorgan, Suha vit jusqu'où allait le terrier du lapin.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "By accepting the Qorgan's offer, Suha got to see what was down the rabbit hole.",
          "locale": "en_US"
        }
      },
      "id": "01JNRGC5DX4KVJVKG2BS9X8EGW",
      "text": "By accepting the Qorgan's offer, Suha got to see what was down the rabbit hole."
    }
  ],
