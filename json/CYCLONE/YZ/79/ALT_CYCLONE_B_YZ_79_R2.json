                "translations": {
                  "en_US": {
                    "text": "Target a Character in any Reserve with Reserve Cost {2} or less. Play it for free. (Put it in one of your Expeditions.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Ciblez un Personnage de Coût de Réserve {2} ou moins dans n'importe quelle Réserve. Jouez-le gratuitement. (Placez-le dans l'une de vos Expéditions.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wähle einen Charakter in einer beliebigen Reserve mit Reservekosten {2} oder weniger. Spiele ihn kostenlos. (Lege ihn in eine deiner Expeditionen.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Scegli come bersaglio un personaggio in una Riserva qualsiasi con costo dalla Riserva pari o inferiore a {2}. Giocalo senza pagarne il costo. (Mettilo in una delle tue spedizioni.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Haz objetivo a un personaje en reserva con coste desde la reserva de {2} o menos. Juégalo sin coste. (Colócalo en una de tus expediciones.)",
                    "locale": "es_ES"
                  }
                },
