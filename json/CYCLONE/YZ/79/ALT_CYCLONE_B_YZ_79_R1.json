        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Like a worm in an apple, Silk squirmed into the Eidolon's mind to convert him to its Faction's interests.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wie ein Wurm in einen Apfel drang Silk in den Geist des Eidolons ein, um es für die Interessen seiner Fraktion zu gewinnen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Come un verme in una mela, Silk si insinuò nella mente dell'eidolon per piegarlo agli interessi della sua fazione.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Como un gusano en una manzana, Seda se coló en la mente del eidolon para convencerlo de los intereses de su facción.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Comme un ver dans la pomme, Silk pénétra l'esprit de l'Eidolon pour le convertir aux intérêts de sa Faction.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC6Y14XG81A70XA7VS9Q7",
      "text": "Like a worm in an apple, Silk squirmed into the Eidolon's mind to convert him to its Faction's interests."
    }
  ],
