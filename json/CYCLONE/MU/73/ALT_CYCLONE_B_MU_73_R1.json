        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "With their fluffy texture and cotton-candy flavor, woollybacks are wyverns' favorite prey.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Aufgrund ihres flauschigen Fells und ihres Zuckerwattegeschmacks sind Wollrücken die Lieblingsbeute der Lindwürmer.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Con la loro consistenza soffice e quel sapore di zucchero filato, le lanuvole sono le prede preferite delle viverne.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Los lanudos son la presa favorita de los guivernos, pues son esponjosos y saben a algodón de azúcar.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "La texture cotonneuse et le goût barbe à papa du dotouffu en font la proie préférée des vouivres.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC0DKW9S6HAYV6HGPKJ9J",
      "text": "With their fluffy texture and cotton-candy flavor, woollybacks are wyverns' favorite prey."
    }
