      "translations": {
        "de_DE": {
          "text": "Wir spazierten zwischen den Büschen umher, als uns einer von ihnen aufsuchte.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Stavamo sfrecciando tra i cespugli, quando uno di loro ci venne incontro.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Corríamos entre los arbustos cuando vino a nuestro encuentro.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Nous zigzaguions entre les buissons quand l'un d'eux vint à notre rencontre.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "We were dashing among the bushes when one of them came to meet us.",
          "locale": "en_US"
        }
      },
