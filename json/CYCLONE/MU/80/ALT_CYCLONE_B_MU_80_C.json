      "translations": {
        "en_US": {
          "text": "The deepest sleep is woven from the wool of sweet dreams.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Der tiefste Schlaf ist aus der Wolle süßer Träume gewebt.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Il sonno più profondo è tessuto con la lana dei sogni tranquilli.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Los sueños más profundos se tejen con la lana de los sueños dulces.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Les sommeils les plus profonds sont tissés de la laine des rêves les plus doux.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC16D9361PH1SWAFFKXEN",
      "text": "The deepest sleep is woven from the wool of sweet dreams."
