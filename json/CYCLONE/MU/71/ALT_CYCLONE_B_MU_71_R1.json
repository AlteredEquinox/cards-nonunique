                "translations": {
                  "en_US": {
                    "text": "When a Character joins the Expedition facing me — You may have me switch Expeditions.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un Personnage rejoint l'Expédition qui me fait face — Vous pouvez me faire changer d'Expédition.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn sich ein Charakter der mir gegenüberstehenden Expedition anschließt — Du darfst mich Expeditionen wechseln lassen.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando un personaggio si unisce alla spedizione che mi affronta — Puoi farmi cambiare spedizione.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando un personaje se incorpore a la expedición enfrentada a mí — Puedes hacer que me traslade de expedición.",
                    "locale": "es_ES"
                  }
                },
                "text": "When a Character joins the Expedition facing me — You may have me switch Expeditions."
              }
            ],
