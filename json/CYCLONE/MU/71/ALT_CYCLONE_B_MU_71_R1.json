        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "When the cranes start their migration, that's the signal that it's time to seek out new horizons.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wenn der Vogelzug der Kraniche beginnt, ist es Zeit, zu neuen Horizonten aufzubrechen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Quando le gru iniziano a migrare, è tempo di cercare nuovi orizzonti.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Cuando las grullas inician su migración, es la señal de que toca buscar nuevos horizontes.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Quand les grues entament leur migration, c'est le signal que le moment est venu de voguer vers d'autres horizons.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC070N3EP4X7GE5YYVR58",
      "text": "When the cranes start their migration, that's the signal that it's time to seek out new horizons."
    }
