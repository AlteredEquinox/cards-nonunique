        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Firmly rooted like a tree, yet free like the birds, he embodies nature's strength.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Fest verwurzelt wie ein Baum und doch frei wie die Vögel, verkörpert er die Kraft der Natur.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Saldamente radicato come un albero, ma libero come gli uccelli, incarna la forza della natura.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Arraigado con firmeza como un árbol, pero libre como las aves. Encarna la fuerza de la naturaleza.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Enraciné comme un arbre, libre comme les oiseaux, il est la force de la nature.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC0VTK4DREH4CXKKNHKEG",
      "text": "Firmly rooted like a tree, yet free like the birds, he embodies nature's strength."
    }
