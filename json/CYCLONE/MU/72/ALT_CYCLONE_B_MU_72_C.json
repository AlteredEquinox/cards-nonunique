      "translations": {
        "en_US": {
          "text": "After all that work, it's time for the dodo to go night-night.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Nach all der Arbeit ist es für den Dodo Zeit, Gute Nacht zu sagen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Dopo tutto quel lavoro, per il dodo è arrivato il momento della buonanotte.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Después de tanto trabajo, es hora de que el dodo se eche una cabezadita.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Après tous ces efforts, il est bien temps de faire dodo.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC0ACFN2A2AV9VW9X4NKP",
      "text": "After all that work, it's time for the dodo to go night-night."
