      },
      "translations": {
        "en_US": {
          "text": "He raised a shield of feathers. Lances and harpoons shattered against his steely wings.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Er hob einen Schild aus Federn. An seinen stählernen Flügeln zerschellten Lanzen und Harpunen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Alzò uno scudo di piume. Lance e arpioni si infransero contro le sue ali d'acciaio.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Levantó un escudo de plumas. Las lanzas y los arpones se estrellaron contra sus alas de acero.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Il leva un bouclier de plumes. Lances et harpons se fracassèrent contre ses ailes d'acier.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC00KPV78WT1Y1EJN98GS",
