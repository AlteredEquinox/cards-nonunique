      },
      "translations": {
        "en_US": {
          "text": "It's not unusual to see these pelicans ferrying small local creatures from one island to the next.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Man sieht diese Pelikane oft, wie sie kleine einheimische Tiere von einer Insel zur nächsten transportieren.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Non è raro vedere questi pellicani trasportare piccole creature locali da un'isola all'altra.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Es habitual ver a estos pelícanos transportando pequeñas criaturas locales de una isla a otra.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Il n'est pas rare de voir ces pélicans transporter d'île en île les petites créatures de la faune locale.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBZT6F4ABS480CKM4DRCX",
      "text": "It's not unusual to see these pelicans ferrying small local creatures from one island to the next."
    }
