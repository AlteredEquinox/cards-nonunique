                "translations": {
                  "en_US": {
                    "text": "#When a Character joins the Expedition facing me — If I'm facing only one Character, [RESUPPLY_LOW].#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#Wenn sich ein Charakter der mir gegenüberstehenden Expedition anschließt — Falls ich nur einem Charakter gegenüberstehe, [RESUPPLY_LOW].#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "#Quando un personaggio si unisce alla spedizione che mi affronta — Se sto affrontando solo un personaggio, [RESUPPLY_LOW].#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#Cuando un personaje se incorpore a la expedición enfrentada a mí — Si solo hay un personaje enfrentado a mí, [RESUPPLY_LOW].#",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "#Lorsqu'un Personnage rejoint l'Expédition qui me fait face — Si je suis face à un seul Personnage, [RESUPPLY_LOW].#",
                    "locale": "fr_FR"
                  }
                },
                "text": "#When a Character joins the Expedition facing me — If I'm facing only one Character, [RESUPPLY_LOW].#"
              }
