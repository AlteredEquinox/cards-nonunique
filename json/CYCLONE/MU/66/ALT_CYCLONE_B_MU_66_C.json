        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Despite their small size, Rhodopean robins will defend their territory with beak and claw.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Trotz ihrer kleinen Statur verteidigen Rhodopes-Rotkehlchen ihr Territorium mit Schnäbeln und Krallen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Nonostante le piccole dimensioni, i pettirossi rodopei difendono il loro territorio con tenacia.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "A pesar de su pequeño tamaño, los petirrojos rhodopenses defienden su territorio con pico y garras.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Malgré leur petite taille, les rouges-gorges rhodopéens n'hésitent pas à défendre leur territoire bec et ongles.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBZQ68QQT7F641C5WVNHM",
      "text": "Despite their small size, Rhodopean robins will defend their territory with beak and claw."
    }
