{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"Surrounded by all of his animal friends, my teacher never felt alone, even living as a hermit.\" - Kauri",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Umgeben von all seinen tierischen Freunden fühlte sich mein Lehrer nie allein, auch wenn er ein Einsiedler war.“ – Kauri",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Circondato da tutti i suoi amici animali, il mio maestro non si è mai sentito solo, anche vivendo da eremita.\" - Kauri",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Pese a vivir como un ermitaño, mi maestro jamás se sintió solo, pues se rodeaba de sus animales». — Kauri",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Entouré de tous ses amis animaux, mon professeur ne s'est jamais senti seul, même s'il vivait en ermite. » - Kauri",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBZX9E69HAK1X2V4DQKHC",
      "text": "\"Surrounded by all of his animal friends, my teacher never felt alone, even living as a hermit.\" - Kauri"
    }
  ],
