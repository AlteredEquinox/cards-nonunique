                "translations": {
                  "en_US": {
                    "text": "{H} [SABOTAGE]. If you discarded a card this way, create a [WOOLLYBACK] Animal token in the Companion Expedition of its owner. #You may have it gain [ASLEEP].#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{H} [SABOTAGE]. Falls du eine Karte auf diese Weise abgelegt hast, erschaffe eine [WOOLLYBACK]-Tiermarke in der Gefährten-Expedition ihres Besitzers. #Du darfst sie [ASLEEP] erhalten lassen.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} [SABOTAGE]. Se hai scartato una carta in questo modo, crea una pedina Animale [WOOLLYBACK] nella spedizione del compagno del suo proprietario. #Puoi farle ottenere [ASLEEP].#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} [SABOTAGE]. Si descartaste una carta de esta manera, crea una ficha de animal [WOOLLYBACK] en la expedición del compañero de su propietario. #Puedes hacer que gane [ASLEEP].#",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{H} [SABOTAGE]. Si vous avez défaussé une carte de cette façon, créez un jeton Animal [WOOLLYBACK] dans l'Expédition Compagnon de son propriétaire. #Vous pouvez lui faire gagner [ASLEEP].#",
                    "locale": "fr_FR"
                  }
                },
                "text": "{H} [SABOTAGE]. If you discarded a card this way, create a [WOOLLYBACK] Animal token in the Companion Expedition of its owner. #You may have it gain [ASLEEP].#"
