                  },
                  "it_IT": {
                    "text": "#Un giocatore bersaglio# può giocare immediatamente un personaggio #senza pagarne il costo# nella spedizione del suo compagno. Ottiene [ANCHORED].",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#El jugador objetivo# puede jugar inmediatamente #sin coste# un personaje en su expedición del compañero. Gana [ANCHORED].",
