      "translations": {
        "en_US": {
          "text": "To maintain their cohesion, the Ordis must call on the most reliable of couriers.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Um ihren Zusammenhalt zu wahren, brauchen die Ordis die zuverlässigsten Kuriere.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Per mantenere la loro coesione, gli Ordis devono avvalersi dei corrieri più affidabili.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Para mantener su unidad, los Ordis deben recurrir a los mensajeros más fiables.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Pour maintenir leur cohésion, les Ordis doivent faire appel aux plus fiables des estafettes.",
