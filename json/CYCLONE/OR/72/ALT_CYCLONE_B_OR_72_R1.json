                "translations": {
                  "en_US": {
                    "text": "#{J}# If I'm in an Ascended Expedition, #create an [AEROLITH] token in target player's Landmarks.# Otherwise, my Expedition [ASCENDS].",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "#{J}# Si je suis dans une Expédition Élevée, #créez un jeton [AEROLITH] dans les Repères d'un joueur ciblé.# Sinon, mon Expédition [ASCENDS].",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "#{J}# Falls ich in einer Aufgestiegenen Expedition bin, #erschaffe eine [AEROLITH]-Marke im Wahrzeichen-Bereich eines Spielers deiner Wahl.# Andernfalls ist meine Expedition [ASCENDS].",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "#{J}# Se sono in una spedizione Ascesa, #crea una pedina [AEROLITH] nei fulcri di un giocatore bersaglio.# Altrimenti, la mia spedizione [ASCENDS].",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#{J}# Si estoy en una expedición ascendida, #crea una ficha de [AEROLITH] en los hitos del jugador objetivo.# De lo contrario, mi expedición [ASCENDS].",
                    "locale": "es_ES"
                  }
                },
                "text": "#{J}# If I'm in an Ascended Expedition, #create an [AEROLITH] token in target player's Landmarks.# Otherwise, my Expedition [ASCENDS]."
              }
            ],
            "reference": "01596"
