                "translations": {
                  "en_US": {
                    "text": "#{J}# If I'm in an Ascended Expedition, I gain 1 boost. Otherwise, my Expedition [ASCENDS].",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#{J}# Falls ich in einer Aufgestiegenen Expedition bin, erhalte ich 1 Verstärkung. Andernfalls ist meine Expedition [ASCENDS].",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#{J}# Si estoy en una expedición ascendida, gano 1 potenciador. De lo contrario, mi expedición [ASCENDS].",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#{J}# Se sono in una spedizione Ascesa, ottengo 1 rinforzo. Altrimenti, la mia spedizione [ASCENDS].",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "#{J}# Si je suis dans une Expédition Élevée, je gagne 1 boost. Sinon, mon Expédition [ASCENDS].",
                    "locale": "fr_FR"
                  }
                },
                "text": "#{J}# If I'm in an Ascended Expedition, I gain 1 boost. Otherwise, my Expedition [ASCENDS]."
              }
