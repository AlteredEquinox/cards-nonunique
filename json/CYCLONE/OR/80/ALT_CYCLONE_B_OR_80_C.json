            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Gioca immediatamente senza pagarne il costo fino a due personaggi con costo base pari o inferiore a {3}. (Costo dalla Riserva se nella Riserva, altrimenti costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Jouez immédiatement jusqu'à deux Personnages de Coût de Base {3} ou moins gratuitement. (Coût de Main, ou Coût de Réserve si joué depuis la Réserve.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "Immediately play for free up to two Characters with Base Cost {3} or less. (Reserve Cost if from Reserve, Hand Cost otherwise.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Du darfst sofort bis zu zwei Charaktere mit Basiskosten {3} oder weniger kostenlos spielen. (Reservekosten, falls aus der Reserve, andernfalls Handkosten.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Juega inmediatamente sin coste hasta dos personajes con coste base de {3} o menos. (Si se juega desde la reserva, es su coste desde esta, si no, su coste desde la mano.)",
                    "locale": "es_ES"
                  }
                },
                "text": "Immediately play for free up to two Characters with Base Cost {3} or less. (Reserve Cost if from Reserve, Hand Cost otherwise.)"
              }
            ],
            "reference": "01433"
          },
          "sequence": 2,
          "id": "01KGQE11EGVAM6ECRFYPDDGV1Y"
        }
