                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Both of your Expeditions [ASCEND]. (Until Rest, they can move forward even if matched in their regions' terrains by the opponent's Expeditions.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Deine beiden Expeditionen sind [ASCEND]. (Können sich bis zur Ruhepause vorwärts bewegen, selbst falls die Expeditionen des Gegners über gleich viele Gelände in den Regionen verfügen.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Entrambe le tue spedizioni [ASCEND]. (Fino al riposo, possono avanzare anche se i terreni delle loro regioni eguagliano quelli delle spedizioni dell'avversario.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Tus dos expediciones [ASCEND]. (Hasta el descanso, pueden avanzar aunque los terrenos de sus regiones estén igualados con los de la expedición del oponente.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Vos deux Expéditions [ASCEND]. (Jusqu'au Repos, elles peuvent avancer même en cas de stats égales aux Expéditions adverses sur les terrains de leurs régions.)",
                    "locale": "fr_FR"
                  }
                },
                "text": "Both of your Expeditions [ASCEND]. (Until Rest, they can move forward even if matched in their regions' terrains by the opponent's Expeditions.)"
              }
            ],
            "reference": "01540"
          },
