                  "en_US": {
                    "text": "Target Expedition [ASCENDS]. (Until Rest, it can move forward even if matched in its region's terrains by the opponent's Expedition.)",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Una spedizione bersaglio [ASCENDS]. (Fino al riposo, può avanzare anche se i terreni della sua regione eguagliano quelli della spedizione dell'avversario.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "La expedición objetivo [ASCENDS]. (Hasta el descanso, puede avanzar aunque los terrenos de su región estén igualados con los de la expedición del oponente.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Une Expédition ciblée [ASCENDS]. (Jusqu'au Repos, elle peut avancer même en cas de stats égales à l'Expédition adverse sur les terrains de sa région.)",
