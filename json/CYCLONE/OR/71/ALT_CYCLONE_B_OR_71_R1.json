      },
      "translations": {
        "en_US": {
          "text": "At the slightest sign of intrusion, these stone lookouts come to life and sound the alarm.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Beim geringsten Anzeichen eines Eindringlings erwachen diese steinernen Wächter zum Leben und schlagen Alarm.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Al minimo segno di intrusione, queste vedette di pietra prendono vita e danno l'allarme.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "A la menor señal de intrusos, estos centinelas de piedra cobran vida y hacen sonar la alarma.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Au moindre signe d'intrusion, ces vigies de pierre prennent vie et donnent l'alerte.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC2MDHDBPVWK2JJJ8CYE5",
