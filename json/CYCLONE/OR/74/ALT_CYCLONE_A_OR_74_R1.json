      "translations": {
        "de_DE": {
          "text": "Wir wichen aus, um dem gereizten Schnappen seines Schnabels zu entgehen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Ci scostammo per evitare l'iroso scatto del suo becco.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Nos hicimos a un lado para evitar el petulante chasquido de su pico.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Nous nous écartâmes pour éviter ses coups de bec grincheux.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "We moved aside to avoid the petulant snapping of its beak.",
          "locale": "en_US"
        }
      },
