                "translations": {
                  "en_US": {
                    "text": "When my Expedition fails to move forward during Dusk — Create an [AEROLITH] token in your Landmarks.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque mon Expédition n'avance pas pendant le Crépuscule — Créez un jeton [AEROLITH] dans vos Repères.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn meine Expedition sich am Abend nicht vorwärts bewegt — Erschaffe eine [AEROLITH]-Marke in deinem Wahrzeichen-Bereich.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando la mia spedizione non avanza durante il crepuscolo — Crea una pedina [AEROLITH] nei tuoi fulcri.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando mi expedición no logre avanzar durante el anochecer — Crea una ficha de [AEROLITH] en tus hitos.",
                    "locale": "es_ES"
                  }
                },
                "text": "When my Expedition fails to move forward during Dusk — Create an [AEROLITH] token in your Landmarks."
              }
