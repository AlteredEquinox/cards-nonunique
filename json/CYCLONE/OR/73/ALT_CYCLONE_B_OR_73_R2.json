          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#{H}# Target a Character facing me. I gain its subtypes and X boosts, where X equals its highest statistic. (I lose these subtypes when I leave the Expedition zone.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "#{H}# Ciblez un Personnage qui me fait face. Je gagne ses sous-types et X boosts, X étant la valeur de sa statistique la plus élevée. (Je perds ces sous-types lorsque je quitte la zone d'Expédition.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "#{H}# Scegli come bersaglio un personaggio che mi affronta. Ottengo i suoi sottotipi e X rinforzi, dove X equivale alla sua statistica più alta. (Perdo questi sottotipi quando lascio l'area delle spedizioni.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "#{H}# Wähle einen mir gegenüberstehenden Charakter. Ich erhalte seinen Subtyp und X Verstärkungen, wobei X seiner höchsten Statistik entspricht. (Ich verliere diese Subtypen, wenn ich die Expeditionszone verlasse.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#{H}# Haz objetivo a un personaje enfrentado a mí. Gano su subtipo y X potenciadores, donde X equivale a su estadística más alta. (Pierdo esos subtipos cuando abandone la zona de expedición.)",
                    "locale": "es_ES"
                  }
                },
                "text": "#{H}# Target a Character facing me. I gain its subtypes and X boosts, where X equals its highest statistic. (I lose these subtypes when I leave the Expedition zone.)"
              }
            ],
            "reference": "01418"
          },
          "sequence": 1,
          "id": "01KGQDYD8DTENH68DNXHHM7PST"
        }
      ],
