          "text": "Dieser junge Rekrut watschelt umher und zeigt stolz sein Abzeichen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Questa giovane recluta si pavoneggia come un cigno in un mare di anatre.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Este recluta patoso se pavonea mientras muestra con orgullo su insignia.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Jeune recrue, il porte fièrement son insigne.",
          "locale": "fr_FR"
        }
