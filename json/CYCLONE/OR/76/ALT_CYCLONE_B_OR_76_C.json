      },
      "translations": {
        "en_US": {
          "text": "When she spreads her wings, her victory shall resonate for all eternity.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wenn sie ihre Flügel ausbreitet, wird ihr Sieg für alle Ewigkeit strahlen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Quando spiegherà le ali, la sua vittoria risuonerà per l'eternità.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Cuando extienda sus alas, su victoria resonará por toda la eternidad.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Quand elle étend ses ailes, sa victoire résonne pour l'éternité.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC3D935P8F5VQ6J1A8QYV",
      "text": "When she spreads her wings, her victory shall resonate for all eternity."
