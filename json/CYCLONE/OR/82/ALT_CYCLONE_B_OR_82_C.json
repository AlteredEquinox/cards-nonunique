                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "{J} Une Expédition ciblée [ASCENDS]. (Jusqu'au Repos, elle peut avancer même en cas de stats égales à l'Expédition adverse sur les terrains de sa région.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{J} La expedición objetivo [ASCENDS]. (Hasta el descanso, puede avanzar aunque los terrenos de su región estén igualados con los de la expedición del oponente.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{J} Una spedizione bersaglio [ASCENDS]. (Fino al riposo, può avanzare anche se i terreni della sua regione eguagliano quelli della spedizione dell'avversario.)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "{J} Target Expedition [ASCENDS]. (Until Rest, it can move forward even if matched in its region's terrains by the opponent's Expedition.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{J} Eine Expedition deiner Wahl ist [ASCENDS]. (Kann sich bis zur Ruhepause vorwärts bewegen, selbst falls beide über gleich viele Gelände in den Regionen verfügen.)",
                    "locale": "de_DE"
                  }
                },
                "text": "{J} Target Expedition [ASCENDS]. (Until Rest, it can move forward even if matched in its region's terrains by the opponent's Expedition.)"
              }
            ],
