                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When you play a Character — If it's in an Ascended Expedition, you may exhaust me ({T}) to give it 1 boost.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Charakter spielst — Falls er in einer Aufgestiegenen Expedition ist, darfst du mich erschöpfen ({T}), um ihm 1 Verstärkung zu geben.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un personaje — Si está en una expedición ascendida, puedes agotarme ({T}) para darle 1 potenciador.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Personnage — S'il est dans une Expédition Élevée, vous pouvez m'épuiser ({T}) pour lui donner 1 boost.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Quando giochi un personaggio — Se è in una spedizione Ascesa, puoi consumarmi ({T}) per conferirgli 1 rinforzo.",
                    "locale": "it_IT"
                  }
                },
                "text": "When you play a Character — If it's in an Ascended Expedition, you may exhaust me ({T}) to give it 1 boost."
              }
            ],
            "reference": "01438"
          },
          "sequence": 1,
          "id": "01KGQE1Q0PASPN2WZF5VS694MT"
        }
      ],
