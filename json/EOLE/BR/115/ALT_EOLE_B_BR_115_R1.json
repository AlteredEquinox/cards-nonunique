        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"It's not time to billet yet, but take the opportunity to stock up.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wir haben noch kein Quartier, aber deckt euch schon mal ein.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« C'est pas l'heure de cantonner, mais profitez-en pour faire le plein. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Non è il momento di accamparsi, ma approfittatene per fare provviste.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Aún no es hora de acantonarse, pero aprovechad para reabasteceros».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HQ8B035C8QV1VHDBMWVP",
      "text": "\"It's not time to billet yet, but take the opportunity to stock up.\""
    }
