      },
      "translations": {
        "en_US": {
          "text": "\"If you underestimate me, my victory will be all the sweeter.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Unterschätzt mich ruhig, dann schmeckt mein Sieg umso süßer.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Si tu me sous-estimes, ça va te coûter bonbon. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Se mi sottovaluti, la mia vittoria sarà ancora più dolce.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Si me subestimas, mi victoria será aún más dulce».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HPTN89Y1AQP4CHB1RE3J",
      "text": "\"If you underestimate me, my victory will be all the sweeter.\""
    }
