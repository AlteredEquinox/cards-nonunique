      },
      "translations": {
        "en_US": {
          "text": "Sometimes it's wiser to be afraid of your own shadow…",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Manchmal sollte man den eigenen Schatten fürchten …",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Il est parfois sage d'avoir peur de son ombre...",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "A volte è più saggio aver paura della propria ombra...",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "A veces conviene hasta tener miedo de tu propia sombra...",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HQ76Y5T05WED13318EED",
      "text": "Sometimes it's wiser to be afraid of your own shadow…"
