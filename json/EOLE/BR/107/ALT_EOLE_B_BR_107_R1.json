                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Lorsqu'un autre Personnage rejoint vos Expéditions — Vous pouvez dépenser 1 boost #d'un Personnage que vous contrôlez# pour lui donner 1 boost.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When another Character joins your Expeditions — You may spend 1 boost #from a Character you control# to give it 1 boost.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn ein anderer Charakter sich deinen Expeditionen anschließt — Du darfst 1 Verstärkung #eines Charakters, den du kontrollierst,# ausgeben, um ihm 1 Verstärkung zu geben.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando un altro personaggio si unisce alle tue spedizioni — Puoi spendere 1 rinforzo #da un personaggio che controlli# per conferirgli 1 rinforzo.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando otro personaje se incorpore a tus expediciones — Puedes gastar 1 potenciador #de un personaje que controles# para darle 1 potenciador.",
                    "locale": "es_ES"
                  }
                },
                "text": "When another Character joins your Expeditions — You may spend 1 boost #from a Character you control# to give it 1 boost."
              }
            ],
            "reference": "02788"
          },
