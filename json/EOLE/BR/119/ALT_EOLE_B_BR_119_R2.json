        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"If you want them, you'll have to go through me first!\" — Kebba",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wenn ihr sie haben wollt, müsst ihr erst an mir vorbei!“ — Kebba",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Pour les atteindre, vous devrez me passer sur le corps ! » — Kebba",
          "locale": "fr_FR"
        },
        "es_ES": {
          "text": "«¡Para alcanzarlos, tendrás que pasar por encima de mi cadáver!». ―Kebba",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Se li vuoi, dovrai prima passare sul mio cadavere!\" — Kebba",
          "locale": "it_IT"
        }
      },
      "id": "01KC94HQEZD9NCDGFA5DRE7GXX",
      "text": "\"If you want them, you'll have to go through me first!\" — Kebba"
    }
  ],
