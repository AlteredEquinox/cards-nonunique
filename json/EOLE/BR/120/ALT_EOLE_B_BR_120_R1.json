                  },
                  {
                    "cardKeyword": {
                      "translations": {
                        "en_US": {
                          "displayWeb": "Fleeting",
                          "locale": "en_US",
                          "description": "Send me to Discard instead of Reserve after my effect resolves."
                        },
                        "de_DE": {
                          "displayWeb": "Vergänglich",
                          "locale": "de_DE",
                          "description": "Lege mich auf die Ablage statt in die Reserve, nachdem mein Effekt abgeklungen ist."
                        },
                        "it_IT": {
                          "displayWeb": "Fugace",
                          "locale": "it_IT",
                          "description": "Mandami negli Scarti invece che nella Riserva dopo che il mio effetto si è risolto."
                        },
                        "es_ES": {
                          "displayWeb": "Fugacidad",
                          "locale": "es_ES",
                          "description": "Una vez resuelto mi efecto, envíame a la pila de descartes en lugar de a la reserva."
                        },
                        "fr_FR": {
                          "displayWeb": "Fugace",
                          "locale": "fr_FR",
                          "description": "Envoyez-moi à la Défausse plutôt qu'en Réserve une fois mon effet résolu."
                        }
                      },
                      "id": "01HKAGPHBY4EPW8TR9VTCHZG5Q",
                      "reference": "FLEETING"
                    },
                    "sequence": 1,
                    "isDescriptionDisplayed": false,
                    "id": "01KG7KBN5AXQRF021J2JNZNYPQ"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "{J} [RESUPPLY]. Then, you may have target Character you control gain [FLEETING].",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{J} [RESUPPLY]. Poi, puoi far ottenere [FLEETING] a un personaggio bersaglio che controlli.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "{J} [RESUPPLY]. Dann darf ein Charakter deiner Wahl, den du kontrollierst, [FLEETING] erhalten.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{J} [RESUPPLY]. Luego, puedes hacer que un personaje objetivo que controles gane [FLEETING].",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{J} [RESUPPLY]. Puis, vous pouvez faire gagner [FLEETING] à un Personnage ciblé que vous contrôlez.",
                    "locale": "fr_FR"
                  }
                },
                "text": "{J} [RESUPPLY]. Then, you may have target Character you control gain [FLEETING]."
              }
            ],
