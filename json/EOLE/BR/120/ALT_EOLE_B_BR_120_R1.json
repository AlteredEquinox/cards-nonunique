                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When you pass — If you control two or more [FLEETING] Characters, complete me.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn du passt — Falls du mindestens zwei Charaktere mit [FLEETING] kontrollierst, vollbringe mich.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando passi — Se controlli due o più personaggi con [FLEETING], eseguimi.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando pases — Si controlas dos personajes con [FLEETING] o más, complétame.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous passez — Si vous contrôlez au moins deux Personnages [FLEETING], accomplissez-moi.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When you pass — If you control two or more [FLEETING] Characters, complete me."
