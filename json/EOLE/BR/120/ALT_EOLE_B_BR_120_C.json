        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"In the dead of night, we must shine the brightest!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„In tiefster Nacht müssen wir am hellsten strahlen!“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« C'est au cœur de la nuit que nous devons briller le plus fort ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Nel cuore della notte, dobbiamo brillare più che mai!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡En lo más oscuro de la noche es cuando debemos brillar con más fuerza!!.",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HQH0VN8XSFMS1TEM79NV",
      "text": "\"In the dead of night, we must shine the brightest!\""
    }
  ],
