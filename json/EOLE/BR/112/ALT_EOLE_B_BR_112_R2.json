      },
      "translations": {
        "en_US": {
          "text": "\"I've found a way! A gap just two klicks away, straight ahead!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Ich hab einen Weg gefunden! Geradeaus ist eine Lücke, nur zwei Kilometer entfernt.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« J'ai trouvé un chemin ! Trouée à deux klicks d'ici, en azimut brutal ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Ho trovato una via! Un varco ad appena due chilometri da qui!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡He encontrado un camino! Hay una brecha a dos kilómetros de aquí, a las doce en punto».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HQ44Q9NMA7M2J6QCCR5P",
      "text": "\"I've found a way! A gap just two klicks away, straight ahead!\""
    }
