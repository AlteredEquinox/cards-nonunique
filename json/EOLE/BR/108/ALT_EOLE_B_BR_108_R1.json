                  },
                  "en_US": {
                    "text": "{R} You may target another Character. It loses [FLEETING] and gains 1 boost.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{R} Du darfst einen anderen Charakter wählen. Er verliert [FLEETING] und erhält 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{R} Puedes hacer objetivo a otro personaje. Pierde [FLEETING] y gana 1 potenciador.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{R} Puoi scegliere come bersaglio un altro personaggio. Perde [FLEETING] e ottiene 1 rinforzo.",
                    "locale": "it_IT"
