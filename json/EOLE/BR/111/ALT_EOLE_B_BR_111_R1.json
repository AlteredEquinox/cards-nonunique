      "translations": {
        "en_US": {
          "text": "\"I only feel alive when I'm on the very edge!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Ich fühl mich nur am Limit lebendig!“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Je ne me sens vivante qu'au bord du précipice ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Mi sento viva solo quando sono sul filo del rasoio!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Solo me siento viva cuando estoy al borde del precipicio».",
          "locale": "es_ES"
        }
