                "translations": {
                  "en_US": {
                    "text": "{H} I gain [FLEETING] unless you control a Feat. (If I would be sent to Reserve, discard me instead.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Je gagne [FLEETING], sauf si vous contrôlez une Prouesse. (Si je devais être envoyé en Réserve, défaussez-moi à la place.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{H} Ottengo [FLEETING] a meno che non controlli una Prodezza. (Se sto per finire nella Riserva, scartami invece.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} Gano [FLEETING] a menos que controles una proeza. (Si fuese a ir a la reserva, en vez de eso, descártame.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{H} Ich erhalte [FLEETING], es sei denn, du kontrollierst eine Heldentat. (Falls ich in die Reserve geschickt werden soll, lege mich stattdessen ab.)",
                    "locale": "de_DE"
                  }
                },
                "text": "{H} I gain [FLEETING] unless you control a Feat. (If I would be sent to Reserve, discard me instead.)"
