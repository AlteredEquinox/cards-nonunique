                ],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "{J} Du darfst eine Karte aus deiner Reserve in deine Manazone legen, erschöpft. #Falls du das tust, nutze [RESUPPLY_LOW].#",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "{J} Vous pouvez mettre une carte de votre Réserve dans votre zone de Mana, épuisée. #Si vous le faites, [RESUPPLY_LOW].#",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "{J} You may put a card from your Reserve in your Mana zone, exhausted. #If you do, [RESUPPLY_LOW].#",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{J} Puoi mettere una carta dalla tua Riserva nella tua area del mana, consumata. #Se lo fai, [RESUPPLY_LOW].#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Puedes colocar una carta de tu reserva en tu zona de maná, agotada. #Si lo haces, [RESUPPLY_LOW].#",
                    "locale": "es_ES"
                  }
                },
                "text": "{J} You may put a card from your Reserve in your Mana zone, exhausted. #If you do, [RESUPPLY_LOW].#"
              }
            ],
