                "translations": {
                  "en_US": {
                    "text": "[COMPLETED]: If one of your Expeditions would move forward during Dusk, you may exhaust me ({T}) to make it move forward one more region instead.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "[COMPLETED]: se una delle tue spedizioni sta per avanzare durante il crepuscolo, puoi consumarmi ({T}) per farla avanzare invece di una regione in più.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "[COMPLETED]: Si una de tus expediciones fuera a avanzar al anochecer, en vez de eso, puedes agotarme ({T}) para hacer que avance una región más.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "[COMPLETED] : Si l'une de vos Expéditions devait avancer pendant le Crépuscule, vous pouvez m'épuiser ({T}) pour l'avancer d'une région supplémentaire à la place.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "[COMPLETED]: Falls sich eine deiner Expeditionen am Abend vorwärts bewegt, darfst du mich erschöpfen ({T}), um sie noch eine Region vorwärts zu bewegen.",
                    "locale": "de_DE"
                  }
                },
                "text": "[COMPLETED]: If one of your Expeditions would move forward during Dusk, you may exhaust me ({T}) to make it move forward one more region instead."
