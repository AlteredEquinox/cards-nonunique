      "cardEffectDisplays": [
        {
          "cardElement": "\/card_elements\/01KJ5N5WBRHRZJT2X4Z61KVYVF",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "{H} Vous pouvez renvoyer un Personnage ciblé qui me fait face de Coût de Base {3} ou moins dans la main de son propriétaire. (Son Coût de Base est le Coût de Réserve s'il est Fugace, le Coût de Main sinon).",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "{H} You may return target Character facing me with Base Cost {3} or less to its owner's hand. (Its Base Cost is the Reserve Cost if it's Fleeting, or the Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst einen mir gegenüberstehenden Charakter deiner Wahl mit Basiskosten {3} oder weniger in die Hand seines Besitzers zurückschicken. (Seine Basiskosten sind die Reservekosten, falls er Vergänglich ist, oder die Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{H} Puedes devolver a la mano de su propietario un personaje objetivo enfrentado a mí con coste base de {3} o menos. (Su coste base es su coste desde la reserva si tiene fugacidad o, de lo contrario, el coste desde la mano.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{H} Puoi far tornare un personaggio bersaglio che mi affronta con costo base pari o inferiore a {3} in mano al suo proprietario. (Il suo costo base corrisponde al costo dalla Riserva se ha Fugace, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  }
                },
                "text": "{H} You may return target Character facing me with Base Cost {3} or less to its owner's hand. (Its Base Cost is the Reserve Cost if it's Fleeting, or the Hand Cost if not.)"
              }
            ],
            "reference": "02800"
          },
          "sequence": 0,
          "id": "01KJ5N5XXKG22FG423W7M18TY8"
        },
