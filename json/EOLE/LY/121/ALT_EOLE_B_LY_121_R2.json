        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "« S'il n'y a pas de fumée sans feu, avec nous, vous allez être servis ! »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"Where there's smoke, there's fire… and we're proof of that!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wo Rauch ist, ist Feuer … wir sind der Beweis!“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Dove c'è fumo c'è fuoco... e noi ne siamo la prova!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«No hay humo sin fuego. ¡Os lo vamos a demostrar!».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HRV3FERJ1T8WTDXEFMA7",
      "text": "\"Where there's smoke, there's fire… and we're proof of that!\""
    }
  ],
