                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When #a Character gains 1 or more boosts# — If I have no boosts, #I gain 1 boost.#",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un #Personnage gagne au moins 1 boost# — Si je n'ai pas de boost, #je gagne 1 boost.#",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Quando #un personaggio ottiene 1 o più rinforzi# — Se non ho rinforzi, #ottengo 1 rinforzo.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando #un personaje gane 1 potenciador o más# — Si no tengo potenciadores, #gano 1 potenciador.#",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn #ein Charakter mindestens 1 Verstärkung erhält# — Falls ich keine Verstärkungen habe, #erhalte ich 1 Verstärkung.#",
                    "locale": "de_DE"
                  }
                },
