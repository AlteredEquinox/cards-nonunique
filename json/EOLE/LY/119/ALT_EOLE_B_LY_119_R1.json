      "translations": {
        "en_US": {
          "text": "Even in the blackest night, it can see light.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Selbst in schwärzester Nacht sieht sie Licht.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Même dans la nuit la plus noire, il peut trouver la lumière.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Scorge la luce anche nella notte più buia.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Hasta en la noche más oscura puede hallar la luz.",
          "locale": "es_ES"
        }
