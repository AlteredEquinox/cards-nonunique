          "cardElement": "\/card_elements\/01KJ5NEB7SCWKVF1G4E93Y7QQ6",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [
                  {
                    "cardKeyword": {
                      "translations": {
                        "en_US": {
                          "displayWeb": "Fleeting",
                          "locale": "en_US",
                          "description": "Send me to Discard instead of Reserve after my effect resolves."
                        },
                        "de_DE": {
                          "displayWeb": "Vergänglich",
                          "locale": "de_DE",
                          "description": "Lege mich auf die Ablage statt in die Reserve, nachdem mein Effekt abgeklungen ist."
                        },
                        "it_IT": {
                          "displayWeb": "Fugace",
                          "locale": "it_IT",
                          "description": "Mandami negli Scarti invece che nella Riserva dopo che il mio effetto si è risolto."
                        },
                        "es_ES": {
                          "displayWeb": "Fugacidad",
                          "locale": "es_ES",
                          "description": "Una vez resuelto mi efecto, envíame a la pila de descartes en lugar de a la reserva."
                        },
                        "fr_FR": {
                          "displayWeb": "Fugace",
                          "locale": "fr_FR",
                          "description": "Envoyez-moi à la Défausse plutôt qu'en Réserve une fois mon effet résolu."
                        }
                      },
                      "id": "01HKAGPHBY4EPW8TR9VTCHZG5Q",
                      "reference": "FLEETING"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01KG7KNCQ208FQNDC6AWE7GNVP"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When you roll one or more dice — If I have no boosts, you may give me 1 boost and [FLEETING].",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando tires un dado o más — Si no tengo potenciadores, puedes darme 1 potenciador y [FLEETING].",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando tiri uno o più dadi — Se non ho rinforzi, puoi conferirmi 1 rinforzo e [FLEETING].",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous lancez au moins un dé — Si je n'ai aucun boost, vous pouvez me donner 1 boost et [FLEETING].",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du einen oder mehrere Würfel wirfst — Falls ich keine Verstärkungen habe, darfst du mir 1 Verstärkung und [FLEETING] geben.",
                    "locale": "de_DE"
                  }
                },
                "text": "When you roll one or more dice — If I have no boosts, you may give me 1 boost and [FLEETING]."
              }
            ],
