                  "de_DE": {
                    "text": "• 4+: Du darfst einen Charakter in deinen Expeditionen wählen. Er aktiviert seine {D} Fähigkeit.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "• 4+ : Vous pouvez cibler un Personnage dans vos Expéditions. Il active sa capacité {D}.",
                    "locale": "fr_FR"
