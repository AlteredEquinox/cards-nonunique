                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When you roll one or more dice — If the result is 6+, I gain 1 boost. If the result is 1, send me to Reserve.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "When you roll one or more dice — If the result is 6+, I gain 1 boost. If the result is 1, send me to Reserve.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Wenn du einen oder mehrere Würfel wirfst — Falls das Ergebnis 6+ ist, erhalte ich 1 Verstärkung. Falls das Ergebnis 1 ist, schicke mich in die Reserve.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando tires un dado o más — Si sacas 6+, gano 1 potenciador. Si sacas 1, envíame a la reserva.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous lancez au moins un dé — Si le résultat est 6+, je gagne 1 boost. Si le résultat est 1, envoyez-moi en Réserve.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When you roll one or more dice — If the result is 6+, I gain 1 boost. If the result is 1, send me to Reserve."
              }
            ],
