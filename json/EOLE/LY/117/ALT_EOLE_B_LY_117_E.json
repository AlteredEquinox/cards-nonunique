        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "« L'âme ne se rend pas au désespoir sans avoir épuisé toutes les illusions. » - Victor Hugo",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"The soul does not give itself up to despair until it has exhausted all illusions.\" – Victor Hugo",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Die Seele ergibt sich der Verzweiflung nicht, ehe sie nicht alle Illusionen erschöpft hat.“ — Victor Hugo",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"L'anima non si abbandona alla disperazione se non dopo aver esaurito tutte le illusioni.\" — Victor Hugo",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«El alma no se rinde a la desesperación sin antes haber agotado todas las ilusiones». —Victor Hugo",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HRHWCDF77P08QS2C1P32",
      "text": "\"The soul does not give itself up to despair until it has exhausted all illusions.\" – Victor Hugo"
    }
  ],
