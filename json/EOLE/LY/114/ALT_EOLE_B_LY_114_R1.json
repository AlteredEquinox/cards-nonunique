                  },
                  "fr_FR": {
                    "text": "#Lorsque vous passez — Vous pouvez me faire activer ma capacité {D}. Si vous le faites, je gagne [FLEETING_CHAR].#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "#Wenn du passt — Du darfst mich meine {D} Fähigkeit aktivieren lassen. Falls du das tust, erhalte ich [FLEETING_CHAR].#",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "#When you pass — You may have me activate my {D} ability. If you do, I gain [FLEETING_CHAR].#",
                    "locale": "en_US"
                  },
