          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Tira un dado. Puoi mandare nella Riserva un personaggio bersaglio con costo base pari o inferiore a {X}, dove X è il risultato. (Il costo base corrisponde al costo dalla Riserva se ha Fugace, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "Roll a die. You may send to Reserve target Character with Base Cost {X} or less, where X is the result. (Base Cost is the Reserve Cost if it's Fleeting, or the Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Tira un dado. Puedes enviar a la reserva un personaje objetivo con coste base de {X} o menos, donde X equivale al resultado. (Su coste base es su coste desde la reserva si tiene fugacidad o, de lo contrario, el coste desde la mano.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Würfle einmal. Du darfst einen Charakter deiner Wahl mit Basiskosten {X} oder weniger in die Reserve schicken, wobei X das Ergebnis ist. (Die Basiskosten sind die Reservekosten, falls er Vergänglich ist, oder die Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Lancez un dé. Vous pouvez envoyer en Réserve un Personnage ciblé de Coût de Base {X} ou moins, X étant le résultat. (Le Coût de Base est le Coût de Réserve s'il est Fugace, le Coût de Main sinon).",
                    "locale": "fr_FR"
                  }
                },
                "text": "Roll a die. You may send to Reserve target Character with Base Cost {X} or less, where X is the result. (Base Cost is the Reserve Cost if it's Fleeting, or the Hand Cost if not.)"
              }
            ],
            "reference": "02862"
          },
