          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [
                  {
                    "cardKeyword": {
                      "translations": {
                        "en_US": {
                          "displayWeb": "Fleeting",
                          "locale": "en_US",
                          "description": "Send me to Discard instead of Reserve after my effect resolves."
                        },
                        "de_DE": {
                          "displayWeb": "Vergänglich",
                          "locale": "de_DE",
                          "description": "Lege mich auf die Ablage statt in die Reserve, nachdem mein Effekt abgeklungen ist."
                        },
                        "it_IT": {
                          "displayWeb": "Fugace",
                          "locale": "it_IT",
                          "description": "Mandami negli Scarti invece che nella Riserva dopo che il mio effetto si è risolto."
                        },
                        "es_ES": {
                          "displayWeb": "Fugacidad",
                          "locale": "es_ES",
                          "description": "Una vez resuelto mi efecto, envíame a la pila de descartes en lugar de a la reserva."
                        },
                        "fr_FR": {
                          "displayWeb": "Fugace",
                          "locale": "fr_FR",
                          "description": "Envoyez-moi à la Défausse plutôt qu'en Réserve une fois mon effet résolu."
                        }
                      },
                      "id": "01HKAGPHBY4EPW8TR9VTCHZG5Q",
                      "reference": "FLEETING"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01KG7KN3HAV30D3TQ50QB9KBSK"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Roll a die. #On a 1-3, I gain [FLEETING].# Then, you may send to Reserve target Character with Base Cost {X} or less, where X is the result.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lancez un dé. #Sur 1-3, je gagne [FLEETING].# Puis, vous pouvez envoyer en Réserve un Personnage ciblé de Coût de Base {X} ou moins, X étant le résultat.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Tira un dado. #Si sacas 1-3, gano [FLEETING].# Luego, puedes enviar a la reserva un personaje objetivo con coste base de {X} o menos, donde X equivale al resultado.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Tira un dado. #Con 1-3, ottengo [FLEETING].# Poi, puoi mandare nella Riserva un personaggio bersaglio con costo base pari o inferiore a {X}, dove X è il risultato.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Würfle einmal. #Bei 1–3 erhalte ich [FLEETING].# Dann darfst du einen Charakter deiner Wahl mit Basiskosten {X} oder weniger in die Reserve schicken, wobei X das Ergebnis ist.",
                    "locale": "de_DE"
                  }
                },
                "text": "Roll a die. #On a 1-3, I gain [FLEETING].# Then, you may send to Reserve target Character with Base Cost {X} or less, where X is the result."
              }
