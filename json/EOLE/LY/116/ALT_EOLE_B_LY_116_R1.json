      },
      "translations": {
        "en_US": {
          "text": "\"Through drifting incense, we purge the darkness within.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Mit Weihrauch vertreiben wir die innere Dunkelheit.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Par la fumée de l'encens, nous purifions la noirceur intérieure. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Tra spire d'incenso, purifichiamo l'oscurità interiore.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Mediante el humo del incienso purificamos la oscuridad interior».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HRG289DNN0RFQ7RBDP3W",
      "text": "\"Through drifting incense, we purge the darkness within.\""
    }
