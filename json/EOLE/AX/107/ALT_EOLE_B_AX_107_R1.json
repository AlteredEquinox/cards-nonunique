                "translations": {
                  "fr_FR": {
                    "text": "#{H}# Vous pouvez mettre une carte de votre main en Réserve pour créer un jeton [AEROLITH] dans vos Repères.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "#{H}# You may put a card from your hand in Reserve to create an [AEROLITH] token in your Landmarks.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#{H}# Du darfst eine Karte aus deiner Hand in die Reserve legen, um eine [AEROLITH]-Marke in deinem Wahrzeichen-Bereich zu erschaffen.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#{H}# Puedes colocar una carta de tu mano en la reserva para crear una ficha de [AEROLITH] en tus hitos.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#{H}# Puoi mettere una carta dalla tua mano nella Riserva per creare una pedina [AEROLITH] nei tuoi fulcri.",
                    "locale": "it_IT"
                  }
                },
                "text": "#{H}# You may put a card from your hand in Reserve to create an [AEROLITH] token in your Landmarks."
