      },
      "translations": {
        "en_US": {
          "text": "Everything contains a need to grow, be it a grain of rice or human being.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Alles will wachsen, ein Reiskorn genauso wie ein Mensch.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Ogni cosa ha in sé il desiderio di crescere, che sia un chicco di riso o un essere umano.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "El deseo de crecer existe en todas las cosas, desde un grano de arroz hasta un ser humano.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "La soif de croître existe en toute chose, du grain de riz à l'être humain.",
          "locale": "fr_FR"
        }
      },
      "id": "01KC94HPJKDPATQXRX5CSQ9Y4R",
      "text": "Everything contains a need to grow, be it a grain of rice or human being."
