                  },
                  "en_US": {
                    "text": "When you pass — If your hand is empty, draw a card. #Otherwise, [RESUPPLY_LOW].#",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Quando passi — Se la tua mano è vuota, pesca una carta. #Altrimenti, [RESUPPLY_LOW].#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando pases — Si tu mano está vacía, roba una carta. #De lo contrario, [RESUPPLY_LOW].#",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn du passt — Falls deine Hand leer ist, ziehe eine Karte. #Andernfalls [RESUPPLY_LOW].#",
