                "translations": {
                  "de_DE": {
                    "text": "Zum Mittag — Falls du der Startspieler bist, erschaffe eine [AEROLITH]-Marke in deinem Wahrzeichen-Bereich.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "À Midi — Si vous êtes le premier joueur, créez un jeton [AEROLITH] dans vos Repères.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "At Noon — If you are first player, create an [AEROLITH] token in your Landmarks.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Si eres el primer jugador, crea una ficha de [AEROLITH] en tus hitos.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Se sei il primo giocatore, crea una pedina [AEROLITH] nei tuoi fulcri.",
                    "locale": "it_IT"
                  }
                },
                "text": "At Noon — If you are first player, create an [AEROLITH] token in your Landmarks."
