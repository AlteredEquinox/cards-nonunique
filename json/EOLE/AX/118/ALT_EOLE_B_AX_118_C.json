            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Send to Reserve target Character with Base Cost {3} or less. (Reserve Cost if it's Fleeting, Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Schicke einen Charakter deiner Wahl mit Basiskosten {3} oder weniger in die Reserve. (Reservekosten, falls Vergänglich, oder Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Envía a la reserva un personaje objetivo con coste base de {3} o menos. (Es el coste desde la reserva si tiene fugacidad o, de lo contrario, el coste desde la mano.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Envoyez en Réserve un Personnage ciblé de Coût de Base {3} ou moins. (Le Coût de Réserve s'il est Fugace, le Coût de Main s'il ne l'est pas.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Manda nella Riserva un personaggio bersaglio con costo base pari o inferiore a {3}. (Costo dalla Riserva se ha Fugace, altrimenti costo dalla mano.)",
                    "locale": "it_IT"
                  }
                },
                "text": "Send to Reserve target Character with Base Cost {3} or less. (Reserve Cost if it's Fleeting, Hand Cost if not.)"
              }
            ],
            "reference": "03008"
          },
          "sequence": 2,
          "id": "01KJ5MV8NJJCK31ZGNHAQGGWR9"
        }
