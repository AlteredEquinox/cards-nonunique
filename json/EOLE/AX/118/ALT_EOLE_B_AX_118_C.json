                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Jouez-moi pour {1} de moins s'il n'y a aucune autre carte dans votre main.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "Play me for {1} less if there are no other cards in your hand.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Giocami per {1} in meno se non ci sono altre carte nella tua mano.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Spiele mich für {1} weniger, falls keine anderen Karten in deiner Hand sind.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Juégame por {1} menos si no hay más cartas en tu mano.",
                    "locale": "es_ES"
                  }
                },
                "text": "Play me for {1} less if there are no other cards in your hand."
              }
            ],
