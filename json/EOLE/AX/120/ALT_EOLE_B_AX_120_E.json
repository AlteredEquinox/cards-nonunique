                ],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "{J} S'il n'y a pas de jetons dans vos Repères, créez-y un jeton [AEROLITH].",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "{J} If there are no tokens in your Landmarks, create an [AEROLITH] token there.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{J} Falls es keine Marken in deinem Wahrzeichen-Bereich gibt, erschaffe dort eine [AEROLITH]-Marke.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{J} Se non ci sono pedine nei tuoi fulcri, crea una pedina [AEROLITH] nei tuoi fulcri.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Si no hay fichas en tus hitos, crea una ficha de [AEROLITH] allí.",
                    "locale": "es_ES"
                  }
                },
                "text": "{J} If there are no tokens in your Landmarks, create an [AEROLITH] token there."
              }
            ],
            "reference": "02773"
          },
          "sequence": 0,
          "id": "01KJ5MWB07SB8KJ7PKGPJ9PA42"
        },
        {
          "cardElement": "\/card_elements\/01KJ5MW99RSMXZD19AF7PJCR17",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Lorsque vous passez — S'il y a au moins trois cartes dans vos Repères, accomplissez-moi.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When you pass — If three cards or more are in your Landmarks, complete me.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn du passt — Falls es mindestens drei Karten in deinem Wahrzeichen-Bereich gibt, vollbringe mich.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando passi — Se ci sono tre o più carte nei tuoi fulcri, eseguimi.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando pases — Si hay tres o más cartas en tus hitos, complétame.",
                    "locale": "es_ES"
                  }
                },
                "text": "When you pass — If three cards or more are in your Landmarks, complete me."
              }
            ],
            "reference": "02774"
          },
          "sequence": 1,
          "id": "01KJ5MWC0TYEP4S4EZ0RZCY6T3"
        }
      ],
      "value": "{J} If there are no tokens in your Landmarks, create an [Aerolith] token there.  When you pass — If three cards or more are in your Landmarks, complete me.",
