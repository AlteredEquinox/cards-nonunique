                  "fr_FR": {
                    "text": "[COMPLETED] : Lorsque vous sacrifiez un Permanent — Un Personnage ciblé non [BOOSTED] dans votre Réserve gagne 1 boost.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "[COMPLETED]: When you sacrifice a Permanent — Target non-[BOOSTED] Character in your Reserve gains 1 boost.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "[COMPLETED]: Wenn du eine Bleibende Karte opferst — Ein Charakter deiner Wahl in der Reserve, der nicht [BOOSTED] ist, erhält 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "[COMPLETED]: quando sacrifichi un permanente — Un personaggio bersaglio senza [BOOSTED] nella tua Riserva ottiene 1 rinforzo.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "[COMPLETED]: Cuando sacrifiques un permanente — Un personaje no [BOOSTED] objetivo en tu reserva gana 1 potenciador.",
