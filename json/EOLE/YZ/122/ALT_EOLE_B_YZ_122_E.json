      "translations": {
        "en_US": {
          "text": "\"Close the breach? I was just getting warmed up…\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Sceller la brèche ? Je commençais tout juste à m'échauffer... »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Die Bresche schließen? Ich bin gerade erst warm geworden …“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Chiudere la breccia? Ho appena iniziato a scaldarmi...\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¿Cerrar la brecha? Justo cuando empezaba a entrar en calor...».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94J019TRRVNWF5A4JSAQGE",
      "text": "\"Close the breach? I was just getting warmed up…\""
    }
