      "translations": {
        "fr_FR": {
          "text": "« Dieu des portes, il est temps de fermer le Voile. » — Sam",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Gott der Tore, zieh den Schleier zu.“ — Sam",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Dio dei cancelli, è il momento di chiudere il Velo.\" — Sam",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"God of gates, it is time to close the Veil.\" — Sam",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "«Dios de las puertas, es hora de cerrar el Velo». —Sam",
