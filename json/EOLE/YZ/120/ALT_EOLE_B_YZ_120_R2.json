                "translations": {
                  "en_US": {
                    "text": "#{J} If you control a [COMPLETED_LOW] Feat,# create a [MANA_MOTH] Illusion token in target Expedition. #Otherwise, I gain 1 boost.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#{J} Falls du eine Heldentat kontrollierst, die [COMPLETED_LOW] ist,# erschaffe eine [MANA_MOTH]-Illusionsmarke in einer Expedition deiner Wahl. #Andernfalls erhalte ich 1 Verstärkung.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "#{J} Se controlli una Prodezza [COMPLETED_LOW],# crea una pedina Illusione [MANA_MOTH] in una spedizione bersaglio. #Altrimenti, ottengo 1 rinforzo.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#{J} Si controlas una proeza [COMPLETED_LOW],# crea una ficha de ilusión [MANA_MOTH] en una expedición objetivo. #De lo contrario, gano 1 potenciador.#",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "#{J} Si vous contrôlez une Prouesse [COMPLETED_LOW],# créez un jeton Illusion [MANA_MOTH] dans une Expédition ciblée. #Sinon, je gagne 1 boost.#",
                    "locale": "fr_FR"
                  }
                },
