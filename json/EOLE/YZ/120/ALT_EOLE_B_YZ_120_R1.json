      "translations": {
        "en_US": {
          "text": "\"Need someone to slam the gate in their faces?\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Besoin de quelqu'un pour leur claquer la porte au nez ? »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Braucht ihr jemanden, der ihnen das Tor vor der Nase zuschlägt?“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Vi serve qualcuno che gli sbatta il cancello in faccia?\"",
          "locale": "it_IT"
