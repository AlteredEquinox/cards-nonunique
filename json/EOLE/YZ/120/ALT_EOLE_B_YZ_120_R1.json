                "translations": {
                  "en_US": {
                    "text": "#{J}# If six or more cards are in your discard pile, create a [MANA_MOTH] Illusion token in target Expedition. #Otherwise, I gain 1 boost.#",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "#{J}# S'il y a au moins six cartes dans votre défausse, créez un jeton Illusion [MANA_MOTH] dans une Expédition ciblée. #Sinon, je gagne 1 boost.#",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "#{J}# Si hay seis o más cartas en tu pila de descartes, crea una ficha de ilusión [MANA_MOTH] en una expedición objetivo. #De lo contrario, gano 1 potenciador.#",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#{J}# Se ci sono sei o più carte nella tua pila degli scarti, crea una pedina Illusione [MANA_MOTH] in una spedizione bersaglio. #Altrimenti, ottengo 1 rinforzo.#",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "#{J}# Falls sich mindestens sechs Karten auf deinem Ablagestapel befinden, erschaffe eine [MANA_MOTH]-Illusionsmarke in einer Expedition deiner Wahl. #Andernfalls erhalte ich 1 Verstärkung.#",
                    "locale": "de_DE"
                  }
                },
                "text": "#{J}# If six or more cards are in your discard pile, create a [MANA_MOTH] Illusion token in target Expedition. #Otherwise, I gain 1 boost.#"
