      },
      "translations": {
        "en_US": {
          "text": "\"By understanding the evil, we can pull it out at the root.\" — Zaj",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« C'est en comprenant le mal qu'on pourra l'arracher à la racine. » — Zaj",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Wer das Böse versteht, kann es an der Wurzel ausreißen.“ — Zaj",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Comprendendo il male, potremo estirparlo alla radice.\" — Zaj",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Al comprender el mal, podremos arrancarlo de raíz». —Zaj",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HZJ7KX7EDBD1NW3J0MFS",
      "text": "\"By understanding the evil, we can pull it out at the root.\" — Zaj"
