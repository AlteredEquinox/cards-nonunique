      },
      "translations": {
        "en_US": {
          "text": "\"Be careful, the Nightmare's darkness can taint any idea.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Vorsicht, die Dunkelheit eines Alptraums verdirbt jede Idee.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Fai attenzione: l'oscurità dell'Incubo può corrompere ogni idea.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Ten cuidado: la oscuridad de la Pesadilla es capaz de mancillar toda idea».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Prenez garde, la noirceur du Cauchemar peut souiller chaque idée. »",
          "locale": "fr_FR"
        }
      },
      "id": "01KC94HXDTXRT2Y26XA2C2J3MM",
      "text": "\"Be careful, the Nightmare's darkness can taint any idea.\""
    }
