          "id": "01KJ5QXE8TW3CWYNNQBREF7X1N"
        },
        {
          "cardElement": "\/card_elements\/01KJ5QXCJHT8X2SCMY1M769K81",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "« Lorsque vous défaussez une carte de votre main — Renvoyez-la dans votre Réserve. »",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "\"When you discard a card from your hand — Return it to your Reserve.\"",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "„Wenn du eine Karte aus deiner Hand ablegst — Lege sie in deine Reserve zurück.“",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "\"Quando scarti una carta dalla tua mano — Falla tornare nella tua Riserva.\"",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "\"Cuando descartes una carta de tu mano — Devuélvela a la reserva\".",
                    "locale": "es_ES"
                  }
                },
                "text": "\"When you discard a card from your hand — Return it to your Reserve.\""
              }
            ],
            "reference": "02738"
          },
