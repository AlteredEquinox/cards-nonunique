                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "As soon as six cards or more are in your discard pile, I permanently gain:",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Dès qu'il y a au moins six cartes dans votre défausse, je gagne de façon permanente :",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Sobald sich mindestens sechs Karten auf deinem Ablagestapel befinden, erhalte ich dauerhaft:",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Non appena ci sono sei o più carte nella tua pila degli scarti, ottengo in modo permanente:",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "En cuanto haya seis o más cartas en tu pila de descartes, gano permanentemente:",
                    "locale": "es_ES"
                  }
                },
                "text": "As soon as six cards or more are in your discard pile, I permanently gain:"
              }
            ],
            "reference": "03013"
          },
