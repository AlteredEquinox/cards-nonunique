                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{T}: pesca una carta, poi scarta una carta dalla tua mano. Puoi eseguire questa azione solo se sei il primo giocatore.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
