          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "As soon as six cards or more are in your discard pile, I permanently gain:",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Dès qu'il y a au moins six cartes dans votre défausse, je gagne de façon permanente :",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Sobald sich mindestens sechs Karten auf deinem Ablagestapel befinden, erhalte ich dauerhaft:",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Non appena ci sono sei o più carte nella tua pila degli scarti, ottengo in modo permanente:",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "En cuanto haya seis o más cartas en tu pila de descartes, gano permanentemente:",
                    "locale": "es_ES"
                  }
                },
                "text": "As soon as six cards or more are in your discard pile, I permanently gain:"
              }
            ],
            "reference": "03013"
          },
          "sequence": 1,
          "id": "01KJ5QZK2WACA4J4D1C39SAAAT"
        },
        {
          "cardElement": "\/card_elements\/01KJ5QZH06R9Z5W72YCBE26C6G",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "« Lorsque vous défaussez une carte de votre main — Renvoyez-la dans votre Réserve. »",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "\"When you discard a card from your hand — Return it to your Reserve.\"",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "„Wenn du eine Karte aus deiner Hand ablegst — Lege sie in deine Reserve zurück.“",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "\"Quando scarti una carta dalla tua mano — Falla tornare nella tua Riserva.\"",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "\"Cuando descartes una carta de tu mano — Devuélvela a la reserva\".",
                    "locale": "es_ES"
                  }
                },
                "text": "\"When you discard a card from your hand — Return it to your Reserve.\""
              }
            ],
            "reference": "02738"
          },
          "sequence": 2,
          "id": "01KJ5QZMCQ0M5M66H4JKJ0KCXH"
        }
      ],
