          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Discard a card from your hand. If you do, discard target card in play with Base Cost {3} or less. (Its Base Cost is the Reserve Cost if Fleeting, the Hand Cost otherwise.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Défaussez une carte de votre main. Si vous le faites, défaussez une carte ciblée en jeu de Coût de Base {3} ou moins. (Son Coût de Base est le Coût de Réserve si elle est Fugace, le Coût de Main sinon.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Lege eine Karte aus deiner Hand ab. Falls du das tust: Lege eine Karte deiner Wahl im Spiel mit Basiskosten {3} oder weniger ab. (Die Basiskosten sind die Reservekosten, falls Vergänglich, andernfalls die Handkosten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Scarta una carta dalla tua mano. Se lo fai, scarta una carta bersaglio in gioco con costo base pari o inferiore a {3}. (Il suo costo base corrisponde al costo dalla Riserva se ha Fugace, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Descarta una carta de tu mano. Si lo haces, descarta una carta objetivo en juego con coste base de {3} o menos. (Su coste base es su coste desde la reserva si tiene fugacidad o su coste desde la mano.)",
                    "locale": "es_ES"
                  }
                },
                "text": "Discard a card from your hand. If you do, discard target card in play with Base Cost {3} or less. (Its Base Cost is the Reserve Cost if Fleeting, the Hand Cost otherwise.)"
              }
            ],
            "reference": "03018"
          },
          "sequence": 1,
          "id": "01KJ5QJNRFB5ZVC8F81VGMCDEE"
        }
