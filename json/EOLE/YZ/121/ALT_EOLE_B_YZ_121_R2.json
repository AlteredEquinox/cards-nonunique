                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "At Noon — If six or more cards are in your discard pile, complete me.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Se ci sono sei o più carte nella tua pila degli scarti, eseguimi.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Si hay seis o más cartas en tu pila de descartes, complétame.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Falls sich mindestens sechs Karten auf deinem Ablagestapel befinden, vollbringe mich.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "À Midi — S'il y a au moins six cartes dans votre défausse, accomplissez-moi.",
                    "locale": "fr_FR"
                  }
                },
                "text": "At Noon — If six or more cards are in your discard pile, complete me."
