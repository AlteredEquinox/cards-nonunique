                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#{J} If six or more cards are in your discard pile, I gain 1 boost.# Otherwise, discard the top card of your deck.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#{J} Falls sich mindestens sechs Karten auf deinem Ablagestapel befinden, erhalte ich 1 Verstärkung.# Andernfalls lege die oberste Karte deines Decks ab.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#{J} Si hay seis o más cartas en tu pila de descartes, gano 1 potenciador.# De lo contrario, descarta la primera carta de tu mazo.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#{J} Se ci sono sei o più carte nella tua pila degli scarti, ottengo 1 rinforzo.# Altrimenti, scarta la prima carta del tuo mazzo.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "#{J} S'il y a au moins six cartes dans votre défausse, je gagne 1 boost.# Sinon, défaussez la première carte de votre deck.",
                    "locale": "fr_FR"
                  }
                },
                "text": "#{J} If six or more cards are in your discard pile, I gain 1 boost.# Otherwise, discard the top card of your deck."
              }
            ],
