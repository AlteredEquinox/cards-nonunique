      },
      "translations": {
        "fr_FR": {
          "text": "« L'Empyrée est saturé de Cauchemar. Il déborde. » — Baba Yaga",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"The Empyrean is flooded with Nightmare. It's spilling over.\" — Baba Yaga",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Das Empyreum ist vom Alptraum durchtränkt. Es läuft schon über.“ — Baba Jaga",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"L'Empireo è sommerso dall'Incubo. Sta traboccando.\" — Baba Yaga",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«El Empyreo está saturado por la Pesadilla. Se desborda». —Baba Yagá",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HYP84R883RH1KMQ5WVER",
      "text": "\"The Empyrean is flooded with Nightmare. It's spilling over.\" — Baba Yaga"
