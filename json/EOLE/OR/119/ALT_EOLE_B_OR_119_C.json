        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"Hold out for as long as possible. That's all that matters.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Haltet durch, solange ihr könnt. Um jeden Preis.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Resistere il più a lungo possibile. È tutto ciò che conta.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Aguantar todo lo posible: eso es lo único que importa».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Tenir, le plus longtemps possible. C'est tout ce qui compte. »",
          "locale": "fr_FR"
        }
      },
      "id": "01KC94HWEBNAZBE6T138KYQSDS",
      "text": "\"Hold out for as long as possible. That's all that matters.\""
    }
  ],
