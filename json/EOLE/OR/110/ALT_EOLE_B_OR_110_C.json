                "translations": {
                  "en_US": {
                    "text": "When my Expedition moves forward [DUE_TO_ASCENSION] (if it moved forward due to at least one matched stat) — Draw a card.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando mi expedición avance [DUE_TO_ASCENSION] (si avanzó debido al menos a una estadística igualada) — Roba una carta.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn sich meine Expedition [DUE_TO_ASCENSION] vorwärts bewegt (falls sie sich aufgrund von mindestens einer gleichen Statistik vorwärts bewegte) — Ziehe eine Karte.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Lorsque mon Expédition avance [DUE_TO_ASCENSION] (si elle a avancé grâce à au moins une statistique égale) — Piochez une carte.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Quando la mia spedizione avanza [DUE_TO_ASCENSION] (se è avanzata per via di almeno una statistica eguagliata) — Pesca una carta.",
                    "locale": "it_IT"
                  }
                },
                "text": "When my Expedition moves forward [DUE_TO_ASCENSION] (if it moved forward due to at least one matched stat) — Draw a card."
              }
