                "translations": {
                  "en_US": {
                    "text": "Send to Reserve target Character with Base Cost {3} or less. Then, if both of your Expeditions are [ASCENDED_P], [RESUPPLY_LOW].",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Manda nella Riserva un personaggio bersaglio con costo base pari o inferiore a {3}. Poi, se entrambe le tue spedizioni sono [ASCENDED_P], [RESUPPLY_LOW].",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Schicke einen Charakter deiner Wahl mit Basiskosten {3} oder weniger in die Reserve. Dann, falls beide deiner Expeditionen [ASCENDED_P] sind, nutze [RESUPPLY_LOW].",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Envoyez en Réserve un Personnage ciblé de Coût de Base {3} ou moins. Puis, si vos deux Expéditions sont [ASCENDED_P], [RESUPPLY_LOW].",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Envía a la reserva un personaje objetivo con coste base de {3} o menos. Luego, si tus dos expediciones están [ASCENDED_P], [RESUPPLY_LOW].",
                    "locale": "es_ES"
                  }
                },
