                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When I leave the Expedition zone — My Expedition [ASCENDS]. (If I leave at Rest, it stays Ascended for the next Day.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je quitte la zone d'Expédition — Mon Expédition [ASCENDS]. (Si je la quitte au Repos, elle reste Élevée le Jour suivant.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ich die Expeditionszone verlasse — Meine Expedition ist [ASCENDS]. (Falls ich sie in der Ruhepause verlasse, bleibt sie für den nächsten Tag Aufgestiegen.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando lascio l'area delle spedizioni — La mia spedizione [ASCENDS]. (Se la lascio durante il riposo, resta Ascesa per la prossima giornata.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando abandone la zona de expedición — Mi expedición [ASCENDS]. (Si la abandono durante el descanso, queda ascendida para el siguiente día.)",
                    "locale": "es_ES"
                  }
                },
                "text": "When I leave the Expedition zone — My Expedition [ASCENDS]. (If I leave at Rest, it stays Ascended for the next Day.)"
              }
            ],
