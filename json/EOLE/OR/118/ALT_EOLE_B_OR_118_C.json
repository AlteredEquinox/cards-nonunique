                  "en_US": {
                    "text": "• Target up to two Expeditions and create an [ORDIS_RECRUIT] Soldier token in each of them.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "• Wähle bis zu zwei Expeditionen und erschaffe eine [ORDIS_RECRUIT]-Soldatenmarke in jeder von ihnen.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "• Ciblez jusqu'à deux Expéditions et créez un jeton Soldat [ORDIS_RECRUIT] dans chacune d'elles.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "• Scegli come bersaglio fino a due spedizioni e crea una pedina Soldato [ORDIS_RECRUIT] in ciascuna di esse.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "• Haz objetivo a hasta dos expediciones y crea una ficha de soldado [ORDIS_RECRUIT] en cada una de ellas.",
