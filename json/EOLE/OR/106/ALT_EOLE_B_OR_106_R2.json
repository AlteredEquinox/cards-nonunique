        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "« Allez, en selle ! Il va falloir voler en formation serrée si on veut évacuer le plus de monde possible ! »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"Come on, saddle up! We need to fly in tight formation to evacuate as many as possible!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Los, sattel auf! Wir müssen dicht fliegen, um so viele zu evakuieren wie möglich!“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Forza, in sella! Dobbiamo volare in formazione compatta per evacuare quante più persone!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡Vamos, a montar! ¡Tendremos que volar en formación cerrada si queremos evacuar al mayor número de personas posible!».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HTYPTF3FJSXTT2XS2C9S",
      "text": "\"Come on, saddle up! We need to fly in tight formation to evacuate as many as possible!\""
    }
  ],
