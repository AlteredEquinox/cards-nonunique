      },
      "translations": {
        "en_US": {
          "text": "Those who stand without honor will fall without wings",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wer ohne Ehre dasteht, wird ohne Flügel fallen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Chi cammina senza onore cadrà senza ali.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Aquellos sin honor caerán sin alas.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "À s'élever sans honneur, on a vite fait d'y perdre des plumes.",
          "locale": "fr_FR"
        }
      },
      "id": "01KC94HX44RE3RXKZE8BK81BSA",
      "text": "Those who stand without honor will fall without wings"
