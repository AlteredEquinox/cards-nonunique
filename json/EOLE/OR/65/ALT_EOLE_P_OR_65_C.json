                "translations": {
                  "en_US": {
                    "text": "When one or more of your [ASCENDED_Z] Expeditions moves forward — If there's no Character facing it, draw a card.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Quando una o più delle tue spedizioni [ASCENDED_Z] avanzano — Se non ci sono personaggi che le affrontano, pesca una carta.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Wenn sich mindestens eine deiner [ASCENDED_Z] Expeditionen vorwärts bewegt — Falls es ihr gegenüber keinen Charakter gibt, ziehe eine Karte.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'au moins une de vos Expéditions [ASCENDED_Z] avance — S'il n'y a aucun Personnage qui lui fait face, piochez une carte.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Cuando una o más de tus expediciones [ASCENDED_Z] avancen — Si no hay ningún personaje enfrentado a ellas, roba una carta.",
                    "locale": "es_ES"
                  }
                },
                "text": "When one or more of your [ASCENDED_Z] Expeditions moves forward — If there's no Character facing it, draw a card."
              }
