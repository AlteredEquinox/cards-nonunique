                  "en_US": {
                    "text": "{H} You may discard target Character with Base Cost {2} or less. If you do, create an [ORDIS_RECRUIT] Soldier token in its Expedition.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez défausser un Personnage ciblé de Coût de Base {2} ou moins. Si vous le faites, créez un jeton Soldat [ORDIS_RECRUIT] dans son Expédition.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst einen Charakter deiner Wahl mit Basiskosten {2} oder weniger ablegen. Falls du das tust, erschaffe eine [ORDIS_RECRUIT]-Soldatenmarke in seiner Expedition.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{H} Puedes descartar un personaje objetivo con coste base de {2} o menos. Si lo haces, crea una ficha de soldado [ORDIS_RECRUIT] en su expedición.",
