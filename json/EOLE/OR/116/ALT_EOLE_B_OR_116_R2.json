                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez défausser un Personnage ciblé de Coût de Base #{1} ou moins.# Si vous le faites, créez un jeton #Animal [WOOLLYBACK]# dans son Expédition.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
