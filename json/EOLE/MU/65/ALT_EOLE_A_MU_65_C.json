                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "At Noon — If you are first player, create a [WOOLLYBACK] Animal token in target opponent's Companion Expedition, then draw a card.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Falls du der Startspieler bist, erschaffe eine [WOOLLYBACK]-Tiermarke in der Gefährten-Expedition eines Gegners deiner Wahl, ziehe dann eine Karte.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "À Midi — Si vous êtes le premier joueur, créez un jeton Animal [WOOLLYBACK] dans l'Expédition Compagnon d'un adversaire ciblé, puis piochez une carte.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Se sei il primo giocatore, crea una pedina Animale [WOOLLYBACK] nella spedizione del compagno di un avversario bersaglio, poi pesca una carta.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Si eres el primer jugador, crea una ficha de animal [WOOLLYBACK] en la expedición del compañero del oponente objetivo y luego roba una carta.",
                    "locale": "es_ES"
                  }
                },
                "text": "At Noon — If you are first player, create a [WOOLLYBACK] Animal token in target opponent's Companion Expedition, then draw a card."
              }
            ],
