      },
      "translations": {
        "en_US": {
          "text": "\"Come to me, Dawon, that I might summon the spirit of Durga!\" — Parvati",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Viens à moi, Dawon, que je convoque l'aspect de Durga ! » — Parvati",
          "locale": "fr_FR"
        },
        "es_ES": {
          "text": "«¡Ven a mí, Dawon, para que invoque el espíritu de Durga!». —Parvati",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Komm zu mir, Dawon, auf dass ich Durgas Geist rufe!“ — Parvati",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Vieni a me, Dawon, affinché io possa evocare lo spirito di Durga!\" — Parvati",
          "locale": "it_IT"
        }
      },
      "id": "01KC94HSFX4HMHC9Q4HSHM1V2V",
