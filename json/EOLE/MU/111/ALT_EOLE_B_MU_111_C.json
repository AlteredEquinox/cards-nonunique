                "translations": {
                  "en_US": {
                    "text": "{H} You may target another Character with {V} less than or equal to mine. It gains [ANCHORED]. (During Rest, it doesn't go to Reserve and it loses Anchored.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez cibler un autre Personnage avec une statistique {V} inférieure ou égale à la mienne. Il gagne [ANCHORED]. (Au Repos, il ne va pas en Réserve et il perd Ancré.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst einen anderen Charakter wählen, dessen {V} gleich oder niedriger als meines ist. Er erhält [ANCHORED]. (Während der Ruhepause geht er nicht in die Reserve und verliert Verankert.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Puoi scegliere come bersaglio un altro personaggio con {V} pari o inferiore alla mia. Ottiene [ANCHORED]. (Durante il riposo, non va nella Riserva e perde Ancorato.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} Puedes hacer objetivo a otro personaje con {V} menor o igual que el mío. Gana [ANCHORED]. (Durante el descanso, no va a la reserva y pierde anclaje.)",
                    "locale": "es_ES"
                  }
                },
