                  },
                  "de_DE": {
                    "text": "{H} Du darfst einen anderen Charakter wählen, dessen {V} gleich oder niedriger als meines ist. Er erhält [ANCHORED].",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{H} Puedes hacer objetivo a otro personaje con {V} menor o igual que el mío. Gana [ANCHORED].",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez cibler un autre Personnage avec une statistique {V} inférieure ou égale à la mienne. Il gagne [ANCHORED].",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{H} Puoi scegliere come bersaglio un altro personaggio con {V} pari o inferiore alla mia. Ottiene [ANCHORED].",
