      },
      "translations": {
        "de_DE": {
          "text": "„Raaawr! Das ganze Rudel hält zur Menschheit, denn der Wolf wird von allen gefürchtet!“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Graouuu ! Toute la meute viendra en aide aux humains, car tous craignent le loup ! »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"Graaawr! The whole pack will stand with humankind, for the wolf is feared by all!\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Roaaar! L'intero branco si schiererà con l'umanità, perché il lupo è temuto da tutti!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡Grrr! Toda la manada vendrá en ayuda de los humanos, pues todos temen al lobo».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HS38JGXZDD3G55C54HWJ",
      "text": "\"Graaawr! The whole pack will stand with humankind, for the wolf is feared by all!\""
