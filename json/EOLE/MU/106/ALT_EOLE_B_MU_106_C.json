                "translations": {
                  "en_US": {
                    "text": "{J} Create a [WOOLLYBACK] Animal token in the Expedition facing me. It gains [ANCHORED]. (During Rest, it doesn't go to Reserve and it loses Anchored.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{J} Erschaffe eine [WOOLLYBACK]-Tiermarke in der mir gegenüberstehenden Expedition. Sie erhält [ANCHORED]. (Während der Ruhepause geht sie nicht in die Reserve und verliert Verankert.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{J} Crea una pedina Animale [WOOLLYBACK] nella spedizione che mi affronta. Ottiene [ANCHORED]. (Durante il riposo, non va nella Riserva e perde Ancorato.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Crea una ficha de animal [WOOLLYBACK] en la expedición enfrentada a mí. Gana [ANCHORED]. (Durante el descanso, no va a la reserva y pierde anclaje.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{J} Créez un jeton Animal [WOOLLYBACK] dans l'Expédition qui me fait face. Il gagne [ANCHORED]. (Au Repos, il ne va pas en Réserve et il perd Ancré.)",
                    "locale": "fr_FR"
                  }
                },
