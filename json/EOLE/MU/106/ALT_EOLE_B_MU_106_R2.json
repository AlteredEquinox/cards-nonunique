      },
      "translations": {
        "fr_FR": {
          "text": "« Allez, Bouloche, veille sur eux. Amène-les à papa ! »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"Come on, Bobble, watch over them. Bring them to daddy!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Los, Wuschel, pass auf sie auf. Bring sie zu Papa!“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Forza, Bioccolo, tienile d'occhio. Portale dal papà!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡Venga, Peluso, cuídamelas! ¡Tráelas con papá!».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HS0CNPZXQK0YFKBYQXHS",
