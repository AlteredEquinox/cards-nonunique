                "translations": {
                  "en_US": {
                    "text": "Target Character you control gains 1 boost. Then, target another Character with equal or lower {V} and send it to Reserve.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Ein Charakter deiner Wahl, den du kontrollierst, erhält 1 Verstärkung. Wähle dann einen anderen Charakter mit gleichem oder niedrigerem {V} und schicke ihn in die Reserve.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Un personaggio bersaglio che controlli ottiene 1 rinforzo. Poi, scegli come bersaglio un altro personaggio con {V} pari o inferiore e mandalo nella Riserva.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Un personaje objetivo que controles gana 1 potenciador. Luego, haz objetivo a otro personaje con {V} menor o igual y envíalo a la reserva.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Un Personnage ciblé que vous contrôlez gagne 1 boost. Puis, ciblez un autre Personnage avec une statistique {V} inférieure ou égale et envoyez-le en Réserve.",
                    "locale": "fr_FR"
                  }
                },
                "text": "Target Character you control gains 1 boost. Then, target another Character with equal or lower {V} and send it to Reserve."
