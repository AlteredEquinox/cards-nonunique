                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When you pass — If three or more Animals in your Expeditions have a different {V} stat, complete me.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous passez — Si au moins trois Animaux dans vos Expéditions ont une statistique {V} différente, accomplissez-moi.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du passt — Falls mindestens drei Tiere in deinen Expeditionen verschiedene Statistiken in {V} haben, vollbringe mich.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando passi — Se tre o più Animali nelle tue spedizioni hanno una statistica {V} diversa, eseguimi.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando pases — Si tres o más animales en tus expediciones tienen una estadística de {V} diferente, complétame.",
                    "locale": "es_ES"
                  }
                },
                "text": "When you pass — If three or more Animals in your Expeditions have a different {V} stat, complete me."
              }
