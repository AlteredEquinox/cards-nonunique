                  "en_US": {
                    "text": "{H} [SABOTAGE] a Character with {V} less than or equal to mine. (You may discard one such target from any Reserve.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} [SABOTAGE] un Personnage avec une statistique {V} inférieure ou égale à la mienne. (Vous pouvez défausser une telle cible de n'importe quelle Réserve.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{H} Nutze [SABOTAGE] bei einem Charakter, dessen {V} gleich oder niedriger als meines ist. (Du darfst eine solche Karte aus einer beliebigen Reserve ablegen.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{H} [SABOTAGE] un personaje con {V} menor o igual que el mío. (Puedes descartar una carta como esa de cualquier reserva.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{H} [SABOTAGE] un personaggio con {V} pari o inferiore alla mia. (Puoi scartare una carta di questo tipo da qualsiasi Riserva.)",
