                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#{J}# #Create a [WOOLLYBACK] Animal token in another Expedition.# Then, if I'm facing one or more Characters, target one of them and we both gain [ANCHORED].",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "#{J}# #Crea una pedina Animale [WOOLLYBACK] in un'altra spedizione.# Poi, se sto affrontando uno o più personaggi, scegline uno come bersaglio e otteniamo entrambi [ANCHORED].",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#{J}# #Crea una ficha de animal [WOOLLYBACK] en otra expedición.# Luego, si hay uno o más personajes enfrentados a mí, haz objetivo a uno de ellos y ambos ganamos [ANCHORED].",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "#{J}# #Erschaffe eine [WOOLLYBACK]-Tiermarke in einer anderen Expedition.# Dann, falls ich einem oder mehr Charakteren gegenüberstehe, wähle einen davon und wir beide erhalten [ANCHORED].",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "#{J}# #Créez un jeton Animal [WOOLLYBACK] dans une autre Expédition.# Puis, si je suis face à au moins un Personnage, ciblez l'un d'eux et nous gagnons tous les deux [ANCHORED].",
                    "locale": "fr_FR"
                  }
                },
                "text": "#{J}# #Create a [WOOLLYBACK] Animal token in another Expedition.# Then, if I'm facing one or more Characters, target one of them and we both gain [ANCHORED]."
              }
