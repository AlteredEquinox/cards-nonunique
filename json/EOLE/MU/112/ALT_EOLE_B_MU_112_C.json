                  },
                  "de_DE": {
                    "text": "Wenn ein Tier sich deinen Expeditionen anschließt — Ich erhalte 1 Verstärkung, bis maximal 2 Verstärkungen auf mir.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando un animal se incorpore a tus expediciones — Gano 1 potenciador, hasta un máximo de 2.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando un Animale si unisce alle tue spedizioni — Ottengo 1 rinforzo, fino a un massimo di 2.",
