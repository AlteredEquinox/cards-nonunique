                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "{J} Target Character with Base Cost {3} or less gains [ANCHORED]. (Its Base Cost is the Reserve Cost if Fleeting, or the Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{J} Un Personnage ciblé de Coût de Base {3} ou moins gagne [ANCHORED]. (Son Coût de Base est le Coût de Réserve s'il est Fugace, le Coût de Main sinon).",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{J} Ein Charakter deiner Wahl mit Basiskosten {3} oder weniger erhält [ANCHORED]. (Die Basiskosten sind die Reservekosten, falls Vergänglich, oder die Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{J} Un personaggio bersaglio con costo base pari o inferiore a {3} ottiene [ANCHORED]. (Il suo costo base corrisponde al costo dalla Riserva se ha Fugace, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Un personaje objetivo con coste base de {3} o menos gana [ANCHORED]. (Su coste base es su coste desde la reserva si tiene fugacidad o su coste desde la mano.)",
                    "locale": "es_ES"
                  }
                },
                "text": "{J} Target Character with Base Cost {3} or less gains [ANCHORED]. (Its Base Cost is the Reserve Cost if Fleeting, or the Hand Cost if not.)"
              }
