      },
      "translations": {
        "fr_FR": {
          "text": "« Le petit d'homme est mien ! Il vivra pour courir avec le clan, et pour chasser avec le clan ! »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"The little one is mine! He shall live to run with the pack and to hunt with the pack!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Der Kleine gehört mir! Er wird mit dem Rudel laufen und mit dem Rudel jagen!“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Il piccoletto è mio! Vivrà per correre con il branco e per cacciare con il branco!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡El pequeño es mío! ¡Vivirá para correr y cazar con la manada!».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HSCBMS2YT6JTC5XWAPW0",
      "text": "\"The little one is mine! He shall live to run with the pack and to hunt with the pack!\""
