                    "text": "{H} I gain [FLEETING] unless #six or more cards are in your discard pile.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{H} Ich erhalte [FLEETING], es sei denn, es befinden sich #mindestens sechs Karten auf deinem Ablagestapel.#",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Ottengo [FLEETING] a meno che #non ci siano sei o più carte nella tua pila degli scarti.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} Gano [FLEETING] a menos que haya #seis o más cartas en tu pila de descartes.#",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{H} Je gagne [FLEETING], sauf s'il y a #au moins six cartes dans votre défausse.#",
