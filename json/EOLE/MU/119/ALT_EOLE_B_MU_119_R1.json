          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Reveal the top five cards of your deck. Choose Animals from them with total Hand Cost {7} or less and play them for free #as if from hand.# Discard the rest.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Revela las cinco primeras cartas de tu mazo. Elige de entre ellas animales con un coste desde la mano total de {7} o menos y juégalas sin coste #como si fuera desde la mano.# Descarta el resto.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Révélez les cinq premières cartes de votre deck. Choisissez parmi elles des Animaux avec un Coût de Main total de {7} ou moins et jouez-les gratuitement #comme si elles venaient de votre main.# Défaussez le reste.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Decke die obersten fünf Karten deines Decks auf. Wähle aus ihnen Tiere mit Gesamt-Handkosten von {7} oder weniger aus und spiele sie kostenlos #wie von der Hand.# Lege den Rest ab.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Rivela le prime cinque carte del tuo mazzo. Tra queste, scegli Animali con un costo dalla mano totale pari o inferiore a {7} e giocali senza pagarne il costo, #come se li giocassi dalla mano.# Scarta le altre carte.",
                    "locale": "it_IT"
                  }
                },
                "text": "Reveal the top five cards of your deck. Choose Animals from them with total Hand Cost {7} or less and play them for free #as if from hand.# Discard the rest."
              }
            ],
            "reference": "02907"
          },
          "sequence": 1,
          "id": "01KJ5PEC3DRDWQF6E460SP9QD2"
        }
      ],
