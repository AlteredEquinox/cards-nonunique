                "translations": {
                  "es_ES": {
                    "text": "{R} [RESUPPLY] y luego crea una ficha de [MANASEED] en los hitos del oponente objetivo. (Es un permanente con «{T}, sacrifícame: Prepara un orbe de maná».)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{R} [RESUPPLY], then create a [MANASEED] token in target opponent's Landmarks. (It's a Permanent with \"{T}, Sacrifice me: Ready a Mana Orb.\")",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{R} [RESUPPLY], puis créez un jeton [MANASEED] dans les Repères d'un adversaire ciblé. (C'est un Permanent avec « {T}, Sacrifiez-moi : Redressez un Orbe de Mana. »)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{R} Nutze [RESUPPLY], dann erschaffe eine [MANASEED]-Marke im Wahrzeichen-Bereich eines Gegners deiner Wahl. (Sie ist eine Bleibende Karte mit „{T}, Opfere mich: Stelle eine Manakugel bereit.“)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{R} [RESUPPLY], poi crea una pedina [MANASEED] nei fulcri di un avversario bersaglio. (È un permanente con \"{T}, sacrificami: ripristina una sfera di mana\".)",
                    "locale": "it_IT"
                  }
                },
