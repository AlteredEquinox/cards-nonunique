                  "en_US": {
                    "text": "{D} : Create a [MANASEED] token in each player's Landmarks. (It's a Permanent with \"{T}, Sacrifice me: Ready a Mana Orb.\")",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{D} : Créez un jeton [MANASEED] dans les Repères de chaque joueur. (C'est un Permanent avec « {T}, Sacrifiez-moi : redressez un Orbe de Mana. »)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{D}: crea una pedina [MANASEED] nei fulcri di ogni giocatore. (È un permanente con \"{T}, sacrificami: ripristina una sfera di mana\".)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "{D} : Erschaffe eine [MANASEED]-Marke im Wahrzeichen-Bereich jedes Spielers. (Sie ist eine Bleibende Karte mit „{T}, Opfere mich: Stelle eine Manakugel bereit.“)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{D}: Crea una ficha de [MANASEED] en los hitos de cada jugador. (Es un permanente con «{T}, sacrifícame: Prepara un orbe de maná».)",
                    "locale": "es_ES"
                  }
                },
