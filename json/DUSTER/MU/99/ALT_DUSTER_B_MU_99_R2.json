                "translations": {
                  "en_US": {
                    "text": "Create a [MANASEED] token in target opponent's Landmarks.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Créez un jeton [MANASEED] dans les Repères d'un adversaire ciblé.",
                    "locale": "fr_FR"
