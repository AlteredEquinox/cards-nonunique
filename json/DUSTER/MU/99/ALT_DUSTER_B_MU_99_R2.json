          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Then, #discard# target Character they control with Base Cost {3} or less. (Its Base Cost is the Reserve Cost if it's Fleeting, or the Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Dann #lege# einen Charakter deiner Wahl mit Basiskosten {3} oder weniger, den er kontrolliert, #ab.# (Basiskosten sind Reservekosten, falls er Vergänglich ist, oder Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Poi, #scarta# un personaggio bersaglio che controlla con costo base pari o inferiore a {3}. (Il suo costo base corrisponde al costo dalla Riserva se ha Fugace, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Puis, #défaussez# un Personnage ciblé qu'il contrôle de Coût de Base {3} ou moins. (Son Coût de Base est le Coût de Réserve s'il est Fugace, le Coût de Main sinon.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Luego, #descarta# un personaje objetivo que controle con coste base de {3} o menos. (Su coste base es su coste desde la reserva si tiene fugacidad o su coste desde la mano.)",
                    "locale": "es_ES"
                  }
                },
                "text": "Then, #discard# target Character they control with Base Cost {3} or less. (Its Base Cost is the Reserve Cost if it's Fleeting, or the Hand Cost if not.)"
              }
            ],
            "reference": "02066"
          },
          "sequence": 2,
          "id": "01K6X4H5JFHZ2566JZC5KRCAAV"
        }
