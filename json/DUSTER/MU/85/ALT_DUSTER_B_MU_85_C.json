                ],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Cuando hagas un [GIFT] — Puedes agotarme ({T}) para recibirlo también. (Un Regalo ocurre si, durante tu turno, un oponente roba una carta, se reabastece o recibe una ficha.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When you make a [GIFT] — You may exhaust me ({T}) to also receive it. (A Gift is when on your turn, an opponent draws a card, Resupplies or receives a token.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous faites un [GIFT] — Vous pouvez m'épuiser ({T}) pour le recevoir aussi. (Vous faites un Don si durant votre tour, un adversaire pioche une carte, Ravitaille ou reçoit un jeton.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du ein [GIFT] gibst — Du darfst mich erschöpfen ({T}), um es auch zu erhalten. (Ein Geschenk entsteht, wenn ein Gegner während deines Zuges eine Karte zieht, Nachschub nutzt oder eine Marke erhält.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando fai un [GIFT] — Puoi consumarmi ({T}) per riceverlo anche tu. (Un Regalo avviene se, durante il tuo turno, l’avversario pesca una carta, si Rifornisce o riceve una pedina.)",
                    "locale": "it_IT"
                  }
                },
                "text": "When you make a [GIFT] — You may exhaust me ({T}) to also receive it. (A Gift is when on your turn, an opponent draws a card, Resupplies or receives a token.)"
              }
            ],
