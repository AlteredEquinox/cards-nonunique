      },
      "translations": {
        "en_US": {
          "text": "Bringing a fruit of the Spindle Tree to the Reka is a way for me to recapture my youth.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Apporter un fruit du Fuseau aux Reka est l'occasion pour moi de retrouver une seconde jeunesse.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Indem ich eine Frucht der Spindel zu den Reka bringe, erlebe ich einen zweiten Frühling.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Portare ai Reka un frutto del Fuso è il mio modo di ritrovare la giovinezza.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Llevar un fruto del Balaustre a los Reka es para mí una forma de vivir una segunda juventud.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZHDK33EFEKM7909CTP75",
      "text": "Bringing a fruit of the Spindle Tree to the Reka is a way for me to recapture my youth."
    }
