                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Lorsque vous faites un [GIFT] — Si je n'ai pas de boost, je gagne 1 boost. (Vous faites un Don si durant votre tour, un adversaire pioche une carte, Ravitaille ou reçoit un jeton.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Cuando hagas un [GIFT] — Si no tengo potenciadores, gano 1 potenciador. (Un Regalo ocurre si, durante tu turno, un oponente roba una carta, se reabastece o recibe una ficha.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn du ein [GIFT] gibst — Falls ich keine Verstärkungen habe, erhalte ich 1 Verstärkung. (Ein Geschenk entsteht, wenn ein Gegner während deines Zuges eine Karte zieht, Nachschub nutzt oder eine Marke erhält.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando fai un [GIFT] — Se non ho rinforzi, ottengo 1 rinforzo. (Un Regalo avviene se, durante il tuo turno, un avversario pesca una carta, Rifornisce o riceve una pedina.)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When you make a [GIFT] — If I have no boosts, I gain 1 boost. (A Gift is when on your turn, an opponent draws a card, Resupplies or receives a token.)",
                    "locale": "en_US"
                  }
                },
                "text": "When you make a [GIFT] — If I have no boosts, I gain 1 boost. (A Gift is when on your turn, an opponent draws a card, Resupplies or receives a token.)"
              }
            ],
