      "translations": {
        "en_US": {
          "text": "If the Juice gives life, then it must take it from somewhere.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Si le Suc rend la vie, il la puise forcément ailleurs.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Wenn der Saft Leben gibt, muss er es irgendwoher nehmen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Se il succo dà vita, da qualche parte deve pur prenderla.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Si el Jugo da la vida, de algún lugar la tiene que sacar.",
          "locale": "es_ES"
