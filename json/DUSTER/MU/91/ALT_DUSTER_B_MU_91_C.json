                "translations": {
                  "es_ES": {
                    "text": "{H} Crea una ficha de [MANASEED] en los hitos de un oponente objetivo. (Es un permanente con «{T}, sacrifícame: Prepara un orbe de maná».)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{H} Create a [MANASEED] token in target opponent's Landmarks. (It's a Permanent with \"{T}, Sacrifice me: Ready a Mana Orb.\")",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Créez un jeton [MANASEED] dans les Repères d'un adversaire ciblé. (C'est un Permanent avec « {T}, Sacrifiez-moi : redressez un Orbe de Mana. »)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{H} Erschaffe eine [MANASEED]-Marke im Wahrzeichen-Bereich eines Gegners deiner Wahl. (Sie ist eine Bleibende Karte mit „{T}, Opfere mich: Stelle eine Manakugel bereit.“)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Crea una pedina [MANASEED] nei fulcri di un avversario bersaglio. (È un permanente con \"{T}, sacrificami: ripristina una sfera di mana\".)",
                    "locale": "it_IT"
                  }
                },
