      },
      "translations": {
        "en_US": {
          "text": "\"By crossing the fruits of the two world trees, we could obtain a fertile specimen.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wenn wir die Früchte der beiden Weltenbäume kreuzen, könnten wir einen lebensfähigen Sprössling erhalten.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Incrociando i frutti dei due alberi del mondo, potremmo ottenere un esemplare fertile.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Al cruzar los frutos de los dos árboles del mundo, podríamos obtener un espécimen fértil».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« En croisant les fruits des deux arbres-mondes, on pourrait obtenir un spécimen fertile. »",
          "locale": "fr_FR"
        }
      },
      "id": "01JZ37ZQ2G0Q5VNKQ8NRCAB9R9",
      "text": "\"By crossing the fruits of the two world trees, we could obtain a fertile specimen.\""
    }
