      "translations": {
        "en_US": {
          "text": "Patiently, the Reka waited for their new world tree to grow.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Patiemment, les Reka ont fait pousser leur nouvel arbre-monde.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Geduldig warteten die Reka, bis ihr neuer Weltenbaum heranwuchs.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "I Reka hanno atteso con pazienza che crescesse il loro nuovo albero del mondo.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Pacientemente, los Reka esperaron a que creciera su nuevo árbol del mundo.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZP6P89QEM5K5XRBRCX8N",
