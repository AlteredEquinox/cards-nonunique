                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Al mediodía — Roba una carta y luego crea dos fichas de [MANASEED] en tus hitos. (Son permanentes con «{T}, sacrifícame: Prepara un orbe de maná».)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "At Noon — Draw a card, then create two [MANASEED] tokens in your Landmarks. (They are Permanents with \"{T}, Sacrifice me: Ready a Mana Orb.\")",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "À Midi — Piochez une carte, puis créez deux jetons [MANASEED] dans vos Repères. (Ce sont des Permanents avec « {T}, Sacrifiez-moi : redressez un Orbe de Mana. »)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Ziehe eine Karte und erschaffe dann zwei [MANASEED]-Marken in deinem Wahrzeichen-Bereich. (Sie sind Bleibende Karten mit „{T}, Opfere mich: Stelle eine Manakugel bereit.“)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Pesca una carta, poi crea due pedine [MANASEED] nei tuoi fulcri. (Sono permanenti con \"{T}, sacrificami: ripristina una sfera di mana\".)",
                    "locale": "it_IT"
                  }
                },
                "text": "At Noon — Draw a card, then create two [MANASEED] tokens in your Landmarks. (They are Permanents with \"{T}, Sacrifice me: Ready a Mana Orb.\")"
              }
            ],
