      "translations": {
        "en_US": {
          "text": "\"Let us offer the Musubi to the Reka, so that new Exalts might be born!\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Offrons le Musubi aux Reka, que naissent de nouveaux Exalts ! »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Lasst uns den Reka die Musubi anbieten, damit neue Erhabene geboren werden!“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Offriamo il Musubi ai Reka, affinché possano nascere nuovi Elevati!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡Ofrezcamos el Musubi a los Reka para que nazcan nuevos Exaltados!».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZQYNHY13P4YCXFHRRYXK",
