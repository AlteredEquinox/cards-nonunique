                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#When you make a [GIFT] — I gain 1 boost.# (A Gift is when on your turn, an opponent draws a card, Resupplies or receives a token.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "#Cuando hagas un [GIFT] — Gano 1 potenciador.# (Un Regalo ocurre si, durante tu turno, un oponente roba una carta, se reabastece o recibe una ficha.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "#Wenn du ein [GIFT] gibst — Ich erhalte 1 Verstärkung.# (Ein Geschenk entsteht, wenn ein Gegner während deines Zuges eine Karte zieht, Nachschub nutzt oder eine Marke erhält.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "#Lorsque vous faites un [GIFT] — Je gagne 1 boost.# (Vous faites un Don si durant votre tour, un adversaire pioche une carte, Ravitaille ou reçoit un jeton.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "#Quando fai un [GIFT] — Ottengo 1 rinforzo.# (Un Regalo avviene se, durante il tuo turno, un avversario pesca una carta, Rifornisce o riceve una pedina.)",
                    "locale": "it_IT"
                  }
                },
                "text": "#When you make a [GIFT] — I gain 1 boost.# (A Gift is when on your turn, an opponent draws a card, Resupplies or receives a token.)"
              }
            ],
            "reference": "02064"
          },
