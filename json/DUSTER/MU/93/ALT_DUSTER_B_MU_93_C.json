      },
      "translations": {
        "es_ES": {
          "text": "«Digan lo que digan, ¡el Naos está sufriendo, igual que lo hizo el Nilam!».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Egal, was sie behaupten – der Naos leidet, genau wie der Nilam vor ihm!“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Quoi qu'ils en disent, le Naos souffre, tout comme le Nilam avant lui ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Checché ne dicano, il Naos sta soffrendo, proprio come il Nilam prima di esso!\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"No matter what they say, the Naos is suffering, just like the Nilam before it!\"",
          "locale": "en_US"
        }
      },
      "id": "01JZ37ZQ9REP0Q8YK71J13BMN4",
      "text": "\"No matter what they say, the Naos is suffering, just like the Nilam before it!\""
    }
