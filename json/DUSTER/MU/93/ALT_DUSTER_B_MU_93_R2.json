                "translations": {
                  "en_US": {
                    "text": "{H} You may return target Permanent to its owner's hand. #If you do, create a [MANASEED] token in its controller's Landmarks.#",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez renvoyer un Permanent ciblé dans la main de son propriétaire. #Si vous le faites, créez un jeton [MANASEED] dans les Repères de son contrôleur.#",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{H} Puedes devolver a la mano de su propietario un permanente objetivo. #Si lo haces, crea una ficha de [MANASEED] en los hitos de su controlador.#",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{H} Puoi far tornare un permanente bersaglio in mano al suo proprietario. #Se lo fai, crea una pedina [MANASEED] nei fulcri del suo controllore.#",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst eine Bleibende Karte deiner Wahl in die Hand ihres Besitzers zurückschicken. #Falls du das tust, erschaffe eine [MANASEED]-Marke im Wahrzeichen-Bereich des kontrollierenden Spielers.#",
                    "locale": "de_DE"
                  }
                },
