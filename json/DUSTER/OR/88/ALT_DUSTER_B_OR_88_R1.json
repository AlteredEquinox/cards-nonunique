                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#If my Expedition is [IN_CONTACT], [DEFENDER_CHA_P] Characters don't prevent it from moving forward.# (I'm In Contact if another player's Expedition is in my region.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "#Si mon Expédition est [IN_CONTACT], les Personnages [DEFENDER_CHA_P] ne l'empêchent pas d'avancer.# (Je suis En Contact si l'Expédition d'un autre joueur est dans ma région.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "#Falls meine Expedition [IN_CONTACT] ist, verhindern [DEFENDER_CHA_P]-Charaktere nicht ihr Vorwärtskommen.# (Ich bin in Kontakt, falls die Expedition eines anderen Spielers in meiner Region ist.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#Si mi expedición está [IN_CONTACT], los personajes [DEFENDER_CHA_P] no evitan que avance.# (Estoy en contacto si la expedición de otro jugador está en mi región.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#Se la mia spedizione è [IN_CONTACT], i personaggi con [DEFENDER_CHA_P] non le impediscono di avanzare.# (Sono In contatto se la spedizione di un altro giocatore si trova nella mia regione.)",
                    "locale": "it_IT"
                  }
                },
                "text": "#If my Expedition is [IN_CONTACT], [DEFENDER_CHA_P] Characters don't prevent it from moving forward.# (I'm In Contact if another player's Expedition is in my region.)"
              }
