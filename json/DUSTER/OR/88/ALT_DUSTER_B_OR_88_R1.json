{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "If a sculptor merely frees the form from the stone, then it never belonged to him in the first place.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Si un sculpteur libère une forme de la pierre, c'est que dès l'origine, elle ne lui a jamais appartenu.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Wenn ein Bildhauer eine Form nur aus dem Stein löst, dann hat sie ihm nie wirklich gehört.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Se uno scultore si limita a liberare una forma dalla pietra, essa non gli è mai appartenuta.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Si un escultor se limita a liberar la forma de la piedra, es que nunca le perteneció.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZS3BWZ87VAP5R555ZQEE",
      "text": "If a sculptor merely frees the form from the stone, then it never belonged to him in the first place."
    }
  ],
