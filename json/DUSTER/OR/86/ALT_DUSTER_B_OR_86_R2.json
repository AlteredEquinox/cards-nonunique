      },
      "translations": {
        "en_US": {
          "text": "\"Form ever follows function. This is the law.\" — Louis Sullivan",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« La forme suit la fonction. Et telle est la loi. » - Louis Sullivan",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Die Form folgt immer der Funktion. Das ist das Gesetz.“ – Louis Sullivan",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"La forma segue la funzione. È la legge.\" — Louis Sullivan",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«La forma responde a la función. Esa es la ley». —Louis Sullivan",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZRSZM8S50YBFVF30AVHR",
      "text": "\"Form ever follows function. This is the law.\" — Louis Sullivan"
