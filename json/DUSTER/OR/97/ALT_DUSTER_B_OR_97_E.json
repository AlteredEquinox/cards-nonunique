      },
      "translations": {
        "it_IT": {
          "text": "\"Sono sicura che il rituale del Musubi ci aiuterà a comprendere il vostro punto di vista.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"I'm sure the Musubi ritual will help us understand your point of view.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Je suis sûre que le rituel du Musubi nous aidera à comprendre votre point de vue. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Ich bin sicher, das Musubi-Ritual wird uns helfen, eure Weltsicht zu verstehen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Seguro que el ritual del Musubi nos ayudará a comprender vuestro punto de vista».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZTG6VHKDS1JCNB1CKBF1",
      "text": "\"I'm sure the Musubi ritual will help us understand your point of view.\""
    }
