                "translations": {
                  "de_DE": {
                    "text": "{J} Erschaffe drei [MANASEED]-Marken in deinem Wahrzeichen-Bereich. Dann, erhalte ich 1 Verstärkung pro Karte in deinem Wahrzeichen-Bereich.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{J} Crea tres fichas de [MANASEED] en tus hitos. Luego, gano 1 potenciador por cada carta que haya en tus hitos.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{J} Create three [MANASEED] tokens in your Landmarks. Then, I gain 1 boost per card in your Landmarks.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{J} Crea tre pedine [MANASEED] nei tuoi fulcri. Poi, ottengo 1 rinforzo per ogni carta nei tuoi fulcri.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{J} Créez trois jetons [MANASEED] dans vos Repères. Puis, je gagne 1 boost par carte dans vos Repères.",
                    "locale": "fr_FR"
                  }
                },
                "text": "{J} Create three [MANASEED] tokens in your Landmarks. Then, I gain 1 boost per card in your Landmarks."
