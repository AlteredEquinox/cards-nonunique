      },
      "translations": {
        "en_US": {
          "text": "Respect your household, and she will help you. But if you neglect it, beware!",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Respectez votre foyer, et elle vous aidera. Mais gare à vous si vous l'entretenez mal.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Respektiere dein Zuhause und sie wird dir helfen. Aber wehe dir, du vernachlässigst es!",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Rispetta la tua casa e lei ti aiuterà. Ma se la trascuri, guai a te!",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Respeta tu hogar, y ella te ayudará. ¡Pero ay de ti si descuidas tu morada!",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZT64WKBK74X1DJQW1J1F",
      "text": "Respect your household, and she will help you. But if you neglect it, beware!"
    }
