      "translations": {
        "en_US": {
          "text": "\"The more I visit this city, the more I love it.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Plus je la visite, plus cette cité me passionne. »",
          "locale": "fr_FR"
