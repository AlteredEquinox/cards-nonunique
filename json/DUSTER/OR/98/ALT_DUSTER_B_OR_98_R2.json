                "translations": {
                  "fr_FR": {
                    "text": "Ciblez un Permanent de Repère de Coût de Main {2} ou moins. #Son contrôleur [RESUPPLIES],# puis vous en prenez le contrôle. (Il rejoint vos Repères.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "Target a Landmark Permanent with Hand Cost {2} or less. #Its controller [RESUPPLIES],# then you take control of it. (It joins your Landmarks.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Haz objetivo a un permanente hito con coste desde la mano de {2} o menos. #Su controlador [RESUPPLIES],# y luego ganas el control de él. (Se incorpora a tus hitos.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Scegli come bersaglio un permanente fulcro con costo dalla mano pari o inferiore a {2}. #Il suo controllore [RESUPPLIES],# poi prendi il controllo del permanente fulcro. (Si unisce ai tuoi fulcri.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Wähle eine Bleibende Wahrzeichenkarte mit Handkosten {2} oder weniger. #Ihr kontrollierender Spieler nutzt [RESUPPLIES],# dann kontrollierst du sie. (Sie tritt deinem Wahrzeichen-Bereich bei.)",
                    "locale": "de_DE"
                  }
                },
                "text": "Target a Landmark Permanent with Hand Cost {2} or less. #Its controller [RESUPPLIES],# then you take control of it. (It joins your Landmarks.)"
