                ],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "S'il y a au moins deux #Sorts# dans votre #Réserve,# les Personnages [DEFENDER_CHA_P] n'empêchent pas mon Expédition d'avancer.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Falls sich mindestens zwei #Zauber# in deiner #Reserve# befinden, verhindern [DEFENDER_CHA_P]-Charaktere nicht das Vorwärtskommen meiner Expedition.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "If there are two or more #Spells# in your #Reserve,# [DEFENDER_CHA_P] Characters don't prevent my Expedition from moving forward.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Si hay dos o más #hechizos# en tu #reserva,# los personajes [DEFENDER_CHA_P] no evitan que mi expedición avance.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Se ci sono due o più #incantesimi# nella tua #Riserva,# i personaggi con [DEFENDER_CHA_P] non impediscono alla mia spedizione di avanzare.",
                    "locale": "it_IT"
                  }
                },
                "text": "If there are two or more #Spells# in your #Reserve,# [DEFENDER_CHA_P] Characters don't prevent my Expedition from moving forward."
