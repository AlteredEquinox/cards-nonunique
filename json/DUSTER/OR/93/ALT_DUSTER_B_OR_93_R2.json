        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Dietro i sorrisi e il giubilo, sento crescere la tensione...\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Behind the smiles and jubilation, I sense a growing tension…\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Derrière les sourires et la liesse, je sens une tension qui grandit... »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Hinter dem Lachen und dem Jubel spüre ich eine wachsende Anspannung …“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Detrás de las sonrisas y el júbilo, percibo que se acrecienta la tensión…».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZSTM567C03KMYYNYTMX7",
      "text": "\"Behind the smiles and jubilation, I sense a growing tension…\""
    }
  ],
