                "translations": {
                  "en_US": {
                    "text": "If there are two or more cards in your Landmarks, [DEFENDER_CHA_P] Characters don't prevent my Expedition from moving forward.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "S'il y a au moins deux cartes dans vos Repères, les Personnages [DEFENDER_CHA_P] n'empêchent pas mon Expédition d'avancer.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Falls sich mindestens zwei Karten in deinem Wahrzeichen-Bereich befinden, verhindern [DEFENDER_CHA_P]-Charaktere nicht das Vorwärtskommen meiner Expedition.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Si hay dos o más cartas en tus hitos, los personajes [DEFENDER_CHA_P] no evitan que mi expedición avance.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Se ci sono due o più carte nei tuoi fulcri, i personaggi con [DEFENDER_CHA_P] non impediscono alla mia spedizione di avanzare.",
                    "locale": "it_IT"
                  }
                },
                "text": "If there are two or more cards in your Landmarks, [DEFENDER_CHA_P] Characters don't prevent my Expedition from moving forward."
