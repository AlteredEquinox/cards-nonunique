      "translations": {
        "it_IT": {
          "text": "\"I souvenir sono l'incarnazione dei ricordi. Fanne tesoro.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«No hay nada más valioso que un bonito souvenir».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"Souvenirs are memories incarnate. Treasure them.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Il n'y a pas plus précieux qu'un bon souvenir. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Nichts ist kostbarer als eine schöne Erinnerung. Bewahre sie.“",
          "locale": "de_DE"
        }
      },
      "id": "01JZ37ZRY6N3E6YAFS9FXTSRYJ",
      "text": "\"Souvenirs are memories incarnate. Treasure them.\""
