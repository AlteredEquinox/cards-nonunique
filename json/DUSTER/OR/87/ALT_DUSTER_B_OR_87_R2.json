                  "fr_FR": {
                    "text": "{J} Vous pouvez me donner 1 boost. Si vous le faites, un adversaire ciblé [RESUPPLIES]. (Il met la première carte de son deck en Réserve.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "{J} You may give me 1 boost. If you do, target opponent [RESUPPLIES]. (They put the top card of their deck in Reserve.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "{J} Puedes darme 1 potenciador. Si lo haces, el oponente objetivo [RESUPPLIES]. (Coloca la primera carta de su mazo en la reserva.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{J} Du darfst mir 1 Verstärkung geben. Falls du das tust, nutzt ein Gegner deiner Wahl [RESUPPLIES]. (Lege die oberste Karte seines Decks in die Reserve.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{J} Puoi conferirmi 1 rinforzo. Se lo fai, un avversario bersaglio [RESUPPLIES]. (Metti la prima carta del suo mazzo nella Riserva.)",
