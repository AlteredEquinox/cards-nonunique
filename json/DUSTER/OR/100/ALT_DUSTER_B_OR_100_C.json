                "translations": {
                  "en_US": {
                    "text": "When I'm sacrificed — Create an [ORDIS_RECRUIT] in a Hero Expedition. (Excess Landmarks are sacrificed at the end of the Day.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je suis sacrifié — Créez un jeton Soldat [ORDIS_RECRUIT] dans une Expédition Héros. (Les Repères excédentaires sont sacrifiés à la fin du Jour.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Cuando me sacrifiques — Crea una ficha de soldado [ORDIS_RECRUIT] en una expedición del héroe. (Los hitos sobrantes se sacrifican al final del día.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn ich geopfert werde — Erschaffe eine [ORDIS_RECRUIT]-Soldatenmarke in einer Helden-Expedition. (Überschüssige Wahrzeichen werden am Ende des Tages geopfert.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando mi sacrifichi — Crea una pedina Soldato [ORDIS_RECRUIT] in una spedizione dell'eroe. (I fulcri in eccesso vengono sacrificati alla fine della giornata.)",
                    "locale": "it_IT"
                  }
                },
                "text": "When I'm sacrificed — Create an [ORDIS_RECRUIT] in a Hero Expedition. (Excess Landmarks are sacrificed at the end of the Day.)"
