        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Sol may have sounded the alarm, but her words seem to be falling on deaf ears.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Sol a beau tirer la sonnette d'alarme, ses propos semblent résonner dans le vide.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Egal, wie laut Sol Alarm schlug, ihre Worte scheinen im Nichts zu verhallen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Sol potrebbe aver lanciato l'allarme, ma le sue parole si sono perse nel vuoto.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Aunque Sol haya dado la voz de alarma, sus palabras parecen caer en saco roto.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZR7JM9TE1P1TYPD84QCF",
      "text": "Sol may have sounded the alarm, but her words seem to be falling on deaf ears."
    }
  ],
