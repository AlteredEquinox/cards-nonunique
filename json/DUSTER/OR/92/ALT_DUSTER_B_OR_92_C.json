        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Credimi, i miei investimenti porteranno beneficio a tutti.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Trust me, it will all trickle down for everyone's benefit.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Le ruissellement profite à tous, je vous l'assure. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Vertrauen Sie mir, es wird zum Wohle aller sein.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Bajadme los impuestos y veréis como todos salen ganando».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZSPG9JGXA7DMW775HM2Q",
      "text": "\"Trust me, it will all trickle down for everyone's benefit.\""
