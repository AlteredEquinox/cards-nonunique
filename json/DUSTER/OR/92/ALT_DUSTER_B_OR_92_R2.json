                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#When I leave the Expedition zone — Create an [ORDIS_RECRUIT] Soldier token in my Expedition.#",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "#Lorsque je quitte la zone d'Expédition — Créez un jeton Soldat [ORDIS_RECRUIT] dans mon Expédition.#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "#Wenn ich die Expeditionszone verlasse — Erschaffe eine [ORDIS_RECRUIT]-Soldatenmarke in meiner Expedition.#",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#Cuando abandone la zona de expedición — Crea una ficha de soldado [ORDIS_RECRUIT] en mi expedición.#",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#Quando lascio l'area delle spedizioni — Crea una pedina Soldato [ORDIS_RECRUIT] nella mia spedizione.#",
                    "locale": "it_IT"
                  }
                },
                "text": "#When I leave the Expedition zone — Create an [ORDIS_RECRUIT] Soldier token in my Expedition.#"
