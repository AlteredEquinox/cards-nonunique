                "translations": {
                  "en_US": {
                    "text": "At Dusk — Create a [MANASEED] token in your Landmarks.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Au Crépuscule — Créez un jeton [MANASEED] dans vos Repères. (C'est un Permanent avec « {T}, Sacrifiez-moi : redressez un Orbe de Mana. »)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Zum Abend — Erschaffe eine [MANASEED]-Marke in deinem Wahrzeichen-Bereich. (Sie ist eine Bleibende Karte mit „{T}, Opfere mich: Stelle eine Manakugel bereit.“)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Al anochecer — Crea una ficha de [MANASEED] en tus hitos. (Es un permanente con «{T}, sacrifícame: Prepara un orbe de maná».)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Al crepuscolo — Crea una pedina [MANASEED] nei tuoi fulcri. (È un permanente con \"{T}, sacrificami: ripristina una sfera di mana\".)",
                    "locale": "it_IT"
                  }
                },
                "text": "At Dusk — Create a [MANASEED] token in your Landmarks."
              }
            ],
