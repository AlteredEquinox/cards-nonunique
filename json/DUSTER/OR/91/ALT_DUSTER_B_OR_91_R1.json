                "translations": {
                  "fr_FR": {
                    "text": "#{J}# Vous pouvez épuiser ({T}) un Permanent que vous contrôlez pour [SABOTAGE_INF]. #Si vous ne le faites pas, je gagne 1 boost.#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "#{J}# Du darfst eine Bleibende Karte, die du kontrollierst, erschöpfen ({T}), um [SABOTAGE_INF] zu nutzen. #Falls du das nicht tust, erhalte ich 1 Verstärkung.#",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "#{J}# You may exhaust ({T}) a Permanent you control to [SABOTAGE_INF]. #If you don't, I gain 1 boost.#",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "#{J}# Puedes agotar ({T}) un permanente que controlas para [SABOTAGE_INF]. #Si no lo haces, gano 1 potenciador.#",
