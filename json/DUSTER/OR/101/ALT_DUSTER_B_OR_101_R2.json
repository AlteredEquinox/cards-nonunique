{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Due popoli separati dal fato e ora di nuovo assieme! D'ora innanzi, questo ricongiungimento sarà per sempre scolpito nella pietra!\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Two people separated by fate, now reunited once more! This reunion shall forever be carved in stone!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Zwei Völker, vom Schicksal getrennt, doch nun wieder vereint! Dieser Moment ist für immer in Stein gemeißelt!“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Deux peuples éloignés par le destin, de nouveau réunis ! Et désormais, ces retrouvailles sont gravées dans la pierre ! »",
          "locale": "fr_FR"
        },
        "es_ES": {
          "text": "«Dos personas separadas por el destino se han reunido. Ahora, su reencuentro quedará plasmado en la piedra por siempre».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZRBENW1FGBDRPV7PXGT6",
      "text": "\"Two people separated by fate, now reunited once more! This reunion shall forever be carved in stone!\""
    }
  ],
