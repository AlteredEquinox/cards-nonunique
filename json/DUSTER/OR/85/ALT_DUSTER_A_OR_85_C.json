        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "I am the beating heart of the swarm, the architect of the hive.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Je suis le cœur de l'essaim, l'architecte de la ruche.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Ich bin das schlagende Herz des Schwarms, der Architekt des Insektenstocks.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Sono il cuore pulsante dello sciame, l'architetto dell'alveare.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Soy el corazón palpitante del enjambre, el arquitecto de la colmena.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZHHNZAAHXHRQR1CVF0QF",
      "text": "I am the beating heart of the swarm, the architect of the hive."
    },
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"È un onore essere stato scelto per scolpire questo monumento condiviso con voi.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« C'est un honneur d'avoir été choisi pour sculpter avec vous ce monument commun. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Es ist mir eine Ehre, dieses gemeinsame Denkmal mit dir zu erschaffen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Es un honor haber sido elegido para esculpir con vosotros este monumento común».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"It's an honor to have been chosen to sculpt this shared monument with you.\"",
          "locale": "en_US"
        }
      },
      "id": "01JZ37ZHK03S7XXK7T3TR8BWV7",
      "text": "\"It's an honor to have been chosen to sculpt this shared monument with you.\""
    }
  ],
