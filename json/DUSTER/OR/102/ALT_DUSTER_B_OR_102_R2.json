                "translations": {
                  "de_DE": {
                    "text": "{T} : Wähle eine Expedition und erschaffe dann darin eine [ORDIS_RECRUIT]-Soldatenmarke #pro Karte in deinem Wahrzeichen-Bereich, bis maximal drei.#",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "{T} : Ciblez une Expédition, puis créez-y un jeton Soldat [ORDIS_RECRUIT] #par carte dans vos Repères, jusqu'à trois par activation.#",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{T}: scegli come bersaglio una spedizione, poi crea in quella spedizione una pedina Soldato [ORDIS_RECRUIT] #per ogni carta nei tuoi fulcri, fino a un max di tre per attivazione.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{T}: Haz objetivo a una expedición y luego crea una ficha de soldado [ORDIS_RECRUIT] en ella #por cada carta en tus hitos, hasta un máximo de tres por activación.#",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{T} : Target an Expedition, then create one [ORDIS_RECRUIT] Soldier token in it #per card in your Landmarks, up to three per activation.#",
                    "locale": "en_US"
                  }
                },
                "text": "{T} : Target an Expedition, then create one [ORDIS_RECRUIT] Soldier token in it #per card in your Landmarks, up to three per activation.#"
