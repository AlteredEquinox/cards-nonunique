        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Here, far from the crowd, is where fruitful negotiations are held between Reka and Asgarthans.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "C'est ici, loin de la foule, que de fructueuses négociations se tiennent entre Reka et Asgarthi.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Hier, fern der Massen, finden fruchtbare Verhandlungen zwischen den Reka und den Bewohnern von Asgartha statt.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Qui, lontano dalle folle, è dove si svolgono fruttuosi negoziati tra i Reka e il popolo di Asgartha.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Aquí, lejos de la multitud, es donde se celebran las fructíferas negociaciones entre los Reka y los asgarthianos.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZRFE1KWS8CFR0P9B452W",
      "text": "Here, far from the crowd, is where fruitful negotiations are held between Reka and Asgarthans."
    }
  ],
