        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Per essere sullo stesso livello, dobbiamo mostrare ciò di cui siamo capaci.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"To be on equal footing, we must show what we're capable of.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Pour être sur un pied d'égalité, il faut montrer de quoi nous sommes capables. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Um auf Augenhöhe zu sein, müssen wir zeigen, wozu wir in der Lage sind.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Para estar en igualdad de condiciones, debemos demostrar de lo que somos capaces».",
          "locale": "es_ES"
        }
      },
      "id": "01K3R4M96VWRD0XP7DJ2DCFWN6",
      "text": "\"To be on equal footing, we must show what we're capable of.\""
    }
