                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Then, I gain [FLEETING] #unless there are two or more exhausted cards in Reserve.#",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Puis, je gagne [FLEETING] #sauf s'il y a au moins deux cartes épuisées en Réserve.#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Dann erhalte ich [FLEETING], #es sei denn, mindestens zwei erschöpfte Karten sind in der Reserve.#",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Luego, gano [FLEETING] #a menos que haya dos o más cartas agotadas en reserva.#",
