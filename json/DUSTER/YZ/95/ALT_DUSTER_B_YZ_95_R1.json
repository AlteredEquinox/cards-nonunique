            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Send to Reserve target Character with Base Cost {4} or less, then exhaust it ({T}). (Its Base Cost is the Reserve Cost if Fleeting, or the Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Envoyez en Réserve un Personnage ciblé de Coût de Base {4} ou moins, puis épuisez-le ({T}). (Son Coût de Base est le Coût de Réserve s'il est Fugace, le Coût de Main sinon.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Envía a la reserva un personaje objetivo con coste base de {4} o menos y luego agótalo ({T}). (Su coste base es su coste desde la reserva si tiene fugacidad o su coste desde la mano.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Manda nella Riserva un personaggio bersaglio con costo base pari o inferiore a {4}, poi consumalo ({T}). (Il suo costo base corrisponde al costo dalla Riserva se ha Fugace, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Schicke einen Charakter deiner Wahl mit Basiskosten {4} oder weniger in die Reserve, dann erschöpfe ihn ({T}). (Basiskosten sind Reservekosten, falls Vergänglich, oder Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  }
                },
                "text": "Send to Reserve target Character with Base Cost {4} or less, then exhaust it ({T}). (Its Base Cost is the Reserve Cost if Fleeting, or the Hand Cost if not.)"
              }
            ],
            "reference": "02023"
          },
          "sequence": 0,
          "id": "01K6X4TCYHK95VG0MJ1PW4MB68"
        },
        {
          "cardElement": "\/card_elements\/01K6X4TCBDGQRY033HS4TGS4MY",
          "cardEffect": {
