        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"I told you it was a bad idea to drink all that Sap Cola…\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Je t'avais dit que c'était pas bon de boire autant de Sap Cola... »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Ich habe dir doch gesagt, du sollst nicht so viel Harz-Cola trinken …“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Te l'avevo detto che era una cattiva idea bersi tutta quella Gingerlinfa...\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Te dije que era mala idea beber tanta Savia Cola…».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZVC5P5YFGYDVDND615DP",
      "text": "\"I told you it was a bad idea to drink all that Sap Cola…\""
    }
  ],
