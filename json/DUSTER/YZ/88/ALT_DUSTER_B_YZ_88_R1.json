                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When you play a Spell with Base Cost {4} or more — #I gain 1 boost.# (It's the Reserve Cost if played from Reserve, or the Hand Cost if not.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Sort de Coût de Base {4} ou plus — #Je gagne 1 boost.# (C'est le Coût de Main, ou le Coût de Réserve s'il est joué depuis la Réserve.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un hechizo con coste base de {4} o más — #Gano 1 potenciador.# (Es su coste desde la reserva si se juega desde la reserva o, de lo contrario, es su coste desde la mano.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando giochi un incantesimo con costo base pari o superiore a {4} — #Ottengo 1 rinforzo.# (Corrisponde al costo dalla Riserva se è giocato dalla Riserva, altrimenti al costo dalla mano.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Zauber mit Basiskosten {4} oder mehr spielst — #Ich erhalte 1 Verstärkung.# (Es gelten die Reservekosten, wenn aus der Reserve gespielt wird, oder die Handkosten, falls nicht.)",
                    "locale": "de_DE"
                  }
                },
                "text": "When you play a Spell with Base Cost {4} or more — #I gain 1 boost.# (It's the Reserve Cost if played from Reserve, or the Hand Cost if not.)"
              }
            ],
