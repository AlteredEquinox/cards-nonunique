{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "« Si les cas sont rares, certaines personnes réagissent mal à la Sève, et je suis là pour enquêter. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Manche Menschen vertragen kein Harz, und so selten das auch sein mag – ich werde herausfinden, warum.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Alcune persone reagiscono male alla linfa, e sebbene i casi siano rari, il mio compito è scoprire perché.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Some people react badly to Sap, and as rare as it may be, my role here is to find out why.\"",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "«A ciertas personas les sienta mal la savia y, aunque se den pocos casos, mi papel es averiguar por qué».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZH78488QXXM050QP8XKW",
      "text": "\"Some people react badly to Sap, and as rare as it may be, my role here is to find out why.\""
    },
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Living creatures are the most beautiful mechanisms of all.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "La plus belle mécanique est celle du vivant.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Lebewesen sind die schönsten Mechanismen überhaupt.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "I meccanismi più affascinanti di tutti sono le creature viventi.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Los seres vivos son el mecanismo más bello de todos.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZH5XSQD1DABTNPMJYBED",
      "text": "Living creatures are the most beautiful mechanisms of all."
    }
