                "translations": {
                  "fr_FR": {
                    "text": "{R} Je gagne 1 boost si vous contrôlez au moins un Permanent épuisé ou s'il y a au moins une carte épuisée dans votre Réserve.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{R} Gano 1 potenciador si controlas uno permanente agotado o si hay una carta agotada en tu reserva.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{R} I gain 1 boost if you control an exhausted Permanent or if there's an exhausted card in your Reserve.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{R} Ottengo 1 rinforzo se controlli un permanente consumato o se c'è una carta consumata nella tua Riserva.",
