      "translations": {
        "it_IT": {
          "text": "\"Con questa nuova invenzione, possiamo generare un campo di forza in grado di proteggere la città!\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"With this new invention, we can generate a force field to protect the city!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Mit dieser neuen Erfindung können wir ein Kraftfeld zum Schutz der Stadt erzeugen!“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«¡Con este nuevo invento, podemos generar un campo de fuerza para proteger la ciudad!».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Grâce à cette nouvelle invention, nous pourrons générer un champ de force pour protéger la cité ! »",
          "locale": "fr_FR"
        }
      },
      "id": "01JZ37ZJ3HWYS8G4RWX99X42G3",
      "text": "\"With this new invention, we can generate a force field to protect the city!\""
