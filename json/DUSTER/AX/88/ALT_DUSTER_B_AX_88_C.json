        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"One day, son, you'll show off your own creations here.\" — Della",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Regarde bien, fiston : un jour ce sera toi qui exposeras tes créations ici. » - Della",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Eines Tages, mein Sohn, wirst du hier deine Erfindungen zeigen.“ – Della",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Un giorno, figlio mio, esporrai qui le tue creazioni.\" — Della",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Un día, hijo, exhibirás aquí tus propias creaciones». ―Della",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZJ1V06X1WTHPP20DQ6DN",
      "text": "\"One day, son, you'll show off your own creations here.\" — Della"
    }
