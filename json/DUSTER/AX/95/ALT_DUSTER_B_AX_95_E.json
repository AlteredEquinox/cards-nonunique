          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Juégame por {1} menos si controlas uno permanente agotado.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Giocami per {1} in meno se controlli un permanente consumato.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Spiele mich für {1} weniger, falls du mindestens eine erschöpfte Bleibende Karte kontrollierst.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "Play me for {1} less if you control an exhausted Permanent.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Jouez-moi pour {1} de moins si vous contrôlez au moins un Permanent épuisé.",
                    "locale": "fr_FR"
                  }
                },
                "text": "Play me for {1} less if you control an exhausted Permanent."
              }
            ],
            "reference": "02000"
          },
          "sequence": 0,
          "id": "01K6X41VYG076A1JFZXZ36DN7F"
        },
        {
          "cardElement": "\/card_elements\/01K6X41V6Z71A0EJQSAVR8X029",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Juégame por {1} menos si hay una carta agotada en tu reserva.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Spiele mich für {1} weniger, falls sich in deiner Reserve mindestens eine erschöpfte Karte befindet.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "Play me for {1} less if there's an exhausted card in your Reserve.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Jouez-moi pour {1} de moins s'il y a au moins une carte épuisée dans votre Réserve.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Giocami per {1} in meno se c'è una carta consumata nella tua Riserva.",
                    "locale": "it_IT"
                  }
                },
                "text": "Play me for {1} less if there's an exhausted card in your Reserve."
              }
            ],
            "reference": "02001"
          },
          "sequence": 1,
          "id": "01K6X41WBQM0FSB202PP01YXW9"
        },
        {
          "cardElement": "\/card_elements\/01K6X41V6Z71A0EJQSAVR8X029",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "{J} If there are four or more exhausted cards among Permanents you control and cards in your Reserve, ready up to two of them.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "{J} Si hay cuatro o más cartas agotadas entre los permanentes que controlas y las cartas en tu reserva, prepara hasta dos de ellas.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{J} Falls sich unter den von dir kontrollierten Bleibenden Karten und den Karten in deiner Reserve mindestens vier erschöpfte Karten befinden, stelle bis zu zwei von ihnen bereit.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "{J} S'il y a au moins quatre cartes épuisées parmi les Permanents que vous contrôlez et les cartes de votre Réserve, redressez-en jusqu'à deux.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{J} Se ci sono quattro o più carte consumate tra i permanenti che controlli e le carte nella tua Riserva, ripristina fino a due di quelle carte.",
                    "locale": "it_IT"
                  }
                },
                "text": "{J} If there are four or more exhausted cards among Permanents you control and cards in your Reserve, ready up to two of them."
              }
            ],
            "reference": "02002"
          },
          "sequence": 2,
          "id": "01K6X41WS4D5TD0DJSWHBN1PW0"
        }
      ],
      "value": "Play me for {1} less if you control an exhausted Permanent.  Play me for {1} less if there's an exhausted card in your Reserve.  {J} If there are four or more exhausted cards among Permanents you control and cards in your Reserve, ready up to two of them.",
