                "translations": {
                  "en_US": {
                    "text": "{J} You may discard #up to two# Characters from your Reserve. If you do, I activate #up to two# of their {r} abilities as if they were mine.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{J} Puoi scartare #fino a due# personaggi dalla tua Riserva. Se lo fai, attivo #fino a due# delle loro abilità {r} come se fossero mie.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Puedes descartar #hasta dos# personajes de tu reserva. Si lo haces, activo #hasta dos# de sus habilidades {r} como si fuesen mías.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{J} Vous pouvez défausser #jusqu'à deux# Personnages de votre Réserve. Si vous le faites, j'active #jusqu'à deux# de leurs capacités {r}, comme si c'étaient les miennes.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{J} Du darfst #bis zu zwei# Charaktere aus deiner Reserve ablegen. Falls du das tust, aktiviere ich #bis zu zwei# seiner {r} Fähigkeiten, als wären es meine.",
                    "locale": "de_DE"
                  }
                },
                "text": "{J} You may discard #up to two# Characters from your Reserve. If you do, I activate #up to two# of their {r} abilities as if they were mine."
              }
