                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Puedes descartar #hasta dos# personajes de tu reserva. Si lo haces, activo #hasta dos# de sus habilidades {r} como si fuesen mías.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{J} Vous pouvez défausser #jusqu'à deux# Personnages de votre Réserve. Si vous le faites, j'active #jusqu'à deux# de leurs capacités {r}, comme si c'étaient les miennes.",
