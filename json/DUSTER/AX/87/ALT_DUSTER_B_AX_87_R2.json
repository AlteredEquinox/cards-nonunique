      },
      "translations": {
        "en_US": {
          "text": "From Kelon to Sap to Manaseed, the Axiom never stop experimenting with alternative energy sources.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Kélon, Sève ou Graine, les Axiom ne cessent d'expérimenter sur des énergies alternatives.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Kelon, Harz, Manasaaten – die Axiom experimentieren stets mit alternativen Energiequellen.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Dal kelon alla linfa, fino ai semi di mana: gli Axiom non smettono mai di sperimentare con fonti di energia alternative.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Ya sea el kelón, la savia o las semillas de maná, los Axiom nunca dejan de experimentar con fuentes de energía alternativas.",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZJ096C53VA20K3K8V9AR",
      "text": "From Kelon to Sap to Manaseed, the Axiom never stop experimenting with alternative energy sources."
    }
