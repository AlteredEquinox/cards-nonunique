      "translations": {
        "en_US": {
          "text": "In the wild rush to find new uses for Manaseeds, it seems the sky's the limit…",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "La course folle aux utilisations des Graines de Mana ne semblait pas connaître de limite.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Die Suche nach neuen Einsatzformen für Manasaaten kennt keine Grenzen …",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Nella frenetica ricerca di nuovi utilizzi per i semi di mana, sembra che non ci siano limiti...",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "La desenfrenada carrera por encontrar nuevos usos para las semillas de maná parecía no tener límites…",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZJ8DXG3MVMS5ECM6QH63",
