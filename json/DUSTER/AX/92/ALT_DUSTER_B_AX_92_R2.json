                "translations": {
                  "en_US": {
                    "text": "{J} You may exhaust ({T}) target card in #any player's# Reserve. If you do, create a [MANASEED] token in #that player's# Landmarks.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{J} Vous pouvez épuiser ({T}) une carte ciblée dans la Réserve #de n'importe quel joueur.# Si vous le faites, créez un jeton [MANASEED] dans les Repères #de ce joueur.#",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{J} Puoi consumare ({T}) una carta bersaglio nella Riserva di #un giocatore qualsiasi.# Se lo fai, crea una pedina [MANASEED] nei fulcri di #quel giocatore.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{J} Puedes agotar ({T}) una carta objetivo en la reserva de #cualquier jugador.# Si lo haces, crea una ficha de [MANASEED] en los hitos de #ese jugador.#",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{J} Du darfst eine Karte deiner Wahl in der Reserve eines #beliebigen Spielers# erschöpfen ({T}). Falls du das tust, erschaffe eine [MANASEED]-Marke im Wahrzeichen-Bereich #dieses Spielers.#",
                    "locale": "de_DE"
                  }
                },
                "text": "{J} You may exhaust ({T}) target card in #any player's# Reserve. If you do, create a [MANASEED] token in #that player's# Landmarks."
