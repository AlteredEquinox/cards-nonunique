      },
      "translations": {
        "it_IT": {
          "text": "\"Il piacere più nobile è la gioia di comprendere.\" — Leonardo da Vinci",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"The noblest pleasure is the joy of understanding.\" — Leonardo da Vinci",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Die schönste Freude ist die Freude des Verstehens.“ – Leonardo da Vinci",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«El placer más noble es la alegría de comprender». ―Leonardo da Vinci",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Le plaisir le plus noble est la joie de comprendre. » - Léonard de Vinci",
          "locale": "fr_FR"
        }
      },
      "id": "01JZ37ZJC4C3HY3BCJVK5EJF62",
