                "translations": {
                  "en_US": {
                    "text": "#{J}# You may [RUSH]. If you would play a card from Reserve this way, you may pay its Hand Cost instead of its Reserve Cost.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#{J}# Du darfst [RUSH] nutzen. Falls du auf diese Weise eine Karte aus der Reserve spielen würdest, darfst du ihre Handkosten anstelle ihrer Reservekosten bezahlen.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#{J}# Puedes [RUSH]. Si fueses a jugar una carta desde la reserva de esta manera, puedes pagar su coste desde la mano en lugar de su coste desde la reserva.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#{J}# Puoi [RUSH]. Se stai per giocare una carta dalla Riserva in questo modo, puoi pagare il suo costo dalla mano invece del suo costo dalla Riserva.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "#{J}# Vous pouvez [RUSH]. Si vous jouez une carte de votre Réserve de cette manière, vous pouvez payer son Coût de Main à la place de son Coût de Réserve.",
                    "locale": "fr_FR"
                  }
                },
                "text": "#{J}# You may [RUSH]. If you would play a card from Reserve this way, you may pay its Hand Cost instead of its Reserve Cost."
              }
            ],
