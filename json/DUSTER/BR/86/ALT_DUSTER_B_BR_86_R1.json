                  "en_US": {
                    "text": "{R} #If I'm [IN_CONTACT], I gain 2 boosts,# otherwise I gain 1 boost. (I'm In Contact if another player's Expedition is in my region.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{R} #Falls ich [IN_CONTACT] bin, erhalte ich 2 Verstärkungen,# andernfalls 1 Verstärkung. (Ich bin in Kontakt, falls die Expedition eines anderen Spielers in meiner Region ist.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{R} #Si estoy [IN_CONTACT], gano 2 potenciadores.# De lo contrario, gano 1 potenciador. (Estoy en contacto si la expedición de otro jugador está en mi región.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{R} #Se sono [IN_CONTACT], ottengo 2 rinforzi,# altrimenti ottengo 1 rinforzo. (Sono In contatto se la spedizione di un altro giocatore si trova nella mia regione.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{R} #Si je suis [IN_CONTACT], je gagne 2 boosts.# Sinon, je gagne 1 boost. (Je suis En Contact si l'Expédition d'un autre joueur se trouve dans ma région.)",
