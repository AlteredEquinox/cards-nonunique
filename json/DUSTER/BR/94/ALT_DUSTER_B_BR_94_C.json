                "translations": {
                  "it_IT": {
                    "text": "{R} Crea due pedine [MANASEED] nei tuoi fulcri. (Sono permanenti con \"{T}, sacrificami: ripristina una sfera di mana\".)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{R} Crea dos fichas de [MANASEED] en tus hitos. (Son permanentes con «{T}, sacrifícame: Prepara un orbe de maná».)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{R} Erschaffe zwei [MANASEED]-Marken in deinem Wahrzeichen-Bereich. (Sie sind Bleibende Karten mit „{T}, Opfere mich: Stelle eine Manakugel bereit.“)",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "{R} Create two [MANASEED] tokens in your Landmarks. (They are Permanents with \"{T}, Sacrifice me: Ready a Mana Orb.\")",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{R} Créez deux jetons [MANASEED] dans vos Repères. (Ce sont des Permanents avec « {T}, Sacrifiez-moi : redressez un Orbe de Mana. »)",
                    "locale": "fr_FR"
                  }
                },
                "text": "{R} Create two [MANASEED] tokens in your Landmarks. (They are Permanents with \"{T}, Sacrifice me: Ready a Mana Orb.\")"
