              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#When I go to Reserve from the Expedition zone — You may return another target Character from your Reserve to your hand.#",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "#Cuando vaya a la reserva desde la zona de expedición — Puedes devolver otro personaje objetivo de tu reserva a tu mano.#",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "#Quando vado nella Riserva dall'area delle spedizioni — Puoi riprendere in mano un altro personaggio bersaglio dalla tua Riserva.#",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "#Lorsque je vais en Réserve depuis la zone d'Expédition — Vous pouvez renvoyer un autre Personnage ciblé de votre Réserve dans votre main.#",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "#Wenn ich aus der Expeditionszone in die Reserve gehe — Du darfst einen anderen Charakter deiner Wahl aus deiner Reserve in deine Hand zurückholen.#",
                    "locale": "de_DE"
                  }
                },
                "text": "#When I go to Reserve from the Expedition zone — You may return another target Character from your Reserve to your hand.#"
              }
            ],
            "reference": "01702"
          },
