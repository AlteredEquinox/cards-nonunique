      },
      "translations": {
        "en_US": {
          "text": "\"In my memory, you're there every time I cross paths with a Leviathan.\" — Sol",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Dans ma mémoire, tu es toujours présent, à chaque fois que je croise un Léviathan. » - Sol",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Du bist stets in meiner Erinnerung, wenn ich einem Leviathan begegne.“ – Sol",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Nei miei ricordi, sei sempre presente ogni volta che incontro un leviatano.\" — Sol",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Estás presente en mi memoria cada vez que me cruzo con un leviatán». ―Sol",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZJRWD5TW6C76S0SR9MM0",
      "text": "\"In my memory, you're there every time I cross paths with a Leviathan.\" — Sol"
    }
