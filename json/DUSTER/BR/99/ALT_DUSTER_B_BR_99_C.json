          "text": "„Dein Fang des Tages verdient eine Manasaat!“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«¡Una semilla de maná bien merecida por tu captura del día!».",
          "locale": "es_ES"
        },
        "fr_FR": {
