                "translations": {
                  "en_US": {
                    "text": "Create a [MANASEED] token in your Landmarks. (It's a Permanent with \"{T}, Sacrifice me: Ready a Mana Orb.\")",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Erschaffe eine [MANASEED]-Marke in deinem Wahrzeichen-Bereich. (Sie ist eine Bleibende Karte mit „{T}, Opfere mich: Stelle eine Manakugel bereit.“)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Crea una pedina [MANASEED] nei tuoi fulcri. (È un permanente con \"{T}, sacrificami: ripristina una sfera di mana\".)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Créez un jeton [MANASEED] dans vos Repères. (C'est un Permanent avec « {T}, Sacrifiez-moi : redressez un Orbe de Mana. »)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Crea una ficha de [MANASEED] en tus hitos. (Es un permanente con «{T}, sacrifícame: Prepara un orbe de maná».)",
                    "locale": "es_ES"
                  }
                },
                "text": "Create a [MANASEED] token in your Landmarks. (It's a Permanent with \"{T}, Sacrifice me: Ready a Mana Orb.\")"
              }
            ],
