                "translations": {
                  "en_US": {
                    "text": "{H} You may [RUSH] a Character. If played from your hand, it activates one of its {r} abilities. (Rush means playing it immediately.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez [RUSH] avec un Personnage. S'il est joué de votre main, il active l'une de ses capacités {r}. (Foncer signifie le jouer immédiatement.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{H} Puedes [RUSH] con un personaje. Si lo juegas desde la mano, activa una de sus habilidades {r}. (Presionar es jugarlo inmediatamente.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst [RUSH] für einen Charakter nutzen. Falls er aus deiner Hand gespielt wird, aktiviert er eine seiner {r} Fähigkeiten. (Forcieren bedeutet, ihn sofort zu spielen.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Puoi [RUSH] un personaggio. Se lo giochi dalla tua mano, attiva una delle sue abilità {r}. (Incalzare significa giocarlo immediatamente.)",
