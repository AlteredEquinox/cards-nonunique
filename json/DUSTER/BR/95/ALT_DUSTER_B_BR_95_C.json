      "translations": {
        "en_US": {
          "text": "Without this suit, diving into the Tumult would be a death sentence.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Sans ce scaphandre, plonger dans le Tumulte serait suicidaire.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Ohne diesen Anzug wäre das Eintauchen in den Tumult ein sicheres Todesurteil.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Senza questa tuta, immergersi nel Tumulto equivarrebbe a una condanna a morte.",
          "locale": "it_IT"
        },
