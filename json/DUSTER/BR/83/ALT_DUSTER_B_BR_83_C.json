                "translations": {
                  "en_US": {
                    "text": "If your Hero has 5 or more Quest counters, I am [GIGANTIC]. (A Gigantic Character is considered present in both Expeditions.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Si votre Héros a au moins 5 compteurs Quête, je suis [GIGANTIC]. (Un Personnage Gigantesque est considéré présent dans les deux Expéditions.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Falls dein Held mindestens 5 Questzähler hat, bin ich [GIGANTIC]. (Ein gigantischer Charakter wird in beiden Expeditionen als anwesend betrachtet.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Se il tuo eroe ha 5 o più segnalini Missione, ho [GIGANTIC]. (Un personaggio Colossale si considera presente in entrambe le spedizioni.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Si tu héroe tiene 5 o más contadores de misión, soy [GIGANTIC]. (Un personaje gigante se considera presente en ambas expediciones.)",
                    "locale": "es_ES"
                  }
                },
                "text": "If your Hero has 5 or more Quest counters, I am [GIGANTIC]. (A Gigantic Character is considered present in both Expeditions.)"
