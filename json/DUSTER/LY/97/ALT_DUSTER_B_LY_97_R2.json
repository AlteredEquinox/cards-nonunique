                "translations": {
                  "fr_FR": {
                    "text": "Vous pouvez me jouer pour {2} de moins dans une Expédition qui est [IN_CONTACT]. (Elle est En Contact si l'Expédition d'un autre joueur est dans sa région.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "You may play me for {2} less in an Expedition that's [IN_CONTACT]. (It's In Contact if there is another player's Expedition in its region.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Du darfst mich für {2} weniger in einer Expedition spielen, die [IN_CONTACT] ist. (Sie ist in Kontakt, falls sich in ihrer Region die Expedition eines anderen Spielers befindet.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Puedes jugarme por {2} menos en una expedición que esté [IN_CONTACT]. (Está en contacto si la expedición de otro jugador está en su región.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Puoi giocarmi per {2} in meno in una spedizione [IN_CONTACT]. (È In contatto se nella sua regione c'è la spedizione di un altro giocatore.)",
