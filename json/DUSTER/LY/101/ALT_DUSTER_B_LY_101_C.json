                  },
                  "it_IT": {
                    "text": "La mia spedizione e i suoi personaggi si considerano [IN_CONTACT]. (Anche se non ci sono altre spedizioni nella mia regione.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Meine Expedition und ihre Charaktere gelten als [IN_CONTACT]. (Selbst falls es in meiner Region keine anderen Expeditionen gibt.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
