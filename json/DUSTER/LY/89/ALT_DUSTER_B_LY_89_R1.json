                "translations": {
                  "en_US": {
                    "text": "At Dusk — If I'm [IN_CONTACT], I gain 1 boost. (I'm In Contact if another player's Expedition is in my region.)",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Al crepuscolo — Se sono [IN_CONTACT], ottengo 1 rinforzo. (Sono In contatto se la spedizione di un altro giocatore si trova nella mia regione.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Au Crépuscule — Si je suis [IN_CONTACT], je gagne 1 boost. (Je suis En Contact si l'Expédition d'un autre joueur est dans ma région.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Zum Abend — Falls ich [IN_CONTACT] bin, erhalte ich 1 Verstärkung. (Ich bin in Kontakt, falls die Expedition eines anderen Spielers in meiner Region ist.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Al anochecer — Si estoy [IN_CONTACT], gano 1 potenciador. (Estoy en contacto si la expedición de otro jugador está en mi región.)",
                    "locale": "es_ES"
                  }
                },
                "text": "At Dusk — If I'm [IN_CONTACT], I gain 1 boost. (I'm In Contact if another player's Expedition is in my region.)"
              }
