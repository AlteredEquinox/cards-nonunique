                "translations": {
                  "en_US": {
                    "text": "{H} If I'm [IN_CONTACT], you may have target Character switch Expeditions. (I'm In Contact if another player's Expedition is in my region.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Si je suis [IN_CONTACT], vous pouvez cibler un Personnage. Il change d'Expédition. (Je suis En Contact si l'Expédition d'un autre joueur est dans ma région.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{H} Si estoy [IN_CONTACT], puedes hacer objetivo a un personaje para que se traslade de expedición. (Estoy en contacto si la expedición de otro jugador está en mi región.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{H} Se sono [IN_CONTACT], puoi scegliere come bersaglio un personaggio e fargli cambiare spedizione. (Sono In contatto se la spedizione di un altro giocatore si trova nella mia regione.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "{H} Falls ich [IN_CONTACT] bin, darfst du einen Charakter wählen, er wechselt Expeditionen. (Ich bin in Kontakt, falls die Expedition eines anderen Spielers in meiner Region ist.)",
                    "locale": "de_DE"
                  }
                },
                "text": "{H} If I'm [IN_CONTACT], you may have target Character switch Expeditions. (I'm In Contact if another player's Expedition is in my region.)"
