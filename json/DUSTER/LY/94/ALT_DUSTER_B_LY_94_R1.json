                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "#{J}# Se sono [IN_CONTACT], [SABOTAGE_LOW]. #Altrimenti, puoi consumare ({T}) una carta bersaglio nella Riserva.# (Sono In contatto se la spedizione di un altro giocatore si trova nella mia regione.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#{J}# Si estoy [IN_CONTACT], [SABOTAGE_LOW]. #De lo contrario, puedes agotar ({T}) una carta objetivo en reserva.# (Estoy en contacto si la expedición de otro jugador está en mi región.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "#{J}# Falls ich [IN_CONTACT] bin, nutze [SABOTAGE_LOW]. #Andernfalls darfst du eine Karte deiner Wahl in der Reserve erschöpfen ({T}).# (Ich bin in Kontakt, falls die Expedition eines anderen Spielers in meiner Region ist.)",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "#{J}# If I'm [IN_CONTACT], [SABOTAGE_LOW]. #Otherwise, you may exhaust ({T}) target card in Reserve.# (I'm In Contact if another player's Expedition is in my region.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "#{J}# Si je suis [IN_CONTACT], [SABOTAGE_LOW]. #Sinon, vous pouvez épuiser ({T}) une carte ciblée en Réserve.# (Je suis En Contact si l'Expédition d'un autre joueur est dans ma région.)",
                    "locale": "fr_FR"
                  }
                },
                "text": "#{J}# If I'm [IN_CONTACT], [SABOTAGE_LOW]. #Otherwise, you may exhaust ({T}) target card in Reserve.# (I'm In Contact if another player's Expedition is in my region.)"
