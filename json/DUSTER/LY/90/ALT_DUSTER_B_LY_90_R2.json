      "translations": {
        "it_IT": {
          "text": "\"Posso entrare ovunque, lista VIP o no.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"I can get in anywhere, VIP list or not.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Pas besoin d'être sur la liste VIP, j'ai toujours mes entrées. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Ich komme überall rein, egal ob auf der VIP-Liste oder nicht.“",
