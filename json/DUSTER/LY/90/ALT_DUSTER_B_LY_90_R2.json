                "translations": {
                  "en_US": {
                    "text": "{H} If I'm [IN_CONTACT], you may exchange a card from your Reserve with a card from your hand. (I'm In Contact if another player's Expedition is in my region.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Si je suis [IN_CONTACT], vous pouvez échanger une carte de votre Réserve contre une carte de votre main. (Je suis En Contact si l'Expédition d'un autre joueur est dans ma région.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{H} Si estoy [IN_CONTACT], puedes intercambiar una carta de tu reserva por una carta de tu mano. (Estoy en contacto si la expedición de otro jugador está en mi región.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "{H} Se sono [IN_CONTACT], puoi scambiare una carta dalla tua Riserva con una carta dalla tua mano. (Sono In contatto se la spedizione di un altro giocatore si trova nella mia regione.)",
