                "cardEffectElementDisplays": [
                  {
                    "cardKeyword": {
                      "translations": {
                        "en_US": {
                          "displayWeb": "Fleeting",
                          "locale": "en_US",
                          "description": "Send me to Discard instead of Reserve after my effect resolves."
                        },
                        "de_DE": {
                          "displayWeb": "Vergänglich",
                          "locale": "de_DE",
                          "description": "Lege mich auf die Ablage statt in die Reserve, nachdem mein Effekt abgeklungen ist."
                        },
                        "it_IT": {
                          "displayWeb": "Fugace",
                          "locale": "it_IT",
                          "description": "Mandami negli Scarti invece che nella Riserva dopo che il mio effetto si è risolto."
                        },
                        "es_ES": {
                          "displayWeb": "Fugacidad",
                          "locale": "es_ES",
                          "description": "Una vez resuelto mi efecto, envíame a la pila de descartes en lugar de a la reserva."
                        },
                        "fr_FR": {
                          "displayWeb": "Fugace",
                          "locale": "fr_FR",
                          "description": "Envoyez-moi à la Défausse plutôt qu'en Réserve une fois mon effet résolu."
                        }
                      },
                      "id": "01HKAGPHBY4EPW8TR9VTCHZG5Q",
                      "reference": "FLEETING"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01K1TWR36D64SMCWFPC7Y7PTX8"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Target opponent reveals the top four cards of their deck. You may play a Character from these cards for free and it gains [FLEETING], then discard the rest. (Don't activate any {h} abilities.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Ein Gegner deiner Wahl deckt die obersten vier Karten seines Decks auf. Du darfst einen Charakter aus diesen Karten kostenlos spielen und er erhält [FLEETING], dann lege die restlichen Karten ab. (Aktiviere keine {h} Fähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "El oponente objetivo revela las cuatro primeras cartas de su mazo. Puedes jugar sin coste un personaje de entre ellas. Gana [FLEETING]. Luego, descarta el resto. (No actives ninguna habilidad {h}.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Un adversaire ciblé révèle les quatre premières cartes de son deck. Vous pouvez jouer gratuitement un Personnage parmi ces cartes, il gagne [FLEETING], puis défaussez le reste. (N'activez pas ses capacités {h}.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Un avversario bersaglio rivela le prime quattro carte del suo mazzo. Puoi giocare un personaggio tra quelle carte senza pagarne il costo e fargli ottenere [FLEETING], poi scartare il resto. (Non attivi alcuna abilità {h}.)",
                    "locale": "it_IT"
                  }
                },
                "text": "Target opponent reveals the top four cards of their deck. You may play a Character from these cards for free and it gains [FLEETING], then discard the rest. (Don't activate any {h} abilities.)"
              }
            ],
