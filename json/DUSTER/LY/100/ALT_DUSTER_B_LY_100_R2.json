        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "\"Non mi sono mai sentita così vicina a qualcuno.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"I've never felt this close to anyone.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Je ne me suis jamais sentie aussi proche de qui que ce soit. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Ich habe mich noch nie jemandem so nahe gefühlt.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Nunca me había sentido tan unida a nadie».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZM2X4AZSYAN45A8SFKG6",
      "text": "\"I've never felt this close to anyone.\""
    }
  ],
