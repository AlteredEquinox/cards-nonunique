                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Comienzo la partida con un marcador de terreno de {V}, otro de {M} y otro de {O}.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "I begin the game with one {V}, one {M} and one {O} Terrain Marker.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Ich beginne das Spiel mit einem {V}, einem {M} und einem {O} Geländemarker.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Inizio la partita con un indicatore terreno {V}, uno {M} e uno {O}.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Je commence la partie avec un marqueur Terrain {V}, un {M} et un {O}.",
