          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "At Noon — You may place one of my Markers on target visible region. (It gains the terrain of the Marker and loses its other terrains until the Marker is removed.)",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — Puoi posizionare uno dei miei indicatori su una regione bersaglio visibile. (Ottiene il terreno dell'indicatore e perde gli altri suoi terreni finché l'indicatore non viene rimosso.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "À Midi — Vous pouvez placer l'un de mes marqueurs sur une région visible ciblée. (Elle gagne le terrain du marqueur et perd ses autres terrains jusqu'à ce que ce marqueur soit retiré.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Al mediodía — Puedes colocar uno de mis marcadores en una región visible objetivo. (Gana el terreno del marcador y pierde sus otros terrenos hasta que se retire el marcador.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — Du darfst einen meiner Marker auf eine sichtbare Region deiner Wahl platzieren. (Er erhält das Gelände des Markers und verliert seine anderen Gelände, bis der Marker entfernt wird.)",
                    "locale": "de_DE"
                  }
                },
                "text": "At Noon — You may place one of my Markers on target visible region. (It gains the terrain of the Marker and loses its other terrains until the Marker is removed.)"
              }
            ],
            "reference": "01317"
          },
          "sequence": 1,
          "id": "01K6X48A0MHWY6KAKHAFJQJNNR"
        }
      ],
