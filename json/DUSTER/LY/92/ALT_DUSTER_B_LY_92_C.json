                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "If I'm [IN_CONTACT], my {V}, {M} and {O} are equal to my highest statistic. (I'm In Contact if another player's Expedition is in my region.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Falls ich [IN_CONTACT] bin, sind meine {V}, {M} und {O} so hoch wie meine höchste Statistik. (Ich bin in Kontakt, falls die Expedition eines anderen Spielers in meiner Region ist.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Se sono [IN_CONTACT], ho {V}, {M} e {O} pari alla mia statistica più alta. (Sono In contatto se la spedizione di un altro giocatore si trova nella mia regione.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Si je suis [IN_CONTACT], mes {V}, {M} et {O} sont égales à ma statistique la plus élevée. (Je suis En Contact si l'Expédition d'un autre joueur est dans ma région.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Si estoy [IN_CONTACT], mi {V}, {M} y {O} son iguales a mi estadística más alta. (Estoy en contacto si la expedición de otro jugador está en mi región.)",
                    "locale": "es_ES"
                  }
                },
                "text": "If I'm [IN_CONTACT], my {V}, {M} and {O} are equal to my highest statistic. (I'm In Contact if another player's Expedition is in my region.)"
