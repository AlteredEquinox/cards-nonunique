      },
      "translations": {
        "it_IT": {
          "text": "\"La costanza è la virtù dei ridicoli.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Constancy is for insensitive clods alone.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« La constance n'est bonne que pour les ridicules. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Beständigkeit ist nur etwas für lächerliche Trottel.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«¿No es verdad, ángel de amor, que en esta apartada orilla más pura la luna brilla y se respira mejor?».",
          "locale": "es_ES"
        }
      },
      "id": "01JZ37ZNGYCFZ3JEMMX717ZTM3",
      "text": "\"Constancy is for insensitive clods alone.\""
