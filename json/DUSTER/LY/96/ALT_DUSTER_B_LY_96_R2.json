      "cardEffectDisplays": [
        {
          "cardElement": "\/card_elements\/01K6X4BH5Y8XZVV7CT8W2043H4",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [
                  {
                    "cardKeyword": {
                      "translations": {
                        "en_US": {
                          "displayWeb": "Fleeting",
                          "locale": "en_US",
                          "description": "Send me to Discard instead of Reserve after my effect resolves."
                        },
                        "de_DE": {
                          "displayWeb": "Vergänglich",
                          "locale": "de_DE",
                          "description": "Lege mich auf die Ablage statt in die Reserve, nachdem mein Effekt abgeklungen ist."
                        },
                        "it_IT": {
                          "displayWeb": "Fugace",
                          "locale": "it_IT",
                          "description": "Mandami negli Scarti invece che nella Riserva dopo che il mio effetto si è risolto."
                        },
                        "es_ES": {
                          "displayWeb": "Fugacidad",
                          "locale": "es_ES",
                          "description": "Una vez resuelto mi efecto, envíame a la pila de descartes en lugar de a la reserva."
                        },
                        "fr_FR": {
                          "displayWeb": "Fugace",
                          "locale": "fr_FR",
                          "description": "Envoyez-moi à la Défausse plutôt qu'en Réserve une fois mon effet résolu."
                        }
                      },
                      "id": "01HKAGPHBY4EPW8TR9VTCHZG5Q",
                      "reference": "FLEETING"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01JZ2K8R5E8F7A8FVKGK59YABA"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "If I would go to Reserve from the Expedition zone, I gain [FLEETING] and defect instead. (I join the Expedition facing me, changing controllers.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Si je devais aller en Réserve depuis la zone d'Expédition, je gagne [FLEETING] et trahis à la place. (Je rejoins l'Expédition qui me fait face et change de contrôleur.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Si fuese a ir a la reserva desde la zona de expedición, en vez de eso, gano [FLEETING] y deserto. (Me incorporo a la expedición enfrentada a mí y cambio de controlador.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Se sto per andare nella Riserva dall'area delle spedizioni, ottengo [FLEETING] e diserto invece. (Mi unisco alla spedizione che mi affronta, cambiando controllore.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Falls ich aus der Expeditionszone in die Reserve gehen würde, erhalte ich stattdessen [FLEETING] und laufe über. (Ich schließe mich der mir gegenüberstehenden Expedition an und wechsle den kontrollierenden Spieler.)",
                    "locale": "de_DE"
                  }
                },
                "text": "If I would go to Reserve from the Expedition zone, I gain [FLEETING] and defect instead. (I join the Expedition facing me, changing controllers.)"
              }
            ],
            "reference": "01741"
          },
          "sequence": 0,
          "id": "01K6X4BHNZGEN2DP55RYXMRHRA"
        }
      ],
      "value": "If I would go to Reserve from the Expedition zone, I gain [[Fleeting]] and defect instead. (I join the Expedition facing me, changing controllers.)",
