      "translations": {
        "en_US": {
          "text": "\"Floor -2, room 217. Welcome to the Underlook Hostel.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Étage -2, chambre 217. Bienvenue à l'auberge Underlook. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„2. Untergeschoss, Zimmer 217. Willkommen im Underlook Hotel.“",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Piano -2, stanza 217. Benvenuti all'Hotel Sguardobasso.\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Planta -2, habitación 217. Que disfrute de su estancia en el Hotel Infravista».",
