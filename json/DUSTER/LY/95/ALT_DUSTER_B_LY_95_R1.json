                  "en_US": {
                    "text": "{H} You may target a Character, it gains [ASLEEP]. #If you control it,# create a [MANASEED] token in your Landmarks.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{H} Puoi scegliere come bersaglio un personaggio e fargli ottenere [ASLEEP]. #Se lo controlli,# crea una pedina [MANASEED] nei tuoi fulcri.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} Puedes hacer objetivo a un personaje. Gana [ASLEEP]. #Si lo controlas,# crea una ficha de [MANASEED] en tus hitos.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez cibler un Personnage. Il gagne [ASLEEP]. #Si vous le contrôlez,# créez un jeton [MANASEED] dans vos Repères.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst einen Charakter wählen, er erhält [ASLEEP]. #Falls du ihn kontrollierst,# erschaffe eine [MANASEED]-Marke in deinem Wahrzeichen-Bereich.",
                    "locale": "de_DE"
                  }
                },
                "text": "{H} You may target a Character, it gains [ASLEEP]. #If you control it,# create a [MANASEED] token in your Landmarks."
