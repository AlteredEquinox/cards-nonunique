                "translations": {
                  "en_US": {
                    "text": "Play me for {1} less if one or more of your Expeditions are [IN_CONTACT]. (If another player's Expedition is in their region.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Juégame por {1} menos si controlas una expedición que esté [IN_CONTACT]. (Significa que la expedición de otro jugador está en su región.)",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Giocami per {1} in meno se controlli una spedizione [IN_CONTACT]. (Significa che la spedizione di un altro giocatore si trova nella sua regione.)",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Spiele mich für {1} weniger, falls du eine Expedition kontrollierst, die [IN_CONTACT] ist. (Das bedeutet, dass sich die Expedition eines anderen Spielers in ihrer Region befindet.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Jouez-moi pour {1} de moins si vous contrôlez au moins une Expédition [IN_CONTACT]. (Cela signifie que l'Expédition d'un autre joueur est dans sa région.)",
                    "locale": "fr_FR"
                  }
                },
