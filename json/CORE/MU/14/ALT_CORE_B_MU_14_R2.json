        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "On peut l'entendre battre dans les arbres, au plus profond de leurs racines : c'est le cœur de la nature.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Man kann ihn in den Bäumen spüren, tief unter ihren Wurzeln – den Herzschlag der Natur.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Se puede sentir en los árboles, bajo sus mismas raíces... el latido de la naturaleza.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Puoi sentirlo negli alberi, nelle profondità delle loro radici: il battito del cuore della natura.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "You can feel it in the trees, deep beneath their roots - the very heartbeat of nature.",
          "locale": "en_US"
        }
      },
      "id": "01HNJH5XB34N8QACRGC0AXDFNB",
      "text": "You can feel it in the trees, deep beneath their roots - the very heartbeat of nature."
    }
