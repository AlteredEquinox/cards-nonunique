        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Im Stamm der Spindel befindet sich das Rinden-Refugium – das Heiligtum, in dem die Muna mit empfindungsfähigen Pflanzen kommunizieren.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Dentro del tronco del Balaustre se encuentra el Refugio de la corteza, un santuario en el que los de Muna charlan con plantas inteligentes.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Within the Spindle's trunk is the Bark Refuge, the sanctuary where the Muna converse with sentient plants.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "All'interno del tronco del Fuso si trova il Riparo della Corteccia, il santuario in cui i Muna dialogano con le piante senzienti.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Le Refuge de l'Écorce, le sanctuaire où les Muna conversent avec les plantes sentientes.",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5YS4S8C9MZTSBXV3RKDC",
      "text": "Within the Spindle's trunk is the Bark Refuge, the sanctuary where the Muna converse with sentient plants."
    }
  ],
