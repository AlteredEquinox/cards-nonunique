      "translations": {
        "fr_FR": {
          "text": "Voir croître la verdure est la plus grande joie qui soit.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Es gibt nichts Schöneres, als alles Grün wachsen und gedeihen zu sehen.",
