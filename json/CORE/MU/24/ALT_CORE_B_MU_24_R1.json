        },
        "es_ES": {
          "text": "No hay alegría mayor que ver la flora medrar y crecer.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "There's no greater joy than seeing all that is green thrive and grow.",
          "locale": "en_US"
        },
        "it_IT": {
