      "translations": {
        "fr_FR": {
          "text": "Il n'y a pas de plus grande bénédiction pour un arbre que de devenir la maison d'un Kodama.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Es gibt keinen größeren Segen für einen Baum, als einem Kodama ein Zuhause zu bieten.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "No hay mayor bendición para un árbol que convertirse en el hogar de un kodama.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "There's no greater blessing for a tree than to offer a home for a Kodama.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Non c'è benedizione più grande per un albero che offrire una casa a un kodama.",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH5WWW2D4NFYN8HED4NR19",
