      "translations": {
        "de_DE": {
          "text": "Der Wald gibt immer etwas zurück. Man muss nur wissen, wo man suchen muss.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Si sabes dónde buscar, el bosque siempre te devuelve lo que le ofreces.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "The forest always gives back, when you know where to look.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Si on donne à la forêt, alors elle saura se montrer généreuse en retour.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "La foresta ti dà sempre qualcosa in cambio, se sai dove cercare.",
