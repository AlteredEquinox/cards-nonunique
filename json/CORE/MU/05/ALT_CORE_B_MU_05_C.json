        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Willst du mit mir eine Partie Dorfvorsteher-Jäger-Fuchs spielen? Ich verspreche, ich werde nicht schummeln!“",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "\"Want to play a game of headman-hunter-fox with me? I promise not to cheat!\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Vuoi giocare a capovillaggio, cacciatore e volpe con me? Ti prometto che non baro!\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Tu sais jouer au renard qui passe ? »",
          "locale": "fr_FR"
        },
        "es_ES": {
          "text": "«¿Alguien quiere jugar al zorro? ¡Prometo que no haré trampas!».",
          "locale": "es_ES"
        }
      },
      "id": "01HNJH5WJFHC3QEZG1HZ6FRQ72",
