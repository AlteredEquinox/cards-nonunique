      "translations": {
        "fr_FR": {
          "text": "Elle est l'âme de la forêt, la patronne de l'herboristerie. Avec herbes et racines, elle concocte de puissantes potions.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Sie ist die Seele des Waldes, die Schutzherrin der Kräutermedizin. Aus Kräutern und Wurzeln mischt sie starke Tränke.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Es el alma del bosque, la patrona de las hierbas medicinales, con las que prepara potentes pociones.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "She is the soul of the forest, the patron of herbal medicine. From herbs and roots, she mixes potent potions.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Lei è l'anima della foresta, la patrona dell'erboristeria: da erbe e radici prepara potenti pozioni.",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH5XKEA42NCDJRE1WMKZEM",
