      "translations": {
        "de_DE": {
          "text": "„Anscheinend hat Thoth mich noch nie im Duell erlebt.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Por lo visto, Thoth nunca me ha visto batirme en duelo».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"It seems Thoth has never seen me duel.\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Sembra che Thot non mi abbia mai visto duellare.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Il semblerait que Thot ne m'ait jamais vue combattre. »",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5S3CZ0GDG84WDBQQB7VE",
      "text": "\"It seems Thoth has never seen me duel.\""
