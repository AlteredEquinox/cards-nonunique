      "translations": {
        "de_DE": {
          "text": "100 Crunches, 100 Liegestütze, 100 Kniebeugen, ein 10-Kilometer-Lauf und der Wunsch, sich zu beweisen: ein ganz normaler Bravos-Trainingsmorgen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "100 abdominales, 100 flexiones, 100 sentadillas, correr 10 kilómetros y el deseo de ponerte a prueba. La típica rutina de entrenamiento matutino en Bravos.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "100 crunches, 100 push-ups, 100 squats, a 10-km run and a desire to prove yourself. Just your typical morning of Bravos training.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "100 pompes, 100 abdos, 100 squats,10 km de course à pied et le désir de faire ses preuves : l'entraînement typique des Bravos. ",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "100 addominali, 100 flessioni, 100 squat, 10 chilometri di corsa e il desiderio di metterti alla prova: una tipica mattinata di allenamento dei Bravos.",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH5SPV7936770CVW6NKWDF",
      "text": "100 crunches, 100 push-ups, 100 squats, a 10-km run and a desire to prove yourself. Just your typical morning of Bravos training."
