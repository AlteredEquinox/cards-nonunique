        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"We will be the arrow that pierces the veil of the unknown, the torch that banishes the mists of ignorance!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wir werden der Pfeil sein, der den Schleier des Unbekannten durchstößt, und die Fackel, die die Nebel der Unwissenheit vertreibt!“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«¡Seremos la flecha que atraviesa el velo de lo desconocido, la antorcha que destierra las nieblas de la ignorancia!».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Nous serons la flèche qui percera le voile de l’inconnu, le flambeau qui bannira les brumes de l’ignorance ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Saremo la freccia che squarcia il velo dell'ignoto, la torcia che allontana la nebbia dell'ignoranza!\"",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH5RZXFWNK68TG1D7FCXPS",
      "text": "\"We will be the arrow that pierces the veil of the unknown, the torch that banishes the mists of ignorance!\""
    }
  ],
