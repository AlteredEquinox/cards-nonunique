      "translations": {
        "de_DE": {
          "text": "Bedenke gut, was du dir wünschst. Es gibt Herausforderungen, die selbst die Bravos lieber vermeiden.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Ten cuidado con lo que deseas. Hay desafíos que incluso en Bravos prefieren evitar.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Be careful what you wish for. There are challenges that even the Bravos prefer to avoid.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Attention à ce que tu souhaites. Il est des dangers que même les Bravos préfèrent éviter.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Bisogna stare attenti a ciò che si desidera. Ci sono sfide che persino i Bravos preferiscono evitare.",
