        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Indes viel Raumes uns sondert, waldbeschattete Berg‘, und des Meers weitrauschende Wogen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«La parte más pesada de la impetuosa guerra la sostienen mis manos».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"Many things lie between us - shadowy mountains and sounding sea.\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Sono fra l’isola e loro molte montagne ombrose, e il mare dall’eco sonora.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Une mer tumultueuse et des montagnes ombragées d'arbres nous séparent. »",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5SDDHC7T85RD6R021WXZ",
      "text": "\"Many things lie between us - shadowy mountains and sounding sea.\""
    }
