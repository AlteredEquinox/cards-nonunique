        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"I only feel alive when I hear the wind whistling in my ears.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Ich fühle mich nur lebendig, wenn ich den Wind in meinen Ohren pfeifen höre.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«El único momento en que me siento viva es cuando escucho el viento silbar en mis oídos».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Mi sento viva solo quando odo il vento soffiare nelle mie orecchie.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Je ne me sens vivante que quand j'entends le vent siffler à mes oreilles. »",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5RMMVA287DYJ324JJFR1",
      "text": "\"I only feel alive when I hear the wind whistling in my ears.\""
    }
  ],
