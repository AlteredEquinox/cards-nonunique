              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Personnage de Coût de Main supérieur ou égal à mon nombre de compteurs Héroïsme — Piochez une carte et je gagne 1 compteur Héroïsme.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Charakter spielst, dessen Handkosten größer oder gleich meiner Anzahl an Heldentumszählern sind — Ziehe eine Karte und ich erhalte 1 Heldentumszähler.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "When you play a Character with Hand Cost greater than or equal to my number of Heroism counters — Draw a card and I gain 1 Heroism counter.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un personaje con coste desde la mano superior o igual a mi número de contadores de heroísmo — Tú robas una carta y yo gano 1 contador de heroísmo.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando giochi un personaggio con costo dalla mano pari o superiore al numero dei miei segnalini Eroismo — Pesca 1 carta e ottengo un segnalino Eroismo.",
                    "locale": "it_IT"
                  }
                },
                "text": "When you play a Character with Hand Cost greater than or equal to my number of Heroism counters — Draw a card and I gain 1 Heroism counter."
              }
            ],
