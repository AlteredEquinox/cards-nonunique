                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Se stai per tirare uno o più dadi, tira invece altrettanti dadi più uno e ignora un tiro a tua scelta.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Si fueses a tirar un dado o más, tira esa cantidad de dados más uno e ignora el dado que quieras.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Si vous deviez lancer au moins un dé, lancez un dé supplémentaire et ignorez le résultat du dé de votre choix.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Falls du einen oder mehrere Würfel werfen würdest, wirf zusätzlich einen mehr und ignoriere den Wurf deiner Wahl.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "If you would roll one or more dice, instead roll that many dice plus one and ignore the roll of your choice.",
                    "locale": "en_US"
                  }
                },
