            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "• 2-5, gana 1 potenciador. (Un potenciador es un contador +1\/+1\/+1. Retíralo cuando abandone la zona de expedición.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "• 2-5, it gains 1 boost. (A boost is a +1\/+1\/+1 counter. Remove it when it leaves the Expedition zone.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "• 2–5 erhält er 1 Verstärkung. (Eine Verstärkung ist ein +1\/+1\/+1-Zähler. Entferne sie, wenn sie die Expeditionszone verlässt.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "• 2-5, ottiene 1 rinforzo. (Un rinforzo è un segnalino +1\/+1\/+1. Rimuovilo quando lascia l'area delle spedizioni.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "• 2-5, il gagne 1 boost. (Un boost est un compteur +1\/+1\/+1. Retirez-le lorsqu'il quitte la zone d'Expédition.)",
                    "locale": "fr_FR"
                  }
                },
                "text": "• 2-5, it gains 1 boost. (A boost is a +1\/+1\/+1 counter. Remove it when it leaves the Expedition zone.)"
              }
            ],
            "reference": "09760"
