      "translations": {
        "de_DE": {
          "text": "Ob Eidolon oder Mensch, wir alle sind von Geschichten geformt. Sie sind die Bausteine unserer Identität.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Eidolones o humanos, a todos nos dan forma las historias. Son las piezas con las que se construye nuestra identidad.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Eidolon ou humain, nous sommes tous façonnés par les histoires. Ce sont elles qui font de nous qui nous sommes.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Eidolon o umani, siamo tutti plasmati da storie. Sono i mattoni della nostra identità.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Eidolon or human, we are all shaped by stories. ",
          "locale": "en_US"
        }
      },
