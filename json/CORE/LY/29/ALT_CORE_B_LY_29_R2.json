        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Wenn die Zeit des Kalann Mae gekommen ist, fühlen sich die Lyra alle an einen Ort gerufen, an dem sie ein Meisterwerk zum Leben erwecken werden.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Cuando llega la hora del Kalann Mae, todos los de Lyra sienten la llamada a un lugar en el que podrán dar vida a una obra maestra.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "When the time of the Kalann Mae comes, the Lyra all feel the call to a single place, where they will bring a masterpiece to life.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Quand vient le temps du Kalann Mae, les Lyra se sentent appelés vers un même lieu pour y faire naître un chef-d'œuvre.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Quando arriva il momento del Kalann Mae, tutti i Lyra sentono la chiamata per un unico luogo, dove daranno vita a un capolavoro.",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH5W37V2PVVB16SCZCDARB",
      "text": "When the time of the Kalann Mae comes, the Lyra all feel the call to a single place, where they will bring a masterpiece to life."
    }
  ],
