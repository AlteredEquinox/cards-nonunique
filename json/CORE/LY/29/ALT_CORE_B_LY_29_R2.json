                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "At Dusk, if you control a [FLEETING] Character, another [ANCHORED] Character and yet another [ASLEEP] Character — You win the game.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Zum Abend, falls du einen Charakter mit [FLEETING], einen anderen Charakter mit [ANCHORED] und einen dritten Charakter mit [ASLEEP] kontrollierst — Du gewinnst das Spiel.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Al crepuscolo, se controlli un personaggio con [FLEETING], un altro personaggio con [ANCHORED] e un terzo personaggio con [ASLEEP] — Vinci la partita.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Al anochecer, si controlas un personaje con [FLEETING], otro con [ANCHORED] y un tercero con [ASLEEP] — Ganas la partida.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Au Crépuscule, si vous contrôlez un Personnage [FLEETING], un autre Personnage [ANCHORED], et encore un Personnage [ASLEEP] — vous gagnez la partie.",
                    "locale": "fr_FR"
                  }
                },
                "text": "At Dusk, if you control a [FLEETING] Character, another [ANCHORED] Character and yet another [ASLEEP] Character — You win the game."
              }
