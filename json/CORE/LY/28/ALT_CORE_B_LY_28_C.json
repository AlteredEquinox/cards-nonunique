                "translations": {
                  "de_DE": {
                    "text": "Alle Charaktere, die du kontrollierst, wechseln die Expeditionen. (Sie verlassen ihre Expeditionen und schließen sich der anderen Expedition des kontrollierenden Spielers an.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Tutti i personaggi che controlli cambiano spedizione. (Lasciano la loro spedizione e si uniscono all'altra spedizione del loro controllore.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Todos los personajes que controles se trasladan de expedición. (Abandonan su expedición y se incorporan a la otra expedición de su controlador.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Chaque Personnage que vous contrôlez change d'Expédition. (Il quitte son Expédition et rejoint l'autre Expédition de son contrôleur.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "All Characters you control switch Expeditions. (They leave their Expeditions and join their controller's other Expedition.)",
                    "locale": "en_US"
                  }
                },
                "text": "All Characters you control switch Expeditions. (They leave their Expeditions and join their controller's other Expedition.)"
