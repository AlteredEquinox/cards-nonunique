        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Wer nach außen schaut, träumt. Wer nach innen schaut, erwacht.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Quien mira hacia fuera sueña, quien mira hacia adentro despierta.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Who looks outside, dreams; who looks inside, awakes.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Celui qui regarde à l'extérieur rêve, celui qui regarde à l'intérieur s'éveille.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Chi guarda fuori, sogna. Chi guarda dentro, si sveglia.",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH5VY634YPPY6WAW0XFYQE",
      "text": "Who looks outside, dreams; who looks inside, awakes."
    }
  ],
