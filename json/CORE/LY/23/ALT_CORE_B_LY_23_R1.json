                  {
                    "cardKeyword": {
                      "translations": {
                        "de_DE": {
                          "displayWeb": "Schlafend",
                          "locale": "de_DE",
                          "description": "Am Abend ignoriere meine Statistiken. Während der Ruhepause gehe ich nicht in die Reserve und verliere Schlafend."
                        },
                        "it_IT": {
                          "displayWeb": "Dormiente",
                          "locale": "it_IT",
                          "description": "Durante il crepuscolo, ignora le mie statistiche. Durante il riposo, non vado nella Riserva e perdo Dormiente."
                        },
                        "en_US": {
                          "displayWeb": "Asleep",
                          "locale": "en_US",
                          "description": "During Dusk, ignore my statistics. During Rest, I don't go to Reserve and I lose Asleep."
                        },
                        "fr_FR": {
                          "displayWeb": "Endormi",
                          "locale": "fr_FR",
                          "description": "Ignorez mes statistiques pendant le Crépuscule. Au Repos, je ne vais pas en Réserve et je perds Endormi."
                        },
                        "es_ES": {
                          "displayWeb": "Sueño",
                          "locale": "es_ES",
                          "description": "Durante el anochecer, ignora mis estadísticas. Durante el descanso, no voy a la reserva y pierdo sueño."
                        }
                      },
                      "id": "01HKAGPDSXJC9J9QJ4Y1DBK28E",
                      "reference": "ASLEEP"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01HTS90SJFPTCN0N8Y2VGH49A9"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#All Characters in target Expedition# gain [ASLEEP]. (This only affects one player's Characters. During Dusk, ignore their statistics. During Rest, they don't go to Reserve and they lose Asleep.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "#Alle Charaktere in einer Expedition deiner Wahl# erhalten [ASLEEP]. (Dies betrifft nur die Charaktere eines Spielers. Am Abend ignoriere ihre Statistiken. Während der Ruhepause gehen sie nicht in die Reserve und verlieren Schlafend.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#Todos los personajes de la expedición objetivo# ganan [ASLEEP]. (Esto afecta solo a los personajes de un mismo jugador. Durante el anochecer, ignora sus estadísticas. Durante el descanso, no va a la reserva y pierde sueño.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "#Chaque Personnage dans une Expédition ciblée# gagne [ASLEEP]. (Cela affecte les personnages d'un seul joueur. Au Crépuscule, ignorez leurs statistiques. Au Repos, ils ne vont pas en Réserve et ils perdent Endormi.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "#Tutti i personaggi in una spedizione bersaglio# ottengono [ASLEEP]. (Si applica solo ai personaggi di un giocatore. Durante il crepuscolo, ignora le sue statistiche. Durante il riposo, non va nella Riserva e perde Dormiente.)",
                    "locale": "it_IT"
                  }
                },
                "text": "#All Characters in target Expedition# gain [ASLEEP]. (This only affects one player's Characters. During Dusk, ignore their statistics. During Rest, they don't go to Reserve and they lose Asleep.)"
              }
            ],
            "reference": "09762"
          },
