        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "Son corps se met à se désagréger alors qu’elle rompt tous les ponts de Mana qui lient son essence à la matière.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Ihr Wesen beginnt sich aufzulösen, während sie alle Mana-Brücken hinter sich abbricht, die das Konzept des eigenen Selbst mit der physischen Materie verbinden.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Su cuerpo empieza a desintegrarse mientras rompe todos los puentes de maná que vinculan la idea de su ser a su forma física.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Her being begins to disintegrate as she breaks all the Mana bridges linking the idea of who she is to physical matter.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Il suo essere inizia a disintegrarsi non appena rompe tutti i ponti di mana che collegano l'idea che ha di sé con la materia fisica.",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH65QRSRNXX5PEER17A0A8",
      "text": "Her being begins to disintegrate as she breaks all the Mana bridges linking the idea of who she is to physical matter."
    }
  ],
