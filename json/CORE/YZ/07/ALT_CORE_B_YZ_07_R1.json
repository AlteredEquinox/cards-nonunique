      },
      "translations": {
        "fr_FR": {
          "text": "« N'attendez pas que la magie vienne à vous, créez la vôtre ! »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Warte nicht einfach darauf, dass etwas Magisches passiert. Erschaffe deinen eigenen Zauber!“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«No esperes a que la magia se aparezca en tu vida. ¡Hazla tú!».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"Don't just wait for magic to happen. Go out and make your own!\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Non stare ad aspettare che la magia accada. Vai là fuori e creala!\"",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH63TCTTVGFW2N5TD45HRW",
      "text": "\"Don't just wait for magic to happen. Go out and make your own!\""
