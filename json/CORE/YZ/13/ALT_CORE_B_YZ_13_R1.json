      },
      "translations": {
        "de_DE": {
          "text": "„Eine gute Tat verdient eine weitere.“",
          "locale": "de_DE"
        },
        "es_ES": { "text": "«Tu turno de ayudar».", "locale": "es_ES" },
        "en_US": {
          "text": "\"One good turn deserves another.\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Se tu conoscessi il tempo come lo conosco io, non diresti che lo perdiamo.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Je parie que vous n’avez jamais parlé au Temps. — Cela se peut bien, répliqua prudemment Alice, mais je l’ai souvent mal employé. »",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH64QV66G24GQ4ZCQK7AFB",
      "text": "\"One good turn deserves another.\""
    }
