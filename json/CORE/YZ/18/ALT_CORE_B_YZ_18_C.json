      "translations": {
        "fr_FR": {
          "text": "Face à une entité aussi imposante, il est naturel de prendre un peu de recul sur la situation.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Wenn ein solch furchterregendes Wesen in deinem Weg steht, ist es nur natürlich, einen Schritt zurückzutreten.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Cuando un ser tan terrorífico aparece en tu camino, dar un paso atrás es la reacción natural.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "When such a terrifying being appears in your path, taking a step back is only natural.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Quando un essere tanto terrificante appare sul tuo cammino, fare un passo indietro è più che naturale.",
