        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "Le Kraken éventre la surface, projetant aux alentours des panaches d’eau qui retombent sur les troupes en un déluge de fin du monde.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Der Krake durchbricht die Oberfläche und schickt Wasserfontänen in einer apokalyptischen Sintflut auf die Truppen herab.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "El Kraken rompe la superficie, arrojando olas que aplastan a los soldados como un diluvio apocalíptico.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "The Kraken tears open the surface, sending plumes of water crashing down on the troops in an apocalyptic deluge.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Il Kraken lacera la superficie, lanciando getti d'acqua che si infrangono sulle truppe in un diluvio apocalittico.",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH659S6C8AZ7HM0Z95D4RC",
      "text": "The Kraken tears open the surface, sending plumes of water crashing down on the troops in an apocalyptic deluge."
    }
