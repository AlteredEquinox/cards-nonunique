                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{D}: Il prossimo incantesimo che giochi in questo turno costa {1} in meno. (Scartami dalla Riserva per eseguire questa azione.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{D}: El siguiente hechizo que juegues este turno cuesta {1} menos. (Descártame de la reserva para hacer esto.)",
