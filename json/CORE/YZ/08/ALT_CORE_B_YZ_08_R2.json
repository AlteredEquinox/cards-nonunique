      },
      "translations": {
        "de_DE": {
          "text": "Sie wird die Zukunft nicht in den Sternen lesen – sie wird sie persönlich verändern.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "No lee el futuro en las estrellas: elige cuál será.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "She won't read the future in the stars, she'll change it herself.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Non leggerà il futuro nelle stelle; lo cambierà lei stessa.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Elle ne lira pas l'avenir dans les étoiles, elle changera elle-même sa destinée.",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH63Z0PT7CTE7FFNX9BZQT",
      "text": "She won't read the future in the stars, she'll change it herself."
