        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "Les Bakus gobent les rêves comme d'autres gobent les fantômes.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Ich habe es mit eigenen Augen gesehen! ‚Baku! Baku!‘, ruft es und verspeist Geister, als wären es Bonbons.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«¡En serio! Dice \"baku, baku\" y se traga los fantasmas como si fueran caramelos».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"I’ve seen it myself! ‘Baku! Baku!’, it says, eating up ghosts as though they were candies.\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"L'ho visto con i miei occhi! 'Baku! Baku!', dice, divorando i fantasmi come fossero caramelle.\"",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH648SF8R8F3CCDJF01N9J",
      "text": "\"I’ve seen it myself! ‘Baku! Baku!’, it says, eating up ghosts as though they were candies.\""
    }
  ],
