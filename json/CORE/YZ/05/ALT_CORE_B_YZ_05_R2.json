          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "#Quando un Robot si unisce alle tue spedizioni — Puoi sacrificarmi per conferirgli 2 rinforzi.#",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "#Wenn ein Roboter sich deinen Expeditionen anschließt — Du darfst mich opfern, um ihm 2 Verstärkungen zu geben.#",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "#Lorsqu'un Robot rejoint vos Expéditions — Vous pouvez me sacrifier pour lui donner 2 boosts.#",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "#Cuando un robot se incorpore a una de tus expediciones — Puedes sacrificarme para darle 2 potenciadores.#",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "#When a Robot joins your Expeditions — You may sacrifice me to give it 2 boosts.#",
                    "locale": "en_US"
                  }
                },
                "text": "#When a Robot joins your Expeditions — You may sacrifice me to give it 2 boosts.#"
              }
            ],
            "reference": "09761"
          },
          "sequence": 0,
          "id": "01K1Z7KEAP1XXJ0AR0VHKGPS7R"
        },
        {
          "cardElement": "\/card_elements\/01K1Z7KDVWSRZEDJ8D4HVAQZDQ",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [
                  {
                    "cardKeyword": {
                      "translations": {
                        "en_US": {
                          "displayWeb": "Fleeting",
                          "locale": "en_US",
                          "description": "Send me to Discard instead of Reserve after my effect resolves."
                        },
                        "de_DE": {
                          "displayWeb": "Vergänglich",
                          "locale": "de_DE",
                          "description": "Lege mich auf die Ablage statt in die Reserve, nachdem mein Effekt abgeklungen ist."
                        },
                        "it_IT": {
                          "displayWeb": "Fugace",
                          "locale": "it_IT",
                          "description": "Mandami negli Scarti invece che nella Riserva dopo che il mio effetto si è risolto."
                        },
                        "es_ES": {
                          "displayWeb": "Fugacidad",
                          "locale": "es_ES",
                          "description": "Una vez resuelto mi efecto, envíame a la pila de descartes en lugar de a la reserva."
                        },
                        "fr_FR": {
                          "displayWeb": "Fugace",
                          "locale": "fr_FR",
                          "description": "Envoyez-moi à la Défausse plutôt qu'en Réserve une fois mon effet résolu."
                        }
                      },
                      "id": "01HKAGPHBY4EPW8TR9VTCHZG5Q",
                      "reference": "FLEETING"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01J7KEP06W9DSN1PJ2GMMHVX5F"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Wenn ich geopfert werde und falls ich dabei nicht [FLEETING] war — Lege mich in die Reserve.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando me sacrifiques, si no tenía [FLEETING] — Colócame en la reserva.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando mi sacrifichi, se non avevo [FLEETING] — Mettimi nella Riserva.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When I'm sacrificed, if I was not [FLEETING] — Put me in Reserve.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je suis sacrifiée, si je n'étais pas [FLEETING] — Mettez-moi en Réserve.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When I'm sacrificed, if I was not [FLEETING] — Put me in Reserve."
              }
            ],
