                  },
                  "es_ES": {
                    "text": "Cuando me sacrifiques, si no tenía [FLEETING] — Colócame en la reserva.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando mi sacrifichi, se non avevo [FLEETING] — Mettimi nella Riserva.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When I'm sacrificed, if I was not [FLEETING] — Put me in Reserve.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je suis sacrifiée, si je n'étais pas [FLEETING] — Mettez-moi en Réserve.",
