                "translations": {
                  "en_US": {
                    "text": "If you have less than eight Mana Orbs, [BOOSTED_TKN_P] tokens you control are [DEFENDER_TKN_P]. (Their Expeditions can't move forward during Dusk.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Si vous avez moins de huit Orbes de Mana, les jetons [BOOSTED_TKN_P] que vous contrôlez sont [DEFENDER_TKN_P]. (Leurs Expéditions ne peuvent pas avancer au Crépuscule.)",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Se hai meno di otto sfere di mana, le pedine con [BOOSTED_TKN_P] che controlli hanno [DEFENDER_TKN_P]. (Le loro spedizioni non possono avanzare durante il crepuscolo.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Si tienes menos de ocho orbes de maná, las fichas [BOOSTED_TKN_P] que controles tienen [DEFENDER_TKN_P]. (Sus expediciones no pueden avanzar durante el anochecer.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Falls du weniger als acht Manakugeln hast, sind Marken mit [BOOSTED_TKN_P], die du kontrollierst, [DEFENDER_TKN_P]. (Ihre Expeditionen können sich am Abend nicht vorwärts bewegen.)",
                    "locale": "de_DE"
                  }
                },
                "text": "If you have less than eight Mana Orbs, [BOOSTED_TKN_P] tokens you control are [DEFENDER_TKN_P]. (Their Expeditions can't move forward during Dusk.)"
