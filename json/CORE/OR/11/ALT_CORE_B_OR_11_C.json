      },
      "translations": {
        "fr_FR": {
          "text": "« N'abandonne jamais. Personne ne sait de quoi demain sera fait. »",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Gib nicht auf. Niemand weiß, was als Nächstes geschehen wird.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«No te rindas nunca. Nadie sabe lo que te deparará el mañana».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"Never give up. No one knows what’s going to happen next.\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Non arrenderti mai. Nessuno sa cosa sta per succedere.\"",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH601K3VJ0TKZ5HXKMA9FN",
      "text": "\"Never give up. No one knows what’s going to happen next.\""
