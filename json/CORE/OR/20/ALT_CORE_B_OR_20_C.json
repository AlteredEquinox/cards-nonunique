      },
      "translations": {
        "es_ES": {
          "text": "Solo un corazón más liviano que una pluma podrá superar el juicio de Anubis.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Seul un cœur aussi léger qu'une plume saura se mesurer au jugement d'Anubis.",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "Nur ein Herz, das so leicht wie eine Feder ist, kann dem Urteil von Anubis standhalten.",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "Only a heart as light as a feather can stand up to the judgment of Anubis.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Solo un cuore leggero come una piuma può tenere testa al giudizio di Anubi.",
