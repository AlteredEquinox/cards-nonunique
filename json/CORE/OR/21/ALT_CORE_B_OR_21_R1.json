                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "#Karten#, die dein Gegner spielt, können nicht weniger als {2} kosten. (Falls sie weniger kosten würden, kosten sie stattdessen {2}.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Les #cartes# jouées par vos adversaires ne peuvent pas coûter moins de {2}. (Si elles coûtent moins, elles coûtent {2} à la place.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "#Cards# your opponents play can't cost less than {2}. (If they would cost less, they cost {2} instead.)",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Le #carte# giocate dai tuoi avversari non possono avere un costo inferiore a {2}. (Se il loro costo è inferiore, costano invece {2}.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "#Las cartas# que jueguen tus oponentes no pueden costar menos de {2}. (Si fueran a costar menos, en vez de eso, cuestan {2}).",
                    "locale": "es_ES"
                  }
                },
                "text": "#Cards# your opponents play can't cost less than {2}. (If they would cost less, they cost {2} instead.)"
