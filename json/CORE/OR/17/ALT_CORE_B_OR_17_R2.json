                "translations": {
                  "it_IT": {
                    "text": "Quando lascio l'area delle spedizioni — Crea una pedina #Robot [BRASSBUG]# in ciascuna delle tue spedizioni.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque je quitte la zone d'Expédition — Créez un jeton #Robot [BRASSBUG]# dans chacune de vos Expéditions.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ich die Expeditionszone verlasse — Erschaffe eine #[BRASSBUG]-Robotermarke# in jeder deiner Expeditionen.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando abandone la zona de expedición — Crea una ficha de #robot [BRASSBUG]# en cada una de tus expediciones.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When I leave the Expedition zone — Create a #[BRASSBUG] Robot# token in each of your Expeditions.",
