      },
      "translations": {
        "de_DE": {
          "text": "„Auch das Dunkel entnahm ich den Augen dir, welches sie deckte.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Aparté la niebla que cubría tus ojos».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"I’ve lifted the mist from off your eyes that’s blurred them up to now.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« J'ai dissipé le nuage qui couvrait tes yeux. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Ti ho anche tolto dagli occhi la nebbia che prima avevi.\"",
          "locale": "it_IT"
        }
      },
      "id": "01HNJH5QQZ6KKAN7AVD2B3ACAK",
      "text": "\"I’ve lifted the mist from off your eyes that’s blurred them up to now.\""
