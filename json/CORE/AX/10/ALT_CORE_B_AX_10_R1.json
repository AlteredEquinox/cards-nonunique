{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Dieses Material wird nicht von der Schwerkraft beeinflusst. Wenn wir das Aerolit nutzen, könnten wir schwebende Schiffe und Städte bauen und zu den Wolken fliegen ...“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Este aerolito no parece verse afectado por la gravedad. Si explotamos sus propiedades, podríamos crear barcos y ciudades flotantes y volar junto a las nubes...».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"This material does not seem to be affected by gravity. By harnessing the properties of this Aerolith, we could create flying ships and cities, and fly close to the clouds...\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Sembra che la forza di gravità non abbia effetto su questo aerolite. Potremmo creare navi e città volanti e volteggiare verso le nuvole...\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« L'Aérolithe ne semble pas affectée par la gravité. En domestiquant ses propriétés, nous pourrions créer des vaisseaux et des villes volantes, tutoyer les nuages... »",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5QEJSR3FSK59Z0WPJ662",
      "text": "\"This material does not seem to be affected by gravity. By harnessing the properties of this Aerolith, we could create flying ships and cities, and fly close to the clouds...\""
    }
  ],
