        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Am effektivsten geht man etwas an, indem man es einfach angeht.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«La forma más eficaz de hacer algo es hacerlo».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"The most effective way to do it, is to do it.\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"Il modo più efficace di fare qualcosa è... farlo.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« La façon la plus efficace de le faire, c'est de le faire. »",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5QFP8ECHG706NPA72JCR",
      "text": "\"The most effective way to do it, is to do it.\""
    }
