        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Das Eindämmen des Tumults hindert andere Alterer gelegentlich daran, ihre Eidola zu materialisieren. Bedauerlich, aber notwendig.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "A veces, mantener a raya el Tumulto impide que otros Alteradores materialicen sus eidolones. Una pena, pero es necesario.",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "Pushing back the Tumult sometimes prevents other Alterers from materializing their Eidolons. Regrettable, but necessary.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "A volte frenare il Tumulto impedisce agli altri alterer di far materializzare i loro eidolon. Spiacevole, ma necessario.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Repousser le Tumulte empêche parfois d'autres Altérateurs de matérialiser leurs Eidolons. Un mal nécessaire.",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5QMDYHJDAXPH1BM1GJPT",
      "text": "Pushing back the Tumult sometimes prevents other Alterers from materializing their Eidolons. Regrettable, but necessary."
    }
