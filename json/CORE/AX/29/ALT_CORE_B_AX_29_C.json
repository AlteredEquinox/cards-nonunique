                "translations": {
                  "de_DE": {
                    "text": "{T} : Der nächste Charakter, den du in dieser Runde aus deiner Hand spielst, aktiviert seine {r} Fähigkeiten (als wäre er aus der Reserve gespielt worden).",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "{T} : Le prochain Personnage que vous jouez de votre main ce tour-ci active ses capacités {r} (comme s'il avait été joué depuis la Réserve).",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "{T}: El siguiente personaje que juegues desde tu mano este turno activa sus habilidades {r} (como si se hubiera jugado desde la reserva.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{T} : The next Character you play from your hand this turn activates its {r} abilities (as if it had been played from Reserve).",
