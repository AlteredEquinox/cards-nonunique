      "translations": {
        "en_US": {
          "text": "What could possibly go wrong with an adorable little self-replicating autonomous robot?",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Was könnte bei einem so niedlichen kleinen, selbst reproduzierenden, autonomen Roboter schon schiefgehen?",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "No es más que un adorable robot autónomo capaz de autorreplicarse. ¿Qué podría salir mal?",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Un petit robot autonome, mignon, autoréplicateur... Qu'est-ce qui pourrait mal se passer ?",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Cosa mai potrebbe andare storto con un piccolo e adorabile robot autonomo autoreplicante?",
