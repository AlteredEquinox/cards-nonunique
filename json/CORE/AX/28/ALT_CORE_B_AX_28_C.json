        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"In a jam? Sorry, mate. Maybe a side effect of our scrambling...\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Eine Störung? Tut mir leid, Kumpel. Vielleicht ein Nebeneffekt unserer Aktivitäten ...“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Siento que nuestras inter-ferencias te hayan inter-rumpido, colega».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Sei nei guai? Mi dispiace, collega. Forse è un effetto collaterale dell'aver disturbato le frequenze...\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Désolé, mon pote. C'est pas qu'on cherche la brouille. Ça doit être un effet secondaire de notre blocage... »",
          "locale": "fr_FR"
        }
      },
      "id": "01HNJH5R5W4B0M7YTWFAY9DNGD",
      "text": "\"In a jam? Sorry, mate. Maybe a side effect of our scrambling...\""
    }
  ],
