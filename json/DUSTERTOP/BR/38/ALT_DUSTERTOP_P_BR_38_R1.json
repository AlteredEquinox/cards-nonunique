          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When I gain 1 or more boosts — You may exhaust ({T}) target card in Reserve. (Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je gagne au moins 1 boost — Vous pouvez épuiser ({T}) une carte ciblée en Réserve. (Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ich mindestens 1 Verstärkung erhalte — Du darfst eine Karte deiner Wahl in der Reserve erschöpfen ({T}). (Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando ottengo 1 o più rinforzi — Puoi consumare ({T}) una carta bersaglio nella Riserva. (Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando gane 1 potenciador o más — Puedes agotar ({T}) una carta objetivo en reserva. (Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo).",
                    "locale": "es_ES"
                  }
                },
                "text": "When I gain 1 or more boosts — You may exhaust ({T}) target card in Reserve. (Exhausted cards can't be played and have no Support abilities.)"
              }
            ],
            "reference": "02098"
