                    "id": "01HTS9E1W0Z3ZVTQ6M51S0WKQR"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Un Personnage ciblé gagne [ASLEEP]. #Vous pouvez lui faire gagner 2 boosts.# (Au Crépuscule, ignorez ses statistiques. Au Repos, il ne va pas en Réserve et il perd Endormi.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Un personaje objetivo gana [ASLEEP]. #Puedes darle 2 potenciadores.# (Durante el anochecer, ignora sus estadísticas. Durante el descanso, no va a la reserva y pierde sueño.)",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Ein Charakter deiner Wahl erhält [ASLEEP]. #Du darfst ihm 2 Verstärkungen geben#. (Am Abend ignoriere seine Statistiken. Während der Ruhepause geht er nicht in die Reserve und verliert Schlafend.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Un personaggio bersaglio ottiene [ASLEEP]. #Puoi conferirgli 2 rinforzi.# (Durante il crepuscolo, ignora le sue statistiche. Durante il riposo, non va nella Riserva e perde Dormiente.)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "Target Character gains [ASLEEP]. #You may give it 2 boosts.# (During Dusk, ignore its statistics. During Rest, it doesn't go to Reserve and it loses Asleep.)",
                    "locale": "en_US"
                  }
                },
                "text": "Target Character gains [ASLEEP]. #You may give it 2 boosts.# (During Dusk, ignore its statistics. During Rest, it doesn't go to Reserve and it loses Asleep.)"
              }
