                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "#{J}# Ogni giocatore mette la prima carta del suo mazzo nella propria area del mana (come una sfera di mana consumata).",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "#{J}# Jeder Spieler legt die oberste Karte seines Decks in seine Manazone (als erschöpfte Manakugel).",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "#{J}# Cada jugador coloca la primera carta de su mazo en su zona de maná (como orbe de maná agotado.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "#{J}# Chaque joueur met la carte du dessus de son deck dans sa zone de Mana (en tant qu'Orbe de Mana épuisé).",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "#{J}# Each player puts the top card of their deck in their Mana zone (as an exhausted Mana Orb).",
                    "locale": "en_US"
                  }
                },
