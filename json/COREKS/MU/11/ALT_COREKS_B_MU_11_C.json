        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "La armonía puede florecer del más pequeño acto de bondad, igual que un campo de arroz entero puede brotar de un solo grano.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Harmonie kann aus einem einzigen Akt der Freundlichkeit gedeihen, so wie ein Reisfeld aus einem einzigen Reiskorn sprießen kann.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "L'harmonie peut naître d'un simple acte de sollicitude, comme une rizière peut germer à partir d'un seul grain de riz.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "L'armonia può sbocciare da un singolo atto di bontà, come un campo di riso può germogliare da un singolo chicco.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Harmony may bloom from a single act of kindness, as a rice field may sprout from a single grain of rice.",
          "locale": "en_US"
        }
      },
      "id": "01HPME82NP5WBSGXMQEBA1F6MQ",
      "text": "Harmony may bloom from a single act of kindness, as a rice field may sprout from a single grain of rice."
