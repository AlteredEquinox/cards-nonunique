        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "«La Tierra no es herencia de nuestros padres, sino un préstamo de nuestros hijos».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Wir erben die Erde nicht von unseren Vorfahren, sondern leihen sie von unseren Kindern.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Nous n'héritons pas de la terre de nos ancêtres, nous l'empruntons à nos enfants. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Non ereditiamo la terra dai nostri antenati, la prendiamo in prestito dai nostri figli.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"We don’t inherit the earth from our ancestors, we borrow it from our children.\"",
          "locale": "en_US"
        }
      },
      "id": "01HPME820RE3P36M56HV7PJTT8",
      "text": "\"We don’t inherit the earth from our ancestors, we borrow it from our children.\""
    }
