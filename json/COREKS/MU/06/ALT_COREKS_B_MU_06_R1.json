      "translations": {
        "es_ES": {
          "text": "Hay quienes dicen que los cosechadores son los cuidadores de los árboles del mundo.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Manche behaupten, die Spindelsammler seien die Hüter der Weltenbäume.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Certains disent que les vendangeurs sont les jardiniers des arbres-mondes.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Qualcuno dice che i mietitori sono i custodi degli alberi del mondo.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Some say the harvesters are the caretakers of the world-trees.",
          "locale": "en_US"
        }
      },
      "id": "01HPME8270EFPHT8ZZFC3ZZAWB",
      "text": "Some say the harvesters are the caretakers of the world-trees."
