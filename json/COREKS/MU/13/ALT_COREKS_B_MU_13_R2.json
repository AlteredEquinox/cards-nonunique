      },
      "translations": {
        "es_ES": {
          "text": "«Somos los centinelas del Skein, sentimos constantemente el pulso de la naturaleza».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Wir sind die Wächter des Skein, immer mit einem Finger am Puls der Natur.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Nous sommes les sentinelles du Skein, toujours à l'écoute du pouls de la nature. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Siamo le sentinelle della Skein, tendiamo sempre l'orecchio a ogni segnale della natura.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"We are the sentinels of the Skein, always keeping a finger on the pulse of nature.\"",
          "locale": "en_US"
        }
      },
      "id": "01HPME82VD7DT624EQTD35Y1VZ",
      "text": "\"We are the sentinels of the Skein, always keeping a finger on the pulse of nature.\""
