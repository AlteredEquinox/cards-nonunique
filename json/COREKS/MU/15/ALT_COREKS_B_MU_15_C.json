        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "Es común verlos dormitar junto a algún estanque, empapándose de agua y luz del sol...",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Manchmal entdeckt man sie dösend in der Nähe eines Teichs, wo sie das Wasser und das Sonnenlicht genießen ... ",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "On peut parfois les voir somnoler non loin d'un étang, se gorgeant d'eau et de lumière...",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "A volte si vedono sonnecchiare vicino a un laghetto, immerse nell'acqua al tepore del sole... ",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "They're sometimes seen dozing close to a pond, soaking in the water and the sunlight... ",
          "locale": "en_US"
        }
      },
      "id": "01HPME835FPC1K39MNZ21FGVJX",
      "text": "They're sometimes seen dozing close to a pond, soaking in the water and the sunlight... "
    }
