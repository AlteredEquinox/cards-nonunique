      },
      "translations": {
        "es_ES": {
          "text": "Los árboles del mundo, como el Balaustre, crecieron de las semillas del fresno cósmico.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Weltenbäume wie die Spindel könnten aus den Samen der Kosmischen Esche entstanden sein.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Les arbres-mondes tels que le Fuseau sont peut-être issus des graines du Frêne Cosmique.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Gli alberi del mondo, come il Fuso, potrebbero aver avuto origine dai semi del Frassino Cosmico.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "World trees like the Spindle may have grown from the seeds of the Cosmic Ash.",
          "locale": "en_US"
        }
      },
