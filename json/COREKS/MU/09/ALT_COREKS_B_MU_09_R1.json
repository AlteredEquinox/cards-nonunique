        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "No hay mayor bendición para un árbol que convertirse en el hogar de un kodama.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Es gibt keinen größeren Segen für einen Baum, als einem Kodama ein Zuhause zu bieten.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Non c'è benedizione più grande per un albero che offrire una casa a un kodama.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "On le regarde avec des yeux bienveillants, sans savoir ce que l'avenir lui réserve.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "We look on with benevolent eyes, not knowing what its future holds.",
          "locale": "en_US"
        }
      },
      "id": "01HPME82FPHHFXBEFD1TZM6E6M",
      "text": "We look on with benevolent eyes, not knowing what its future holds."
    }
  ],
