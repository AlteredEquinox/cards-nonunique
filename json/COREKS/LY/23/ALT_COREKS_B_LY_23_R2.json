      },
      "translations": {
        "es_ES": {
          "text": "En el cielo y en el mar, un diamante de verdad.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Hoch über der Welt – so hoch wie ein Diamant am Himmel.",
          "locale": "de_DE"
        },
        "fr_FR": { "text": "Et le vent souffle fort.", "locale": "fr_FR" },
        "it_IT": {
          "text": "Brilla, brilla sopra noi, mi domando di chi sei.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Up above the world so high, like a diamond in the sky.",
          "locale": "en_US"
        }
      },
