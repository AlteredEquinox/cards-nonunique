                "translations": {
                  "de_DE": {
                    "text": "Ein Charakter deiner Wahl erhält [ASLEEP]. (Am Abend ignoriere seine Statistiken. Während der Ruhepause geht er nicht in die Reserve und verliert Schlafend.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Un personaggio bersaglio ottiene [ASLEEP]. (Durante il crepuscolo, ignora le sue statistiche. Durante il riposo, non va nella Riserva e perde Dormiente.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Un personaje objetivo gana [ASLEEP]. (Durante el anochecer, ignora sus estadísticas. Durante el descanso, no va a la reserva y pierde sueño.)",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Un Personnage ciblé gagne [ASLEEP]. (Au Crépuscule, ignorez ses statistiques. Au Repos, il ne va pas en Réserve et il perd Endormi.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "Target Character gains [ASLEEP]. (During Dusk, ignore its statistics. During Rest, it doesn't go to Reserve and it loses Asleep.)",
                    "locale": "en_US"
                  }
                },
