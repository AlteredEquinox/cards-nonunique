      },
      "translations": {
        "es_ES": {
          "text": "Igual que los de Bravos, los de Lyra se ven atraídos por la libertad y la búsqueda de nuevos horizontes.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Wie die Bravos zieht es auch die Lyra in die Freiheit und an ferne Horizonte.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Tout comme les Bravos, les Lyra sont attirés par la liberté et l'horizon lointain.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Come i Bravos, i Lyra sono attratti dalla libertà e dagli orizzonti distanti.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Like the Bravos, Lyras are drawn to freedom and the distant horizon.",
          "locale": "en_US"
        }
      },
      "id": "01HPME802CBY49ZR3QM93E1GVR",
      "text": "Like the Bravos, Lyras are drawn to freedom and the distant horizon."
