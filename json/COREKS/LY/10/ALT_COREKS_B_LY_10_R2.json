        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "El líquido negro trazó formas sobre la piedra y de ellas surgieron innumerables criaturas de hollín.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Die schwarze Flüssigkeit zeichnete Formen auf den Stein und aus diesen Linien erhoben sich unzählige Kreaturen aus Ruß.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Le liquide noir traça des formes sur la pierre, et de ces traits jaillirent d’innombrables créatures de suie.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Il liquido nero tracciò delle figure sulla pietra e da quelle linee scaturirono innumerevoli creature di fuliggine.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The black liquid traced shapes on the stone, and from these lines sprang innumerable creatures of soot.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7ZSG4PMH171BX9A65E15",
      "text": "The black liquid traced shapes on the stone, and from these lines sprang innumerable creatures of soot."
