      "translations": {
        "es_ES": {
          "text": "Hay momentos para ser prudentes, ¡y momentos para jugárselo todo!",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Es gibt eine Zeit der Vorsicht – und eine Zeit, in der man aufs Ganze gehen muss!",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Il y a des moments où la prudence est de mise, et d'autres pour de l'imprudence dans la mise !",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "C'è un momento per essere cauti e un momento per scommettere tutto!",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "There's a time to be cautious, and a time to bet it all!",
          "locale": "en_US"
        }
