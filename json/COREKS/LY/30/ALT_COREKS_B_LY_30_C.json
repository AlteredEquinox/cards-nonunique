        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "El puesto móvil del cuerpo de exploración se alza en las alturas como la rueda de una rueca tejiendo el viento.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "L'avant-poste mobile des Corps expéditionnaires s'élève haut, tel un rouet tissant le vent.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "L'avamposto mobile dei Corpi di Spedizione svetta in alto, come un filatoio che tesse il vento.",
          "locale": "it_IT"
        },
        "de_DE": {
          "text": "Der mobile Außenposten des Expeditionstrupps schwebt hoch in den Lüften wie ein Spinnrad, das den Wind webt.",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "The Expeditionary Corps' mobile outpost soars high, like a spinning wheel weaving the wind.",
          "locale": "en_US"
        }
      },
      "id": "01HPME81NHW1YTC62GE8NX5D2C",
      "text": "The Expeditionary Corps' mobile outpost soars high, like a spinning wheel weaving the wind."
    }
