      "translations": {
        "de_DE": {
          "text": "Die alte Welt liegt im Sterben, die neue ist noch nicht geboren. Es ist die Zeit der Monster.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "El viejo mundo se muere, el nuevo tarda en aparecer. Y en ese claroscuro surgen los monstruos.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "L'ancien monde se meurt et le nouveau monde peine à naître : voici venir l'âge des monstres.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Il vecchio mondo sta morendo e il nuovo mondo lotta per nascere: è l'era dei mostri.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The old world is dying, and the new world struggles to be born: now is the time of monsters.",
          "locale": "en_US"
        }
      },
