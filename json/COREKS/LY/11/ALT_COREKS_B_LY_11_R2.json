      },
      "translations": {
        "es_ES": {
          "text": "«Eidolón o no, eres nuestra pastora. Tú lideras, nosotros te seguimos».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Ob Eidolon oder nicht, du bist unsere Hirtin. Du führst und wir folgen.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Eidolon ou non, tu es notre Bergère. Tu guides, et nous suivons. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Eidolon o no, sei la nostra guida. Tu vai avanti, noi ti seguiamo.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Eidolon or not, you are our Shepherdess. You lead and we follow.\"",
          "locale": "en_US"
        }
      },
      "id": "01HPME7ZXA4M6WR1F1Q290TBK7",
      "text": "\"Eidolon or not, you are our Shepherdess. You lead and we follow.\""
