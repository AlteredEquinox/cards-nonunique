        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "El Kraken rompe la superficie, arrojando olas que aplastan a los soldados como un diluvio apocalíptico.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Der Krake durchbricht die Oberfläche und schickt Wasserfontänen in einer apokalyptischen Sintflut auf die Truppen herab.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Dans les abysses, personne ne vous entend crier.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "In the abyssal depths, no one can hear you scream.",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "Il Kraken lacera la superficie, lanciando getti d'acqua che si infrangono sulle truppe in un diluvio apocalittico.",
          "locale": "it_IT"
        }
      },
      "id": "01HPME8BFXS1R29D1XPWZ3PDST",
      "text": "In the abyssal depths, no one can hear you scream."
    }
  ],
