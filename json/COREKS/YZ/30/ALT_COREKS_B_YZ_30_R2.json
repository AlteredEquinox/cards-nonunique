        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "¿Qué secretos siniestros se esconden en el Colegio de magia de Asgartha? Tan solo los dementes y los de Yzmir lo saben con seguridad...",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Welche dunklen, phantasmagorischen Geheimnisse verbergen sich in Asgarthas Akademie der Magie? Nur Verrückte und die Yzmir wissen das mit Sicherheit ...",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Seuls les Yzmir et les fous savent quels fantasmagoriques et sombres secrets cache le Collège de Magie d'Asgartha.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Quali oscuri segreti fantasmagorici si celano nella Scuola di magia di Asgartha? Solo i folli e gli Yzmir lo sanno per certo...",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "What dark, phantasmagorical secrets hide within Asgartha's College of Magic? Only madmen and the Yzmirs know for sure...",
          "locale": "en_US"
        }
      },
      "id": "01HPME8DZTE6W17AQ6JAYAZY20",
      "text": "What dark, phantasmagorical secrets hide within Asgartha's College of Magic? Only madmen and the Yzmirs know for sure..."
    }
  ],
