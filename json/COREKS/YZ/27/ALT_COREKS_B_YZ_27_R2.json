      },
      "translations": {
        "de_DE": {
          "text": "Der Himmel öffnete sich in einer donnernden Welle, als der Traum auf die Welt losgelassen wurde.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Le ciel se fendit en ondes tempétueuses alors que le rêve s'épanchait sur le monde.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "The sky cracked open in a thunderous wave as the dream was unleashed upon the world.",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "El cielo se abrió con un estruendo cuando el sueño se liberó sobre el mundo.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Il cielo si spalancò in un'onda tonante quando il sogno venne liberato sul mondo.",
          "locale": "it_IT"
        }
      },
      "id": "01HPME8DCRJBW49DWRMYQGEV9M",
