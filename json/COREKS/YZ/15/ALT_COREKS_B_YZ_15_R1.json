{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "«Hay puertas que no se deben abrir, sellos que no se deben romper. Y sin embargo, yo lo haré».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Es gibt Tore, die man nicht öffnen, und Siegel, die man nicht brechen sollte. Und dennoch werde ich beides tun.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Il y a des portes que l'on ne doit pas ouvrir, des sceaux que l'on ne doit pas briser. Et pourtant, je le ferai. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Ci sono portali che non dovrebbero essere aperti e sigilli che non dovrebbero essere infranti. Eppure lo farò.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"There are gates one should not open, there are seals one should not breach. And yet I will.\"",
          "locale": "en_US"
        }
      },
      "id": "01HPME8B6ZD9SSE6BCEAQZTQ84",
      "text": "\"There are gates one should not open, there are seals one should not breach. And yet I will.\""
    }
  ],
