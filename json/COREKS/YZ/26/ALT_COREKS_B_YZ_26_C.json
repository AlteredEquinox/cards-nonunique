        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Die tosenden Wellen brachen über die angreifenden Armeen herein, und unzählige Soldaten verschwanden in den brausenden Fluten.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Les vagues rugissantes se brisèrent sur les armées qui chargeaient, et d'innombrables soldats disparurent sous les eaux en furie.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Le onde ruggenti si infransero sugli eserciti alla carica e innumerevoli soldati svanirono sotto le acque impetuose.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The roaring waves crashed down over the charging armies, and countless soldiers vanished beneath the raging waters.",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "Las olas aplastaron con fuerza al ejército en mitad de su carga, y un sinnúmero de soldados se perdieron en las profundidades del mar embravecido.",
          "locale": "es_ES"
        }
      },
      "id": "01HPME8D685RAXBXN3YZ0JA0CE",
      "text": "The roaring waves crashed down over the charging armies, and countless soldiers vanished beneath the raging waters."
    }
  ],
