                        "de_DE": {
                          "displayWeb": "",
                          "locale": "de_DE",
                          "description": "Eine Verstärkung ist ein +1\/+1\/+1-Zähler. Entferne sie, wenn sie die Expeditionszone verlässt."
                        },
                        "it_IT": {
                          "displayWeb": "",
                          "locale": "it_IT",
                          "description": "Un rinforzo è un segnalino +1\/+1\/+1. Rimuovilo quando lascia l'area delle spedizioni."
                        },
                        "es_ES": {
                          "displayWeb": "",
                          "locale": "es_ES",
                          "description": "Un potenciador es un contador +1\/+1\/+1. Retíralo cuando abandone la zona de expedición."
