                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Quando giochi un incantesimo — Un personaggio bersaglio che controlli ottiene 1 rinforzo. (Fallo dopo che l'incantesimo si è risolto.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Sort — Un Personnage ciblé que vous contrôlez gagne 1 boost$[BB]. (Faites cela après la résolution du sort.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Zauber spielst — Ein Charakter deiner Wahl, den du kontrollierst, erhält 1 Verstärkung. (Dies geschieht, wenn der Effekt abgeklungen ist.)",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "When you play a Spell — Target Character you control gains 1 boost$[BB]. (Do this after the spell resolves.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un hechizo — Un personaje objetivo que controles gana 1 potenciador. (Haz esto después de que el hechizo se resuelva.)",
                    "locale": "es_ES"
                  }
                },
                "text": "When you play a Spell — Target Character you control gains 1 boost$[BB]. (Do this after the spell resolves.)"
              }
