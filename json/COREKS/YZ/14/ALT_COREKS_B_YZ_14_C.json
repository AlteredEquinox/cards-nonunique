        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "El Rubedo es la última fase de la alquimia, el momento en que una sustancia renace como el fénix antes de regresar al mundo.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Rubedo ist die letzte Stufe der Alchemie, in der die eigene Substanz wie ein Phönix wiedergeboren wird, bevor sie in die Welt zurückkehrt.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Le Rubedo est l'étape finale de l'alchimie, où la substance d'un individu renaît tel un phénix avant de retourner au monde.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "La Rubedo è la fase finale dell'alchimia, dove la sostanza rinasce come una fenice prima di fare ritorno nel mondo.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Rubedo is the final stage of alchemy, where one's substance is reborn like a phoenix before returning to the world.",
          "locale": "en_US"
        }
      },
      "id": "01HPME8B2QHV6NK5K1BEM0CEZ5",
      "text": "Rubedo is the final stage of alchemy, where one's substance is reborn like a phoenix before returning to the world."
    }
  ],
