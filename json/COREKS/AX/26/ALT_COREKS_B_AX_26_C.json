                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "{T}, Spend 1 of my Kelon counters: the next Character you play this turn gains 1 boost.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "{T}, gastar 1 de mis contadores de kelón: el siguiente personaje que juegues este turno gana 1 potenciador.",
