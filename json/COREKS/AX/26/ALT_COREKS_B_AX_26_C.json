                "translations": {
                  "de_DE": {
                    "text": "{T}, Gib 1 meiner Kelon-Zähler aus: Der nächste Charakter, den du in dieser Runde spielst, erhält 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
