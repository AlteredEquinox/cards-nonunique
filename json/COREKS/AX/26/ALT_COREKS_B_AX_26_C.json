                  },
                  "fr_FR": {
                    "text": "{T}, dépensez 1 de mes compteurs Kélon : le prochain Personnage que vous jouez ce tour-ci gagne 1 boost.",
                    "locale": "fr_FR"
                  }
                },
                "text": "{T}, Spend 1 of my Kelon counters: the next Character you play this turn gains 1 boost."
