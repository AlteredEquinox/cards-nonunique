                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Cuando voy a la reserva desde tu mano — Puedes jugarme sin coste y gano $[ASLEEP].",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "Wenn ich aus deiner Hand in die Reserve gehe — Du darfst mich kostenlos spielen und ich erhalte $[ASLEEP].",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Lorsque je vais en Réserve depuis votre main — Vous pouvez me jouer gratuitement et je gagne $[ASLEEP].",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Quando vado nella Riserva dalla tua mano — Puoi giocarmi senza pagare il mio costo e ottengo $[ASLEEP].",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When I go to Reserve from your hand — You may play me for free and I gain $[ASLEEP].",
                    "locale": "en_US"
                  }
                },
                "text": "When I go to Reserve from your hand — You may play me for free and I gain $[ASLEEP]."
