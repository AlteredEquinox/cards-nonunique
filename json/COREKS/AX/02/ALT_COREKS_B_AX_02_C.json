      "translations": {
        "de_DE": {
          "text": "Ein Energiesystem ist ein Teil einer raffinierten Maschinerie, die für Höchstleistungen optimiert werden muss.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Todo sistema de energía es una pieza de delicada maquinaria por optimizar.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Tout système énergétique est une machinerie subtile, à optimiser pour en tirer le meilleur rendement.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Un sistema energetico è un raffinato meccanismo da ottimizzare per migliorarne il risultato.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "An energy system is a piece of subtle machinery to be optimized for better output.",
          "locale": "en_US"
        }
