      "cardEffectDisplays": [
        {
          "cardElement": "\/card_elements\/01K1Z6QC54CAXWK2R1XJTGA3BF",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Wenn eine Karte am Nachmittag deine Reserve verlässt — Falls ich weniger als 5 Schrottzähler habe, erhalte ich 1 Schrottzähler.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando una carta abandone tu reserva durante la tarde — Si tengo menos de 5 contadores de chatarra, gano 1 contador de chatarra.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando una carta lascia la tua Riserva durante il pomeriggio — Se ho meno di 5 segnalini Rottame, ottengo 1 segnalino Rottame.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When a card leaves your Reserve during the Afternoon — If I have less than 5 Scrap counters, I gain 1 Scrap counter.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'une carte quitte votre Réserve pendant l'Après-midi — Si j'ai moins de 5 compteurs Ferraille, je gagne 1 compteur Ferraille.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When a card leaves your Reserve during the Afternoon — If I have less than 5 Scrap counters, I gain 1 Scrap counter."
              }
            ],
            "reference": "00795"
          },
          "sequence": 0,
          "id": "01K1Z6QCEXG9ZHG3A9661K1F1E"
        },
        {
          "cardElement": "\/card_elements\/01K1Z6QC54CAXWK2R1XJTGA3BF",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Falls ich 5 oder mehr Schrottzähler habe, erhalte ich „{T} : Ziehe eine Karte und lege dann eine Karte aus deiner Hand in deine Reserve.“",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Se ho 5 o più segnalini Rottame, ottengo \"{T}: pesca una carta, poi metti una carta dalla tua mano nella Riserva.\"",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "If I have 5 or more Scrap counters, I gain \"{T} : Draw a card, then put a card from your hand in Reserve.\"",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Si j'ai au moins 5 compteurs Ferraille, je gagne « {T} : Piochez une carte, puis mettez une carte de votre main en Réserve. »",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Si tengo 5 contadores de chatarra o más, gano \"{T}: Roba una carta y luego coloca una carta de tu mano en la reserva\".",
                    "locale": "es_ES"
                  }
                },
                "text": "If I have 5 or more Scrap counters, I gain \"{T} : Draw a card, then put a card from your hand in Reserve.\""
              }
            ],
            "reference": "00796"
          },
          "sequence": 1,
          "id": "01K1Z6QCPN745346AVWPKMGMNC"
        }
      ],
      "value": "When a card leaves your Reserve during the Afternoon — If I have less than 5 Scrap counters, I gain 1 Scrap counter.  If I have 5 or more Scrap counters, I gain \"{T} : Draw a card, then put a card from your hand in Reserve.\"",
      "id": "01K1Z6QC54CAXWK2R1XJTGA3BF"
