        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "Pocos visitan las profundidades de la Fundición, y aún menos pueden explicar cómo fueron creados los bicholatas.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Nur wenige Menschen besuchen die Tiefen der Gießerei, und noch weniger können erklären, wie die Blechkäfer entstanden sind.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Rares sont ceux qui visitent les profondeurs de la Fonderie, et encore plus rares ceux qui savent expliquer d'où viennent les Scarabots.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Poche persone si addentrano nelle profondità della Fonderia e ancora meno riescono a spiegare l'origine delle ottonblatte.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Few people visit the depths of the Foundry, and even fewer can explain how the Brassbugs came to be.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7WTQ91JWK5QWF302TH6G",
      "text": "Few people visit the depths of the Foundry, and even fewer can explain how the Brassbugs came to be."
    }
  ],
