        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "«Las minas de Suspira pronto se agotarán. El precioso kelón dejará de manar».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Die Minen von Suspira werden bald erschöpft sein. Dann wird euer kostbares Kelon versiegen.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Les mines de Suspira seront bientôt exsangues. Votre précieux Kélon va se tarir. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Le miniere di Suspira si esauriranno presto. Il vostro prezioso Kelon si esaurirà.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Suspira's mines will soon run dry. Your precious Kelon will run dry.\"",
          "locale": "en_US"
        }
      },
      "id": "01HPME7WZ9VG9AMFBJB7S7R0F1",
      "text": "\"Suspira's mines will soon run dry. Your precious Kelon will run dry.\""
