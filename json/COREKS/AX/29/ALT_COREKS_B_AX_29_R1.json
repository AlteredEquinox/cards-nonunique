{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "Incrustada en la pared de un acantilado, se alza sobre la ciudad y recuerda a todos los que la admiran que nada es inalcanzable si pones todo tu empeño.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Eingebettet in die Felswand überblickt sie die Stadt und erinnert alle, die zu ihr hinaufschauen: Wo ein Wille ist, ist auch ein Weg.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Enchâssée dans la falaise, elle surplombe la ville, rappelant à tous ceux qui lèvent les yeux que rien n'est inaccessible si l'on s'en donne la peine.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Incastonata in una parete rocciosa, si affaccia sulla città e ricorda a chiunque la osservi che impegnandosi nulla è inarrivabile.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Embedded in the cliff wall, it overlooks the city and reminds everyone who looks up at it that nothing is unreachable if you put your mind to it.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7X2EPT39FJ3A9FBQ8AKY",
      "text": "Embedded in the cliff wall, it overlooks the city and reminds everyone who looks up at it that nothing is unreachable if you put your mind to it."
    }
  ],
