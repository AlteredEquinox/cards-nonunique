      },
      "translations": {
        "de_DE": {
          "text": "Die begrenzten Ressourcen der Axiom zwangen sie dazu, so viel wie möglich wiederzuverwenden.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Los recursos limitados de Axiom los motivan a reutilizar todo lo que puedan.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Les ressources limitées ont toujours poussé les Axiom à recycler ce qui pouvait l'être.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Vista la scarsità di risorse, gli Axiom hanno imparato a riutilizzare tutto ciò che potevano.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The Axiom's limited resources pushed them to reuse whatever they could.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7W4DP17MCCG9B4EJNEYF",
