      },
      "translations": {
        "de_DE": {
          "text": "„Auch das Dunkel entnahm ich den Augen dir, welches sie deckte.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Aparté la niebla que cubría tus ojos».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Ti ho anche tolto dagli occhi la nebbia che prima avevi.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Et, au milieu d’eux, Athéna aux yeux clairs, impérissable et immortelle. »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"Down from the skies, I come to check your rage.\"",
          "locale": "en_US"
        }
      },
      "id": "01HPME7WHC2TWYWV5NPAK9QHAW",
      "text": "\"Down from the skies, I come to check your rage.\""
    }
