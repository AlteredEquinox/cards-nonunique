      "translations": {
        "es_ES": {
          "text": "En las canteras de Suspira se cuenta una leyenda: que existe otro tipo de kelón.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "In den Steinbrüchen von Suspira hält sich eine Legende: die Existenz einer anderen Art von Kelon.",
