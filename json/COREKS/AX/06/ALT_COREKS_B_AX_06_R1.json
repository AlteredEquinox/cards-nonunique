                "translations": {
                  "en_US": {
                    "text": "{J} #You may pay {2} to create a [BRASSBUG] Robot token in target Expedition.# Then, Robots you control gain 1 boost.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "{J} #Puedes pagar {2} para crear una ficha de robot [BRASSBUG] en una expedición objetivo.# Luego, los robots que controlas ganan 1 potenciador.",
                    "locale": "es_ES"
                  },
                  "de_DE": {
                    "text": "{J} #Du darfst {2} bezahlen, um eine [BRASSBUG]-Robotermarke in einer Expedition deiner Wahl zu erschaffen.# Roboter, die du kontrollierst, erhalten dann 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{J} #Puoi pagare {2} per creare una pedina Robot [BRASSBUG] in una spedizione bersaglio.# Poi, i Robot che controlli ottengono 1 rinforzo.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{J} #Vous pouvez payer {2} pour créer un jeton Robot [BRASSBUG] dans une Expédition ciblée.# Puis, les Robots que vous contrôlez gagnent 1 boost.",
                    "locale": "fr_FR"
                  }
                },
                "text": "{J} #You may pay {2} to create a [BRASSBUG] Robot token in target Expedition.# Then, Robots you control gain 1 boost."
