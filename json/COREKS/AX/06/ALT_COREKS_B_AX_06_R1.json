      "translations": {
        "de_DE": {
          "text": "Mit jedem Schlag seines Hammers schmiedet Ogun das Schicksal der Axiom.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Con cada golpe de su martillo, Ogun forja el destino de Axiom.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "À chaque coup de marteau, Ogun forge le destin des Axiom.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Con ogni colpo di martello, Ogun forgia il destino degli Axiom.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "With every blow of his hammer, Ogun forges the Axiom's destiny.",
          "locale": "en_US"
        }
