        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Wir haben alle schon einiges durchgemacht. Aber sie hat Schlimmeres durchgemacht.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Todos hemos vivido momentos oscuros, pero ella ha sobrevivido a cosas mucho peores.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Tu penses avoir traversé ton lot d'épreuves ? J'ai connu bien pire. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Tutti abbiamo superato qualche avversità. Ma lei ha affrontato di peggio.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "We've all lived through some things. But she's been through worse.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7Y3TRKFX0TQHS0CFC2EP",
      "text": "We've all lived through some things. But she's been through worse."
