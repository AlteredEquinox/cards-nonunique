      },
      "translations": {
        "de_DE": {
          "text": "„Und nun präge dir all diese Dinge gut ein, mit weisem Herzen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Ahora medita bien en tu mente prudente estos consejos míos, uno a uno».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Et veuillez, je vous prie, retenir toutes ces choses dans un cœur averti. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"E ora, prega, racchiudi bene tutte queste cose in un cuore saggio.\" ",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"And now, pray, mark all these things well in a wise heart.\" ",
          "locale": "en_US"
        }
      },
      "id": "01HPME7XRFR5X0AGW2JVD4NGRQ",
      "text": "\"And now, pray, mark all these things well in a wise heart.\" "
