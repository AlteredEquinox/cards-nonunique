      "translations": {
        "de_DE": {
          "text": "Nicht einmal das Gewicht des Himmels konnte ihn zur Unterwerfung zwingen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Ni el peso del cielo le hará doblegarse.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Le poids du ciel ne saurait lui faire courber l'échine.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Nemmeno il peso del cielo riuscirebbe a piegarlo.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Not even the weight of the sky could make him buckle.",
          "locale": "en_US"
        }
      },
