        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Nur die begabtesten Alterer können die längst vergessenen Legenden der Menschheit zum Leben erwecken.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Pues tan solo los más prodigiosos de los Alteradores serían capaces de hacer que las leyendas más recordadas de la humanidad cobrasen vida.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Seuls les Altérateurs et Altératrices les plus doués peuvent donner vie aux légendes gravées dans la mémoire de l'humanité.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Giacché solo i più talentuosi degli alterer potevano dare vita alle leggende a lungo narrate dall'umanità.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "For only the most gifted of Alterers could bring humanity's long-remembered legends to life.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7YFSZAG7C2G6XG51KPG4",
      "text": "For only the most gifted of Alterers could bring humanity's long-remembered legends to life."
