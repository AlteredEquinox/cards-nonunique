      "translations": {
        "de_DE": {
          "text": "Ein Held kann durch seinen Gefährten Alteration praktizieren – unabhängig von der Entfernung zwischen ihnen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Un héroe puede practicar la alteración a través de su compañero, sea cual sea la distancia que los separe.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Quelle que soit la distance, un Altérateur peut se servir de son Alter Ego comme vecteur de matérialisation.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Un eroe può servirsi del suo compagno come vettore di alterazione, indipendentemente dalla distanza che li separa.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "A Hero can practice Alteration through their Companion, no matter the distance between them.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7Z09J7RTY3M6GAYD9AM5",
      "text": "A Hero can practice Alteration through their Companion, no matter the distance between them."
