        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Flammen sprühen aus seiner Hand, während er auf das Monster zustürzt und eine Spur aus glühendem Feuer hinter sich herzieht ...",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Sus manos expulsan llamas mientras cae sobre el monstruo, dejando tras de sí un rastro de fuego refulgente...",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Des flammes jaillissent de sa main alors qu’il chute en direction du monstre, laissant derrière lui une traînée incandescente...",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Le fiamme volano dalla sua mano mentre scende verso il mostro, lasciandosi dietro una scia di fuoco incandescente...",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Flames fly from his hand as he falls towards the monster, leaving a trail of glowing fire behind him...",
          "locale": "en_US"
        }
      },
      "id": "01HPME7YW1G1ZEKH5F8NXSDKSB",
      "text": "Flames fly from his hand as he falls towards the monster, leaving a trail of glowing fire behind him..."
    }
