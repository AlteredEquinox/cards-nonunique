        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "El fuego que parece extinto a menudo duerme bajo las cenizas.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Heute mag es brennen – morgen wird es Asche sein.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Le feu qui semble éteint souvent dort sous la cendre...",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Il fuoco che sembra spento spesso dorme sotto la cenere.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "It may be a fire today - tomorrow it will be ashes.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7XFRJPGJCSV67F9WD449",
      "text": "It may be a fire today - tomorrow it will be ashes."
