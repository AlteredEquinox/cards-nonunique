      "translations": {
        "de_DE": {
          "text": "Die schreckliche Bestie wich zurück und beugte sich der Macht der Bravos.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "La terrible bestia se achantó y tembló ante el poder de los de Bravos.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "La terrible bête se recroquevilla en tremblant devant la force des Bravos.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "L'orribile bestia si contrasse e indietreggiò di fronte alla potenza dei Bravos.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The terrible beast shrank and cowered before the might of the Bravos.",
          "locale": "en_US"
        }
      },
