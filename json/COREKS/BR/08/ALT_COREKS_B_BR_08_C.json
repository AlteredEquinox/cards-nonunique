        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„‚Bleib auf dem Weg‘, haben sie gesagt. Ich gehe meinen eigenen Weg!“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Dicen que es mejor no salirse del camino. ¡Yo trazo mi propio camino!».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Reste sur le chemin, qu'ils disaient. Je trace mon propre chemin ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Rimani sul sentiero, dicono. Ma il sentiero lo creo io!\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Stay on the path, they say. I make my own path!\"",
          "locale": "en_US"
        }
      },
      "id": "01HPME7XK55QBVC93SS562SD7X",
      "text": "\"Stay on the path, they say. I make my own path!\""
    }
