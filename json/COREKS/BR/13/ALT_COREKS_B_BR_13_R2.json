      "translations": {
        "de_DE": {
          "text": "„Überwinde deinen Schmerz. Aufgeben würde viel stärker schmerzen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Aguanta el dolor. Rendirse duele más».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Affronte ta douleur. Abandonner fait bien plus mal. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Sopporta il dolore. Arrendersi farebbe ancora più male.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Push through the pain. Giving up would hurt far more.\"",
          "locale": "en_US"
        }
