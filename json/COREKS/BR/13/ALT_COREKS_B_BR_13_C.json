          "text": "„Überwinde deinen Schmerz. Aufgeben würde viel stärker schmerzen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Aguanta el dolor. Rendirse duele más».",
          "locale": "es_ES"
        },
