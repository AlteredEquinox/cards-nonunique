{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Bedenke gut, was du dir wünschst. Es gibt Herausforderungen, die selbst die Bravos lieber vermeiden.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Ten cuidado con lo que deseas. Hay desafíos que incluso en Bravos prefieren evitar.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Bisogna stare attenti a ciò che si desidera. Ci sono sfide che persino i Bravos preferiscono evitare.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Pour attirer la chance, dépense de l'argent neuf pour un vieil ami, partage une vieille tradition avec un nouvel ami, et réchauffe le cœur d'un ami sincère en écrivant son nom sur les ailes d'un dragon.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "To attract good fortune, spend new coin on an old friend, share an old pleasure with a new friend, and lift up the heart of a true friend by writing his name on the wings of a dragon.",
          "locale": "en_US"
        }
      },
      "id": "01HPME7YDSEQ34WXR0B80FZD1T",
      "text": "To attract good fortune, spend new coin on an old friend, share an old pleasure with a new friend, and lift up the heart of a true friend by writing his name on the wings of a dragon."
    }
