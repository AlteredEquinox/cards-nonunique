        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "A pesar de tener todo en su contra y hacer frente a un leviatán imposiblemente colosal, la legión de Ordis cargó.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Trotz gewaltiger zahlenmäßiger Unterlegenheit und eines unvorstellbar großen Leviathans griff die Ordis-Legion an.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Nonostante il leviatano enorme e le minime probabilità di riuscita, la legione degli Ordis attaccò.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Facing terrible odds and an unfathomably huge Leviathan, the Ordis legion charged nonetheless.",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "Malgré des chances dérisoires, la légion Ordis chargea face au colossal et insondable Léviathan.",
          "locale": "fr_FR"
        }
      },
      "id": "01HPME884HWHGRRD6PR7A2T3QM",
      "text": "Facing terrible odds and an unfathomably huge Leviathan, the Ordis legion charged nonetheless."
    }
  ],
