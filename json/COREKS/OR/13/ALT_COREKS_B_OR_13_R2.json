        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Die Aegis-Wächterin öffnete das Tor und trat zur Seite, um sie durchzulassen. Dabei begrüßte sie sie mit einem Nicken.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "La Sentinelle de l’Aegis ouvrit la porte et fit un pas de côté pour la laisser passer, la saluant d’un hochement de tête.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "La sentinella dell'Aegis aprì la porta e si fece da parte per farla passare, salutandola con un cenno del capo al suo passaggio.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The Aegis Sentinel opened the door and stepped aside to let her through, acknowledging her with a nod as she passed.",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "El centinela de la Égida abrió la puerta y se echó a un lado para dejarla pasar, asintiendo mientras ella cruzaba el umbral.",
          "locale": "es_ES"
        }
      },
      "id": "01HPME86ZQHAV7ZJGHPJP7H9FQ",
      "text": "The Aegis Sentinel opened the door and stepped aside to let her through, acknowledging her with a nod as she passed."
    }
  ],
