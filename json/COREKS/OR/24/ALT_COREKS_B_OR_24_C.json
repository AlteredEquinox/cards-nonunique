        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "fr_FR": {
          "text": "À travers leur Esprit-Ruche, les Ordis font de la multitude une seule et même volonté.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Attraverso la loro mente alveare, gli Ordis trasformano i pensieri della moltitudine in una volontà unificata.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Through their Hive Mind, Ordis turns the thoughts of the multitude into a unified will.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Durch ihr kollektives Bewusstsein verwandeln die Ordis die Gedanken der Menge in einen vereinten Willen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "A través de su comunión mental, en Ordis los pensamientos de una multitud se convierten en una sola voluntad unificada.",
          "locale": "es_ES"
        }
      },
      "id": "01HPME8887CNEK6AHVWVE506WV",
      "text": "Through their Hive Mind, Ordis turns the thoughts of the multitude into a unified will."
    }
  ],
