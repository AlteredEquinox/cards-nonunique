                "translations": {
                  "it_IT": {
                    "text": "Quando la mia spedizione non avanza durante il crepuscolo — Crea #due# pedine Soldato [ORDIS_RECRUIT] in una spedizione bersaglio dopo il riposo.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Wenn meine Expedition sich am Abend nicht vorwärts bewegt — Erschaffe nach der Ruhepause #zwei# [ORDIS_RECRUIT]-Soldatenmarken in einer Expedition deiner Wahl.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Lorsque mon Expédition n'avance pas pendant le Crépuscule — Créez #deux jetons# Soldat [ORDIS_RECRUIT] dans une Expédition ciblée après le Repos.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Cuando mi expedición no logre avanzar durante el anochecer — Crea #dos# fichas de soldado [ORDIS_RECRUIT] en una expedición objetivo tras el descanso.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When my Expedition fails to move forward during Dusk — Create #two# [ORDIS_RECRUIT] Soldier tokens in target Expedition after Rest.",
