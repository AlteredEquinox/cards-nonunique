                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Charaktere, die dein Gegner spielt, können nicht weniger als {2} kosten. (Falls sie weniger kosten würden, kosten sie stattdessen {2}.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "I personaggi giocati dai tuoi avversari non possono avere un costo inferiore a {2}. (Se il loro costo è inferiore, costano invece {2}.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Les Personnages joués par vos adversaires ne peuvent pas coûter moins de {2}. (S'ils coûtent moins, ils coûtent {2} à la place.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "Characters your opponents play can't cost less than {2}. (If they would cost less, they cost {2} instead.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Los personajes que jueguen tus oponentes no pueden costar menos de {2}. (Si fueran a costar menos, en vez de eso, cuestan {2}).",
                    "locale": "es_ES"
                  }
                },
                "text": "Characters your opponents play can't cost less than {2}. (If they would cost less, they cost {2} instead.)"
              }
            ],
