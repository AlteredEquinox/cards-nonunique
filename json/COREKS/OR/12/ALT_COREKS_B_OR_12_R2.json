        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "Der Gedanke, dem Rat gegenüberzustehen, ist für die meisten Möchtegern-Verbrecher in Asgartha abschreckend genug.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "La simple idée de faire face au Conseil suffit à dissuader la plupart des criminels d'Asgartha.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Già solo l'idea di comparire innanzi al Concilio funge da deterrente per i potenziali criminali di Asgartha.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "The idea of facing the Council is deterrent enough for most would-be criminals in Asgartha.",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "La mera idea de tener que vérselas con el Concilio basta para disuadir a la mayoría de los criminales de Asgartha.",
          "locale": "es_ES"
        }
      },
      "id": "01HPME86VE0C49CZNFQS0J2FCC",
      "text": "The idea of facing the Council is deterrent enough for most would-be criminals in Asgartha."
    }
  ],
