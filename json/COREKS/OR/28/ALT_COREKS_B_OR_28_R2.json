      "translations": {
        "de_DE": {
          "text": "Ein Wahrzeichen des Wissens und der Ordnung, ein Leuchtturm, der hoch über der Welt thront.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Un flambeau de connaissance et de civilisation. Un phare qui surplombe le monde.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Un lume di conoscenza e ordine, un faro che svetta sul mondo.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "A beacon of knowledge and order, a lighthouse towering high above the world.",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "Una luminaria de saber y orden, un faro que se alza sobre el mundo.",
          "locale": "es_ES"
        }
