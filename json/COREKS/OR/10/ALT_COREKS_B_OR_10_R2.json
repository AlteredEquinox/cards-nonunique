      "translations": {
        "es_ES": {
          "text": "«Este formulario no está cumplimentado correctamente. Por favor, pide cita para mañana».",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "„Dieses Formular wurde nicht korrekt ausgefüllt. Bitte vereinbaren Sie für morgen einen neuen Termin.“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Le document a été mal rempli. Veuillez prendre un nouveau rendez-vous demain. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Il modulo è stato compilato in modo errato. Si prega di fissare un nuovo appuntamento domani.\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"The document has been filled out incorrectly. Please make a new appointment tomorrow.\"",
          "locale": "en_US"
        }
