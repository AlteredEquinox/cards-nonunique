                "translations": {
                  "it_IT": {
                    "text": "Quando un avversario pesca una o più carte o [RESUPPLY_T] — Crea una pedina Soldato [ORDIS_RECRUIT] in una spedizione bersaglio.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Wenn ein Gegner eine oder mehrere Karten zieht oder [RESUPPLY_T] nutzt — Erschaffe eine [ORDIS_RECRUIT]-Soldatenmarke in einer Expedition deiner Wahl.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando un oponente robe una o más cartas o se [RESUPPLY_T] — Crea una ficha de soldado [ORDIS_RECRUIT] en una expedición objetivo.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un adversaire pioche au moins une carte ou [RESUPPLY_T] — Créez un jeton Soldat [ORDIS_RECRUIT] dans une Expédition ciblée.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When an opponent draws one or more cards or does [RESUPPLY_T] — Create an [ORDIS_RECRUIT] Soldier token in target Expedition.",
                    "locale": "en_US"
                  }
