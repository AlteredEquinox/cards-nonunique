        "subject": "Flavor Text"
      },
      "translations": {
        "es_ES": {
          "text": "Aún no ha habido alma alguna lo bastante valerosa para retar su sabiduría.",
          "locale": "es_ES"
        },
        "de_DE": {
          "text": "Bisher hat sich noch niemand gefunden, der kühn genug war, seine Weisheit anzufechten.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Nulle âme n'est assez audacieuse pour contester sa sagesse.",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "Non è ancora stata trovata un'anima abbastanza audace da contestare la sua saggezza.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "A soul has yet to be found who is bold enough to contest his wisdom.",
          "locale": "en_US"
        }
      },
      "id": "01HPME87J786YGQS9951KRE38P",
