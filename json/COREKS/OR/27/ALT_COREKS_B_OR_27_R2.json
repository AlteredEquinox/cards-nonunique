        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Heute und in aller Zukunft werden wir den Sieg über den Kraken feiern und uns an der wiedergewonnenen Freiheit erfreuen!“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Aujourd'hui, et pour les siècles à venir, nous célébrerons la victoire sur le Kraken et notre liberté retrouvée ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Oggi e per i secoli a venire, festeggeremo la vittoria sul Kraken e ci godremo la libertà riconquistata!\"",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "\"Today, and for centuries to come, we will celebrate victory over the Kraken and revel in freedom regained!\"",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "«¡Hoy, y en los siglos venideros, celebraremos la victoria contra el Kraken y disfrutaremos de la libertad que hemos reconquistado!».",
          "locale": "es_ES"
        }
      },
      "id": "01HPME88M61W0PBD83EYQACP0X",
      "text": "\"Today, and for centuries to come, we will celebrate victory over the Kraken and revel in freedom regained!\""
    }
  ],
