                "translations": {
                  "en_US": {
                    "text": "When a Character you control gains 1 or more boosts — You may exhaust me ({T}) to give target Character 1 boost.$[BB].",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando un personaje que controles gane 1 potenciador o más — Puedes agotarme ({T}) para dar 1 potenciador a un personaje objetivo.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un Personnage que vous contrôlez gagne au moins 1 boost — Vous pouvez m'épuiser ({T}) pour donner 1 boost à un Personnage ciblé.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ein Charakter, den du kontrollierst, mindestens 1 Verstärkung erhält — Du darfst mich erschöpfen ({T}), um einem Charakter deiner Wahl 1 Verstärkung zu geben.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando un personaggio che controlli ottiene 1 o più rinforzi — Puoi consumarmi ({T}) per conferire 1 rinforzo a un personaggio bersaglio.",
