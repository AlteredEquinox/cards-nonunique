      },
      "translations": {
        "es_ES": {
          "text": "Cuando escuchas la voz del viento, siempre te lleva allí donde el destino te espera.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Quando ascolti la voce del vento, essa ti porta sempre dove dovresti essere.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "When you listen to the voice of the Wind, it always carries you where you're meant to be.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wenn du auf die Stimme des Windes hörst, trägt er dich immer dorthin, wo du sein sollst.",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "Quand on écoute la voix du Vent, il nous porte toujours là où nous sommes censés être.",
          "locale": "fr_FR"
        }
      },
      "id": "01JYRGVWXDJBA01K32YRGGQ208",
      "text": "When you listen to the voice of the Wind, it always carries you where you're meant to be."
    }
