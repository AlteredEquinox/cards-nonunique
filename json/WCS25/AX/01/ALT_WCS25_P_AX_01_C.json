                "translations": {
                  "en_US": {
                    "text": "When you play a Permanent with Hand Cost {3} or more — You may exhaust me ({T}) to create a [BRASSBUG] Robot token in target Expedition.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un permanente con coste desde la mano de {3} o más — Puedes agotarme ({T}) para crear una ficha de robot [BRASSBUG] en una expedición objetivo.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando giochi un permanente con costo dalla mano pari o superiore a {3} — Puoi consumarmi ({T}) per creare una pedina Robot [BRASSBUG] in una spedizione bersaglio.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Permanent de Coût de Main {3} ou plus — Vous pouvez m'épuiser ({T}) pour créer un jeton Robot [BRASSBUG] dans une Expédition ciblée.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du eine Bleibende Karte mit Handkosten {3} oder mehr spielst — Du darfst mich erschöpfen ({T}), um eine [BRASSBUG]-Robotermarke in einer Expedition deiner Wahl zu erschaffen.",
                    "locale": "de_DE"
                  }
                },
                "text": "When you play a Permanent with Hand Cost {3} or more — You may exhaust me ({T}) to create a [BRASSBUG] Robot token in target Expedition."
