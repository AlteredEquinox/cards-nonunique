      },
      "translations": {
        "de_DE": {
          "text": "Der Ruf des Horns riss sie aus dem Schlaf, als die weißen Schatten aus dem Wald kamen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "El sonido del cuerno les despertó de su letargo mientras las sombras blancas salían del bosque.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Il suono del corno li destò dal sonno, mentre le ombre bianche uscivano dal bosco.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Le son du cor les sortit de leur sommeil, tandis que les ombres blanches émergèrent des bois.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "The sound of the horn stirred them from their slumber as the white shadows emerged from the woods.",
          "locale": "en_US"
        }
      },
      "id": "01J21J29J3SS15YBMEYKNFMYEA",
