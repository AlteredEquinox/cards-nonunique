                  },
                  "de_DE": {
                    "text": "Ein Charakter deiner Wahl erhält 1 Verstärkung. Falls er [ASLEEP] ist, #erhält er [ANCHORED]# und verliert [ASLEEP]. (Während der Ruhepause geht er nicht in die Reserve und verliert Verankert.)",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Un Personnage ciblé gagne 1 boost. S'il est [ASLEEP], #il gagne [ANCHORED]# et perd [ASLEEP]. (Au Repos, il ne va pas en Réserve et il perd Ancré.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Un personaje objetivo gana 1 potenciador. Si tiene [ASLEEP], #gana [ANCHORED]# y pierde [ASLEEP]. (Durante el descanso, no va a la reserva y pierde anclaje).",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "Target Character gains 1 boost. If it is [ASLEEP], #it gains [ANCHORED]# and loses [ASLEEP]. (At Rest, it doesn't go to Reserve and loses Anchored).",
