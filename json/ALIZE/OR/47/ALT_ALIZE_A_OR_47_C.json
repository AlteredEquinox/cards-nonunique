      "translations": {
        "de_DE": {
          "text": "Seine heulende Stimme klingt wie Donner oder knisterndes Eis.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Aúlla con una voz potente cual trueno y gélida cual hielo.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Ulula con una voce simile a un tuono o a ghiaccio che scricchiola.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Ses hurlements évoquent le tonnerre ou le craquement de la glace.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "With a voice like thunder or crackling ice it howls.",
          "locale": "en_US"
        }
      },
