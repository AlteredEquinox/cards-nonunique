                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "es_ES": {
                    "text": "Cuando juegues un personaje — Si su expedición va por detrás, gano 1 contador de ordalía.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando giochi un personaggio — Se la sua spedizione è indietro, ottengo 1 segnalino Prova.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When you play a Character — If its Expedition is behind, I gain 1 Trial counter.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Charakter spielst — Falls seine Expedition hinten liegt, erhalte ich 1 Prüfungszähler.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Personnage — Si son Expédition est en retard, je gagne 1 compteur Épreuve.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When you play a Character — If its Expedition is behind, I gain 1 Trial counter."
              }
