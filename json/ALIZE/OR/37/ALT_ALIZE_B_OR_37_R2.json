      },
      "translations": {
        "en_US": {
          "text": "Darkness is cheap, and that's why Scrooge liked it.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Dunkelheit ist billig, deshalb mochte Scrooge sie.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "La oscuridad es barata, cómo no le va a gustar a Scrooge.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Il buio costa poco, e perciò piaceva a Scrooge.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "L'obscurité ne coûte pas cher, c'est pour cela que Scrooge ne la détestait pas.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J28NX9GGWQQ9YENE44HCE",
      "text": "Darkness is cheap, and that's why Scrooge liked it."
    }
