          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [
                  {
                    "cardKeyword": {
                      "translations": {
                        "de_DE": {
                          "displayWeb": "Schlafend",
                          "locale": "de_DE",
                          "description": "Am Abend ignoriere meine Statistiken. Während der Ruhepause gehe ich nicht in die Reserve und verliere Schlafend."
                        },
                        "it_IT": {
                          "displayWeb": "Dormiente",
                          "locale": "it_IT",
                          "description": "Durante il crepuscolo, ignora le mie statistiche. Durante il riposo, non vado nella Riserva e perdo Dormiente."
                        },
                        "en_US": {
                          "displayWeb": "Asleep",
                          "locale": "en_US",
                          "description": "During Dusk, ignore my statistics. During Rest, I don't go to Reserve and I lose Asleep."
                        },
                        "fr_FR": {
                          "displayWeb": "Endormi",
                          "locale": "fr_FR",
                          "description": "Ignorez mes statistiques pendant le Crépuscule. Au Repos, je ne vais pas en Réserve et je perds Endormi."
                        },
                        "es_ES": {
                          "displayWeb": "Sueño",
                          "locale": "es_ES",
                          "description": "Durante el anochecer, ignora mis estadísticas. Durante el descanso, no voy a la reserva y pierdo sueño."
                        }
                      },
                      "id": "01HKAGPDSXJC9J9QJ4Y1DBK28E",
                      "reference": "ASLEEP"
                    },
                    "sequence": 0,
                    "isDescriptionDisplayed": false,
                    "id": "01J21KNGVZCJYTCCEN5FY4J9FP"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Ogni giocatore sceglie un personaggio che controlla. Ottiene [ASLEEP]. (Scegli prima tu. Durante il crepuscolo, ignora le statistiche dei personaggi con Dormiente. Durante il riposo, non vanno nella Riserva e perdono Dormiente.)",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "Each player chooses a Character they control. It gains [ASLEEP]. (You choose first. Ignore the statistics of Asleep Characters during Dusk. At Rest, they don't go to Reserve and lose Asleep.)",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "Cada jugador elige un personaje que controle. Gana [ASLEEP]. (Tú eliges primero. Durante el anochecer, ignora las estadísticas de los personajes con sueño. Durante el descanso, no van a la reserva y pierden sueño).",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Chaque joueur choisit un Personnage qu'il contrôle. Il gagne [ASLEEP]. (Vous choisissez en premier. Au Crépuscule, ignorez les statistiques des Personnages Endormis. Au Repos, ils ne vont pas en Réserve et ils perdent Endormi.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Jeder Spieler wählt einen Charakter, den er kontrolliert. Er erhält [ASLEEP]. (Du wählst zuerst. Ignoriere die Statistiken von Charakteren mit Schlafend am Abend. In der Ruhepause gehen sie nicht in die Reserve und verlieren Schlafend.)",
                    "locale": "de_DE"
                  }
                },
                "text": "Each player chooses a Character they control. It gains [ASLEEP]. (You choose first. Ignore the statistics of Asleep Characters during Dusk. At Rest, they don't go to Reserve and lose Asleep.)"
              }
            ],
            "reference": "00675"
          },
