      },
      "translations": {
        "en_US": {
          "text": "Fall asleep in the cold, and you might never wake up.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wer in der Kälte einschläft, wacht vielleicht nicht mehr auf.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Duérmete en el frío y quizá nunca despiertes.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Se ti addormenti nel freddo, potresti non risvegliarti.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "S'endormir dans le froid, c'est risquer de ne jamais se réveiller.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J29283215X24MQSHGWK3S",
      "text": "Fall asleep in the cold, and you might never wake up."
