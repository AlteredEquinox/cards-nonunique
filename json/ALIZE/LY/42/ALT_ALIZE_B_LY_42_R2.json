                "translations": {
                  "en_US": {
                    "text": "Send target Character to Reserve, then exhaust it ({T}). (Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Envoyez un Personnage ciblé en Réserve, puis épuisez-le ({T}). (Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Schicke einen Charakter deiner Wahl in die Reserve, dann erschöpfe ihn ({T}). (Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Manda un personaggio bersaglio nella Riserva, poi consumalo ({T}). (Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Envía un personaje objetivo a la reserva y luego agótalo ({T}). (Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo).",
                    "locale": "es_ES"
                  }
                },
                "text": "Send target Character to Reserve, then exhaust it ({T}). (Exhausted cards can't be played and have no Support abilities.)"
              }
            ],
