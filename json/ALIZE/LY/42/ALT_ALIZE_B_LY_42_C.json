          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Ich koste {2} weniger, falls es unter den Charakteren, die du kontrollierst, mindestens drei Basisstatistiken von 0 gibt.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "Je coûte {2} de moins s'il y a au moins trois statistiques de base 0 parmi les Personnages que vous contrôlez.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "I cost {2} less if there are three or more base statistics of 0 among Characters you control.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "Costo {2} in meno se ci sono tre o più statistiche base pari a 0 tra i personaggi che controlli.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuesto {2} menos si hay tres o más estadísticas básicas de 0 entre los personajes que controles.",
                    "locale": "es_ES"
                  }
                },
                "text": "I cost {2} less if there are three or more base statistics of 0 among Characters you control."
              }
            ],
            "reference": "01180"
          },
          "sequence": 1,
          "id": "01KH6SVZVNMZE2X2592WSB5400"
        },
        {
          "cardElement": "\/card_elements\/01KH6SVYKZH3EVM8X3MGB1MHXS",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "Send target Character to Reserve, then exhaust it ({T}). (Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Envoyez un Personnage ciblé en Réserve, puis épuisez-le ({T}). (Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Schicke einen Charakter deiner Wahl in die Reserve, dann erschöpfe ihn ({T}). (Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Manda un personaggio bersaglio nella Riserva, poi consumalo ({T}). (Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Envía un personaje objetivo a la reserva y luego agótalo ({T}). (Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo).",
                    "locale": "es_ES"
                  }
                },
                "text": "Send target Character to Reserve, then exhaust it ({T}). (Exhausted cards can't be played and have no Support abilities.)"
              }
            ],
            "reference": "00754"
          },
          "sequence": 2,
          "id": "01KH6SW0DR52F2SDEMTCMNQT9M"
        }
