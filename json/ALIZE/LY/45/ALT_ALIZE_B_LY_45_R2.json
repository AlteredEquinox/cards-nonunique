      },
      "translations": {
        "en_US": {
          "text": "We can hear it, echoing in the vast expanses.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wir hören sein Echo in den unendlichen Weiten widerhallen.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "En los vastos parajes se oye su retumbar.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Riusciamo a sentirne l'eco nelle vaste distese.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "On peut entendre son écho résonner dans les vastes étendues.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J26401K86RFFEQPQRCMNX",
      "text": "We can hear it, echoing in the vast expanses."
