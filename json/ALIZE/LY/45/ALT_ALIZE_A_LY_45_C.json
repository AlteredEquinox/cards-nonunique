        {
          "cardElement": "\/card_elements\/01KH6SBFTM38ABBBMV01M1RW8H",
          "cardEffect": {
            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Quando giochi un personaggio — Se è in un terreno in cui la sua statistica base è pari a 0, ottengo 1 segnalino Prova.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "Wenn du einen Charakter spielst — Falls er in einem Gelände ist, wo seine Basisstatistik 0 ist, erhalte ich 1 Prüfungszähler.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Cuando juegues un personaje — Si está en un terreno en el que su estadística base es 0, gano 1 contador de ordalía.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When you play a Character — If it's in a terrain where its base statistic is 0, I gain 1 Trial counter.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous jouez un Personnage — S'il est dans un terrain où sa statistique de base est 0, je gagne 1 compteur Épreuve.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When you play a Character — If it's in a terrain where its base statistic is 0, I gain 1 Trial counter."
              }
            ],
            "reference": "01149"
          },
          "sequence": 0,
          "id": "01KH6SBGEBSQDZRY1D668N8P70"
        },
        {
          "cardElement": "\/card_elements\/01KH6SBFTM38ABBBMV01M1RW8H",
          "cardEffect": {
