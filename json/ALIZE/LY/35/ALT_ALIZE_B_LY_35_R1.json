        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Neun Faden tief verfolg' er uns - von jenes Landes Schnee.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«A nueve brazas de profundidad nos había seguido. Desde la tierra de la niebla y la nieve».",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Au frais ondin s'unit l'ardente salamandre - Et de bleuâtres feux se croisent sur les eaux. »",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "\"Nine fathom deep he had followed us - From the land of mist and snow.\"",
          "locale": "en_US"
        },
        "it_IT": {
          "text": "\"A nove braccia di profondità ci aveva seguiti dalla terra di nebbia e neve.\"",
          "locale": "it_IT"
        }
      },
      "id": "01J21J25B6097M300EWDVBAHM7",
      "text": "\"Nine fathom deep he had followed us - From the land of mist and snow.\""
    }
  ],
