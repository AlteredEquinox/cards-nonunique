                  },
                  "fr_FR": {
                    "text": "Si une Expédition qui me fait face est en #{V},# elle ne peut pas avancer durant le Crépuscule, sauf grâce à #{V}.#",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "Se una spedizione che mi affronta è in #{V},# non può avanzare durante il crepuscolo tranne che per via di #{V}.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
