      },
      "translations": {
        "de_DE": {
          "text": "„Ein altbewährter Trick ist besser als ein neuer Trick ohne Effekt.“ – Houdini",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "\"An old trick well done is far better than a new trick with no effect.\" - Houdini",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "«Un truco viejo bien hecho es mucho mejor que un truco nuevo carente de efecto». —Houdini",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Un vecchio trucco ben riuscito è molto meglio di un nuovo trucco senza effetto.\" - Houdini",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Un vieux tour bien exécuté vaut mieux qu'un nouveau tour raté. » - Houdini",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J25NK08P8830GRB8Q2Y6F",
      "text": "\"An old trick well done is far better than a new trick with no effect.\" - Houdini"
    }
  ],
