                  "en_US": {
                    "text": "[COOLDOWN]. (If I go to Reserve after my effect resolves, exhaust me {T}. Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "[COOLDOWN]. (Si je vais en Réserve après la résolution de mon effet, épuisez-moi {T}. Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "[COOLDOWN]. (Falls ich in die Reserve gehe, nachdem mein Effekt abgeklungen ist, erschöpfe mich {T}. Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
