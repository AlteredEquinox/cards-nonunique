                  "en_US": {
                    "text": "{R} #If I'm in {M}, [SABOTAGE]. Otherwise,# you may exhaust ({T}) target card in Reserve. (Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "{R} #Se sono in {M}, [SABOTAGE]. Altrimenti,# puoi consumare ({T}) una carta bersaglio nella Riserva. (Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{R} #Si estoy en {M}, [SABOTAGE]. De lo contrario,# puedes agotar ({T}) una carta objetivo en reserva. (Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo).",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{R} #Si je suis en {M}, [SABOTAGE]. Sinon,# vous pouvez épuiser ({T}) une carte ciblée en Réserve. (Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "{R} #Falls ich in {M} bin, [SABOTAGE]. Andernfalls# darfst du eine Karte deiner Wahl in der Reserve erschöpfen ({T}). (Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  }
                },
                "text": "{R} #If I'm in {M}, [SABOTAGE]. Otherwise,# you may exhaust ({T}) target card in Reserve. (Exhausted cards can't be played and have no Support abilities.)"
