        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "La vita è un'erta. Scorre lentamente quando si sale, ma passa in fretta quando si discende.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "Life is a slope. It's slow going up, and quick going down.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Das Leben ist ein Abhang. Man gelangt langsam hinauf, aber schnell hinunter.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "La vida es como una pendiente: se sube despacio y se baja rápido.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "La vie est comme une pente, lente à monter, rapide à dévaler.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J244HX4KADHQX3V72P5QD",
      "text": "Life is a slope. It's slow going up, and quick going down."
    }
