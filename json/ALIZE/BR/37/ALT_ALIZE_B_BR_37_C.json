      },
      "translations": {
        "en_US": {
          "text": "\"What doesn't kill you makes you stronger.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Was dich nicht umbringt, macht dich stärker.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Lo que no te mata te hace más fuerte».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Ciò che non uccide ti rende più forte.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Ce qui ne te tue pas te rend plus fort. »",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J24BXW4QYS583XK8H6PVE",
      "text": "\"What doesn't kill you makes you stronger.\""
