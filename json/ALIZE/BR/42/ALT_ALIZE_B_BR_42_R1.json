                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "Renvoyez un Personnage ou Permanent ciblé dans la main de son propriétaire, puis mettez-moi dans votre zone de Mana (en tant qu'Orbe de Mana épuisé).",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Schicke einen Charakter oder eine Bleibende Karte deiner Wahl in die Hand ihres Besitzers zurück, füge mich dann deiner Manazone hinzu (als erschöpfte Manakugel).",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Fai tornare un personaggio o un permanente bersaglio in mano al suo proprietario, poi mettimi nella tua area del mana (come una sfera di mana consumata).",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Devuelve a la mano de su propietario un personaje o permanente objetivo y luego colócame en tu zona de maná (como orbe de maná agotado).",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "Return target Character or Permanent to its owner's hand, then #you may# put me in your Mana zone (as an exhausted Mana Orb).",
