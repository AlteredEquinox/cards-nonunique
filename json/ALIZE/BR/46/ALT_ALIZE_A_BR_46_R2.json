                    "id": "01JMCY0D92P86DH9QJQZ56NB4R"
                  }
                ],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Wenn ich meinen 3. Prüfungszähler erhalte — Opfere mich. Falls du das tust, erschaffe eine [DRAGON_SHADE]-Illusionsmarke in einer Expedition deiner Wahl, dann erhalten alle Charaktere, die du kontrollierst, 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando ottengo il mio terzo segnalino Prova — Sacrificami. Se lo fai, crea una pedina Illusione [DRAGON_SHADE] in una spedizione bersaglio, poi tutti i personaggi che controlli ottengono 1 rinforzo.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando gane mi tercer contador de ordalía — Sacrifícame. Si lo haces, crea una ficha de ilusión [DRAGON_SHADE] en una expedición objetivo y luego todos los personajes que controlas ganan 1 potenciador.",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When I gain my third Trial counter — Sacrifice me. If you do, create a [DRAGON_SHADE] Illusion token in target Expedition, then all Characters you control gain 1 boost.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je gagne mon troisième compteur Épreuve — Sacrifiez-moi. Si vous le faites, créez un jeton Illusion [DRAGON_SHADE] dans une Expédition ciblée, puis tous les Personnages que vous contrôlez gagnent 1 boost.",
                    "locale": "fr_FR"
                  }
                },
                "text": "When I gain my third Trial counter — Sacrifice me. If you do, create a [DRAGON_SHADE] Illusion token in target Expedition, then all Characters you control gain 1 boost."
              }
            ],
