      },
      "translations": {
        "de_DE": {
          "text": "Auf dem Gipfel wartet er auf Freiheit, auf Erlösung.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "En la cumbre espera la llegada de la libertad, de la liberación.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Sulla vetta attendono la libertà e la liberazione.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Au sommet, il attend. La liberté. La libération.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "On the summit it waits, for freedom, for release.",
          "locale": "en_US"
        }
      },
      "id": "01JH1NW7ZK7G8GVYJ2ZEQ1BQN3",
      "text": "On the summit it waits, for freedom, for release."
