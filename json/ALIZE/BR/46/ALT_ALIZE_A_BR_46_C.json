                ],
                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "Wenn ein Charakter, den du kontrollierst, [FLEETING_CHAR] erhält — Ich erhalte 1 Prüfungszähler.",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando un personaggio che controlli ottiene [FLEETING_CHAR] — Ottengo 1 segnalino Prova.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando un personaje que controles gane [FLEETING_CHAR] — Gano 1 contador de ordalía.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'un Personnage que vous contrôlez gagne [FLEETING_CHAR] — Je gagne 1 compteur Épreuve.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When a Character you control gains [FLEETING_CHAR] — I gain 1 Trial counter.",
                    "locale": "en_US"
                  }
                },
                "text": "When a Character you control gains [FLEETING_CHAR] — I gain 1 Trial counter."
