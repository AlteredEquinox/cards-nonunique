                  },
                  "it_IT": {
                    "text": "Quando un altro personaggio si unisce alla mia spedizione — Sacrificalo #e ottengo 1 rinforzo.#",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando otro personaje se incorpore a mi expedición — Sacrifícalo #y gano 1 potenciador.#",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "When another Character joins my Expedition — Sacrifice it #and I gain 1 boost.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn ein weiterer Charakter sich meiner Expedition anschließt — Opfere ihn #und ich erhalte 1 Verstärkung.#",
