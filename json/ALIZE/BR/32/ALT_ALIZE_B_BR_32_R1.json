                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "{H} Du darfst mich [FLEETING_CHAR] erhalten lassen. Falls du das tust, erhält ein anderer Charakter deiner Wahl 1 Verstärkung.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "{H} Vous pouvez me faire gagner [FLEETING_CHAR]. Si vous le faites, un autre Personnage ciblé gagne 1 boost.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{H} Puoi farmi ottenere [FLEETING_CHAR]. Se lo fai, un altro personaggio bersaglio ottiene 1 rinforzo.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "{H} You may have me gain [FLEETING_CHAR]. If you do, another target Character gains 1 boost.",
                    "locale": "en_US"
                  },
                  "es_ES": {
                    "text": "{H} Puedes hacer que gane [FLEETING_CHAR]. Si lo haces, otro personaje objetivo gana 1 potenciador.",
