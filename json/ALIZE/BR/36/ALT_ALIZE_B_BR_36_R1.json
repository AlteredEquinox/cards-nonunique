{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"Their ranks will be composed of seasoned argonauts, ready to face the perils of the unknown!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Ihre Reihen werden aus erfahrenen Argonauten bestehen, die bereit sind, sich den unbekannten Gefahren zu stellen!“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Sus filas estarán compuestas por argonautas experimentados, dispuestos a enfrentarse a los peligros de lo desconocido».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"I loro ranghi saranno composti da argonauti esperti, pronti ad affrontare i pericoli dell'ignoto!\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Leurs rangs seront composés d'argonautes émérites, prêts à se confronter aux périls de l'inconnu ! »",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J24A9NF16W9D7J7B79RY0",
      "text": "\"Their ranks will be composed of seasoned argonauts, ready to face the perils of the unknown!\""
    }
  ],
