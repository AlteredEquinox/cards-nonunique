      },
      "translations": {
        "en_US": {
          "text": "Faster, ever faster! Our fire rages highest when the race is afoot!",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Schneller, immer schneller! Unser Feuer wütet am stärksten, wenn das Rennen in vollem Gange ist!",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "¡Más rápido, más! ¡Nuestra llama arde más fuerte cuando corremos!",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Più veloce, più veloce! Il nostro fuoco infuria più che mai quando la gara è in atto!",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Plus vite, encore plus vite ! C'est dans la course que notre feu s'exprime !",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J23XQ3HQHFR99QR3YY553",
