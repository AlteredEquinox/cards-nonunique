      "translations": {
        "de_DE": {
          "text": "„Im Angesicht einer Schwierigkeit steht man kurz vor einer Entdeckung.“",
          "locale": "de_DE"
        },
        "en_US": {
          "text": "\"When you are face to face with a difficulty, you are up against a discovery.\"",
          "locale": "en_US"
        },
        "es_ES": {
          "text": "«Cuando te enfrentas a una dificultad, miras a la cara al descubrimiento».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Quando sei faccia a faccia con un ostacolo, stai per imbatterti in una scoperta.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Quand on rencontre une difficulté, on est face à une découverte. »",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J23RSG0R0Q25G0D58X12D",
