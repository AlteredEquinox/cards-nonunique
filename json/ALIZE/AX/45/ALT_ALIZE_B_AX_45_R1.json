      },
      "translations": {
        "en_US": {
          "text": "Nothing is created, nothing is lost... even to the frost.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Nichts wird erschaffen, nichts geht verloren ... auch nicht an den Frost.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Nada se crea ni se pierde... Ni siquiera por culpa de la escarcha.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Nulla si crea, nulla si distrugge... nemmeno il ghiaccio.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Rien ne se crée, rien ne se perd... même dans le givre.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J23TB440CMSVSXNJ4NGPN",
      "text": "Nothing is created, nothing is lost... even to the frost."
