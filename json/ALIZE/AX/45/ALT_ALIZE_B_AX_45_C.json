                      "translations": {
                        "en_US": {
                          "displayWeb": "Exhausted Resupply",
                          "locale": "en_US",
                          "description": "Put the top card of your deck in Reserve, then exhaust it {T}."
                        },
                        "de_DE": {
                          "displayWeb": "Erschöpfter Nachschub",
                          "locale": "de_DE",
                          "description": "Lege die oberste Karte deines Decks in die Reserve, dann erschöpfe sie {T}."
                        },
                        "it_IT": {
                          "displayWeb": "Rifornisci-Consuma",
                          "locale": "it_IT",
                          "description": "Metti la prima carta del tuo mazzo nella Riserva, poi consumala {T}."
                        },
