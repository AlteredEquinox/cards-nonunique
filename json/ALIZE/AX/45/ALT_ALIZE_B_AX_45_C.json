                  },
                  "it_IT": {
                    "text": "Puoi tenere una carta aggiuntiva nella Riserva durante la notte se è consumata.",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Vous pouvez conserver une carte de plus en Réserve pendant la Nuit si elle est épuisée.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "You may keep one more card in Reserve during Night if it's exhausted.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Du darfst während der Nacht eine weitere Karte in Reserve behalten, falls sie erschöpft ist.",
                    "locale": "de_DE"
                  }
                },
                "text": "You may keep one more card in Reserve during Night if it's exhausted."
