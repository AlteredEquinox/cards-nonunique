                ],
                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "At Noon — [EXHAUSTED_RESUPPLY]. (Put the top card of your deck in Reserve, then exhaust it {T}. Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Zum Mittag — [EXHAUSTED_RESUPPLY]. (Lege die oberste Karte deines Decks in die Reserve, dann erschöpfe sie {T}. Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Al mediodía — [EXHAUSTED_RESUPPLY]. (Coloca la primera carta de tu mazo en reserva y luego agótala {T}. Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo).",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "A mezzogiorno — [EXHAUSTED_RESUPPLY]. (Metti la prima carta del tuo mazzo nella Riserva, poi consumala {T}. Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "À Midi — [EXHAUSTED_RESUPPLY]. (Mettez la première carte de votre deck en Réserve, puis épuisez-la {T}. Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  }
                },
                "text": "At Noon — [EXHAUSTED_RESUPPLY]. (Put the top card of your deck in Reserve, then exhaust it {T}. Exhausted cards can't be played and have no Support abilities.)"
              }
            ],
