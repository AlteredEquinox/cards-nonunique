        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "In den Höhlen und Spalten heult und ruft es nach uns.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "En las cuevas y las grietas se oye su lamento y su llamada.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Nelle caverne e negli anfratti, geme e ci chiama.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Depuis les grottes et les crevasses, il geint et nous appelle.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "In the caves and crevices, it wails and calls to us.",
          "locale": "en_US"
        }
      },
      "id": "01JH1NW7YC57KQ9X708TW7DXWG",
      "text": "In the caves and crevices, it wails and calls to us."
    }
  ],
