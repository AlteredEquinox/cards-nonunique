            "cardEffectElements": [
              {
                "idGd": 0,
                "cardEffectElementDisplays": [],
                "type": "OUTPUT",
                "translations": {
                  "it_IT": {
                    "text": "Quando una carta va dal tuo mazzo o dalla tua mano nella Riserva — Ottengo 1 segnalino Prova.",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando una carta vaya de tu mazo o de tu mano a la reserva — Gano 1 contador de ordalía.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "Lorsqu'une carte va en Réserve depuis votre deck ou votre main — Je gagne 1 compteur Épreuve.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When a card goes from your deck or hand to Reserve — I gain 1 Trial counter.",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Wenn eine Karte aus deinem Deck oder deiner Hand in die Reserve geht — Ich erhalte 1 Prüfungszähler.",
                    "locale": "de_DE"
                  }
                },
                "text": "When a card goes from your deck or hand to Reserve — I gain 1 Trial counter."
              }
            ],
            "reference": "01143"
          },
