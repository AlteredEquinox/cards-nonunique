      },
      "translations": {
        "en_US": {
          "text": "When you're alone in the cold, even the tiniest light can feel like salvation.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Ein kleines Licht ist eine Erlösung für den, der in der Kälte ist.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "En la soledad de la fría noche, una pequeña luz puede ser tu salvación.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Quando si è soli nel freddo, anche una piccola luce può somigliare alla salvezza.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Quand on est seul dans le froid, un peu de lumière fait chaud au cœur.",
