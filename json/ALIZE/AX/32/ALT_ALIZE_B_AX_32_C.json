                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "When I go to Reserve from anywhere — Exhaust me ({T}). (Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque je vais en Réserve depuis n'importe où — Épuisez-moi ({T}). (Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn ich von irgendwoher in die Reserve gehe — Erschöpfe mich ({T}). (Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Quando vado nella Riserva da un luogo qualsiasi — Consumami ({T}). (Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "Cuando vaya a la reserva desde cualquier lugar — Agótame ({T}). (Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo).",
                    "locale": "es_ES"
                  }
                },
                "text": "When I go to Reserve from anywhere — Exhaust me ({T}). (Exhausted cards can't be played and have no Support abilities.)"
              }
