        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Symphonies begin with two notes, fires with a couple of sparks, and masterpieces with two drops of metal.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Ein Symphonie beginnt mit zwei Noten, ein Feuer mit zwei Funken, ein Meisterwerk mit zwei Tropfen Metall.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Las sinfonías comienzan con dos notas; los incendios, con un par de chispas; las obras maestras, con dos gotas de metal.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Le sinfonie iniziano con due note, gli incendi con un paio di scintille e i capolavori con due gocce di metallo.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Une symphonie naît de deux notes, un feu d'une étincelle, et un chef-d'œuvre de deux gouttes de métal.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J23EJ1WM4ENQY9Y19K9YE",
      "text": "Symphonies begin with two notes, fires with a couple of sparks, and masterpieces with two drops of metal."
    }
  ],
