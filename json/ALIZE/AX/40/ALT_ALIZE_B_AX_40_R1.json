                "translations": {
                  "es_ES": {
                    "text": "{J} #Si controlas dos o más permanentes, crea dos fichas de robot [BRASSBUG] en una expedición objetivo. De lo contrario,# crea solo una.",
                    "locale": "es_ES"
                  },
                  "fr_FR": {
                    "text": "{J} #Si vous contrôlez au moins deux Permanents, créez deux jetons Robot [BRASSBUG] dans une Expédition ciblée. Sinon,# créez-en un seul.",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{J} #Se controlli due o più permanenti, crea due pedine Robot [BRASSBUG] in una spedizione bersaglio. Altrimenti,# creane solo una.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "{J} #Falls du mindestens zwei Bleibende Karten kontrollierst, erschaffe zwei [BRASSBUG]-Robotermarken in einer Expedition deiner Wahl. Andernfalls# erschaffe nur eine.",
                    "locale": "de_DE"
                  },
                  "en_US": {
                    "text": "{J} #If you control two or more Permanents, create two [BRASSBUG] Robot tokens in target Expedition. Otherwise,# create only one.",
                    "locale": "en_US"
                  }
                },
                "text": "{J} #If you control two or more Permanents, create two [BRASSBUG] Robot tokens in target Expedition. Otherwise,# create only one."
              }
