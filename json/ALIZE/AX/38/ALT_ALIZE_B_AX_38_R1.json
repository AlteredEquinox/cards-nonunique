        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"If we could just find a substitute for the missing parts, we could make it work.\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wenn wir die fehlenden Teile ersetzen, könnten wir ihn zum Laufen bringen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Si encontrásemos un reemplazo para las piezas que faltan, podríamos hacer que funcionase».",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "\"Se solo riuscissimo a trovare dei pezzi di ricambio per le parti mancanti potremmo farlo funzionare.\"",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Si on pouvait remplacer les pièces manquantes, on pourrait le faire fonctionner... »",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J23BH6ZGDMD304ZP34X28",
      "text": "\"If we could just find a substitute for the missing parts, we could make it work.\""
    }
