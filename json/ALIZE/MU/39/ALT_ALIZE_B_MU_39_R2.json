                "type": "OUTPUT",
                "translations": {
                  "de_DE": {
                    "text": "{H} Ein Gegner deiner Wahl darf [EXHAUSTED_RESUPPLY_INF] nutzen. (Er legt die oberste Karte seines Decks in die Reserve, dann erschöpft er sie {T}. Erschöpfte Karten sind unspielbar und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "{H} Un avversario bersaglio può [EXHAUSTED_RESUPPLY_INF]. (Mette la prima carta del suo mazzo nella Riserva, poi la consuma {T}. Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "es_ES": {
                    "text": "{H} El oponente objetivo puede [EXHAUSTED_RESUPPLY_INF]. (Tu oponente coloca la primera carta de su mazo en reserva y luego la agota {T}. Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo.)",
                    "locale": "es_ES"
                  },
                  "en_US": {
                    "text": "{H} Target opponent may [EXHAUSTED_RESUPPLY_INF]. (They put the top card of their deck in Reserve, then they exhaust it {T}.)",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "{H} Un adversaire ciblé peut [EXHAUSTED_RESUPPLY_INF]. (Il met la première carte de son deck en Réserve, puis l'épuise {T}. Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  }
                },
