                "translations": {
                  "it_IT": {
                    "text": "{H} Un avversario bersaglio può [EXHAUSTED_RESUPPLY_INF], #poi può farlo un'altra volta.# (Mette la prima carta del suo mazzo nella Riserva, poi la consuma {T}.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "{H} Un adversaire ciblé peut [EXHAUSTED_RESUPPLY_INF], #puis le faire à nouveau.# (Il met la première carte de son deck en Réserve, puis l'épuise {T}.)",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "{H} Target opponent may [EXHAUSTED_RESUPPLY_INF], #then may do it again.# (They put the top card of their deck in Reserve, then they exhaust it {T}.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{H} Ein Gegner deiner Wahl darf [EXHAUSTED_RESUPPLY_INF] nutzen, #und darf dies dann wiederholen.# (Er legt die oberste Karte seines Decks in die Reserve, dann erschöpft er sie {T}.)",
                    "locale": "de_DE"
                  },
                  "es_ES": {
