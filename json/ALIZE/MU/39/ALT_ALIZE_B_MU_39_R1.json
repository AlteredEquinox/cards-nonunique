{
  "loreEntries": [
    {
      "loreEntryElementType": {
        "id": "01GR6AENPX6HQP8G16KNV7BNA2",
        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "Thus, as the snow falls under the sky's clear frost. She has awoken - Snegurochka is once again!",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Als der Schnee unter dem klaren Frost des Himmels fiel, erwachte sie – Snegurotschka ist wieder da!",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Así, mientras cae la nieve bajo la clara escarcha del cielo, se ha despertado: ¡Snégurotchka está de vuelta!",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "La neve cade sotto il gelo limpido del cielo. Si è svegliata: Snégurotchka è di nuovo qui!",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "« Maman Printemps, sois bonne, et donne-moi un peu de soleil pour réchauffer mon pauvre cœur ! »",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J26ZTNP55FXMK4ZHR0RAJ",
      "text": "Thus, as the snow falls under the sky's clear frost. She has awoken - Snegurochka is once again!"
    }
  ],
