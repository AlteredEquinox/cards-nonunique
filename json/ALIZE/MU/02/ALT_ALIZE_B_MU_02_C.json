      "translations": {
        "en_US": {
          "text": "When you care for the earth, it let roots grow strong and resilient.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Wenn man die Erde pflegt, erwachsen aus ihr starke und widerstandsfähige Wurzeln.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Si cuidas de la tierra, sus raíces se vuelven fuertes y resistentes.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Quando ti prendi cura della terra, essa fa crescere radici forti e resistenti.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "C'est en aérant la terre que l'on permet aux racines de devenir fortes et endurantes.",
