        "subject": "Flavor Text"
      },
      "translations": {
        "it_IT": {
          "text": "È un'ombra, uno spettro, che non cessa di sibilare e mormorare. Vuole essere trovato. Vuole essere liberato.",
          "locale": "it_IT"
        },
        "en_US": {
          "text": "It is a shadow, a phantom, always hissing, always whispering. It wants to be found. It wants to be unleashed.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Es ist ein Schatten, ein Phantom, zischelnd und flüsternd. Es will gefunden werden. Es will entfesselt werden.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Es una sombra, un fantasma, siempre siseando, susurrando. Quiere que lo encontremos. Quiere ser liberado.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "C'est un spectre, un fantôme, chuintant et chuchotant sans cesse. Il veut qu'on le trouve. Il veut qu'on le libère.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J27SDPWSQ5ZMGJM2R562K",
      "text": "It is a shadow, a phantom, always hissing, always whispering. It wants to be found. It wants to be unleashed."
    }
