      "translations": {
        "de_DE": {
          "text": "Was auch immer uns bevorstehen mag: Gute Manieren und Höflichkeit kommen nie aus der Mode!",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Por grandes que sean las tribulaciones, nunca debemos olvidar las buenas costumbres y la educación.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Qualunque sia la prova che dobbiamo affrontare, le buone maniere e l'educazione sono sempre di moda!",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Les bonnes manières et la politesse ne sont jamais hors de propos, quelle que soit la situation.",
          "locale": "fr_FR"
        },
        "en_US": {
          "text": "Whatever ordeals we may face, good manners and politeness are always in fashion!",
          "locale": "en_US"
        }
      },
      "id": "01J21J2A0YVMXQ6VXHSN5X7FPB",
