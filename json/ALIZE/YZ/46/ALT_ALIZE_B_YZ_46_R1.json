                  },
                  "fr_FR": {
                    "text": "Lorsque vous épuisez une carte en Réserve — Je gagne 1 compteur Épreuve.",
                    "locale": "fr_FR"
                  },
                  "en_US": {
                    "text": "When you exhaust a card in Reserve — I gain 1 Trial counter.",
                    "locale": "en_US"
                  },
