                "translations": {
                  "es_ES": {
                    "text": "Cuando agotes una carta en reserva — Puedes agotarme ({T}) para crear una ficha de ilusión [MANA_MOTH] en una expedición objetivo.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Quando consumi una carta nella Riserva — Puoi consumarmi ({T}) per creare una pedina Illusione [MANA_MOTH] in una spedizione bersaglio.",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "When you exhaust a card in Reserve — You may exhaust me ({T}) to create a [MANA_MOTH] Illusion token in target Expedition.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Lorsque vous épuisez une carte en Réserve — Vous pouvez m'épuiser ({T}) pour créer un jeton Illusion [MANA_MOTH] dans une Expédition ciblée.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Wenn du eine Karte in der Reserve erschöpfst — Du darfst mich erschöpfen ({T}), um eine [MANA_MOTH]-Illusionsmarke in einer Expedition deiner Wahl zu erschaffen.",
                    "locale": "de_DE"
                  }
                },
                "text": "When you exhaust a card in Reserve — You may exhaust me ({T}) to create a [MANA_MOTH] Illusion token in target Expedition."
