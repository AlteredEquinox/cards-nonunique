        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "During the scant hours of their brief existence, the Moths flutter about, carrying only the idea of themselves.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Während ihrer kurzen Existenz flattern die Motten umher.",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "Durante sus escasas horas de vida, las polillas revolotean portando la idea misma de su existencia.",
          "locale": "es_ES"
        },
        "it_IT": {
          "text": "Nelle poche ore della loro breve esistenza, le falene vagano alla ricerca di chi sono.",
          "locale": "it_IT"
        },
        "fr_FR": {
          "text": "Durant les quelques heures de leur brève existence, les Phalènes papillonnent, porteuses de l'idée d'elles-mêmes.",
          "locale": "fr_FR"
        }
      },
      "id": "01J21J2BJXHPA7QXXGV5D2NFB8",
      "text": "During the scant hours of their brief existence, the Moths flutter about, carrying only the idea of themselves."
    }
  ],
