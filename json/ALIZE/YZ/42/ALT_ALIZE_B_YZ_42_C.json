                "translations": {
                  "en_US": {
                    "text": "Send to Reserve each Character from target Expedition, then exhaust them ({T}). (Exhausted cards can't be played and have no Support abilities.)",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "Schicke jeden Charakter aus einer Expedition deiner Wahl in die Reserve und erschöpfe ihn dann ({T}). (Erschöpfte Karten können nicht gespielt werden und haben keine Unterstützungsfähigkeiten.)",
                    "locale": "de_DE"
                  },
                  "it_IT": {
                    "text": "Manda nella Riserva tutti i personaggi di una spedizione bersaglio, poi consumali ({T}). (Le carte consumate non possono essere giocate e non hanno abilità di supporto.)",
                    "locale": "it_IT"
                  },
                  "fr_FR": {
                    "text": "Envoyez en Réserve tous les Personnages d'une Expédition ciblée, puis épuisez-les ({T}). (Une carte épuisée ne peut pas être jouée et n'a pas de capacité de Soutien.)",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "Envía a la reserva a cada personaje de una expedición objetivo y luego agótalos ({T}). (Las cartas agotadas no se pueden jugar y no tienen habilidades de apoyo).",
                    "locale": "es_ES"
                  }
                },
                "text": "Send to Reserve each Character from target Expedition, then exhaust them ({T}). (Exhausted cards can't be played and have no Support abilities.)"
              }
            ],
