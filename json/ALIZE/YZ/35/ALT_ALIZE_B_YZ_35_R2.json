                "type": "OUTPUT",
                "translations": {
                  "fr_FR": {
                    "text": "{H} Vous pouvez épuiser ({T}) une carte ciblée en Réserve. #Puis, s'il y a au moins deux cartes épuisées en Réserve, je gagne 1 boost.#",
                    "locale": "fr_FR"
                  },
                  "it_IT": {
                    "text": "{H} Puoi consumare ({T}) una carta bersaglio nella Riserva. #Poi, se ci sono due o più carte consumate nella Riserva, ottengo 1 rinforzo.#",
                    "locale": "it_IT"
                  },
                  "en_US": {
                    "text": "{H} You may exhaust ({T}) target card in Reserve. #Then, if there are two or more exhausted cards in Reserve, I gain 1 boost.#",
                    "locale": "en_US"
                  },
                  "de_DE": {
                    "text": "{H} Du darfst eine Karte deiner Wahl in der Reserve erschöpfen ({T}). #Dann, falls mindestens zwei erschöpfte Karten in der Reserve sind, erhalte ich 1 Verstärkung.#",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "{H} Puedes agotar ({T}) una carta objetivo en reserva. #Luego, si hay dos o más cartas agotadas en reserva, gano 1 potenciador.#",
                    "locale": "es_ES"
                  }
                },
                "text": "{H} You may exhaust ({T}) target card in Reserve. #Then, if there are two or more exhausted cards in Reserve, I gain 1 boost.#"
              }
            ],
