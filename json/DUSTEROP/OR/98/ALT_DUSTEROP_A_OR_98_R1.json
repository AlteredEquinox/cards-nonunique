        "es_ES": {
          "text": "«¡Me importan un bledo tus supuestos retrasos administrativos!».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"I don't give a damn about your so-called administrative delays!\"",
          "locale": "en_US"
        },
