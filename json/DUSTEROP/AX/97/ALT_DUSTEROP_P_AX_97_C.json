                "translations": {
                  "en_US": {
                    "text": "Exhaust a card in your Reserve. If you do, send to Reserve target Character with Base Cost {3} or less.",
                    "locale": "en_US"
                  },
                  "fr_FR": {
                    "text": "Épuisez une carte de votre Réserve. Si vous le faites, envoyez en Réserve un Personnage ciblé de Coût de Base {3} ou moins.",
                    "locale": "fr_FR"
                  },
                  "de_DE": {
                    "text": "Erschöpfe eine Karte in deiner Reserve. Falls du das tust, schicke einen Charakter deiner Wahl mit Basiskosten {3} oder weniger in die Reserve.",
                    "locale": "de_DE"
                  },
                  "es_ES": {
                    "text": "Agota una carta en tu reserva. Si lo haces, envía a la reserva un personaje objetivo con coste base de {3} o menos.",
                    "locale": "es_ES"
                  },
                  "it_IT": {
                    "text": "Consuma una carta nella tua Riserva. Se lo fai, manda nella Riserva un personaggio bersaglio con costo base pari o inferiore a {3}.",
