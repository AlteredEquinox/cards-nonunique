        "subject": "Flavor Text"
      },
      "translations": {
        "de_DE": {
          "text": "„Du musst ein Fehler in meinem System sein, denn ich kann dich nicht aus meinem Gedächtnis löschen.“",
          "locale": "de_DE"
        },
        "es_ES": {
          "text": "«Debes de ser un error en mi sistema, porque no puedo borrarte de mi memoria».",
          "locale": "es_ES"
        },
        "en_US": {
          "text": "\"You must be a bug in my system, because I can't clear you out of my memory.\"",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Tu dois être un bug dans mon système, parce que je peux pas te sortir de ma mémoire vive. »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Devi essere un errore nel mio sistema, perché non riesco a eliminarti dalla memoria.\"",
          "locale": "it_IT"
        }
      },
      "id": "01K4Z6KZ56A9G6E4G1XSNTNWGT",
      "text": "\"You must be a bug in my system, because I can't clear you out of my memory.\""
    }
